<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════
         LIST VIEW — Danh sách khách hàng
    ══════════════════════════════════════════════ -->
    <record id="view_dlm_customer_list" model="ir.ui.view">
        <field name="name">dlm.customer.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Khách hàng" default_order="name asc">
                <field name="name" string="Tên khách hàng"/>
                <field name="customer_type" string="Loại" widget="badge"
                       decoration-info="customer_type == 'individual'"
                       decoration-success="customer_type == 'dealer'"
                       decoration-warning="customer_type == 'enterprise'"/>
                <field name="phone" string="Điện thoại"/>
                <field name="email" string="Email"/>
                <field name="street" string="Địa chỉ" optional="show"/>
                <field name="country_id" string="Quốc gia" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════
         FORM VIEW — Chi tiết khách hàng
    ══════════════════════════════════════════════ -->
    <record id="view_dlm_customer_form" model="ir.ui.view">
        <field name="name">dlm.customer.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Khách hàng">
                <sheet>
                    <field name="image_1920" widget="image"
                           class="oe_avatar" readonly="0"/>
                    <div class="oe_title">
                        <label for="name" string="Tên khách hàng"/>
                        <h1>
                            <field name="name" placeholder="Nhập tên khách hàng..."
                                   required="1"/>
                        </h1>
                        <field name="customer_type" widget="radio"
                               options="{'horizontal': true}"/>
                    </div>

                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group string="Địa chỉ">
                            <field name="street" placeholder="Số nhà, đường..."/>
                            <field name="street2" placeholder="Phường/Xã"/>
                            <field name="city" placeholder="Quận/Huyện"/>
                            <field name="state_id" placeholder="Tỉnh/Thành phố"
                                   options="{'no_create': true}"/>
                            <field name="country_id"
                                   options="{'no_create': true}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Ghi chú nội bộ" name="internal_notes">
                            <field name="dlm_note"
                                   placeholder="Ghi chú dành cho nội bộ BA/Sales — không hiển thị cho khách hàng..."/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter (mail.thread) -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════
         SEARCH VIEW — Bộ lọc tìm kiếm
    ══════════════════════════════════════════════ -->
    <record id="view_dlm_customer_search" model="ir.ui.view">
        <field name="name">dlm.customer.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm khách hàng">
                <field name="name" string="Tên" filter_domain="[('name', 'ilike', self)]"/>
                <field name="phone" string="Điện thoại"/>
                <field name="email" string="Email"/>

                <separator/>

                <filter name="filter_individual" string="Cá nhân"
                        domain="[('customer_type', '=', 'individual')]"/>
                <filter name="filter_enterprise" string="Doanh nghiệp"
                        domain="[('customer_type', '=', 'enterprise')]"/>
                <filter name="filter_dealer" string="Đại lý"
                        domain="[('customer_type', '=', 'dealer')]"/>

                <separator/>

                <filter name="filter_active" string="Đang hoạt động"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Đã lưu trữ"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_customer_type" string="Loại khách hàng"
                            context="{'group_by': 'customer_type'}"/>
                    <filter name="group_country" string="Quốc gia"
                            context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════
         ACTION — Window action mở danh sách khách hàng
    ══════════════════════════════════════════════ -->
    <record id="action_dlm_customer" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
        <field name="context">{
            'default_customer_rank': 1,
            'default_customer_type': 'individual'
        }</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_dlm_customer_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dlm_customer_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dlm_customer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có khách hàng nào
            </p>
            <p>Tạo khách hàng đầu tiên cho Đại Linh ERP.</p>
        </field>
    </record>

</odoo>
