<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="dai_linh_erp.DlmHome">
    <div class="dlm-home">

        <!-- ── Header ── -->
        <div class="dlm-home-header">
            <div class="dlm-home-header-inner">
                <div class="dlm-logo-wrap">
                    <i class="fa fa-industry dlm-logo-icon"/>
                </div>
                <div>
                    <h1 class="dlm-home-title">Đại Linh ERP</h1>
                    <p class="dlm-home-subtitle">
                        Công ty TNHH Đầu tư và Sản xuất Đại Linh
                    </p>
                </div>
            </div>
        </div>

        <!-- ── Module grid ── -->
        <div class="dlm-home-body">
            <h2 class="dlm-section-title">Danh sách phân hệ</h2>

            <div class="dlm-module-grid">
                <t t-foreach="modules" t-as="mod" t-key="mod.id">
                    <div
                        class="dlm-module-card"
                        t-att-class="mod.soon ? 'dlm-card-soon' : 'dlm-card-active'"
                        t-on-click="() => this.openModule(mod)"
                    >
                        <!-- Color bar top -->
                        <div class="dlm-card-bar" t-att-class="mod.color"/>

                        <!-- Icon -->
                        <div class="dlm-card-icon-wrap" t-att-class="mod.color + '-bg'">
                            <i class="fa" t-att-class="mod.icon"/>
                        </div>

                        <!-- Content -->
                        <div class="dlm-card-content">
                            <div class="dlm-card-group" t-esc="mod.group"/>
                            <h3 class="dlm-card-name" t-esc="mod.name"/>
                            <p class="dlm-card-desc" t-esc="mod.description"/>
                        </div>

                        <!-- Badge -->
                        <div class="dlm-card-footer">
                            <t t-if="mod.soon">
                                <span class="dlm-badge dlm-badge-soon">Sắp ra mắt</span>
                            </t>
                            <t t-else="">
                                <span class="dlm-badge dlm-badge-ready">
                                    <i class="fa fa-check me-1"/> Hoạt động
                                </span>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>

    </div>
</t>

</templates>
