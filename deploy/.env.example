# ─────────────────────────────────────────────
#  DLM-ERP · biến môi trường production
#  cp .env.example .env  →  sửa rồi chmod 600 .env
# ─────────────────────────────────────────────

# ── Domain & SSL ─────────────────────────────
# Domain phải đã trỏ A record về IP VPS TRƯỚC khi chạy init-letsencrypt.sh
DOMAIN=erp.example.com
LETSENCRYPT_EMAIL=you@example.com
# STAGING=1 → xin cert thử của Let's Encrypt (cert không hợp lệ nhưng không dính
# rate-limit 5 lần/tuần). Chạy thử thành công rồi mới đổi về 0 và xin cert thật.
STAGING=0

# ── PostgreSQL ───────────────────────────────
# Sinh password:  openssl rand -base64 24
POSTGRES_USER=odoo
POSTGRES_PASSWORD=

# ── Backup ───────────────────────────────────
BACKUP_DIR=/opt/dlm-backup
BACKUP_KEEP_DAYS=7
