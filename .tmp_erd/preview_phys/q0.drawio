        <mxCell id="t2" value="DLM-ERP — Physical ERD · 0 — Overview / Table map" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#12263F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1600" height="32" as="geometry"/></mxCell>
        <mxCell id="t3" value="Toàn bộ 56 đối tượng vật lý, chỉ tên bảng và khoá chính, gom theo 6 vùng chủ đề. Cột cuối là bảng lõi Odoo bị tham chiếu nhưng nằm ngoài phạm vi mô hình. Thuộc tính đầy đủ xem trang A–F." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A5A5A;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Cạnh: chân quạ ở đầu &#x27;nhiều&#x27;. Vòng tròn ở đầu &#x27;một&#x27; = cha TÙY CHỌN (FK cho phép NULL). Màu cạnh = ON DELETE — đỏ CASCADE · xanh lá RESTRICT · xám đứt SET NULL. Cạnh đậm = nối sang trang khác." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5A5A5A;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="1700" height="32" as="geometry"/></mxCell>
