        <mxCell id="t3" value="Hộp viền đậm = bảng do dự án tạo (dl_*) · nền xanh nhạt = bảng lõi Odoo có thêm cột dlm_ · nền xám = bảng lõi dùng nguyên trạng · viền đứt tím = SQL VIEW · hộp bo tròn cam = bảng nối Many2many · hộp xám nhạt = nhắc lại từ trang khác." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5A5A5A;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1500" height="32" as="geometry"/></mxCell>
