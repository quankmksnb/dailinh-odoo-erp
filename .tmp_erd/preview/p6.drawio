          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6-a_bal" value="&lt;b&gt;STOCK BALANCE&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;#8226; Không có mã &amp;#8212; &lt;u&gt;(Item, Location, Lot)&lt;/u&gt;&lt;br/&gt;&amp;#8226; On-hand · Reserved · Available quantity&lt;br/&gt;&amp;#8226; Supplier &amp;amp; receipt date &lt;i&gt;(thừa kế từ lô)&lt;/i&gt;&lt;br/&gt;&amp;#8226; &lt;i&gt;Lớp kiểm kê:&lt;/i&gt; counted quantity · count-entered flag&lt;br/&gt;&amp;#8226; &amp;#160;&amp;#160;difference vs. system&lt;br/&gt;&amp;#8226; &lt;i&gt;Lớp phế liệu:&lt;/i&gt; scrap unit price · line value&lt;br/&gt;&amp;#8226; &amp;#160;&amp;#160;&lt;b&gt;đây là giá BÁN, không phải giá vốn&lt;/b&gt; &amp;#8212;&lt;br/&gt;&amp;#8226; &amp;#160;&amp;#160;nên thủ kho được xem (§8.3)&lt;br/&gt;&amp;#8226; Không nhập trực tiếp: dòng sinh/mất theo chứng từ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;" vertex="1" parent="p6-1">
          <mxGeometry x="1000" y="1830" width="340" height="178" as="geometry"/>
        </mxCell>
        <mxCell id="p6-e60" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#b3b3b3;dashed=1;dashPattern=3 3;" edge="1" parent="p6-1" source="p6-bal" target="p6-a_bal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6-a_scrap" value="&lt;b&gt;SCRAP RECOVERY RECONCILIATION&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;#8226; &lt;b&gt;Dẫn xuất &amp;#8212; không có khoá lưu trữ&lt;/b&gt;, một dòng / &lt;u&gt;tháng&lt;/u&gt;&lt;br/&gt;&amp;#8226; Period (month)&lt;br/&gt;&amp;#8226; Actual quantity into the scrap zone&lt;br/&gt;&amp;#8226; Quantity sold out of it&lt;br/&gt;&amp;#8226; &lt;b&gt;Estimated quantity&lt;/b&gt; &lt;i&gt;(từ BOM của đơn đã chốt trong kỳ)&lt;/i&gt;&lt;br/&gt;&amp;#8226; Difference · Verdict: Short / Matches / Over estimate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;" vertex="1" parent="p6-1">
          <mxGeometry x="2400" y="2230" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p6-e61" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#b3b3b3;dashed=1;dashPattern=3 3;" edge="1" parent="p6-1" source="p6-scrap" target="p6-a_scrap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt62" value="&lt;b&gt;⚠ Chỗ dễ vẽ sai nhất của trang F (§4.7-6)&lt;/b&gt;&lt;br/&gt;Cạnh &lt;b&gt;contains → STOCK DOCUMENT LINE&lt;/b&gt; là &lt;b&gt;đường ĐƠN&lt;/b&gt; (tham gia &lt;i&gt;bộ phận&lt;/i&gt;), &lt;b&gt;không&lt;/b&gt; phải đường kép &amp;#8212; dù dòng phiếu là thực thể yếu.&lt;br/&gt;Lý do: &lt;b&gt;dòng điều chỉnh kiểm kê không có phiếu cha&lt;/b&gt;. Odoo 17 áp kết quả kiểm kê bằng cách sinh thẳng chuyển động &lt;i&gt;is-adjustment&lt;/i&gt;, &lt;b&gt;không&lt;/b&gt; tạo phiếu. Đối ứng là vị trí ảo &lt;i&gt;Điều chỉnh kiểm kê&lt;/i&gt; &amp;#8658; hàng không tự sinh ra hay biến mất, kể cả khi sửa sai.&lt;br/&gt;Những dòng đó định danh bằng &lt;i&gt;(Item, Location, Timestamp)&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="1100" width="560" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt63" value="&lt;b&gt;Hai vai tới cùng một thực thể (§4.7-4, §5-3)&lt;/b&gt;&lt;br/&gt;&lt;b&gt;STOCK_DOCUMENT_LINE → STOCK_LOCATION&lt;/b&gt; xuất hiện &lt;b&gt;hai lần&lt;/b&gt;: &lt;i&gt;từ vị trí&lt;/i&gt; và &lt;i&gt;tới vị trí&lt;/i&gt;. Elmasri bắt buộc đặt &lt;b&gt;tên vai (role name)&lt;/b&gt; khi hai quan hệ nối cùng một cặp thực thể &amp;#8212; thiếu tên vai là &lt;b&gt;sơ đồ sai nghĩa&lt;/b&gt;, không chỉ là thiếu nhãn." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="1340" width="560" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt64" value="&lt;b&gt;STOCK BALANCE &amp;#8212; khoá tổ hợp từ BA quan hệ&lt;/b&gt;&lt;br/&gt;Không có khoá riêng: định danh bởi &lt;b&gt;(ITEM, LOCATION, LOT)&lt;/b&gt; &amp;#8658; cả ba cạnh &lt;i&gt;stocked_as · holds · held_as&lt;/i&gt; đều là &lt;b&gt;tham gia toàn bộ&lt;/b&gt; phía tồn kho.&lt;br/&gt;&lt;b&gt;Kiểm kê là một trạng thái đếm, không phải chứng từ&lt;/b&gt; (§0.2-6) &amp;#8658; nó &lt;i&gt;không&lt;/i&gt; có hộp riêng trên sơ đồ. Vì thế quan hệ &lt;b&gt;adjusted_by chạy ngược chiều trực giác&lt;/b&gt;: tồn kho &lt;i&gt;sinh ra&lt;/i&gt; dòng chuyển động, chứ không phải ngược lại." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="1520" width="560" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="p6-lg65" value="&lt;b&gt;CH&amp;#218; GI&amp;#7842;I K&amp;#221; HI&amp;#7878;U &amp;#8212; Chen / EER (Elmasri &amp;amp; Navathe)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;#9633; H&amp;#7897;p &amp;#273;&amp;#417;n &amp;#8212; ki&amp;#7875;u th&amp;#7921;c th&amp;#7875;&lt;br/&gt;&amp;#9636; H&amp;#7897;p k&amp;#233;p (cam) &amp;#8212; th&amp;#7921;c th&amp;#7875; y&amp;#7871;u (weak entity)&lt;br/&gt;&amp;#9633; H&amp;#7897;p n&amp;#233;t &amp;#273;&amp;#7913;t x&amp;#225;m &amp;#8212; entity bi&amp;#234;n (thu&amp;#7897;c sub-ERD kh&amp;#225;c, kh&amp;#244;ng v&amp;#7869; thu&amp;#7897;c t&amp;#237;nh)&lt;br/&gt;&amp;#9671; H&amp;#236;nh thoi &amp;#8212; ki&amp;#7875;u quan h&amp;#7879;&lt;br/&gt;&amp;#9671; H&amp;#236;nh thoi k&amp;#233;p &amp;#8212; quan h&amp;#7879; &amp;#273;&amp;#7883;nh danh (identifying relationship)&lt;br/&gt;&amp;#8212; &amp;#272;&amp;#432;&amp;#7901;ng &amp;#273;&amp;#417;n &amp;#8212; tham gia b&amp;#7897; ph&amp;#7853;n (partial)&lt;br/&gt;&amp;#8801; &amp;#272;&amp;#432;&amp;#7901;ng k&amp;#233;p &amp;#8212; tham gia to&amp;#224;n b&amp;#7897; (total)&lt;br/&gt;&lt;b&gt;1 / M / N&lt;/b&gt; tr&amp;#234;n c&amp;#7841;nh &amp;#8212; l&amp;#7921;c l&amp;#432;&amp;#7907;ng (cardinality ratio)&lt;br/&gt;&amp;#9711; V&amp;#242;ng tr&amp;#242;n &lt;b&gt;d&lt;/b&gt; / &lt;b&gt;o&lt;/b&gt; &amp;#8212; chuy&amp;#234;n bi&amp;#7879;t ho&amp;#225; disjoint / overlapping; cung mang &lt;b&gt;&amp;#8834;&lt;/b&gt; tr&amp;#7887; v&amp;#7873; l&amp;#7899;p con&lt;br/&gt;&amp;#8943; &amp;#272;&amp;#432;&amp;#7901;ng ch&amp;#7845;m t&amp;#237;m &amp;#8212; tham chi&amp;#7871;u m&amp;#7873;m (snapshot, c&amp;#7889; &amp;#253; kh&amp;#244;ng c&amp;#243; kho&amp;#225; ngo&amp;#7841;i)&lt;br/&gt;&amp;#9642; H&amp;#7897;p tr&amp;#7855;ng c&amp;#7841;nh entity &amp;#8212; thu&amp;#7897;c t&amp;#237;nh nghi&amp;#7879;p v&amp;#7909; ch&amp;#237;nh; &lt;u&gt;g&amp;#7841;ch ch&amp;#226;n&lt;/u&gt; = &amp;#273;&amp;#7883;nh danh nghi&amp;#7879;p v&amp;#7909;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="1740" width="560" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt66" value="&lt;b&gt;KHÔNG xuất hiện trên trang F &amp;#8212; và vì sao&lt;/b&gt;&lt;br/&gt;&amp;#8226; &lt;b&gt;Kiểm kê&lt;/b&gt; &amp;#8212; là trạng thái đếm trên STOCK_BALANCE (§0.2-6), không phải chứng từ.&lt;br/&gt;&amp;#8226; &lt;b&gt;Chi tiết dòng phiếu theo lô&lt;/b&gt; &amp;#8212; đã diễn tả đủ bằng quan hệ N:M có thuộc tính (§4.7-5).&lt;br/&gt;&amp;#8226; &lt;b&gt;Tuyến nhập 2 bước · nhóm cung ứng&lt;/b&gt; &amp;#8212; cơ chế nội bộ sinh ra cặp 1—1 &lt;i&gt;Nhận → Kiểm&lt;/i&gt;, không phải dữ liệu nghiệp vụ.&lt;br/&gt;&amp;#8226; &lt;b&gt;XSX · NTP&lt;/b&gt; &amp;#8212; đã seed nhưng thuộc sub-ERD G (§4.8).&lt;br/&gt;&amp;#8226; &lt;b&gt;Sáu lớp con của Phiếu kho&lt;/b&gt; &amp;#8212; xem ghi chú bên phải." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="2110" width="560" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt67" value="&lt;b&gt;Ký hiệu riêng trang F&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;#9633; Hộp &lt;b&gt;nét đứt tím&lt;/b&gt; &amp;#8212; thực thể &lt;b&gt;dẫn xuất&lt;/b&gt; (derived): không lưu trữ, tính lại mỗi lần đọc.&lt;br/&gt;&amp;#9671; Hình thoi &lt;b&gt;nét đứt tím&lt;/b&gt; + cạnh nét đứt tím &amp;#8212; &lt;b&gt;quan hệ suy diễn&lt;/b&gt;: dữ liệu đọc lại từ nơi khác, không có khoá ngoại.&lt;br/&gt;&lt;i&gt;Khác với đường chấm tím ở chú giải chung&lt;/i&gt; &amp;#8212; đường chấm là &lt;i&gt;tham chiếu mềm / snapshot&lt;/i&gt; (sub-ERD D)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="2110" width="320" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt68" value="&lt;b&gt;Tự tham chiếu = xương sống truy vết đối ngoại (§4.7-2, 3)&lt;/b&gt;&lt;br/&gt;Phiếu &lt;b&gt;Kiểm &amp;amp; cất&lt;/b&gt; và phiếu &lt;b&gt;Trả hàng NCC&lt;/b&gt; đều neo về &lt;b&gt;phiếu Nhận hàng&lt;/b&gt;, &lt;i&gt;không&lt;/i&gt; neo vào nhau &amp;#8658; khiếu nại NCC luôn quy được về &lt;b&gt;lần giao hàng&lt;/b&gt; đã gây ra nó.&lt;br/&gt;&lt;b&gt;Ràng buộc trên quan hệ này:&lt;/b&gt; &lt;i&gt;mỗi phiếu Nhận hàng sinh đúng MỘT phiếu Kiểm &amp;amp; cất.&lt;/i&gt; Đây là &lt;b&gt;ràng buộc, không phải cấu trúc&lt;/b&gt; &amp;#8212; nếu để hệ thống gộp theo mặc định (theo vị trí + loại hoạt động, &lt;b&gt;không&lt;/b&gt; theo đối tác), hai phiếu nhận của hai NCC sẽ gộp thành một phiếu kiểm và phiếu trả hàng sẽ &lt;b&gt;ghi sai tên NCC&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="2250" y="130" width="500" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt69" value="&lt;b&gt;Vì sao KHÔNG vẽ hộp cho 6 lớp con của Phiếu kho (§0.2-3, §5-1)&lt;/b&gt;&lt;br/&gt;Nhận hàng · Kiểm &amp;amp; cất · Chuyển kho · Giao hàng · Trả hàng NCC · Bán phế liệu &lt;b&gt;dùng chung đúng một bộ thuộc tính&lt;/b&gt;, chỉ khác tuyến đi và quy trình.&lt;br/&gt;Bản thân &lt;b&gt;thuộc tính phân lớp lại là một thực thể&lt;/b&gt; (&lt;b&gt;OPERATION_TYPE&lt;/b&gt;) &amp;#8658; chuyên biệt hoá ở đây được xác định bởi &lt;b&gt;quan hệ &lt;i&gt;classifies&lt;/i&gt;&lt;/b&gt;, vẽ thêm 6 hộp rỗng chỉ làm sơ đồ ồn." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="2250" y="370" width="500" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt70" value="&lt;b&gt;Cây vị trí &amp;#8212; và vì sao phế liệu là vị trí THẬT (§4.7-1)&lt;/b&gt;&lt;br/&gt;3 khu × 5 vị trí con, quan hệ đệ quy &lt;i&gt;parent_of&lt;/i&gt;.&lt;br/&gt;Cả ba khu đều khai là vị trí &lt;b&gt;nội bộ&lt;/b&gt; (không phải &lt;i&gt;view&lt;/i&gt;) &amp;#8212; khu &lt;i&gt;view&lt;/i&gt; sẽ mất tiền tố &lt;code&gt;DL/&lt;/code&gt; trên đường dẫn hiển thị.&lt;br/&gt;Khu &lt;b&gt;Phế liệu chờ bán&lt;/b&gt; (&lt;code&gt;DL/XUONG/PL&lt;/code&gt;) là vị trí nội bộ thật, &lt;b&gt;không&lt;/b&gt; dùng vị trí phế liệu ảo của Odoo: phế liệu là &lt;b&gt;tài sản bán lại được đã trừ trước vào giá vốn&lt;/b&gt; lúc báo giá, nên phải &lt;b&gt;cân được, đếm được, bán được&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="2530" y="830" width="340" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="p6-nt71" value="&lt;b&gt;Vòng phản hồi phế liệu (§4.7-7) &amp;#8212; đọc đúng nghĩa&lt;/b&gt;&lt;br/&gt;So &lt;b&gt;dự toán thu hồi&lt;/b&gt; (từ định mức của các đơn đã chốt trong kỳ) với &lt;b&gt;cân thực tế&lt;/b&gt; (hàng vào khu phế liệu).&lt;br/&gt;Tiền bán phế liệu &lt;b&gt;không phải lãi thêm&lt;/b&gt; &amp;#8212; giá trị thu hồi đã bị trừ trước vào giá vốn lúc báo giá. Vậy nên:&lt;br/&gt;&amp;#8226; thu hồi &lt;b&gt;ít hơn&lt;/b&gt; dự toán = &lt;b&gt;đang lỗ ngầm&lt;/b&gt;;&lt;br/&gt;&amp;#8226; thu hồi &lt;b&gt;nhiều hơn&lt;/b&gt; = định mức hao hụt đặt quá tay.&lt;br/&gt;Số thực tế đọc từ &lt;b&gt;STOCK_DOCUMENT_LINE&lt;/b&gt;, &lt;b&gt;không&lt;/b&gt; từ STOCK_BALANCE: tồn kho là ảnh chụp hiện tại, không có chiều thời gian để chia kỳ.&lt;br/&gt;Đây chính là seam &lt;b&gt;S10&lt;/b&gt; đóng vòng về quan hệ &lt;i&gt;recovers_as_scrap&lt;/i&gt; ở sub-ERD B (§4.3)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="p6-1">
          <mxGeometry x="2530" y="1500" width="340" height="290" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
