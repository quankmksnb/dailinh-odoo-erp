<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="dl_base.DlmRail">
    <div class="dlm-rail" t-if="state.visible" t-att-class="{ collapsed: sidebar.collapsed }">
        <div class="dlm-rail-head">
            <div class="dlm-rail-logo" title="Trang chủ"
                 t-on-click="() => this.openModule('dl_base.action_dl_home')">
                <span class="dlm-rail-icon">◆</span>
                <span class="dlm-rail-label">DLM-ERP</span>
            </div>
            <button class="dlm-rail-toggle" t-on-click="() => this.toggleSidebar()"
                    t-att-title="sidebar.collapsed ? 'Mở rộng' : 'Thu gọn'">
                <i class="fa fa-bars"/>
            </button>
        </div>

        <t t-foreach="visibleItems" t-as="item" t-key="item.key">
            <t t-if="item.children and item.children.length">
                <div class="dlm-rail-item has-children"
                     t-att-title="item.name"
                     t-att-class="{ 'expanded': state.expanded[item.key], 'active': sidebar.activeKey === item.key }"
                     t-on-click="() => this.toggleSubmenu(item.key)">
                    <span class="dlm-rail-icon"><i t-att-class="'fa ' + item.icon"/></span>
                    <span class="dlm-rail-label" t-esc="item.name"/>
                    <i class="dlm-rail-chevron fa fa-chevron-down"/>
                </div>
                <div class="dlm-rail-submenu" t-if="state.expanded[item.key]">
                    <t t-foreach="item.children" t-as="child" t-key="child.key">
                        <div class="dlm-rail-item dlm-rail-subitem"
                             t-att-title="child.name"
                             t-on-click.stop="() => this.openModule(child.actionXmlId, item.key)">
                            <span class="dlm-rail-icon"/>
                            <span class="dlm-rail-label" t-esc="child.name"/>
                        </div>
                    </t>
                </div>
            </t>
            <t t-else="">
                <div class="dlm-rail-item" t-att-title="item.name"
                     t-att-class="{ 'disabled': !item.actionXmlId, 'active': sidebar.activeKey === item.key }"
                     t-on-click="() => this.openModule(item.actionXmlId, item.key)">
                    <span class="dlm-rail-icon"><i t-att-class="'fa ' + item.icon"/></span>
                    <span class="dlm-rail-label" t-esc="item.name"/>
                    <span class="dlm-rail-soon" t-if="!item.actionXmlId">Sắp có</span>
                </div>
            </t>
        </t>
    </div>
</t>

</templates>
