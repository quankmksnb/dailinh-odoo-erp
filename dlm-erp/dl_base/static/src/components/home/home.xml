<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="dl_base.DlHome">
    <div class="dl-home o_action">
        <!-- Topbar tối giản: thương hiệu + systray (avatar/thông báo). Navbar
             tím của Odoo bị ẩn ở chế độ fullscreen nên systray đặt tại đây. -->
        <header class="dl-home-topbar">
            <Dropdown class="'dl-home-brand'">
                <t t-set-slot="toggler">
                    <span class="dl-home-brand-logo">◆</span>
                    <span class="dl-home-brand-name">DLM-ERP</span>
                    <i class="fa fa-angle-down dl-home-brand-caret"/>
                </t>
                <DropdownItem t-foreach="apps" t-as="app" t-key="app.id"
                              class="{ 'o_app': true }"
                              href="getMenuItemHref(app)"
                              onSelected="() => this.onAppSelected(app)"
                              t-esc="app.name"/>
            </Dropdown>
            <div class="o_menu_systray dl-home-systray" role="menu">
                <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                    <ErrorHandler onError="(error) => this.handleItemError(error, item)">
                        <t t-component="item.Component" t-props="item.props"/>
                    </ErrorHandler>
                </t>
            </div>
        </header>

        <div class="dl-home-body">
            <div class="dl-home-hero">
                <h1 class="dl-home-hero-title">DLM ERP</h1>
            </div>

            <!-- Lưới card module. Mỗi card = 1 menu cấp 1 user được phép truy cập. -->
            <div class="dl-home-cards">
                <t t-foreach="modules" t-as="mod" t-key="mod.key">
                    <button class="dl-home-card" t-on-click="() => this.openCard(mod)">
                        <span class="dl-home-card-icon"
                              t-attf-style="background-color: {{ mod.color }}">
                            <i t-att-class="'fa ' + mod.icon"/>
                        </span>
<<<<<<< Updated upstream
