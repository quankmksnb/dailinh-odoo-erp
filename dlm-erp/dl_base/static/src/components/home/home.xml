<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="dl_base.DlHome">
    <div class="dl-home o_action">
        <!-- Landing theo vai trò: đang chuyển thẳng vào màn nghiệp vụ chính.
             Hiện loader để không chớp lưới thẻ rồi mới nhảy. -->
        <div t-if="state.redirecting" class="dl-home-redirecting">
            <i class="fa fa-circle-o-notch fa-spin"/>
            <span>Đang mở màn hình làm việc…</span>
        </div>
        <t t-else="">
        <nav class="dl-home-navbar">
            <Dropdown class="'dl-home-brand'">
                <t t-set-slot="toggler">
                    <img class="dl-home-brand-logo"
                         src="/dl_base/static/img/dai_linh_mark.png" alt="Đại Linh"/>
                    <span class="dl-home-brand-name">Đại Linh</span>
                    <i class="fa fa-angle-down dl-home-brand-caret"/>
                </t>
                <DropdownItem t-foreach="apps" t-as="app" t-key="app.id"
                              class="{ 'o_app': true }"
                              href="getMenuItemHref(app)"
                              onSelected="() => this.onAppSelected(app)"
                              t-esc="app.name"/>
            </Dropdown>

            <div class="o_menu_systray dl-home-systray" role="menu">
                <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                    <ErrorHandler onError="(error) => this.handleItemError(error, item)">
                        <t t-component="item.Component" t-props="item.props"/>
                    </ErrorHandler>
                </t>
            </div>
        </nav>

        <div class="dl-home-body">
            <div class="dl-home-hero">
                <img class="dl-home-hero-logo"
                     src="/dl_base/static/img/dai_linh_logo.png"
                     alt="Công ty TNHH Đầu tư và Sản xuất Đại Linh"/>
                <!-- Logo đã mang chữ "DAI LINH" nên tiêu đề nói việc, còn tên
                     pháp lý đầy đủ đặt ở dòng phụ. -->
                <h1 class="dl-home-title">Hệ thống quản lý báo giá &amp; phê duyệt</h1>
                <p class="dl-home-subtitle">Công ty TNHH Đầu tư và Sản xuất Đại Linh</p>
            </div>

            <div class="dl-home-grid">
                <t t-foreach="cards" t-as="card" t-key="card.key">
                    <div class="dl-home-card"
                         t-on-click="() => this.openCard(card)">
                        <div class="dl-home-card-icon" t-attf-style="background: {{ card.color }}">
                            <i t-att-class="'fa ' + card.icon"/>
                        </div>
                        <div class="dl-home-card-info">
                            <span class="dl-home-card-name" t-esc="card.name"/>
                            <span class="dl-home-card-desc" t-esc="card.description"/>
                        </div>
                        <!-- Badge việc đang chờ (vd số yêu cầu chờ phê duyệt) -->
                        <span t-if="badgeCounts[card.key]" class="dl-home-card-badge"
                              t-esc="badgeCounts[card.key]"/>
                    </div>
                </t>
            </div>
        </div>
        </t>
    </div>
</t>

</templates>
