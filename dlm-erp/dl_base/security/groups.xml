<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             Category đánh dấu "Vai trò DLM-ERP" (RBAC).
             Mọi res.groups nằm trong category này được coi là VAI TRÒ và
             hiển thị ở màn Phân quyền. Vai trò Admin tạo động cũng gán vào đây.
        ============================================================ -->
        <record id="module_category_dl_rbac" model="ir.module.category">
            <field name="name">Vai trò DLM-ERP</field>
            <field name="description">Nhóm vai trò phân quyền DLM-ERP (RBAC)</field>
            <field name="sequence">5</field>
        </record>

        <!-- ============================================================
             4 Nhóm quyền DL ERP (H2 — Entity Proposal v2)
             Được định nghĩa tại base để mọi module con đều tham chiếu được.
        ============================================================ -->

        <!-- Tất cả user DLM đều implied group_user -->
        <record id="dl_group_ceo" model="res.groups">
            <field name="name">CEO</field>
            <field name="comment">Phê duyệt báo giá, cấu hình kinh doanh (F2, F3, E1), override margin</field>
            <field name="category_id" ref="module_category_dl_rbac" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="dl_group_admin" model="res.groups">
            <field name="name">Admin/IT</field>
            <field name="comment">Quản trị hệ thống, cấu hình kỹ thuật (F1, F4), tạo user</field>
            <field name="category_id" ref="module_category_dl_rbac" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="dl_group_ba" model="res.groups">
            <field name="name">BA/Sales</field>
            <field name="comment">Tạo và chỉnh sửa báo giá, xem lịch sử phê duyệt</field>
            <field name="category_id" ref="module_category_dl_rbac" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="dl_group_tech" model="res.groups">
            <field name="name">Kỹ thuật</field>
            <field name="comment">Quản lý BOM, bản vẽ, vật tư — KHÔNG thấy giá bán cuối</field>
            <field name="category_id" ref="module_category_dl_rbac" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <!-- ============================================================
             Bổ sung cho module dl_product (Bảng giá Vật tư)
        ============================================================ -->

        <record id="dl_group_accountant" model="res.groups">
            <field name="name">Kế toán nội bộ</field>
            <field name="comment">Chủ sở hữu Bảng giá Vật tư: cập nhật đơn giá, NCC, ngày hiệu lực, đánh dấu giá không hợp lệ</field>
            <field name="category_id" ref="module_category_dl_rbac"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="dl_group_sales_manager" model="res.groups">
            <field name="name">Trưởng phòng Kinh doanh</field>
            <field name="comment">Xem (Restricted) danh mục vật tư/giá tham khảo phục vụ quản lý kinh doanh</field>
            <field name="category_id" ref="module_category_dl_rbac"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Mua hàng: sở hữu "giá MUA" — Nhà cung cấp, giá NCC (supplierinfo),
             giá vốn. Tách khỏi Kế toán (Kế toán giữ giá bán? KHÔNG — giá bán
             chuyển cho Sales; Kế toán chỉ còn xem giá). -->
        <record id="dl_group_purchasing" model="res.groups">
            <field name="name">Mua hàng</field>
            <field name="comment">Chủ sở hữu giá MUA: Nhà cung cấp, đơn giá NCC (duyệt/áp dụng), giá vốn</field>
            <field name="category_id" ref="module_category_dl_rbac"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ============================================================
             Seed: gán tài khoản admin mặc định của Odoo vào vai trò
             Admin/IT của DLM. Nếu không có dòng này, DB mới cài xong sẽ
             KHÔNG có user nào thuộc dl_group_admin ⇒ không ai vào được màn
             Phân quyền (guard _check_rbac_admin chặn). Membership do tick
             tay trên UI chỉ nằm trong DB, không đi theo git.
        ============================================================ -->
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('dl_base.dl_group_admin'))]"/>
        </record>

    </data>
</odoo>