<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             4 Nhóm quyền DL ERP (H2 — Entity Proposal v2)
             Được định nghĩa tại base để mọi module con đều tham chiếu được.
        ============================================================ -->

        <!-- Tất cả user DLM đều implied group_user -->
        <record id="dl_group_ceo" model="res.groups">
            <field name="name">CEO</field>
            <field name="comment">Phê duyệt báo giá, cấu hình kinh doanh (F2, F3, E1), override margin</field>
            <field name="category_id" ref="base.module_category_hidden" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="dl_group_admin" model="res.groups">
            <field name="name">Admin/IT</field>
            <field name="comment">Quản trị hệ thống, cấu hình kỹ thuật (F1, F4), tạo user</field>
            <field name="category_id" ref="base.module_category_hidden" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="dl_group_ba" model="res.groups">
            <field name="name">BA/Sales</field>
            <field name="comment">Tạo và chỉnh sửa báo giá, xem lịch sử phê duyệt</field>
            <field name="category_id" ref="base.module_category_hidden" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="dl_group_tech" model="res.groups">
            <field name="name">Kỹ thuật</field>
            <field name="comment">Quản lý BOM, bản vẽ, vật tư — KHÔNG thấy giá bán cuối</field>
            <field name="category_id" ref="base.module_category_hidden" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <!-- ============================================================
             Bổ sung cho module dlm_material (Bảng giá Vật tư)
        ============================================================ -->

        <record id="dl_group_accountant" model="res.groups">
            <field name="name">Kế toán nội bộ</field>
            <field name="comment">Chủ sở hữu Bảng giá Vật tư: cập nhật đơn giá, NCC, ngày hiệu lực, đánh dấu giá không hợp lệ</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="dl_group_sales_manager" model="res.groups">
            <field name="name">Trưởng phòng Kinh doanh</field>
            <field name="comment">Xem (Restricted) danh mục vật tư/giá tham khảo phục vụ quản lý kinh doanh</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>