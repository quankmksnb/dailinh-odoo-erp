<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem
        id="menu_dl_root"
        name="DLM-ERP"
        sequence="1"
        web_icon="dl_base,static/description/icon.png"
        action="action_dl_home"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_tech,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager"
    />

    <menuitem
        id="menu_dl_sale"
        name="CRM &amp; Báo giá"
        parent="menu_dl_root"
        sequence="10"
    />

    <!-- Menu cha phải mở cho MỌI vai trò có ít nhất một menu con bên trong
         (Odoo yêu cầu pass groups cả tổ tiên): tech/admin quản sản phẩm,
         ba/ceo/sm xem danh mục, kế toán + sm vào Bảng giá (dl_product). -->
    <menuitem
        id="menu_dl_product"
        name="Sản phẩm &amp; Vật tư"
        parent="menu_dl_root"
        sequence="20"
        groups="dl_base.dl_group_tech,dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_accountant"
    />

    <menuitem
        id="menu_dl_technical"
        name="Kỹ thuật"
        parent="menu_dl_root"
        sequence="20"
        groups="dl_base.dl_group_tech,dl_base.dl_group_admin,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager"
    />

    <!-- Chưa có màn báo cáo thực tế: ẩn hẳn để người dùng không mở vào ngõ cụt. -->
    <record id="menu_dl_report" model="ir.ui.menu">
        <field name="name">Báo cáo</field>
        <field name="parent_id" ref="menu_dl_root"/>
        <field name="sequence">40</field>
        <field name="active" eval="False"/>
    </record>

    <menuitem
        id="menu_dl_config"
        name="Cấu hình"
        parent="menu_dl_root"
        sequence="100"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_admin"
    />

</odoo>
