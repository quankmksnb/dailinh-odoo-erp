<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem
        id="menu_dl_root"
        name="DLM-ERP"
        sequence="1"
        web_icon="dl_base,static/description/icon.png"
        action="action_dl_home"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_tech,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager,dl_base.dl_group_purchasing,dl_base.dl_group_warehouse"
    />
    <!-- ⚠️ THÊM VAI TRÒ MỚI thì phải thêm vào ĐÂY nữa, không chỉ ở menu nghiệp
         vụ: Odoo bắt pass groups CẢ TỔ TIÊN. Thiếu ở menu gốc ⇒ user đăng nhập
         vào KHÔNG thấy app DLM-ERP đâu cả, và KHÔNG có lỗi nào nổ — chỉ là màn
         hình trống. (Đã vấp thật với vai trò Thủ kho, 2026-08-11.)
         Có test canh: dl_inventory test_thu_kho_vao_duoc_app_dlm. -->

    <menuitem
        id="menu_dl_sale"
        name="CRM &amp; Báo giá"
        parent="menu_dl_root"
        sequence="10"
    />

    <!-- Menu cha phải mở cho MỌI vai trò có ít nhất một menu con bên trong
         (Odoo yêu cầu pass groups cả tổ tiên): tech/admin quản sản phẩm,
         ba/ceo/sm xem danh mục, kế toán + sm vào Bảng giá, Mua hàng vào
         Bảng giá Vật tư (dl_product). -->
    <menuitem
        id="menu_dl_product"
        name="Sản phẩm &amp; Vật tư"
        parent="menu_dl_root"
        sequence="20"
        groups="dl_base.dl_group_tech,dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_accountant,dl_base.dl_group_purchasing"
    />

    <menuitem
        id="menu_dl_technical"
        name="Kỹ thuật"
        parent="menu_dl_root"
        sequence="20"
        groups="dl_base.dl_group_tech,dl_base.dl_group_admin,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager"
    />

    <!-- Menu CONTAINER của phân hệ Kho (menu con khai ở dl_inventory/views/menus.xml).
         ⚠️ Odoo bắt pass groups CẢ TỔ TIÊN ⇒ phải liệt kê ĐỦ mọi vai trò có ít
         nhất một menu con: Thủ kho (chủ sở hữu), Mua hàng (Trả hàng NCC), Admin,
         Kỹ thuật (xem tồn vật tư khi lập BOM), CEO/Trưởng KD (xem), Kế toán (xem).
         Sales KHÔNG vào nhóm này — họ xem phiếu giao qua smart button trên đơn. -->
    <menuitem
        id="menu_dl_inventory"
        name="Kho"
        parent="menu_dl_root"
        sequence="30"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_purchasing,dl_base.dl_group_admin,dl_base.dl_group_tech,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_accountant"
    />

    <!-- Chưa có màn báo cáo thực tế: ẩn hẳn để người dùng không mở vào ngõ cụt. -->
    <record id="menu_dl_report" model="ir.ui.menu">
        <field name="name">Báo cáo</field>
        <field name="parent_id" ref="menu_dl_root"/>
        <field name="sequence">40</field>
        <field name="active" eval="False"/>
    </record>

    <!-- ⚠️ Đây KHÔNG phải danh sách đầy đủ. dl_config/views/menus.xml nới thêm
         Trưởng KD / Kỹ thuật / Kế toán / BA bằng (4, ref(...)), vì menu con
         "Cấu hình Báo giá" cấp cho 6 vai trò mà Odoo bắt phải pass groups CẢ
         TỔ TIÊN. Đọc riêng file này sẽ tưởng chỉ CEO/Admin vào được Cấu hình —
         DB thật có 6 group và đó là ĐÚNG, đừng "siết" lại. -->
    <menuitem
        id="menu_dl_config"
        name="Cấu hình"
        parent="menu_dl_root"
        sequence="100"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_admin"
    />

</odoo>
