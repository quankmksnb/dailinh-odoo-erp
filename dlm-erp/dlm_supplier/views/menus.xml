<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu NCC full-CRUD: chỉ Admin / CEO / Kế toán (BỎ Trưởng phòng KD).
         Trưởng KD dùng menu chỉ-đọc riêng bên dưới (S04: "Xem danh sách").
         (6,0,[...]) đặt lại toàn bộ groups thay cho danh sách gốc của dl_sale. -->
    <record id="dl_sale.menu_dl_sale_supplier" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_admin'),
            ref('dl_base.dl_group_ceo'),
            ref('dl_base.dl_group_accountant'),
        ])]"/>
    </record>

    <!-- Menu NCC chỉ-đọc cho Trưởng phòng KD (trỏ tới action_dl_supplier_readonly). -->
    <menuitem
        id="menu_dl_sale_supplier_readonly"
        name="NCC / Thầu phụ"
        parent="dl_base.menu_dl_sale"
        sequence="20"
        action="action_dl_supplier_readonly"
        groups="dl_base.dl_group_sales_manager"
    />

</odoo>
