<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Giới hạn menu NCC (dl_partner) chỉ cho Admin / CEO / Kế toán.
         (6,0,[...]) ghi đè toàn bộ groups từ dl_partner.partner_menus.xml. -->
    <record id="dl_partner.menu_dl_sale_supplier" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_admin'),
            ref('dl_base.dl_group_ceo'),
            ref('dl_base.dl_group_accountant'),
        ])]"/>
    </record>
</odoo>
