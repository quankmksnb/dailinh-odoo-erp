<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cảnh báo "NCC không còn hoạt động" ở màn Giá Vật tư (Cap_Nhat_S04 mục 6) -->
    <record id="view_dl_material_price_form_inherit_sup_active" model="ir.ui.view">
        <field name="name">dlm.material.price.form.inherit.sup.active</field>
        <field name="model">dl.material.price</field>
        <field name="inherit_id" ref="dlm_material.view_dl_material_price_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auto_close_preview']/.." position="after">
                <field name="supplier_active" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="supplier_active">
                    NCC này đã Ngừng hoạt động (Inactive).
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_dl_material_price_list_tree_inherit_sup_active" model="ir.ui.view">
        <field name="name">dlm.material.price.list.tree.inherit.sup.active</field>
        <field name="model">dl.material.price</field>
        <field name="inherit_id" ref="dlm_material.view_dl_material_price_list_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-warning">not supplier_active</attribute>
            </xpath>
            <xpath expr="//field[@name='supplier_id']" position="after">
                <field name="supplier_active" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
