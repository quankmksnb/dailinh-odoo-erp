<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Mở rộng form/tree NCC có sẵn của dl_sale (theo Cap_Nhat_S04):
         - supplier_code (đã có từ trước)
         - category_id (Tags, native) = "Nhóm vật tư cung cấp"
         - Người liên hệ = contact con chuẩn Odoo (child_ids), không field mới
         - Tab "Giá vật tư" = material_price_ids (One2many, không field DB mới)
         Không tạo action/menu mới — dùng nguyên action_dl_supplier có sẵn.
    ================================================================ -->

    <record id="view_dl_supplier_form_inherit_sup" model="ir.ui.view">
        <field name="name">dlm.supplier.form.inherit.sup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="dl_sale.view_dl_supplier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <field name="supplier_code" readonly="1" invisible="partner_role != 'supplier'"/>
            </xpath>
            <xpath expr="//field[@name='partner_role']" position="before">
                <group invisible="partner_role != 'supplier'">
                    <field name="category_id" widget="many2many_tags" string="Nhóm vật tư cung cấp"
                           options="{'color_field': 'color'}"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='notes']" position="after">
                <page string="Người liên hệ" name="contacts" invisible="partner_role != 'supplier'">
                    <field name="child_ids" context="{'default_parent_id': id, 'default_type': 'contact'}"
                           domain="[('type', '=', 'contact')]">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="function" string="Chức vụ"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </tree>
                    </field>
                </page>
                <page string="Giá vật tư" name="material_prices" invisible="partner_role != 'supplier'">
                    <field name="material_price_ids" create="0" delete="0">
                        <tree>
                            <field name="material_id"/>
                            <field name="unit_price"/>
                            <field name="uom_id"/>
                            <field name="valid_from"/>
                            <field name="is_active"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_dl_supplier_tree_inherit_sup" model="ir.ui.view">
        <field name="name">dlm.supplier.tree.inherit.sup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="dl_sale.view_dl_supplier_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="supplier_code"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="category_id" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_dl_supplier_search_inherit_sup" model="ir.ui.view">
        <field name="name">dlm.supplier.search.inherit.sup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="dl_sale.view_dl_supplier_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="category_id"/>
            </xpath>
            <xpath expr="//filter[@name='group_city']" position="after">
                <filter string="Nhóm vật tư cung cấp" name="group_category" context="{'group_by': 'category_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
