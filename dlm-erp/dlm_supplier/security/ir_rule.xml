<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_partner_sales_manager_no_supplier" model="ir.rule">
            <field name="name">Trưởng phòng KD: không CRUD NCC thuần (chỉ xem)</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_sales_manager'))]" />
            <field name="domain_force">
                [('partner_role', '!=', 'supplier')]
            </field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Chỉ chặn Khách hàng THUẦN ('customer'). Dùng domain phủ định để
             KHÔNG chặn các partner không-role (res.users kế thừa res.partner:
             partner của user đang đăng nhập có partner_role=NULL — nếu dùng
             ('in', (...)) sẽ loại NULL và gây Forbidden khi Odoo đọc res.users).
             '=' False cộng '!=' 'customer' = mọi record trừ Khách hàng thuần
             (gồm supplier, both, và các partner không-role). -->
        <record id="rule_partner_accountant_supplier_only" model="ir.rule">
            <field name="name">Kế toán: không truy cập Khách hàng thuần</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('dl_base.dl_group_accountant'))]"/>
            <field name="domain_force">
                ['|', ('partner_role', '=', False), ('partner_role', '!=', 'customer')]
            </field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>
    </data>
</odoo>