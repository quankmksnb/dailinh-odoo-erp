<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dl_customer_tree" model="ir.ui.view">
        <field name="name">dlm.customer.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Khách hàng" class="dl-customer-list" js_class="dl_customer_list"
                default_order="dlm_code asc"
                decoration-muted="active == False">
                <field name="avatar_128" widget="image" class="dl-customer-avatar"
                    options="{'preview_image': 'avatar_128'}" nolabel="1" />
                <field name="dlm_has_photo" column_invisible="1" />
                <field name="dlm_code" string="Mã KH" />
                <field name="name" string="Tên khách hàng" />
                <field name="partner_type" string="Loại" widget="badge"
                    decoration-info="partner_type == 'company'"
                    decoration-warning="partner_type == 'dealer'" />
                <field name="dlm_status_label" string="Trạng thái" widget="badge"
                    decoration-success="active"
                    decoration-danger="not active" />
                <field name="phone" string="Điện thoại" />
                <field name="email" widget="email" />
                <field name="city" string="Tỉnh/TP" />
                <field name="category_id" string="Nhãn" widget="many2many_tags"
                    options="{'color_field': 'color'}" optional="show" />
                <field name="active" column_invisible="1" />
            </tree>
        </field>
    </record>

    <record id="view_dl_customer_form" model="ir.ui.view">
        <field name="name">dlm.customer.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Khách hàng" class="dl-customer-form" js_class="dl_customer_form">
                <header>
                    <button name="toggle_active" type="object" string="Vô hiệu hóa KH"
                        class="btn-danger" invisible="not active or not id"
                        confirm="Vô hiệu hóa khách hàng này? Dữ liệu cũ được giữ nguyên; KH sẽ không xuất hiện khi tạo báo giá/RFQ mới."
                        groups="dl_base.dl_group_sales_manager,dl_base.dl_group_admin" />
                    <button name="toggle_active" type="object" string="Kích hoạt lại"
                        class="btn-secondary" invisible="active"
                        groups="dl_base.dl_group_sales_manager,dl_base.dl_group_admin" />
                </header>
                <sheet>
                    <field name="partner_role" invisible="1"/>
                    <field name="active" invisible="1"/>

                    <widget name="web_ribbon" title="Ngừng hợp tác"
                        bg_color="text-bg-danger" invisible="active" />

                    <div class="dl-cust-head">
                        <field name="image_1920" widget="image"
                            class="oe_avatar dl-cust-form-avatar"
                            readonly="not active"
                            options="{'preview_image': 'image_128'}" />
                        <div class="dl-cust-head-main">
                            <label for="name" string="Tên khách hàng" />
                            <h1>
                                <field name="name" string="Tên khách hàng"
                                    placeholder="Tên khách hàng..."
                                    required="1"
                                    readonly="not active" />
                            </h1>
                            <div class="dl-cust-code" invisible="not dlm_code">Mã KH: <field
                                    name="dlm_code" class="oe_inline" />
                            </div>
                            <field name="partner_type" widget="radio"
                                options="{'horizontal': true}" nolabel="1"
                                readonly="not active"
                                class="dl-cust-type-seg" />
                            <field name="category_id" widget="many2many_tags"
                                string="Nhãn"
                                options="{'color_field': 'color', 'no_create_edit': False}"
                                placeholder="VD: Khách quen, VIP..."
                                readonly="not active" />
                        </div>

                    </div>

                    <!-- Cảnh báo MỀM trùng tên khách hàng — không chặn lưu, chỉ
                         nhắc kiểm tra lại (xem _compute_dlm_duplicate_name_warning). -->
                    <div class="alert alert-warning" role="alert"
                        invisible="not dlm_duplicate_name_warning">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <field name="dlm_duplicate_name_warning" class="oe_inline" />
                    </div>

                    <!-- Gộp hồ sơ khi đối tác đã là NCC — chỉ hiện lúc tạo mới.
                         Rút gọn còn 1 dòng (review UX cust #f1); chi tiết đã nằm
                         trong placeholder ô chọn. -->
                    <div class="alert alert-info dl-cust-mergebox" role="status"
                        invisible="id">
                        <div class="fw-bold mb-2">
                            <i class="fa fa-link me-1"/>Đã là Nhà cung cấp? Chọn tên bên dưới để gộp thành một hồ sơ chung — để trống nếu là khách mới.
                        </div>
                        <field name="pending_link_partner_id"
                            nolabel="1"
                            context="{'dl_link_search_role': 'supplier'}"
                            options="{'no_open': True, 'no_create': True}"
                            placeholder="Gõ tên Nhà cung cấp để tìm và gộp..."/>
                    </div>

                    <group>
                        <group string="Thông tin liên hệ">
                            <!-- Cá nhân bắt buộc Di động (không có MST nên số di
                                 động là dữ liệu định danh duy nhất); DN/Đại lý
                                 chỉ cần một trong ba kênh — luật đầy đủ nằm ở
                                 _check_customer_contact_channel. -->
                            <field name="phone" string="Điện thoại" readonly="not active"
                                placeholder="Bắt buộc một trong: Điện thoại / Di động / Email" />
                            <field name="mobile" string="Di động" readonly="not active"
                                required="partner_type == 'individual'"
                                placeholder="Bắt buộc với khách Cá nhân" />
                            <field name="email" widget="email" readonly="not active" />
                            <field name="vat" string="Mã số thuế (MST)"
                                widget="dl_tax_code"
                                readonly="not active"
                                required="partner_type in ['company', 'dealer']"
                                placeholder="Bắt buộc với Doanh nghiệp và Đại lý; Cá nhân có thể để trống" />
                            <field name="dlm_allow_dup_tax" readonly="not active"
                                invisible="not vat" />
                            <field name="dlm_allow_dup_contact" readonly="not active"
                                invisible="not phone and not mobile and not email" />
                            <!-- Cửa thoát trùng phải để lại dấu vết: tích là
                                 phải giải thích (_check_dup_override_reason). -->
                            <field name="dlm_dup_override_reason" readonly="not active"
                                invisible="not dlm_allow_dup_tax and not dlm_allow_dup_contact"
                                placeholder="VD: Chi nhánh Hà Nội, dùng chung MST và tổng đài với trụ sở." />
                        </group>
                        <group string="Địa chỉ">
                            <!-- Địa chỉ in lên PDF báo giá / hợp đồng ⇒ bắt buộc
                                 với khách có tư cách pháp nhân (DN, Đại lý). -->
                            <field name="street" string="Đường" readonly="not active"
                                required="partner_type in ['company', 'dealer']"
                                placeholder="Số nhà, tên đường..." />
                            <field name="city" string="Tỉnh / TP" readonly="not active"
                                required="partner_type in ['company', 'dealer']"
                                placeholder="Tỉnh / Thành phố" />
                            <field name="country_id" string="Quốc gia" readonly="not active"
                                placeholder="Quốc gia" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Người liên hệ" name="contacts">
                            <!-- default_partner_role/type=False: chặn default của action
                                 KH rò xuống người liên hệ (contact con cũng là res.partner).
                                 Nếu để rò, contact bị coi là 'KH Doanh nghiệp' và dính ràng
                                 buộc bắt buộc MST khi lưu. Contact KHÔNG phải KH DLM. -->
                            <field name="child_ids"
                                context="{'default_type': 'contact', 'default_partner_role': False, 'default_partner_type': False}"
                                readonly="not active">
                                <!-- Mỗi dòng bắt buộc Họ tên và ít nhất một kênh
                                     liên lạc; luật đầy đủ ở _check_contact_name /
                                     _check_contact_channel. Thêm cột Di động để
                                     người nhập có đủ ba ô mà ràng buộc đang xét. -->
                                <tree editable="bottom">
                                    <field name="name" string="Họ tên" required="1" />
                                    <field name="function" string="Chức vụ" />
                                    <field name="phone" string="Điện thoại"
                                        placeholder="Bắt buộc một trong: ĐT / Di động / Email" />
                                    <field name="mobile" string="Di động" />
                                    <field name="email" widget="email" />
                                </tree>
                            </field>
                        </page>

                        <page string="Ghi chú nội bộ" name="notes">
                            <field name="comment" readonly="not active"
                                placeholder="Ghi chú, yêu cầu đặc biệt, chính sách giá riêng..." />
                        </page>

                        <page string="Thông tin hệ thống" name="audit">
                            <group>
                                <group string="Khởi tạo">
                                    <field name="create_uid" string="Người tạo" readonly="1" />
                                    <field name="create_date" string="Ngày tạo" readonly="1" />
                                </group>
                                <group string="Cập nhật gần nhất">
                                    <field name="write_uid" string="Người sửa" readonly="1" />
                                    <field name="write_date" string="Ngày sửa" readonly="1" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Log/chatter cho quản lý (CEO, Trưởng KD, Admin) và đội sở
                     hữu khách hàng (BA/Sales). -->
                <div class="oe_chatter"
                     groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_admin,dl_base.dl_group_ba">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_customer_search" model="ir.ui.view">
        <field name="name">dlm.customer.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Tìm khách hàng">
                <field name="name" string="Tên" filter_domain="[('name', 'ilike', self)]" />
                <field name="dlm_code" string="Mã KH" />
                <field name="phone" />
                <field name="email" />
                <field name="vat" string="MST" />
                <field name="category_id" string="Nhãn" />
                <separator />
                <filter string="Cá nhân" name="filter_individual"
                    domain="[('partner_type', '=', 'individual')]" />
                <filter string="Doanh nghiệp" name="filter_company"
                    domain="[('partner_type', '=', 'company')]" />
                <filter string="Đại lý" name="filter_dealer"
                    domain="[('partner_type', '=', 'dealer')]" />
                <separator />
                <filter string="Đang hợp tác" name="active" domain="[('active', '=', True)]" />
                <filter string="Ngừng hợp tác" name="inactive" domain="[('active', '=', False)]" />
                <separator />
                <filter string="Hôm nay" name="date_today"
                    domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]" />
                <filter string="7 ngày qua" name="date_7days"
                    domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(days=-7), datetime.time(0,0,0)))]" />
                <filter string="30 ngày qua" name="date_30days"
                    domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(days=-30), datetime.time(0,0,0)))]" />
                <group expand="0" string="Nhóm theo">
                    <filter string="Loại khách hàng" name="group_type"
                        context="{'group_by': 'partner_type'}" />
                    <filter string="Tỉnh/TP" name="group_city"
                        context="{'group_by': 'city'}" />
                    <filter string="Nhãn" name="group_category"
                        context="{'group_by': 'category_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Sequence mã KH (KH-0001) -->
    <record id="seq_dlm_customer" model="ir.sequence">
        <field name="name">DLM Khách hàng</field>
        <field name="code">dlm.customer</field>
        <field name="prefix">KH-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="action_dl_customer" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="domain">[('partner_role', 'in', ['customer', 'both'])]</field>
        <field name="context">{'default_partner_role': 'customer', 'default_partner_type': 'company', 'active_test': False}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_customer_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_customer_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_customer_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo khách hàng đầu tiên!</p>
            <p>Quản lý toàn bộ danh sách khách hàng của Đại Linh tại đây.</p>
        </field>
    </record>

    <!-- Action form-only cho mũi tên mở KH (get_formview_action). Có id nên URL
         giữ được view khi F5/deep-link. Không gắn menu, chỉ dùng qua điều hướng. -->
    <record id="action_dl_customer_form" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dl_customer_form" />
        <field name="target">current</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- EX-42: ngưỡng gộp đơn auto-approval (VNĐ) — CEO/Admin sửa được ở S02.
         noupdate để không ghi đè khi nâng cấp module. -->
    <data noupdate="1">
        <record id="param_split_order_threshold" model="ir.config_parameter">
            <field name="key">dl_sale.split_order_threshold</field>
            <field name="value">20000000</field>
        </record>
    </data>

</odoo>
