<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": chỉ seed 1 lần; -u dl_config KHÔNG ghi đè giá trị người dùng đã sửa. -->
    <data noupdate="1">

        <!-- Singleton cấu hình báo giá. Engine chỉ đọc HAI tham số này
             (vat_pct + rounding_to — xem quotation_pricing_service._build_context);
             các cấu hình khác (markup, chiết khấu, công đoạn, hao hụt, ma trận…)
             nằm ở các model quy tắc V3 riêng, KHÔNG ở singleton này.
             Không seed cơ cấu %/SLA/hao hụt-theo-nhóm nữa: chúng là dữ liệu chết,
             engine bỏ qua, chỉ gây hiểu lầm khi đọc DB (review §1.1). -->
        <record id="pricing_config_default" model="dl.pricing.config">
            <field name="name">Cấu hình báo giá</field>
            <field name="vat_pct">0</field>
            <field name="rounding_to">1000</field>
        </record>

        <!-- Ma trận phê duyệt báo giá dùng model dl.pricing.approval.matrix
             (seed ở pricing_seed.xml), KHÔNG phải dl.approval.level (đã ngừng dùng). -->

    </data>
</odoo>
