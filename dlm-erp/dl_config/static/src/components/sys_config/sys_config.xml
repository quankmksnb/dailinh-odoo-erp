<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="dl_config.DlSysConfig">
    <div class="dl-cfg o_action">
        <div class="dl-cfg-inner">

            <!-- Header -->
            <div class="dl-cfg-head">
                <div class="dl-cfg-head-main">
                    <h1 class="dl-cfg-title">Cấu hình Hệ thống</h1>
                    <span class="dl-cfg-subtitle">
                        Admin / CEO được sửa · Trưởng KD chỉ xem · Mọi thay đổi được ghi audit (BR-28)
                    </span>
                </div>
            </div>

            <!-- Tab bar -->
            <div class="dl-cfg-tabs">
                <t t-foreach="tabs" t-as="t" t-key="t.key">
                    <button class="dl-cfg-tab" type="button"
                            t-att-class="{ 'is-active': state.tab === t.key }"
                            t-on-click="() => this.setTab(t.key)">
                        <i t-att-class="'fa ' + t.icon"/> <span t-esc="t.label"/>
                    </button>
                </t>
            </div>

            <!-- ================= TAB 1: Tham số báo giá ================= -->
            <t t-if="state.tab === 'cost'">
                <div class="dl-cfg-panel">
                    <div class="dl-cfg-panel-head">
                        <span class="dl-cfg-panel-title">Cơ cấu chi phí (Cost Structure)</span>
                        <button class="dl-cfg-save" type="button" t-on-click="saveCost">
                            <i class="fa fa-check"/> Lưu thay đổi
                        </button>
                    </div>

                    <div class="dl-cfg-grid">
                        <label class="dl-cfg-f"><span class="k">Tỷ lệ chi phí vật tư (%)</span>
                            <input type="number" t-model.number="state.cost.material"/>
                            <span class="hint">Tham khảo 55% — không phải công thức cứng</span></label>
                        <label class="dl-cfg-f"><span class="k">Tỷ lệ chi phí nhân công (%)</span>
                            <input type="number" t-model.number="state.cost.labor"/>
                            <span class="hint">Khoảng 30–35%</span></label>
                        <label class="dl-cfg-f"><span class="k">Tỷ lệ rủi ro / phát sinh (%)</span>
                            <input type="number" t-model.number="state.cost.risk"/>
                            <span class="hint">0–5% (mặc định 3%)</span></label>
                        <label class="dl-cfg-f"><span class="k">Lợi nhuận mục tiêu (%)</span>
                            <input type="number" t-model.number="state.cost.margin"/>
                            <span class="hint">Target margin — mặc định 12%</span></label>
                        <label class="dl-cfg-f"><span class="k">Chi phí vận hành / overhead (%)</span>
                            <input type="number" t-model.number="state.cost.overhead"/>
                            <span class="hint">Cấu hình theo thực tế DN</span></label>
                        <label class="dl-cfg-f"><span class="k">Chiết khấu tối đa cho phép (%)</span>
                            <input type="number" t-model.number="state.cost.maxDiscount"/>
                            <span class="hint">Liên quan ma trận phê duyệt</span></label>
                        <label class="dl-cfg-f"><span class="k">VAT mặc định (%)</span>
                            <input type="number" t-model.number="state.cost.vat"/>
                            <span class="hint">0% — báo giá không gồm thuế (theo xác nhận)</span></label>
                        <label class="dl-cfg-f"><span class="k">Hiệu lực giá vật tư (ngày)</span>
                            <input type="number" t-model.number="state.cost.priceValidity"/>
                            <span class="hint">Quá hạn → cảnh báo khi tính báo giá</span></label>
                        <label class="dl-cfg-f"><span class="k">Làm tròn giá bán</span>
                            <select t-model.number="state.cost.rounding">
                                <t t-foreach="rounding" t-as="r" t-key="r.v">
                                    <option t-att-value="r.v" t-esc="r.label"/>
                                </t>
                            </select>
                            <span class="hint">Áp dụng cho giá bán cuối</span></label>
                    </div>

                    <!-- Hao hụt theo nhóm vật tư -->
                    <div class="dl-cfg-subhead">
                        <span>Tỷ lệ hao hụt mặc định theo nhóm vật tư (%)</span>
                        <button class="dl-cfg-mini" type="button" t-on-click="addWaste"><i class="fa fa-plus"/> Thêm nhóm</button>
                    </div>
                    <table class="dl-cfg-table">
                        <thead><tr><th>Nhóm vật tư</th><th class="num">Hao hụt (%)</th><th class="act"></th></tr></thead>
                        <tbody>
                            <t t-foreach="state.waste" t-as="w" t-key="w_index">
                                <tr>
                                    <td><input type="text" class="cell" t-model="w.group"/></td>
                                    <td class="num"><input type="number" class="cell num" t-model.number="w.pct"/></td>
                                    <td class="act"><button class="dl-cfg-del" type="button" t-on-click="() => this.removeWaste(w_index)"><i class="fa fa-trash-o"/></button></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>

            <!-- ================= TAB 2: Ma trận phê duyệt ================= -->
            <t t-if="state.tab === 'matrix'">
                <div class="dl-cfg-panel">
                    <div class="dl-cfg-panel-head">
                        <span class="dl-cfg-panel-title">Ma trận phê duyệt (Approval Matrix)</span>
                        <div class="dl-cfg-head-btns">
                            <button class="dl-cfg-mini" type="button" t-on-click="addLevel"><i class="fa fa-plus"/> Thêm cấp duyệt</button>
                            <button class="dl-cfg-save" type="button" t-on-click="saveMatrix"><i class="fa fa-check"/> Lưu ma trận</button>
                        </div>
                    </div>

                    <div class="dl-cfg-note info">
                        <i class="fa fa-info-circle"/>
                        Quyền sửa ma trận: hiện áp dụng <b>Admin + CEO</b> (đề xuất mặc định — chờ CEO chốt).
                        Sửa ngưỡng chỉ ảnh hưởng báo giá mới; BG đang Pending giữ cấp cũ.
                    </div>
                    <div t-if="ceoBackupMissing" class="dl-cfg-note warn">
                        <i class="fa fa-exclamation-triangle"/>
                        CEO chưa có Backup Approver — quá SLA sẽ chỉ nhắc, không tự escalate (EX-27).
                    </div>

                    <div class="dl-cfg-matrix-wrap">
                        <table class="dl-cfg-matrix">
                            <thead>
                                <tr>
                                    <th class="ord">Thứ tự</th>
                                    <th class="lname">Tên cấp</th>
                                    <th>Giá trị (triệu)</th>
                                    <th>Chiết khấu (%)</th>
                                    <th>Margin tối thiểu</th>
                                    <th>Người duyệt</th>
                                    <th>Cụ thể</th>
                                    <th>Backup</th>
                                    <th>Kiểu</th>
                                    <th class="num">SLA (h)</th>
                                    <th>Trạng thái</th>
                                    <th class="act"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.levels" t-as="l" t-key="l.id">
                                    <tr t-att-class="{ 'is-off': !l.active, 'is-overlap': hasOverlap(l) }">
                                        <td class="ord">
                                            <div class="dl-cfg-ord">
                                                <button type="button" t-on-click="() => this.moveLevel(l_index, -1)" t-att-disabled="l_index === 0"><i class="fa fa-angle-up"/></button>
                                                <button type="button" t-on-click="() => this.moveLevel(l_index, 1)" t-att-disabled="l_index === state.levels.length - 1"><i class="fa fa-angle-down"/></button>
                                            </div>
                                        </td>
                                        <td class="lname">
                                            <input type="text" class="cell" t-model="l.name"/>
                                            <span t-if="l.priority" class="dl-cfg-flag">Ưu tiên</span>
                                            <span t-if="hasOverlap(l)" class="dl-cfg-flag err" title="Trùng khoảng giá trị với cấp khác">Chồng chéo</span>
                                        </td>
                                        <td>
                                            <div class="dl-cfg-range">
                                                <input type="number" class="cell num" t-model.number="l.vMin"/>
                                                <span>–</span>
                                                <input type="number" class="cell num" t-model.number="l.vMax" placeholder="∞"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="dl-cfg-range">
                                                <input type="number" class="cell num" t-model.number="l.dMin"/>
                                                <span>–</span>
                                                <input type="number" class="cell num" t-model.number="l.dMax"/>
                                            </div>
                                        </td>
                                        <td><input type="number" class="cell num" t-model.number="l.marginMin" placeholder="—"/></td>
                                        <td>
                                            <select class="cell" t-model="l.role">
                                                <t t-foreach="approverRoles" t-as="ar" t-key="ar.key">
                                                    <option t-att-value="ar.key" t-esc="ar.label"/>
                                                </t>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="cell" t-model="l.user">
                                                <t t-foreach="approverUsers" t-as="au" t-key="au.key">
                                                    <option t-att-value="au.key" t-esc="au.label"/>
                                                </t>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="cell" t-model="l.backup">
                                                <t t-foreach="approverUsers" t-as="au" t-key="au.key">
                                                    <option t-att-value="au.key" t-esc="au.key ? au.label : '(Chưa gán)'"/>
                                                </t>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="cell" t-model="l.mode">
                                                <t t-foreach="modes" t-as="m" t-key="m">
                                                    <option t-att-value="m" t-esc="m"/>
                                                </t>
                                            </select>
                                        </td>
                                        <td class="num"><input type="number" class="cell num" t-model.number="l.sla"/></td>
                                        <td>
                                            <button class="dl-cfg-toggle" type="button"
                                                    t-att-class="l.active ? 'on' : 'off'"
                                                    t-on-click="() => this.toggleLevel(l)">
                                                <t t-esc="l.active ? 'Bật' : 'Tắt'"/>
                                            </button>
                                            <span t-if="l.pending" class="dl-cfg-pending" t-att-title="l.pending + ' BG chờ duyệt'">
                                                <i class="fa fa-hourglass-half"/> <t t-esc="l.pending"/>
                                            </span>
                                        </td>
                                        <td class="act">
                                            <button class="dl-cfg-del" type="button" t-on-click="() => this.removeLevel(l)"
                                                    t-att-class="{ 'is-locked': l.pending }">
                                                <i class="fa fa-trash-o"/>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr t-if="l.note" class="dl-cfg-noterow">
                                        <td colspan="12"><i class="fa fa-sticky-note-o"/> <input type="text" class="cell note" t-model="l.note" placeholder="Ghi chú nội bộ…"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <!-- ================= TAB 3: SLA & Escalation ================= -->
            <t t-if="state.tab === 'sla'">
                <div class="dl-cfg-panel">
                    <div class="dl-cfg-panel-head">
                        <span class="dl-cfg-panel-title">SLA &amp; Escalation</span>
                        <button class="dl-cfg-save" type="button" t-on-click="saveSla"><i class="fa fa-check"/> Lưu thay đổi</button>
                    </div>

                    <div class="dl-cfg-grid">
                        <label class="dl-cfg-f"><span class="k">SLA Trưởng KD (giờ làm việc)</span>
                            <input type="number" min="1" t-model.number="state.sla.salesManager"/>
                            <span class="hint">Kể từ khi báo giá được trình lên</span></label>
                        <label class="dl-cfg-f"><span class="k">SLA CEO (giờ làm việc)</span>
                            <input type="number" min="1" t-model.number="state.sla.ceo"/>
                            <span class="hint">Kể từ khi báo giá được trình lên</span></label>
                        <label class="dl-cfg-f"><span class="k">Tần suất nhắc nhở (giờ)</span>
                            <input type="number" min="1" t-model.number="state.sla.reminderEvery"/>
                            <span class="hint">Nhắc sau X giờ chưa xử lý</span></label>
                    </div>

                    <div class="dl-cfg-subhead"><span>Hành động khi quá SLA</span></div>
                    <div class="dl-cfg-checks">
                        <label class="dl-cfg-check"><input type="checkbox" t-model="state.sla.onOverdue.remind"/> <span>Nhắc nhở</span></label>
                        <label class="dl-cfg-check"><input type="checkbox" t-model="state.sla.onOverdue.escalate"/> <span>Tự động Escalate lên cấp trên / Backup</span></label>
                        <label class="dl-cfg-check"><input type="checkbox" t-model="state.sla.onOverdue.log"/> <span>Ghi log</span></label>
                        <label class="dl-cfg-check"><input type="checkbox" t-model="state.sla.onOverdue.kpi"/> <span>Ghi nhận để tính KPI</span></label>
                    </div>

                    <div class="dl-cfg-subhead"><span>Quy định duyệt trễ</span></div>
                    <label class="dl-cfg-check big">
                        <input type="checkbox" t-model="state.sla.requireLateReason"/>
                        <span>Bắt buộc nhập lý do khi approve sau khi đã quá SLA</span>
                    </label>
                </div>
            </t>

            <!-- ================= TAB 4: Parametric ================= -->
            <t t-if="state.tab === 'param'">
                <div class="dl-cfg-panel">
                    <div class="dl-cfg-panel-head">
                        <span class="dl-cfg-panel-title">Tham số công thức Parametric</span>
                        <button class="dl-cfg-save" type="button" t-on-click="saveParam"><i class="fa fa-check"/> Lưu thay đổi</button>
                    </div>

                    <div class="dl-cfg-grid">
                        <label class="dl-cfg-f"><span class="k">Tỉ trọng thép (kg/m³)</span>
                            <input type="number" t-model.number="state.parametric.steelDensity"/>
                            <span class="hint">Mặc định 7850 — cấu hình theo mác thép</span></label>
                    </div>

                    <div class="dl-cfg-subhead">
                        <span>Định mức kg/m thép hộp/ống theo quy cách</span>
                        <button class="dl-cfg-mini" type="button" t-on-click="() => this.addRow('kgm')"><i class="fa fa-plus"/> Thêm dòng</button>
                    </div>
                    <table class="dl-cfg-table">
                        <thead><tr><th>Quy cách</th><th class="num">kg/m</th><th class="act"></th></tr></thead>
                        <tbody>
                            <t t-foreach="state.parametric.kgm" t-as="r" t-key="r_index">
                                <tr>
                                    <td><input type="text" class="cell" t-model="r.spec"/></td>
                                    <td class="num"><input type="number" step="0.01" class="cell num" t-model.number="r.val"/></td>
                                    <td class="act"><button class="dl-cfg-del" type="button" t-on-click="() => this.removeRow('kgm', r_index)"><i class="fa fa-trash-o"/></button></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="dl-cfg-subhead">
                        <span>Định mức phủ sơn (m²/kg)</span>
                        <button class="dl-cfg-mini" type="button" t-on-click="() => this.addRow('paint')"><i class="fa fa-plus"/> Thêm dòng</button>
                    </div>
                    <table class="dl-cfg-table">
                        <thead><tr><th>Loại sơn / số lớp</th><th class="num">m²/kg</th><th class="act"></th></tr></thead>
                        <tbody>
                            <t t-foreach="state.parametric.paint" t-as="r" t-key="r_index">
                                <tr>
                                    <td><input type="text" class="cell" t-model="r.type"/></td>
                                    <td class="num"><input type="number" step="0.1" class="cell num" t-model.number="r.val"/></td>
                                    <td class="act"><button class="dl-cfg-del" type="button" t-on-click="() => this.removeRow('paint', r_index)"><i class="fa fa-trash-o"/></button></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="dl-cfg-subhead">
                        <span>Định mức vật tư phụ cố định</span>
                        <button class="dl-cfg-mini" type="button" t-on-click="() => this.addRow('aux')"><i class="fa fa-plus"/> Thêm dòng</button>
                    </div>
                    <table class="dl-cfg-table">
                        <thead><tr><th>Vật tư phụ</th><th class="num">Số lượng</th><th>Đơn vị</th><th class="act"></th></tr></thead>
                        <tbody>
                            <t t-foreach="state.parametric.aux" t-as="r" t-key="r_index">
                                <tr>
                                    <td><input type="text" class="cell" t-model="r.name"/></td>
                                    <td class="num"><input type="number" class="cell num" t-model.number="r.qty"/></td>
                                    <td><input type="text" class="cell" t-model="r.unit"/></td>
                                    <td class="act"><button class="dl-cfg-del" type="button" t-on-click="() => this.removeRow('aux', r_index)"><i class="fa fa-trash-o"/></button></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>

            <!-- ================= TAB 5: Lịch sử thay đổi ================= -->
            <t t-if="state.tab === 'audit'">
                <div class="dl-cfg-panel">
                    <div class="dl-cfg-panel-head">
                        <span class="dl-cfg-panel-title">Lịch sử thay đổi cấu hình (Audit log)</span>
                    </div>
                    <table class="dl-cfg-table audit">
                        <thead><tr><th>Thời gian</th><th>Nhóm cấu hình</th><th>Tham số</th><th>Thay đổi (cũ → mới)</th></tr></thead>
                        <tbody>
                            <t t-foreach="state.audit" t-as="a" t-key="a_index">
                                <tr>
                                    <td class="mono" t-esc="a.time"/>
                                    <td><span class="dl-cfg-tag" t-esc="a.tab"/></td>
                                    <td t-esc="a.param"/>
                                    <td t-esc="a.detail"/>
                                </tr>
                            </t>
                            <tr t-if="!state.audit.length"><td colspan="4" class="dl-cfg-empty">Chưa có thay đổi nào.</td></tr>
                        </tbody>
                    </table>
                </div>
            </t>

        </div>

        <!-- Dialog -->
        <t t-if="state.dialog">
            <div class="dl-cfg-modal-backdrop" t-on-click="dialogClose">
                <div class="dl-cfg-dialog" t-on-click.stop="">
                    <div class="dl-cfg-dialog-icon" t-att-class="state.dialog.kind">
                        <i t-att-class="'fa ' + (state.dialog.kind === 'block' ? 'fa-ban' : 'fa-exclamation-triangle')"/>
                    </div>
                    <div class="dl-cfg-dialog-title" t-esc="state.dialog.title"/>
                    <div class="dl-cfg-dialog-msg" t-esc="state.dialog.msg"/>
                    <div class="dl-cfg-dialog-foot">
                        <t t-if="state.dialog.kind === 'block'">
                            <button class="dl-cfg-mbtn primary" type="button" t-on-click="dialogClose">Đã hiểu</button>
                        </t>
                        <t t-else="">
                            <button class="dl-cfg-mbtn ghost" type="button" t-on-click="dialogClose">Hủy</button>
                            <button class="dl-cfg-mbtn" type="button"
                                    t-att-class="state.dialog.danger ? 'danger' : 'primary'"
                                    t-on-click="dialogOk" t-esc="state.dialog.okLabel || 'Xác nhận'"/>
                        </t>
                    </div>
                </div>
            </div>
        </t>

        <!-- Toast -->
        <t t-if="state.toast">
            <div class="dl-cfg-toast"><i class="fa fa-check-circle"/> <span t-esc="state.toast"/></div>
        </t>
    </div>
</t>

</templates>
