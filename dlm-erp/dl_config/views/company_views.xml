<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dl_company_tree" model="ir.ui.view">
        <field name="name">dl.company.tree</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <tree string="Công ty" class="dl-company-list" js_class="dl_company_list"
                  create="true">
                <field name="parent_id" column_invisible="1"/>
                <field name="name" string="Tên công ty"/>
                <field name="vat" string="MST"/>
                <field name="currency_id" string="Tiền tệ"/>
                <field name="phone" string="Điện thoại"/>
                <field name="email" string="Email"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_company_form" model="ir.ui.view">
        <field name="name">dl.company.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="Công ty" class="dl-company-form" create="true">
                <sheet>
                    <field name="parent_id" invisible="1"/>
                    <div class="dl-co-head">
                        <field name="logo" widget="image" class="dl-co-logo"
                               options="{'preview_image': 'logo'}"/>
                        <div class="dl-co-head-main">
                            <label for="name" string="Tên công ty"/>
                            <h1><field name="name" placeholder="Tên công ty..."/></h1>
                            <field name="vat" string="Mã số thuế (MST)"
                                   placeholder="Mã số thuế..." class="dl-co-vat"
                                   nolabel="1"/>
                        </div>
                    </div>

                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="phone" string="Điện thoại"/>
                            <field name="mobile" string="Di động"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url" string="Website"/>
                        </group>
                        <group string="Địa chỉ">
                            <field name="street" string="Đường"
                                   placeholder="Số nhà, tên đường..."/>
                            <field name="street2" string="Phường / Xã"
                                   placeholder="Phường / Xã..."/>
                            <field name="city" string="Tỉnh / TP"
                                   placeholder="Tỉnh / Thành phố"/>
                            <field name="state_id" string="Bang / Tỉnh"
                                   placeholder="Bang / Tỉnh"/>
                            <field name="zip" string="Mã bưu chính"/>
                            <field name="country_id" string="Quốc gia"
                                   placeholder="Quốc gia"/>
                        </group>
                    </group>

                    <group>
                        <group string="Kinh doanh">
                            <field name="currency_id" string="Tiền tệ"/>
                            <field name="company_registry" string="Mã doanh nghiệp"/>
                        </group>
                        <group/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dl_company_search" model="ir.ui.view">
        <field name="name">dl.company.search</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <search string="Tìm công ty">
                <field name="name" string="Tên"/>
                <field name="vat" string="MST"/>
                <field name="phone" string="Điện thoại"/>
                <field name="email" string="Email"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_currency" string="Tiền tệ"
                            context="{'group_by': 'currency_id'}"/>
                    <filter name="group_country" string="Quốc gia"
                            context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_company" model="ir.actions.act_window">
        <field name="name">Công ty</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_company_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_company_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_company_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có công ty nào phù hợp.</p>
            <p>Thông tin công ty phát hành báo giá, hoá đơn.</p>
        </field>
    </record>

</odoo>
