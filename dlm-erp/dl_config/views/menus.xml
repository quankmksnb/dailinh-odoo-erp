<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mở menu cha cho MỌI vai trò có ít nhất một menu con bên trong (Odoo
         yêu cầu pass groups cả tổ tiên): Trưởng KD/KTV/Kế toán/BA được cấp
         menu "Cấu hình Báo giá" bên dưới nên phải thấy được menu cha; các menu
         con khác vẫn giữ groups riêng (Quản lý User/Phân quyền chỉ Admin...). -->
    <record id="dl_base.menu_dl_config" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (4, ref('dl_base.dl_group_sales_manager')),
            (4, ref('dl_base.dl_group_tech')),
            (4, ref('dl_base.dl_group_ba')),
        ]"/>
    </record>

    <menuitem
        id="menu_dl_config_user_admin"
        name="Quản lý người dùng"
        parent="dl_base.menu_dl_config"
        sequence="5"
        action="action_dl_user_admin"
        groups="dl_base.dl_group_admin"
    />

    <menuitem
        id="menu_dl_config_role_perm"
        name="Phân quyền"
        parent="dl_base.menu_dl_config"
        sequence="6"
        action="action_dl_role_perm"
        groups="dl_base.dl_group_admin"
    />

    <!-- Cấu hình Báo giá — một màn OWL nhiều tab (V3 §3.1 cho phép thanh tab). -->
    <menuitem
        id="menu_dl_config_pricing"
        name="Cấu hình Báo giá"
        parent="dl_base.menu_dl_config"
        sequence="7"
        action="action_dl_pricing_config"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager,dl_base.dl_group_tech,dl_base.dl_group_ba"
    />

    <menuitem
        id="menu_dl_config_uom"
        name="Đơn vị tính"
        parent="dl_base.menu_dl_config"
        sequence="20"
        action="action_dl_uom"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_admin"
    />

</odoo>
