<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dl_role_tree" model="ir.ui.view">
        <field name="name">dl.role.tree</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <tree string="Vai trò" class="dl-role-list" js_class="dl_role_list"
                  create="false" edit="true" delete="false">
                <field name="name" string="Vai trò"/>
                <field name="comment" string="Mô tả"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_role_form" model="ir.ui.view">
        <field name="name">dl.role.form</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <form string="Vai trò" class="dl-role-form" create="false" duplicate="false">
                <sheet>
                    <div class="oe_title dl-role-title">
                        <label for="name" string="Vai trò"/>
                        <!-- Tên vai trò cố định (6 vai trò mặc định) — khoá sửa để
                             không phá bộ lọc theo tên của action. -->
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <field name="comment" string="Mô tả"
                               placeholder="Mô tả trách nhiệm của vai trò..."/>
                    </group>

                    <notebook>
                        <page string="Người dùng" name="users">
                            <field name="users" nolabel="1">
                                <tree string="Người dùng" create="false" delete="true">
                                    <field name="name" string="Họ tên"/>
                                    <field name="login" string="Đăng nhập"/>
                                    <field name="email" string="Email"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Phân quyền theo module" name="access">
                            <field name="model_access" nolabel="1">
                                <tree string="Phân quyền theo module" editable="bottom">
                                    <field name="name" string="Tên quy tắc"/>
                                    <field name="model_id" string="Module / Model"/>
                                    <field name="perm_read" string="Xem"
                                           widget="boolean_toggle"/>
                                    <field name="perm_write" string="Sửa"
                                           widget="boolean_toggle"/>
                                    <field name="perm_create" string="Thêm"
                                           widget="boolean_toggle"/>
                                    <field name="perm_unlink" string="Xoá"
                                           widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Kế thừa &amp; Quy tắc" name="rules">
                            <group>
                                <field name="implied_ids" widget="many2many_tags"
                                       readonly="1" string="Kế thừa nhóm"/>
                            </group>
                            <separator string="Quy tắc bản ghi (ir.rule)"/>
                            <field name="rule_groups" nolabel="1" readonly="1">
                                <tree string="Quy tắc bản ghi">
                                    <field name="name" string="Tên"/>
                                    <field name="model_id" string="Model"/>
                                    <field name="domain_force" string="Miền áp dụng"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dl_role_search" model="ir.ui.view">
        <field name="name">dl.role.search</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <search string="Tìm vai trò">
                <field name="name" string="Vai trò"/>
                <field name="comment" string="Mô tả"/>
            </search>
        </field>
    </record>

    <record id="action_dl_role" model="ir.actions.act_window">
        <field name="name">Phân quyền</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">tree,form</field>
        <!-- Lọc đúng 6 vai trò DLM theo tên (domain act_window không ref() được
             xml_id; 6 group đều thuộc category Hidden nên lọc theo tên). -->
        <field name="domain">[('name', 'in', ['CEO', 'Admin/IT', 'BA/Sales', 'Trưởng phòng Kinh doanh', 'Kỹ thuật', 'Kế toán nội bộ'])]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_role_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_role_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_role_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có vai trò nào phù hợp.</p>
            <p>Quản lý vai trò, gán người dùng và phân quyền theo module.</p>
        </field>
    </record>

</odoo>
