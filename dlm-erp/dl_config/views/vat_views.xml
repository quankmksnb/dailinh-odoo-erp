<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dl_vat_tree" model="ir.ui.view">
        <field name="name">dl.vat.tree</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <tree string="Thuế VAT" class="dl-vat-list" js_class="dl_vat_list"
                  create="true" decoration-muted="active == False">
                <field name="name" string="Tên thuế"/>
                <field name="type_tax_use" string="Loại"/>
                <field name="amount" string="Giá trị" digits="[16, 4]"/>
                <field name="amount_type" string="Cách tính"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_vat_form" model="ir.ui.view">
        <field name="name">dl.vat.form</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <form string="Thuế VAT" class="dl-vat-form" js_class="dl_vat_form">
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Tên thuế"/>
                        <h1><field name="name" placeholder="VD: Thuế GTGT 10%"/></h1>
                    </div>

                    <group>
                        <group string="Cấu hình thuế">
                            <field name="type_tax_use" string="Loại thuế"
                                   widget="radio" options="{'horizontal': true}"
                                   class="dl-seg"/>
                            <field name="amount_type" string="Cách tính"/>
                            <field name="amount" string="Giá trị" digits="[16, 4]"/>
                            <field name="price_include" string="Đã gồm trong giá"/>
                        </group>
                        <group string="Áp dụng &amp; Kế toán">
                            <field name="country_id" string="Quốc gia áp dụng"/>
                            <field name="tax_group_id" string="Nhóm thuế"/>
                            <field name="description" string="Mô tả"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dl_vat_search" model="ir.ui.view">
        <field name="name">dl.vat.search</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <search string="Tìm thuế">
                <field name="name" string="Tên"/>
                <separator/>
                <filter name="filter_sale" string="Bán"
                        domain="[('type_tax_use', '=', 'sale')]"/>
                <filter name="filter_purchase" string="Mua"
                        domain="[('type_tax_use', '=', 'purchase')]"/>
                <separator/>
                <filter name="filter_active" string="Đang dùng"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Đã ẩn"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_type_use" string="Loại thuế"
                            context="{'group_by': 'type_tax_use'}"/>
                    <filter name="group_amount_type" string="Cách tính"
                            context="{'group_by': 'amount_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_vat" model="ir.actions.act_window">
        <field name="name">Thuế VAT</field>
        <field name="res_model">account.tax</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_type_tax_use': 'sale'}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_vat_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_vat_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_vat_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có sắc thuế nào phù hợp.</p>
            <p>Quản lý thuế suất (VAT) áp dụng khi lập báo giá, hoá đơn.</p>
        </field>
    </record>

</odoo>
