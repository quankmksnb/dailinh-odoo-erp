<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- KTV trả RFQ về Sales bổ sung — chọn dòng + nhập lý do -->
    <record id="view_dl_rfq_return_wizard_form" model="ir.ui.view">
        <field name="name">dl.rfq.return.wizard.form</field>
        <field name="model">dl.rfq.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Trả lại RFQ để bổ sung">
                <field name="request_id" invisible="1"/>
                <group>
                    <p colspan="2" class="text-muted">
                        Chọn dòng cần Sales bổ sung thông tin. Dòng đã đánh dấu
                        <em>Chờ bổ sung</em> từ màn xử lý được tick sẵn.
                    </p>
                </group>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="rfq_line_id" column_invisible="1"/>
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="product_name" readonly="1"/>
                        <field name="technical_status" widget="badge"
                               decoration-muted="technical_status in ('pending', 'not_required')"
                               decoration-warning="technical_status in ('processing', 'waiting')"
                               decoration-success="technical_status == 'done'"
                               decoration-danger="technical_status == 'infeasible'"
                               readonly="1"/>
                        <field name="note" placeholder="Thông tin cần bổ sung..."/>
                    </tree>
                </field>
                <separator string="Ghi chú chung"/>
                <field name="reason" nolabel="1" class="dl-textarea-lg"
                       placeholder="Ghi chú bổ sung chung cho toàn bộ RFQ (tùy chọn)..."/>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Gửi lại Sales" class="oe_highlight"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
