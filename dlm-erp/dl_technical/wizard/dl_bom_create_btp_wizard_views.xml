<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- §13.1 — Wizard "Thêm bán thành phẩm vào định mức" -->
    <record id="view_dl_bom_create_btp_wizard_form" model="ir.ui.view">
        <field name="name">dl.bom.create.btp.wizard.form</field>
        <field name="model">dl.bom.create.btp.wizard</field>
        <field name="arch" type="xml">
            <form string="Thêm bán thành phẩm">
                <field name="parent_is_provisional" invisible="1"/>
                <field name="name_dup_state" invisible="1"/>
                <field name="name_dup_exact_id" invisible="1"/>

                <group>
                    <field name="bom_id" invisible="1"/>
                    <field name="name" placeholder="VD: Khung hàn 1200x800"/>
                    <!-- Cảnh báo mềm trùng/gần giống ngay khi gõ (inline, không modal). -->
                    <div class="alert alert-warning mb-0" role="alert" colspan="2"
                         invisible="name_dup_state == 'none'">
                        <field name="name_dup_message" nolabel="1" readonly="1"/>
                    </div>
                    <field name="confirm_similar_name"
                           invisible="name_dup_state != 'similar'"/>

                    <field name="category_id"
                           options="{'no_quick_create': True}"/>
                    <field name="quantity"/>

                    <!-- M9 — chặn phản xạ đẻ một BTP cho mỗi khổ. -->
                    <field name="will_be_stocked"/>
                    <div class="alert alert-warning mb-0" role="alert" colspan="2"
                         invisible="will_be_stocked">
                        <i class="fa fa-exclamation-triangle me-1" title="Cân nhắc"/>
                        <b>Đây có phải chỉ là cắt vật tư theo khổ của đơn này không?</b>
                        Nếu đúng thì <b>đừng tạo bán thành phẩm</b> — hãy thêm một
                        <b>dòng định mức</b> với vật tư gốc và nhập kích thước, hệ thống
                        tự tính khối lượng. Bán thành phẩm có định mức riêng, tạo theo
                        từng khổ sẽ nhân đôi dữ liệu rất nhanh.
                        <div class="mt-1">
                            Chỉ tạo bán thành phẩm khi nó <b>tự nằm trong kho</b> và
                            <b>dùng lại cho đơn khác</b> (VD: chân bàn tiêu chuẩn mạ kẽm
                            làm hàng loạt).
                        </div>
                    </div>

                    <field name="init_mode" widget="radio"/>
                    <field name="copy_from_bom_id"
                           invisible="init_mode != 'copy'"
                           required="init_mode == 'copy'"
                           options="{'no_create': True}"/>
                </group>

                <div class="alert alert-info" role="status">
                    Bán thành phẩm sẽ ở trạng thái <strong>Nháp</strong>; chính thức hóa
                    khi bạn <strong>Hoàn tất dòng RFQ</strong> (hoặc duyệt tay). Bước
                    tiếp theo: nhập vật tư cho định mức của bán thành phẩm.
                    <span invisible="not parent_is_provisional">
                        <br/>Định mức cha đang là bản tạm RFQ — bán thành phẩm này kế
                        thừa trạng thái tạm và sẽ được dọn nếu RFQ bỏ dở.
                    </span>
                </div>

                <footer>
                    <button name="action_create" type="object"
                            string="Tạo &amp; mở định mức BTP" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
