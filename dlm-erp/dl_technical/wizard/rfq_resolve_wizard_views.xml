<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Workspace xử lý một dòng RFQ — MỘT màn, ba khối tự thu gọn + decision
         dock (thiết kế §5 / §9.4). Bỏ 3 bước tuần tự cũ: các khối tự mở/thu gọn
         theo dữ liệu, nút Hoàn tất luôn hiện ở dock (disable + nêu thiếu gì khi
         chưa đủ, KHÔNG raise modal). -->
    <record id="view_dl_rfq_resolve_wizard_form" model="ir.ui.view">
        <field name="name">dl.rfq.resolve.wizard.form</field>
        <field name="model">dl.rfq.resolve.wizard</field>
        <field name="arch" type="xml">
            <form string="Xử lý RFQ" class="dl-rfq-resolve" create="0" delete="0">
                <header>
                    <button name="action_cancel" type="object"
                            string="Quay lại RFQ" icon="fa-arrow-left"
                            class="btn-secondary"/>
                    <!-- Trục tiến độ display-only (suy từ dữ liệu, không bấm). -->
                    <field name="step" widget="dl_stepper"
                           statusbar_visible="product,bom,confirm"/>
                </header>

                <sheet>
                    <!-- Trạng thái điều khiển / điều kiện (chỉ dùng cho invisible). -->
                    <field name="rfq_line_id" invisible="1"/>
                    <field name="show_bom_picker" invisible="1"/>
                    <field name="is_infeasible" invisible="1"/>
                    <field name="has_existing_supplement" invisible="1"/>
                    <field name="product_is_rfq_provisional" invisible="1"/>
                    <field name="selected_bom_is_rfq_provisional" invisible="1"/>
                    <field name="selected_bom_has_lines" invisible="1"/>
                    <field name="selected_bom_confirmed" invisible="1"/>
                    <field name="can_confirm" invisible="1"/>
                    <field name="check_product" invisible="1"/>
                    <field name="check_bom_selected" invisible="1"/>
                    <field name="check_bom_belongs" invisible="1"/>
                    <field name="check_bom_has_lines" invisible="1"/>
                    <field name="check_bom_confirmed" invisible="1"/>
                    <field name="check_request_unchanged" invisible="1"/>
                    <field name="allowed_product_ids" invisible="1"/>
                    <field name="next_line_id" invisible="1"/>
                    <field name="search_outside_category" invisible="1"/>
                    <field name="has_any_bom" invisible="1"/>
                    <field name="selected_bom_can_discard" invisible="1"/>
                    <field name="pricing_block_count" invisible="1"/>
                    <field name="pricing_block_names" invisible="1"/>
                    <field name="suggestion_state" invisible="1"/>
                    <field name="suggestion_count" invisible="1"/>
                    <field name="auto_selected" invisible="1"/>
                    <field name="has_parametric_template" invisible="1"/>
                    <field name="show_param_panel" invisible="1"/>
                    <field name="param_reused_bom" invisible="1"/>

                    <!-- Banner dữ liệu tạm / chờ bổ sung (toàn bề ngang). -->
                    <div class="alert alert-warning" role="status"
                         invisible="not product_is_rfq_provisional and not selected_bom_is_rfq_provisional">
                        <i class="fa fa-clock-o me-1" title="Dữ liệu tạm từ RFQ"/>
                        <strong>Dữ liệu đang được giữ tạm cho dòng RFQ này.</strong>
                        Sản phẩm/định mức chỉ trở thành dữ liệu chính thức sau khi bấm
                        <em>Hoàn tất dòng</em>. Bạn có thể quay lại RFQ và mở lại để làm tiếp.
                    </div>
                    <div class="alert alert-warning" role="status"
                         invisible="not has_existing_supplement">
                        <i class="fa fa-clock-o me-1" title="Chờ bổ sung"/>
                        <strong>Dòng này đang chờ Sales bổ sung.</strong>
                        Nếu bạn tiếp tục xử lý và bấm <em>Hoàn tất dòng</em>,
                        yêu cầu bổ sung sẽ được gỡ tự động.
                        <button name="action_show_supplement" type="object"
                                string="Sửa nội dung bổ sung"
                                class="btn-link btn-sm p-0 ms-1 align-baseline"/>
                    </div>

                    <!-- Mở lại dòng đã kết luận Không khả thi → banner lý do +
                         2 lối: sửa lý do (modal) hoặc xử lý lại dòng. -->
                    <div class="alert alert-danger" role="status"
                         invisible="not is_infeasible">
                        <i class="fa fa-ban me-1" title="Không khả thi"/>
                        <strong>Dòng này đã kết luận Không khả thi.</strong>
                        <span invisible="not infeasible_reason">
                            Lý do: <field name="infeasible_reason" readonly="1"
                                   nolabel="1" class="dl-rfq-inline-field"/>.
                        </span>
                        <div class="mt-2">
                            <button name="action_show_infeasible" type="object"
                                    string="Sửa lý do" class="btn-secondary btn-sm"/>
                            <button name="action_reopen_feasible" type="object"
                                    string="Xử lý lại dòng này" class="btn-primary btn-sm ms-1"/>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="request_product_name" string="Dòng RFQ đang xử lý"/>
                        <h1>
                            <field name="request_product_name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ══ Bố cục 2 cột: yêu cầu Sales (dính) · quyết định KT ══ -->
                    <div class="dl-rfq-layout">

                        <!-- CỘT TRÁI — yêu cầu Sales, dính khi cuộn. -->
                        <div class="dl-rfq-aside" role="region"
                             aria-label="Thông tin yêu cầu từ Sales">
                            <div class="dl-rfq-section-title">
                                <i class="fa fa-file-text-o me-1"/>Yêu cầu từ Sales
                            </div>
                            <field name="request_has_params" invisible="1"/>
                            <field name="request_params_out_of_range" invisible="1"/>
                            <group>
                                <field name="request_category_id" readonly="1"/>
                                <label for="request_quantity"/>
                                <div class="o_row">
                                    <field name="request_quantity" readonly="1" widget="dl_qty"/>
                                    <field name="request_uom_id" readonly="1" nolabel="1"/>
                                </div>
                                <field name="request_reference_product_id" readonly="1"/>
                                <field name="request_dimension_note" readonly="1"/>
                            </group>
                            <!-- Thông số Sales đã điền theo mẫu của nhóm. Panel tham
                                 số ở cột phải được mồi sẵn từ chính bộ này, nên KTV
                                 đối chiếu được thay vì phải gõ lại từ cột trái. -->
                            <div invisible="not request_has_params">
                                <div class="dl-rfq-section-title mt-2">
                                    <i class="fa fa-sliders me-1"/>Thông số Sales nhập
                                </div>
                                <field name="request_param_ids" readonly="1" nolabel="1">
                                    <tree create="false" delete="false" edit="false"
                                          string="Thông số Sales nhập">
                                        <field name="name" string="Thông số"/>
                                        <field name="value" string="Giá trị" widget="dl_qty"/>
                                        <field name="unit_hint" string="Đơn vị"/>
                                    </tree>
                                </field>
                                <div class="alert alert-warning mt-1 mb-0 py-1 px-2 small"
                                     role="alert"
                                     invisible="not request_params_out_of_range">
                                    <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/>
                                    Có thông số ngoài miền thường làm — xem kỹ trước
                                    khi dùng lại định mức cũ.
                                </div>
                            </div>
                            <div class="dl-rfq-attachments"
                                 invisible="not request_attachment_ids">
                                <div class="dl-rfq-section-title mt-2">
                                    <i class="fa fa-picture-o me-1"/>Ảnh / Tệp Sales gửi
                                </div>
                                <field name="request_attachment_ids"
                                       widget="many2many_binary"
                                       readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <!-- CỘT PHẢI — 3 khối quyết định kỹ thuật. -->
                        <div class="dl-rfq-main">

                            <!-- ⑴ SẢN PHẨM ─────────────────────────────────── -->
                            <!-- Thu gọn khi đã chọn sản phẩm. -->
                            <div class="dl-rfq-block dl-rfq-block--done"
                                 invisible="not product_id">
                                <div class="dl-rfq-block-summary">
                                    <span class="dl-rfq-check"><i class="fa fa-check-circle text-success"/></span>
                                    <span class="dl-rfq-block-no">⑴</span>
                                    <span class="fw-bold">Sản phẩm:</span>
                                    <field name="product_id" readonly="1" nolabel="1"
                                           class="dl-rfq-inline-field"/>
                                    <span class="badge text-bg-warning ms-1"
                                          invisible="not product_is_rfq_provisional">tạm</span>
                                    <!-- Mỗi đường tự quyết một nhãn RIÊNG, cố ý không gộp:
                                         mức chắc chắn của chúng khác hẳn nhau nên KTV cần
                                         biết mình đang gật cái gì. Nhãn nào cũng có CHỮ +
                                         icon + title, không dựa vào màu làm tín hiệu duy
                                         nhất. -->
                                    <field name="product_origin" invisible="1"/>
                                    <span class="badge text-bg-success ms-1"
                                          invisible="product_origin != 'exact_config'"
                                          title="Trùng chữ ký tham số với một định mức đã chốt — cùng mẫu, cùng bộ số">
                                        <i class="fa fa-check me-1" aria-hidden="true"/>khớp chính xác cấu hình</span>
                                    <span class="badge text-bg-info ms-1"
                                          invisible="product_origin != 'sales_pick'"
                                          title="Sales đã chỉ đích danh Kiểu hàng này trên yêu cầu báo giá">
                                        <i class="fa fa-hand-o-right me-1" aria-hidden="true"/>Sales chọn kiểu hàng</span>
                                    <span class="badge text-bg-info ms-1"
                                          invisible="product_origin != 'name_match'"
                                          title="Đã có sản phẩm trùng hệt tên Sales gõ — dùng lại thay vì tạo trùng">
                                        <i class="fa fa-link me-1" aria-hidden="true"/>trùng tên đã có</span>
                                    <!-- §3.6 — nhắc KTV đây là SP máy ĐOÁN (đường A). -->
                                    <span class="badge text-bg-warning ms-1"
                                          invisible="product_origin != 'suggested'"
                                          title="Hệ thống đoán theo tên / nhóm / khách từng đặt — kiểm tra lại giúp">
                                        <i class="fa fa-lightbulb-o me-1" aria-hidden="true"/>máy đoán, kiểm lại</span>
                                    <span class="badge text-bg-secondary ms-1"
                                          invisible="product_origin != 'created'"
                                          title="Chưa từng gia công — hệ thống tạo sản phẩm theo đúng tên và nhóm Sales khai">
                                        <i class="fa fa-plus me-1" aria-hidden="true"/>tạo từ yêu cầu Sales</span>
                                    <button name="action_change_product" type="object"
                                            string="Đổi sản phẩm" class="btn-link btn-sm ms-auto"/>
                                </div>

                                <!-- 🔴 Lá chắn TÊN GẦN GIỐNG sống ở đây.
                                     Hệ thống vừa tạo một sản phẩm mới, nhưng bộ dò
                                     khớp thấy có món cũ na ná. Luật cũ chặn cứng và
                                     bắt KTV tick xác nhận; luật mới không chặn nữa
                                     nên PHẢI nhắc ở đúng chỗ này, không thì âm thầm
                                     đẻ sản phẩm trùng nghĩa. -->
                                <div class="alert alert-warning mt-2 mb-0 py-2" role="status"
                                     invisible="product_origin != 'created' or suggestion_state == 'none'">
                                    <div class="d-flex align-items-center flex-wrap">
                                        <span>
                                            <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/>
                                            Đã có món tương tự:
                                        </span>
                                        <field name="suggested_product_id" readonly="1" nolabel="1"
                                               class="dl-rfq-inline-field ms-1 fw-bold"/>
                                        <span class="text-muted ms-2">·
                                            <field name="suggestion_reason" readonly="1" nolabel="1"
                                                   class="dl-rfq-inline-field"/></span>
                                        <button name="action_use_suggested_product" type="object"
                                                string="Dùng món cũ thay vì tạo mới"
                                                class="btn-secondary btn-sm ms-auto"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Mở khi chưa chọn sản phẩm.

                                 Từ đợt 2026-08-19 đây KHÔNG còn là bước mở màn:
                                 hệ thống đã tự quyết sản phẩm trước khi màn hình
                                 hiện ra (xem default_get), nên khối này chỉ bung
                                 ra khi KTV bấm "Đổi sản phẩm" — tức đường LẬT
                                 LẠI thủ công — hoặc khi dòng cũ chưa có nhóm SP
                                 nên không suy được. -->
                            <div class="dl-rfq-block dl-rfq-block--active"
                                 invisible="product_id">
                                <h2 class="dl-rfq-block-title">
                                    <span class="dl-rfq-block-no">⑴</span> Chọn lại sản phẩm
                                </h2>
                                <p class="text-muted mb-2">
                                    Hệ thống chọn chưa đúng? Chọn sản phẩm khác đã từng gia
                                    công, hoặc tạo sản phẩm mới ở đây.
                                </p>

                                <!-- §3.6 — thẻ "Có phải cái này?": bộ dò khớp gợi ý SP đã
                                     từng gia công (khớp SP tham khảo Sales chọn / tên / nhóm
                                     / khách từng đặt) để KTV khỏi tự gõ tìm và khỏi tạo SP
                                     trùng. Hiện khi có gợi ý mà chưa đạt ngưỡng tự chọn. -->
                                <div class="alert alert-info" role="status"
                                     invisible="suggestion_state == 'none'">
                                    <div class="fw-bold mb-1">
                                        <i class="fa fa-lightbulb-o me-1"/>Có phải sản phẩm này?
                                    </div>
                                    <div class="d-flex align-items-center flex-wrap">
                                        <field name="suggested_product_id" readonly="1" nolabel="1"
                                               class="dl-rfq-inline-field"/>
                                        <span class="text-muted ms-2">·
                                            <field name="suggestion_reason" readonly="1" nolabel="1"
                                                   class="dl-rfq-inline-field"/></span>
                                        <button name="action_use_suggested_product" type="object"
                                                string="Dùng sản phẩm này"
                                                class="btn-primary btn-sm ms-auto"/>
                                    </div>
                                    <field name="suggestion_ids" readonly="1" nolabel="1"
                                           class="mt-2" invisible="suggestion_count &lt; 2">
                                        <tree string="Ứng viên khác">
                                            <field name="display_name" string="Sản phẩm"/>
                                            <field name="categ_id" string="Nhóm"/>
                                        </tree>
                                    </field>
                                    <div class="text-muted small mt-1">
                                        Không đúng? Bỏ qua và chọn/tạo sản phẩm bên dưới.
                                    </div>
                                </div>

                                <group string="Sản phẩm đã từng gia công">
                                    <field name="product_id" placeholder="Tìm theo tên sản phẩm..."
                                           nolabel="1"
                                           domain="[('id', 'in', allowed_product_ids)]"
                                           options="{'no_create': True}"
                                           context="{'default_product_kind': 'manufactured', 'default_dlm_lifecycle_state': 'draft', 'default_categ_id': request_category_id, 'default_name': request_product_name}"/>
                                    <!-- EX-05 / D-F: lọc nhóm MỀM — Sales có thể khai nhầm nhóm. -->
                                    <div colspan="2" class="text-muted small mt-1"
                                         invisible="search_outside_category">
                                        Không thấy sản phẩm đúng? Có thể Sales khai nhầm nhóm.
                                        <button name="action_search_outside_category" type="object"
                                                string="Tìm ngoài nhóm này"
                                                class="btn-link btn-sm p-0 align-baseline"/>
                                    </div>
                                    <div colspan="2" class="alert alert-info py-1 px-2 mt-1" role="status"
                                         invisible="not search_outside_category">
                                        <i class="fa fa-search me-1"/>Đang tìm ở <b>mọi nhóm sản phẩm</b>.
                                        Chọn sản phẩm khác nhóm sẽ được ghi nhận để Sales sửa lại nhóm.
                                        <button name="action_search_outside_category" type="object"
                                                string="Quay lại lọc trong nhóm"
                                                class="btn-link btn-sm p-0 align-baseline"/>
                                    </div>
                                </group>

                                <!-- Không còn nút "Tạo sản phẩm mới" ở đây.
                                     Khai sinh danh mục là việc hành chính: hệ thống
                                     dựng ngầm sản phẩm theo TÊN và NHÓM Sales khai
                                     (xem _dlm_autoresolve_product). Việc của Kỹ thuật
                                     ở khối này chỉ là NHẬN DIỆN — trỏ vào món đã từng
                                     gia công nếu máy chọn chưa đúng. -->
                                <div class="alert alert-info py-2 mt-2" role="status">
                                    <i class="fa fa-info-circle me-1" aria-hidden="true"/>
                                    Đây thật sự là món <b>chưa từng gia công</b>?
                                    <button name="action_restore_auto_product" type="object"
                                            string="Quay lại sản phẩm hệ thống dựng sẵn"
                                            class="btn-link btn-sm p-0 align-baseline"/>
                                    · Yêu cầu của Sales chưa đủ rõ để nhận diện?
                                    Bấm <b>Cần bổ sung</b> ở thanh dưới.
                                </div>
                            </div>

                            <!-- ⑵ ĐỊNH MỨC VẬT TƯ ──────────────────────────── -->
                            <!-- Chưa tới lượt: xám mờ khi chưa có sản phẩm. -->
                            <div class="dl-rfq-block dl-rfq-block--pending"
                                 invisible="product_id">
                                <div class="dl-rfq-block-summary text-muted">
                                    <span class="dl-rfq-block-no">⑵</span>
                                    <span>Định mức vật tư — chọn sản phẩm trước.</span>
                                </div>
                            </div>

                            <!-- Đã có định mức + không mở picker → thu gọn tóm tắt. -->
                            <div class="dl-rfq-block dl-rfq-block--done"
                                 invisible="not product_id or not selected_bom_id or show_bom_picker">
                                <div class="dl-rfq-block-summary">
                                    <span class="dl-rfq-check"><i class="fa fa-check-circle text-success"/></span>
                                    <span class="dl-rfq-block-no">⑵</span>
                                    <span class="fw-bold">Định mức:</span>
                                    <field name="selected_bom_label" readonly="1" nolabel="1"
                                           class="dl-rfq-inline-field"/>
                                    <span class="text-muted ms-1">·
                                        <field name="selected_bom_line_count" readonly="1" nolabel="1"
                                               class="dl-rfq-inline-field"/> dòng vật tư</span>
                                </div>
                                <div class="dl-rfq-block-actions">
                                    <button name="action_edit_selected_bom" type="object"
                                            string="Sửa cho đơn này" class="btn-secondary btn-sm"/>
                                    <button name="action_toggle_bom_picker" type="object"
                                            string="Chọn bản khác" class="btn-secondary btn-sm"/>
                                    <button name="action_confirm_bom" type="object"
                                            string="Xác nhận định mức" class="btn-secondary btn-sm"
                                            invisible="selected_bom_confirmed"/>
                                    <button name="action_discard_draft_bom" type="object"
                                            string="Bỏ bản nháp này" class="btn-link btn-sm text-danger"
                                            confirm="Bỏ bản định mức nháp này? Không thể hoàn tác."
                                            invisible="not selected_bom_can_discard"/>
                                </div>
                                <!-- EX-13 / RES-022: cảnh báo vật tư thiếu giá NCC (chỉ TÊN,
                                     không lộ giá). Không chặn Hoàn tất — chỉ báo trước. -->
                                <div class="alert alert-warning py-2 mt-2" role="status"
                                     invisible="pricing_block_count == 0">
                                    <i class="fa fa-money me-1" title="Thiếu giá nhà cung cấp"/>
                                    <strong><field name="pricing_block_count" readonly="1" nolabel="1"
                                            class="dl-rfq-inline-field"/> vật tư chưa có giá nhà cung cấp đã duyệt</strong>:
                                    <field name="pricing_block_names" readonly="1" nolabel="1"
                                           class="dl-rfq-inline-field"/>.
                                    Sales sẽ chưa tạo được báo giá cho tới khi Mua hàng cập nhật giá.
                                    <button name="action_notify_purchasing" type="object"
                                            string="Báo Mua hàng" class="btn-link btn-sm p-0 ms-1 align-baseline"/>
                                </div>
                                <field name="selected_bom_line_ids" readonly="1"
                                       class="dl-rfq-bom-preview">
                                    <tree>
                                        <field name="material_id"/>
                                        <field name="dim_length" string="Dài đoạn (mm)"/>
                                        <field name="piece_count"/>
                                        <field name="quantity"/>
                                        <field name="uom_id" string="Đơn vị tính"/>
                                        <field name="waste_rate"/>
                                        <field name="effective_qty"/>
                                    </tree>
                                </field>
                            </div>

                            <!-- Chưa có định mức HOẶC đang mở picker → khối chọn/tạo. -->
                            <div class="dl-rfq-block dl-rfq-block--active"
                                 invisible="not product_id or (selected_bom_id and not show_bom_picker)">
                                <h2 class="dl-rfq-block-title">
                                    <span class="dl-rfq-block-no">⑵</span> Định mức vật tư
                                </h2>
                                <!-- EX-09: SP chưa có định mức nào → KHÔNG hiện bảng rỗng khó
                                     hiểu, mà hướng dẫn tạo định mức mới ngay. -->
                                <div class="alert alert-light border py-2" role="status"
                                     invisible="has_any_bom">
                                    <i class="fa fa-info-circle me-1"/>
                                    Sản phẩm này <b>chưa có định mức nào</b> — hãy tạo định mức mới
                                    cho yêu cầu này.
                                </div>
                                <p class="text-muted mb-2" invisible="not has_any_bom">
                                    Chọn một định mức đã có của sản phẩm hoặc tạo định mức mới cho yêu cầu này.
                                </p>

                                <!-- RES-028 — cấu hình này đã từng chốt: dùng lại định
                                     mức cũ thay vì đẻ thêm bản trùng nội dung. -->
                                <div class="alert alert-success py-2" role="status"
                                     invisible="not param_reused_bom">
                                    <i class="fa fa-recycle me-1" title="Dùng lại"/>
                                    <b>Dùng lại định mức đã chốt</b> cho đúng cấu hình này —
                                    hệ thống không sinh bản mới. Giá vẫn được tính lại theo
                                    giá vật tư hiện hành khi lập báo giá.
                                </div>

                                <!-- Đợt 4 — Sinh định mức từ BOM mẫu tham số: nhập D/R/C
                                     MỘT LẦN, hệ thống tự suy kích thước từng dòng vật tư
                                     (không tính tay). Chỉ hiện khi SP có mẫu tham số. -->
                                <div class="alert alert-info py-2" role="status"
                                     invisible="not has_parametric_template or show_param_panel">
                                    <i class="fa fa-magic me-1" title="Mẫu tham số"/>
                                    Sản phẩm này có <b>mẫu tham số</b>
                                    (<field name="parametric_template_id" readonly="1" nolabel="1"
                                            class="dl-rfq-inline-field"/>) —
                                    nhập kích thước, hệ thống tự sinh định mức.
                                    <button name="action_open_param_panel" type="object"
                                            string="Nhập kích thước &amp; sinh định mức"
                                            class="btn-primary btn-sm ms-1"/>
                                </div>

                                <div class="dl-rfq-param-panel border rounded p-2 mb-2"
                                     invisible="not show_param_panel">
                                    <div class="fw-bold mb-1">
                                        <i class="fa fa-magic me-1"/>Sinh định mức từ mẫu:
                                        <field name="parametric_template_id" readonly="1" nolabel="1"
                                               class="dl-rfq-inline-field"/>
                                    </div>
                                    <field name="param_line_ids" nolabel="1">
                                        <tree editable="bottom" create="0" delete="0">
                                            <field name="name" readonly="1"/>
                                            <field name="value"/>
                                            <field name="range_hint" readonly="1"/>
                                        </tree>
                                    </field>
                                    <div class="text-muted small mt-1">
                                        <i class="fa fa-info-circle me-1"/>Nhập kích thước theo
                                        <b>yêu cầu / bản vẽ</b> của đơn này — hệ thống không tự
                                        đọc số từ mô tả và không điền sẵn số nào.
                                    </div>
                                    <div class="mt-2">
                                        <button name="action_generate_instance" type="object"
                                                string="Sinh định mức" class="btn-primary btn-sm"/>
                                        <button name="action_close_param_panel" type="object"
                                                string="Đóng" class="btn-link btn-sm"/>
                                    </div>
                                </div>

                                <field name="bom_ids" nolabel="1" invisible="not has_any_bom">
                                    <tree>
                                        <field name="name"/>
                                        <field name="bom_type" widget="badge"/>
                                        <field name="version" string="Phiên bản"/>
                                        <!-- Định mức của SP dùng chung chỉ khác nhau ở CỠ —
                                             thiếu cột này thì bảng chỉ là "Bản #2 / Bản #3",
                                             không có cách nào biết bản nào là cỡ nào. -->
                                        <field name="param_display" string="Tham số"/>
                                        <field name="status" widget="badge"/>
                                        <field name="create_date" string="Ngày tạo"/>
                                        <button name="action_open_form" type="object"
                                                icon="fa-external-link"
                                                title="Mở định mức trên trang đầy đủ"/>
                                    </tree>
                                </field>
                                <group invisible="not has_any_bom">
                                    <field name="selected_bom_id"/>
                                </group>
                                <div class="dl-rfq-block-actions">
                                    <button name="action_edit_selected_bom" type="object"
                                            string="Sửa cho đơn này" class="btn-secondary btn-sm"
                                            invisible="not selected_bom_id"/>
                                    <button name="action_create_bom" type="object"
                                            string="Tạo định mức mới" class="btn-secondary btn-sm"/>
                                    <!-- EX-16: bỏ NGAY bản nháp tạm (đổi ý) thay vì chờ cron. -->
                                    <button name="action_discard_draft_bom" type="object"
                                            string="Bỏ bản nháp này" class="btn-link btn-sm text-danger"
                                            confirm="Bỏ bản định mức nháp này? Không thể hoàn tác."
                                            invisible="not selected_bom_can_discard"/>
                                    <button name="action_toggle_bom_picker" type="object"
                                            string="Đóng danh sách" class="btn-link btn-sm"
                                            invisible="not show_bom_picker or not selected_bom_id"/>
                                </div>
                            </div>

                            <!-- ⑶ KIỂM TRA (checklist tự tick) ─────────────── -->
                            <div class="dl-rfq-block dl-rfq-block--check"
                                 invisible="not product_id">
                                <h2 class="dl-rfq-block-title">
                                    <span class="dl-rfq-block-no">⑶</span> Kiểm tra trước khi hoàn tất
                                    <span class="badge text-bg-light ms-2">
                                        <field name="checklist_done" readonly="1" nolabel="1"
                                               class="dl-rfq-inline-field"/>/<field name="checklist_total"
                                               readonly="1" nolabel="1" class="dl-rfq-inline-field"/>
                                    </span>
                                </h2>
                                <ul class="dl-rfq-checklist">
                                    <li>
                                        <i class="fa fa-check text-success" invisible="not check_product"/>
                                        <i class="fa fa-times text-danger" invisible="check_product"/>
                                        Đã xác định sản phẩm
                                    </li>
                                    <li>
                                        <i class="fa fa-check text-success" invisible="not check_bom_belongs"/>
                                        <i class="fa fa-times text-danger" invisible="check_bom_belongs"/>
                                        Định mức thuộc đúng sản phẩm
                                    </li>
                                    <li>
                                        <i class="fa fa-check text-success" invisible="not check_bom_confirmed"/>
                                        <i class="fa fa-clock-o text-warning" invisible="check_bom_confirmed"/>
                                        <span invisible="check_bom_confirmed">
                                            Định mức đang ở trạng thái Nháp — sẽ được xác nhận khi Hoàn tất
                                            <button name="action_confirm_bom" type="object"
                                                    string="Xác nhận định mức ngay"
                                                    class="btn-link btn-sm"/>
                                        </span>
                                        <span invisible="not check_bom_confirmed">Định mức đã được xác nhận</span>
                                    </li>
                                    <li>
                                        <i class="fa fa-check text-success" invisible="not check_request_unchanged"/>
                                        <i class="fa fa-exclamation-triangle text-danger" invisible="check_request_unchanged"/>
                                        Yêu cầu Sales không thay đổi từ lúc bạn mở
                                    </li>
                                </ul>
                            </div>

                        </div><!-- /dl-rfq-main -->
                    </div><!-- /dl-rfq-layout -->

                    <!-- ══ DECISION DOCK (dính đáy) ══ -->
                    <div class="dl-rfq-dock">
                        <!-- Phương án chính. Lối thoát (bổ sung / không khả thi)
                             mở trong modal, không xổ ngay trong dock. -->
                        <div class="dl-rfq-dock-main">
                            <div class="dl-rfq-dock-summary">
                                <span invisible="not product_id">
                                    <i class="fa fa-cube me-1"/>
                                    <field name="product_id" readonly="1" nolabel="1"
                                           class="dl-rfq-inline-field"/>
                                </span>
                                <span invisible="not selected_bom_id" class="ms-2">
                                    · <field name="selected_bom_label" readonly="1" nolabel="1"
                                             class="dl-rfq-inline-field"/>
                                </span>
                                <div class="text-danger small mt-1" invisible="can_confirm">
                                    <field name="confirm_blocker" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                            <div class="dl-rfq-dock-cta">
                                <!-- Đủ điều kiện → nút thật. -->
                                <button name="action_confirm" type="object"
                                        string="Hoàn tất dòng" class="btn-primary"
                                        invisible="not can_confirm"/>
                                <button name="action_confirm_next" type="object"
                                        string="Hoàn tất &amp; dòng tiếp ▸" class="btn-secondary"
                                        invisible="not can_confirm or not next_line_id"/>
                                <!-- Chưa đủ → nút giả disable (không raise modal). -->
                                <span class="btn btn-primary disabled dl-rfq-btn-disabled"
                                      invisible="can_confirm">Hoàn tất dòng</span>
                            </div>
                            <div class="dl-rfq-dock-exits" invisible="is_infeasible">
                                <button name="action_show_supplement" type="object"
                                        string="Cần bổ sung" class="btn-link"/>
                                <span class="text-muted">·</span>
                                <button name="action_show_infeasible" type="object"
                                        string="Không khả thi" class="btn-link text-danger"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
