<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Nhận RFQ (Kỹ thuật) — wizard chọn/tạo Product + BOM cho 1 dòng RFQ.
    ================================================================ -->
    <record id="view_dl_rfq_resolve_wizard_form" model="ir.ui.view">
        <field name="name">dl.rfq.resolve.wizard.form</field>
        <field name="model">dl.rfq.resolve.wizard</field>
        <field name="arch" type="xml">
            <form string="Xử lý RFQ" class="dl-rfq-resolve">
                <field name="rfq_line_id" invisible="1"/>

                <!-- Khối yêu cầu từ Sales — gộp gọn để KTV xem nhanh trên cùng 1 màn. -->
                <div class="alert alert-info" role="alert">
                    <group>
                        <group>
                            <field name="request_product_name"/>
                            <field name="request_category_id"/>
                            <field name="request_quantity"/>
                        </group>
                        <group>
                            <field name="request_reference_product_id"/>
                            <field name="request_dimension_note"/>
                        </group>
                    </group>
                    <field name="request_attachment_ids" widget="many2many_binary"
                           readonly="1" nolabel="1"
                           invisible="not request_attachment_ids"/>
                </div>

                <group>
                    <field name="mode" widget="radio"/>
                </group>

                <!-- A. Product đã từng gia công -->
                <group invisible="mode != 'existing'" string="Chọn Product có sẵn">
                    <field name="allowed_product_ids" invisible="1"/>
                    <field name="product_id" placeholder="Tìm theo tên sản phẩm..."
                           domain="[('id', 'in', allowed_product_ids)]"
                           context="{'default_product_kind': 'manufactured', 'default_dlm_lifecycle_state': 'draft', 'default_categ_id': request_category_id, 'default_name': request_product_name}"/>
                    <div colspan="2" class="text-muted" invisible="not product_id">
                        <i class="fa fa-info-circle"/>
                        Giống y hệt: chọn BOM có sẵn bên dưới. Chỉ đổi vật liệu/kích
                        thước: bấm "Clone thành biến thể mới" để tạo phiên bản Nháp riêng.
                    </div>
                    <button name="action_clone_variant" type="object"
                            string="Clone thành biến thể mới (đổi vật liệu/kích thước)"
                            class="btn-secondary" invisible="not product_id"/>
                </group>

                <group invisible="mode != 'existing' or not product_id" string="BOM Version">
                    <field name="bom_ids" nolabel="1" colspan="2">
                        <tree>
                            <field name="name"/>
                            <field name="version"/>
                            <field name="status" widget="badge"/>
                            <field name="create_date" string="Ngày tạo"/>
                        </tree>
                    </field>
                </group>

                <group invisible="mode != 'existing' or not product_id">
                    <field name="selected_bom_id"/>
                    <button name="action_edit_selected_bom" type="object"
                            string="Chỉnh sửa BOM cho RFQ này"
                            class="btn-secondary"
                            invisible="not selected_bom_id"/>
                    <button name="action_create_bom" type="object"
                            string="Tạo BOM mới"
                            class="btn-secondary"/>
                </group>

                <notebook invisible="mode != 'existing' or not selected_bom_id">
                    <page string="Chi tiết BOM (xem trước)">
                        <field name="selected_bom_line_ids" readonly="1">
                            <tree>
                                <field name="material_id"/>
                                <field name="measurement_shape_id"/>
                                <field name="quantity"/>
                                <field name="waste_rate"/>
                                <field name="effective_qty"/>
                                <field name="subtotal"/>
                            </tree>
                        </field>
                    </page>
                </notebook>

                <!-- B. Product chưa từng gia công -->
                <group invisible="mode != 'new'" string="Tạo Product mới">
                    <field name="new_product_name"/>
                    <field name="new_product_category_id"/>
                    <button name="action_create_product" type="object"
                            string="Tạo Product" class="oe_highlight"/>
                </group>

                <!-- Hoặc: kết luận dòng này KHÔNG khả thi (không cần Product/BOM). -->
                <separator string="Hoặc — không khả thi"/>
                <group>
                    <field name="is_infeasible"/>
                    <field name="infeasible_reason"
                           invisible="not is_infeasible"
                           required="is_infeasible"/>
                    <button name="action_mark_infeasible" type="object"
                            string="Xác nhận không khả thi" class="btn-warning"
                            invisible="not is_infeasible"/>
                </group>

                <footer>
                    <button name="action_confirm" type="object"
                            string="Xác nhận" class="oe_highlight"
                            invisible="is_infeasible"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
