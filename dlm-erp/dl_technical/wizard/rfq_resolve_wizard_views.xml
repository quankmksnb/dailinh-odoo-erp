<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Workspace xử lý một dòng RFQ — full-page, ba công đoạn tuyến tính. -->
    <record id="view_dl_rfq_resolve_wizard_form" model="ir.ui.view">
        <field name="name">dl.rfq.resolve.wizard.form</field>
        <field name="model">dl.rfq.resolve.wizard</field>
        <field name="arch" type="xml">
            <form string="Xử lý RFQ" class="dl-rfq-resolve" create="0" delete="0">
                <header>
                    <button name="action_cancel" type="object"
                            string="Quay lại RFQ" icon="fa-arrow-left"
                            class="btn-secondary"/>
                    <button name="action_previous_step" type="object"
                            string="Bước trước"
                            invisible="step == 'product'"/>
                    <button name="action_next_step" type="object"
                            string="Tiếp tục" class="oe_highlight"
                            invisible="step == 'confirm' or is_infeasible"/>
                    <button name="action_confirm" type="object"
                            string="Hoàn tất dòng" class="oe_highlight"
                            invisible="step != 'confirm' or is_infeasible"/>
                    <!-- Băng chuyền RFQ nhiều dòng: hoàn tất rồi mở luôn dòng
                         gia công chưa xử lý kế tiếp, khỏi quay về RFQ tự tìm. -->
                    <field name="next_line_id" invisible="1"/>
                    <button name="action_confirm_next" type="object"
                            string="Hoàn tất &amp; dòng tiếp theo"
                            invisible="step != 'confirm' or is_infeasible or not next_line_id"/>
                    <button name="action_mark_infeasible" type="object"
                            string="Xác nhận không khả thi" class="btn-warning"
                            invisible="not is_infeasible"/>
                    <button name="action_mark_supplement" type="object"
                            string="Yêu cầu bổ sung" class="btn-warning"
                            invisible="is_infeasible or not supplement_note"/>
                    <field name="step" widget="dl_stepper"
                           statusbar_visible="product,bom,confirm"/>
                </header>

                <sheet>
                    <field name="rfq_line_id" invisible="1"/>
                    <field name="product_is_rfq_provisional" invisible="1"/>
                    <field name="selected_bom_is_rfq_provisional" invisible="1"/>

                    <div class="alert alert-warning" role="status"
                         invisible="not product_is_rfq_provisional and not selected_bom_is_rfq_provisional">
                        <i class="fa fa-clock-o me-1" title="Dữ liệu tạm từ RFQ"/>
                        <strong>Dữ liệu đang được giữ tạm cho dòng RFQ này.</strong>
                        Sản phẩm/BOM chỉ trở thành dữ liệu chính thức sau khi bấm
                        <em>Hoàn tất dòng</em>. Bạn có thể quay lại RFQ và mở lại để làm tiếp.
                    </div>

                    <!-- Cảnh báo khi dòng đang chờ Sales bổ sung: KTV vẫn tiếp
                         tục xử lý được (thông tin có thể đã nhận qua kênh khác)
                         nhưng cần biết rằng hoàn tất sẽ gỡ yêu cầu bổ sung. -->
                    <field name="has_existing_supplement" invisible="1"/>
                    <div class="alert alert-warning" role="status"
                         invisible="not has_existing_supplement">
                        <i class="fa fa-clock-o me-1" title="Chờ bổ sung"/>
                        <strong>Dòng này đang chờ Sales bổ sung.</strong>
                        Nếu bạn tiếp tục xử lý và bấm <em>Hoàn tất dòng</em>,
                        yêu cầu bổ sung sẽ được gỡ tự động.
                    </div>

                    <div class="oe_title">
                        <label for="request_product_name" string="Dòng RFQ đang xử lý"/>
                        <h1>
                            <field name="request_product_name" readonly="1"/>
                        </h1>
                    </div>

                    <div class="dl-rfq-request-summary" role="region"
                         aria-label="Thông tin yêu cầu từ Sales">
                        <div class="dl-rfq-section-title">
                            <i class="fa fa-file-text-o me-1"/>Yêu cầu từ Sales
                        </div>
                        <group>
                            <group>
                                <field name="request_category_id" readonly="1"/>
                                <field name="request_quantity" readonly="1"/>
                            </group>
                            <group>
                                <field name="request_reference_product_id" readonly="1"/>
                                <field name="request_dimension_note" readonly="1"/>
                            </group>
                        </group>
                        <field name="request_attachment_ids" widget="many2many_binary"
                               readonly="1" nolabel="1"
                               invisible="not request_attachment_ids"/>
                    </div>

                    <!-- Bước 1: xác định Product. -->
                    <div class="dl-rfq-step-panel" invisible="step != 'product'">
                        <h2><span class="badge text-bg-primary me-2">1</span>Xác định sản phẩm</h2>
                        <p class="text-muted">
                            Chọn sản phẩm đã từng gia công hoặc tạo sản phẩm mới từ yêu cầu của Sales.
                        </p>

                        <group>
                            <field name="mode" widget="radio"/>
                        </group>

                        <group invisible="mode != 'existing'" string="Chọn sản phẩm có sẵn">
                            <field name="allowed_product_ids" invisible="1"/>
                            <field name="product_id" placeholder="Tìm theo tên sản phẩm..."
                                   domain="[('id', 'in', allowed_product_ids)]"
                                   options="{'no_create': True}"
                                   context="{'default_product_kind': 'manufactured', 'default_dlm_lifecycle_state': 'draft', 'default_categ_id': request_category_id, 'default_name': request_product_name}"/>
                        </group>

                        <group invisible="mode != 'new'" string="Tạo sản phẩm mới">
                            <field name="new_product_name" required="mode == 'new'"/>
                            <field name="new_product_category_id" required="mode == 'new'"/>
                            <field name="name_dup_state" invisible="1"/>
                            <field name="name_dup_exact_id" invisible="1"/>

                            <!-- Trùng hệt: chặn tạo, mời chọn lại SP có sẵn. -->
                            <div class="alert alert-danger" colspan="2" role="alert"
                                 invisible="name_dup_state != 'exact'">
                                <i class="fa fa-ban me-1" title="Trùng"/>
                                <field name="name_dup_message" nolabel="1" readonly="1"/>
                                <div class="mt-2">
                                    <button name="action_use_duplicate_product" type="object"
                                            string="Dùng sản phẩm này"
                                            class="btn-primary btn-sm"/>
                                </div>
                            </div>

                            <!-- Gần giống: cảnh báo mềm, cần tick xác nhận. -->
                            <div class="alert alert-warning" colspan="2" role="alert"
                                 invisible="name_dup_state != 'similar'">
                                <i class="fa fa-exclamation-triangle me-1" title="Gần giống"/>
                                <field name="name_dup_message" nolabel="1" readonly="1"/>
                                <div class="mt-2">
                                    <field name="confirm_similar_name"
                                           class="d-inline-block me-1"/>
                                    <label for="confirm_similar_name"
                                           string="Xác nhận đây thực sự là sản phẩm khác"
                                           class="fw-normal"/>
                                </div>
                            </div>

                            <button name="action_create_product" type="object"
                                    string="Tạo sản phẩm" class="oe_highlight"
                                    invisible="name_dup_state == 'exact'"/>
                        </group>
                    </div>

                    <!-- Bước 2: chọn/tạo/chỉnh BOM. Các đường BOM chi tiết sẽ
                         được chuẩn hóa riêng ở Mức 5. -->
                    <div class="dl-rfq-step-panel" invisible="step != 'bom'">
                        <h2><span class="badge text-bg-primary me-2">2</span>Định mức BOM</h2>
                        <p class="text-muted">
                            Chọn BOM đã xác nhận/đã khóa hoặc tạo phiên bản phù hợp với yêu cầu này.
                        </p>

                        <group string="Sản phẩm đã xác định">
                            <field name="product_id" readonly="1"/>
                        </group>

                        <group string="Phiên bản định mức">
                            <field name="bom_ids" nolabel="1" colspan="2">
                                <tree>
                                    <field name="name"/>
                                    <field name="version"/>
                                    <field name="status" widget="badge"/>
                                    <field name="create_date" string="Ngày tạo"/>
                                    <button name="action_open_form" type="object"
                                            icon="fa-external-link"
                                            title="Mở BOM trên trang đầy đủ"/>
                                </tree>
                            </field>
                        </group>

                        <group>
                            <field name="selected_bom_id"/>
                            <button name="action_edit_selected_bom" type="object"
                                    string="Chỉnh sửa BOM cho RFQ này"
                                    class="btn-secondary"
                                    invisible="not selected_bom_id"/>
                            <button name="action_create_bom" type="object"
                                    string="Tạo BOM mới" class="btn-secondary"/>
                        </group>

                        <notebook invisible="not selected_bom_id">
                            <page string="Chi tiết BOM (xem trước)">
                                <field name="selected_bom_line_ids" readonly="1">
                                    <tree>
                                        <field name="material_id"/>
                                        <field name="measurement_shape_id"/>
                                        <field name="quantity"/>
                                        <field name="waste_rate"/>
                                        <field name="effective_qty"/>
                                        <field name="subtotal"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </div>

                    <!-- Bước 3: rà soát trước khi ghi kết quả về dòng RFQ. -->
                    <div class="dl-rfq-step-panel" invisible="step != 'confirm'">
                        <h2><span class="badge text-bg-primary me-2">3</span>Xác nhận phương án</h2>
                        <div class="alert alert-success" role="status">
                            Kiểm tra lại Product và BOM trước khi bấm <b>Hoàn tất dòng</b>.
                        </div>
                        <group string="Phương án kỹ thuật">
                            <field name="product_id" readonly="1"/>
                            <field name="selected_bom_id" readonly="1"/>
                        </group>
                        <notebook invisible="not selected_bom_id">
                            <page string="Chi tiết BOM đã chọn">
                                <field name="selected_bom_line_ids" readonly="1">
                                    <tree>
                                        <field name="material_id"/>
                                        <field name="measurement_shape_id"/>
                                        <field name="quantity"/>
                                        <field name="waste_rate"/>
                                        <field name="effective_qty"/>
                                        <field name="subtotal"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </div>

                    <!-- Kết luận không khả thi luôn sẵn ở mọi bước; khi bật,
                         nút xác nhận riêng xuất hiện trên header. -->
                    <div class="dl-rfq-infeasible-panel"
                         invisible="supplement_note">
                        <separator string="Hoặc — kết luận không khả thi"/>
                        <group>
                            <field name="is_infeasible"/>
                        </group>
                        <field name="infeasible_reason" nolabel="1"
                               class="dl-textarea-lg"
                               invisible="not is_infeasible"
                               required="is_infeasible"
                               placeholder="Nêu rõ lý do để Sales trao đổi lại với khách hàng..."/>
                    </div>

                    <div class="dl-rfq-supplement-panel"
                         invisible="is_infeasible">
                        <separator string="Hoặc — yêu cầu Sales bổ sung thông tin"/>
                        <field name="supplement_note" nolabel="1"
                               class="dl-textarea-lg"
                               placeholder="Nêu rõ thông tin Sales cần bổ sung (ảnh rõ hơn, kích thước chi tiết, yêu cầu kỹ thuật cụ thể...)"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
