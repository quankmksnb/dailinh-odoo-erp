<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             😴 FILE NÀY ĐÃ NGỦ ĐÔNG — KHÔNG còn nằm trong __manifest__.py.

             Từ 2026-08-09 (thiết kế §14), quy cách vật tư nằm trên chính vật tư
             (dlm_calc_kind + dlm_profile_kind + a/b/t) và dòng BOM không tham
             chiếu dl.measurement.* nữa. Giữ file để còn đường lui nếu sau này
             cần công thức hình học tổng quát.

             ⚠️ Muốn bật lại thì phải khôi phục trước các bản ghi
             demo_meas_type_weight / demo_meas_type_area / demo_meas_shape_flat /
             demo_meas_shape_square_tube ở dl_product/data/dl_demo_data.xml —
             chúng đã bị gỡ, các ref bên dưới sẽ không resolve được.

             Bộ Rule (dl.measurement.type) + Shape (dl.measurement.shape) đầy
             đủ cho 13→17 công thức hard-code trong dl_bom_line_mixin.py.
        ================================================================ -->

        <!-- Rule còn thiếu (Khối lượng + Diện tích đã có sẵn ở dl_product) -->
        <record id="meas_type_perimeter" model="dl.measurement.type">
            <field name="name">Chu vi</field>
            <field name="formula_uom_id" ref="uom.product_uom_meter" />
        </record>
        <record id="meas_type_volume" model="dl.measurement.type">
            <field name="name">Thể tích</field>
            <field name="formula_uom_id" ref="uom.product_uom_cubic_meter" />
        </record>
        <record id="meas_type_length" model="dl.measurement.type">
            <field name="name">Chiều dài</field>
            <field name="formula_uom_id" ref="uom.product_uom_meter" />
        </record>

        <!-- Khối lượng — 3 shape mới (Tấm phẳng/Ống vuông rỗng đã có ở dl_product) -->
        <record id="meas_shape_hollow_round_tube" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="dl_product.demo_meas_type_weight"/>
            <field name="name">Ống tròn rỗng</field>
            <field name="code">hollow_round_tube</field>
            <field name="default_coefficient">7850</field>
            <field name="coefficient_label">Khối lượng riêng (kg/m³)</field>
        </record>
        <record id="meas_shape_solid_round_bar" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="dl_product.demo_meas_type_weight"/>
            <field name="name">Thanh đặc tròn</field>
            <field name="code">solid_round_bar</field>
            <field name="default_coefficient">7850</field>
            <field name="coefficient_label">Khối lượng riêng (kg/m³)</field>
        </record>
        <record id="meas_shape_solid_square_bar" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="dl_product.demo_meas_type_weight"/>
            <field name="name">Thanh đặc vuông</field>
            <field name="code">solid_square_bar</field>
            <field name="default_coefficient">7850</field>
            <field name="coefficient_label">Khối lượng riêng (kg/m³)</field>
        </record>

        <!-- Diện tích (Rule đã có sẵn ở dl_product, dùng lại) -->
        <record id="meas_shape_area_rectangle" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="dl_product.demo_meas_type_area"/>
            <field name="name">Hình chữ nhật</field>
            <field name="code">area_rectangle</field>
        </record>
        <record id="meas_shape_area_square" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="dl_product.demo_meas_type_area"/>
            <field name="name">Hình vuông</field>
            <field name="code">area_square</field>
        </record>
        <record id="meas_shape_area_circle" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="dl_product.demo_meas_type_area"/>
            <field name="name">Hình tròn</field>
            <field name="code">area_circle</field>
        </record>
        <record id="meas_shape_area_triangle" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="dl_product.demo_meas_type_area"/>
            <field name="name">Hình tam giác</field>
            <field name="code">area_triangle</field>
        </record>

        <!-- Chu vi -->
        <record id="meas_shape_perimeter_rectangle" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="meas_type_perimeter"/>
            <field name="name">Hình chữ nhật</field>
            <field name="code">perimeter_rectangle</field>
        </record>
        <record id="meas_shape_perimeter_square" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="meas_type_perimeter"/>
            <field name="name">Hình vuông</field>
            <field name="code">perimeter_square</field>
        </record>
        <record id="meas_shape_perimeter_circle" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="meas_type_perimeter"/>
            <field name="name">Hình tròn</field>
            <field name="code">perimeter_circle</field>
        </record>

        <!-- Thể tích -->
        <record id="meas_shape_volume_box" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="meas_type_volume"/>
            <field name="name">Hình hộp chữ nhật</field>
            <field name="code">volume_box</field>
        </record>
        <record id="meas_shape_volume_cube" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="meas_type_volume"/>
            <field name="name">Hình lập phương</field>
            <field name="code">volume_cube</field>
        </record>
        <record id="meas_shape_volume_cylinder" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="meas_type_volume"/>
            <field name="name">Hình trụ</field>
            <field name="code">volume_cylinder</field>
        </record>
        <record id="meas_shape_volume_sphere" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="meas_type_volume"/>
            <field name="name">Hình cầu</field>
            <field name="code">volume_sphere</field>
        </record>

        <!-- Chiều dài -->
        <record id="meas_shape_length_segment" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="meas_type_length"/>
            <field name="name">Đoạn thẳng</field>
            <field name="code">length_segment</field>
        </record>

    </data>
</odoo>
