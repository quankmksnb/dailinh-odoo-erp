<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- TECH-04/05 — BOM mẫu cho nhóm "Khung thép hàn" (khớp kịch bản) -->
        <record id="demo_bom_template_khungthep" model="dl.bom.template">
            <field name="name">BOM mẫu Khung thép hàn</field>
            <field name="product_category_id" ref="dl_product.categ_khung_thep_han"/>
        </record>

        <record id="demo_bom_tmpl_line_tamsat" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_template_khungthep"/>
            <field name="material_id" ref="dl_product.demo_product_tam_sat"/>
            <field name="quantity">2</field>
            <field name="note">KTV chỉnh lại theo kích thước thật khi áp dụng</field>
        </record>
        <record id="demo_bom_tmpl_line_khungong" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_template_khungthep"/>
            <field name="material_id" ref="dl_product.demo_product_khung_ong"/>
            <field name="quantity">4</field>
            <field name="note">KTV chỉnh lại theo kích thước thật</field>
        </record>
        <record id="demo_bom_tmpl_line_ocvit" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_template_khungthep"/>
            <field name="material_id" ref="dl_product.demo_product_oc_vit"/>
            <field name="quantity">8</field>
            <field name="note">Chỉ mang tính gợi ý — có thể đổi loại ốc vít</field>
        </record>

        <!-- Nối category → BOM mẫu mặc định (PROD-01 bom_template_id) -->
        <record id="dl_product.categ_khung_thep_han" model="product.category">
            <field name="bom_template_id" ref="demo_bom_template_khungthep"/>
        </record>

    </data>
</odoo>
