<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- TECH-04/05 — BOM mẫu cho nhóm "Khung thép hàn" (khớp kịch bản).
             Seed ở trạng thái ĐÃ XÁC NHẬN + hiện hành: ràng buộc LK-04
             (_dlm_check_bom_template_id) chỉ cho gán mẫu Confirmed/Locked làm
             mẫu mặc định của nhóm (xem nối category ở dưới). -->
        <record id="demo_bom_template_khungthep" model="dl.bom.template">
            <field name="name">BOM mẫu Khung thép hàn</field>
            <field name="product_category_id" ref="dl_product.categ_khung_thep_han"/>
            <field name="product_qty">1</field>
            <field name="version">1</field>
            <field name="status">confirmed</field>
            <field name="is_current" eval="True"/>
        </record>

        <record id="demo_bom_tmpl_line_tamsat" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_template_khungthep"/>
            <field name="material_id" ref="dl_product.demo_product_tam_sat"/>
            <field name="quantity">2</field>
            <field name="note">KTV chỉnh lại theo kích thước thật khi áp dụng</field>
        </record>
        <record id="demo_bom_tmpl_line_khungong" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_template_khungthep"/>
            <field name="material_id" ref="dl_product.demo_product_khung_ong"/>
            <field name="quantity">4</field>
            <field name="note">KTV chỉnh lại theo kích thước thật</field>
        </record>
        <record id="demo_bom_tmpl_line_ocvit" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_template_khungthep"/>
            <field name="material_id" ref="dl_product.demo_product_oc_vit"/>
            <field name="quantity">8</field>
            <field name="note">Chỉ mang tính gợi ý — có thể đổi loại ốc vít</field>
        </record>

        <!-- Nối category → BOM mẫu mặc định (PROD-01 bom_template_id) -->
        <record id="dl_product.categ_khung_thep_han" model="product.category">
            <field name="bom_template_id" ref="demo_bom_template_khungthep"/>
        </record>

        <!-- ================================================================
             ĐỢT 4 — BOM MẪU THAM SỐ demo "Bàn thép khung hộp" cho nhóm
             "Bàn ghế sắt". KTV nhập D/R/C một lần, hệ thống suy kích thước cắt
             từng dòng vật tư (chân: 4 đoạn × C · dọc: 2 đoạn × D · ngang:
             2 đoạn × R · mặt bàn: 1 tấm D×R) rồi quy ra đơn vị mua của vật tư.
        ================================================================ -->

        <!-- Sản phẩm generic để gắn định mức sinh ra (đường B). -->
        <record id="demo_product_ban_thep" model="product.product">
            <field name="name">Bàn thép khung hộp</field>
            <field name="default_code">GC-BANTHEP</field>
            <field name="product_kind">manufactured</field>
            <field name="categ_id" ref="dl_product.categ_ban_ghe_sat"/>
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
        </record>

        <!-- BOM mẫu tham số — seed ở trạng thái ĐÃ XÁC NHẬN + hiện hành để
             workspace nhận ra ngay (generate_instance đòi confirmed/locked). -->
        <record id="demo_bom_tmpl_ban_thep" model="dl.bom.template">
            <field name="name">Bàn thép khung hộp (tham số D×R×C)</field>
            <field name="product_category_id" ref="dl_product.categ_ban_ghe_sat"/>
            <field name="product_qty">1</field>
            <field name="version">1</field>
            <field name="status">confirmed</field>
            <field name="is_current" eval="True"/>
            <!-- Đích đến của MỌI kích thước sinh từ mẫu: workspace RFQ dựa vào
                 field này để dẫn Kỹ thuật về sản phẩm dùng chung thay vì đẻ mã
                 sản phẩm mới cho từng cỡ. -->
            <field name="generic_product_id" ref="demo_product_ban_thep"/>
        </record>

        <!-- Tham số cấp sản phẩm: Dài / Rộng / Cao (mm), có miền hợp lệ. -->
        <record id="demo_bom_param_D" model="dl.bom.template.param">
            <field name="bom_template_id" ref="demo_bom_tmpl_ban_thep"/>
            <field name="sequence">10</field>
            <field name="code">D</field>
            <field name="name">Chiều dài</field>
            <field name="dim_role">length</field>
            <field name="default_value">1200</field>
            <field name="value_min">600</field>
            <field name="value_max">2400</field>
        </record>
        <record id="demo_bom_param_R" model="dl.bom.template.param">
            <field name="bom_template_id" ref="demo_bom_tmpl_ban_thep"/>
            <field name="sequence">20</field>
            <field name="code">R</field>
            <field name="name">Chiều rộng</field>
            <field name="dim_role">width</field>
            <field name="default_value">800</field>
            <field name="value_min">400</field>
            <field name="value_max">1200</field>
        </record>
        <record id="demo_bom_param_C" model="dl.bom.template.param">
            <field name="bom_template_id" ref="demo_bom_tmpl_ban_thep"/>
            <field name="sequence">30</field>
            <field name="code">C</field>
            <field name="name">Chiều cao</field>
            <field name="dim_role">height</field>
            <field name="default_value">750</field>
            <field name="value_min">600</field>
            <field name="value_max">900</field>
        </record>

        <!-- ⚠️ Ánh xạ đúng cách (§15.2): CHIỀU DÀI MỘT ĐOẠN ← tham số (hệ số 1),
             số lượng đoạn để ở "Số đoạn". Nhân 4 vào chiều dài như bản cũ thì
             ra đúng tổng mét nhưng MẤT cut list — xưởng không biết cắt mấy đoạn
             dài bao nhiêu. Quy cách (cạnh 25, dày 1.5) đã nằm trên vật tư. -->

        <!-- Dòng 1 — Chân bàn: 4 đoạn, mỗi đoạn dài = C. -->
        <record id="demo_bom_tmpl_ban_line_chan" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_tmpl_ban_thep"/>
            <field name="material_id" ref="dl_product.demo_product_ong_vuong"/>
            <field name="piece_count">4</field>
            <field name="note">4 chân bàn</field>
        </record>
        <record id="demo_bom_map_chan_len" model="dl.bom.template.line.param.map">
            <field name="template_line_id" ref="demo_bom_tmpl_ban_line_chan"/>
            <field name="target_field">dim_length</field>
            <field name="param_id" ref="demo_bom_param_C"/>
            <field name="factor">1</field>
        </record>

        <!-- Dòng 2 — Thanh dọc khung: 2 đoạn, mỗi đoạn dài = D. -->
        <record id="demo_bom_tmpl_ban_line_doc" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_tmpl_ban_thep"/>
            <field name="material_id" ref="dl_product.demo_product_ong_vuong"/>
            <field name="piece_count">2</field>
            <field name="note">2 thanh dọc</field>
        </record>
        <record id="demo_bom_map_doc_len" model="dl.bom.template.line.param.map">
            <field name="template_line_id" ref="demo_bom_tmpl_ban_line_doc"/>
            <field name="target_field">dim_length</field>
            <field name="param_id" ref="demo_bom_param_D"/>
            <field name="factor">1</field>
        </record>

        <!-- Dòng 3 — Thanh ngang khung: 2 đoạn, mỗi đoạn dài = R. -->
        <record id="demo_bom_tmpl_ban_line_ngang" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_tmpl_ban_thep"/>
            <field name="material_id" ref="dl_product.demo_product_ong_vuong"/>
            <field name="piece_count">2</field>
            <field name="note">2 thanh ngang</field>
        </record>
        <record id="demo_bom_map_ngang_len" model="dl.bom.template.line.param.map">
            <field name="template_line_id" ref="demo_bom_tmpl_ban_line_ngang"/>
            <field name="target_field">dim_length</field>
            <field name="param_id" ref="demo_bom_param_R"/>
            <field name="factor">1</field>
        </record>

        <!-- Dòng 4 — Mặt bàn (tấm): 1 tấm cắt D × R. Độ dày/khổ nằm ở vật tư. -->
        <record id="demo_bom_tmpl_ban_line_mat" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_tmpl_ban_thep"/>
            <field name="material_id" ref="dl_product.demo_product_thep_cuon"/>
            <field name="piece_count">1</field>
            <field name="note">Mặt bàn</field>
        </record>
        <record id="demo_bom_map_mat_len" model="dl.bom.template.line.param.map">
            <field name="template_line_id" ref="demo_bom_tmpl_ban_line_mat"/>
            <field name="target_field">dim_length</field>
            <field name="param_id" ref="demo_bom_param_D"/>
        </record>
        <record id="demo_bom_map_mat_wid" model="dl.bom.template.line.param.map">
            <field name="template_line_id" ref="demo_bom_tmpl_ban_line_mat"/>
            <field name="target_field">dim_width</field>
            <field name="param_id" ref="demo_bom_param_R"/>
        </record>

        <!-- Dòng 5 — Bulông: số lượng cố định, không ánh xạ tham số. -->
        <record id="demo_bom_tmpl_ban_line_bulong" model="dl.bom.template.line">
            <field name="bom_template_id" ref="demo_bom_tmpl_ban_thep"/>
            <field name="material_id" ref="dl_product.demo_product_oc_vit"/>
            <field name="quantity">16</field>
            <field name="note">Bulông liên kết (cố định)</field>
        </record>

    </data>
</odoo>
