<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="dl_technical.DlTechnicalHome">
    <div class="dl-technical o_action">
        <div class="dl-technical-inner">
            <!-- Page header — cùng khung với quote_home/config_home -->
            <div class="dl-technical-head">
                <div class="dl-technical-head-main">
                    <h1 class="dl-technical-title">Kỹ thuật</h1>
                    <span class="dl-technical-subtitle">
                        Quản lý sản phẩm, bán thành phẩm, bản vẽ, BOM &amp; BOM mẫu, và xử lý yêu cầu báo giá (RFQ)
                    </span>
                </div>
            </div>

            <!-- Lối vào nghiệp vụ dạng hàng nén -->
            <div class="dl-technical-section-label">Lối vào</div>
            <div class="dl-technical-rows">
                <t t-foreach="cards" t-as="c" t-key="c.key">
                    <div class="dl-technical-row"
                         t-att-class="{ 'is-disabled': !c.actionXmlId }"
                         t-on-click="() => this.openCard(c.actionXmlId)">
                        <span class="dl-technical-row-icon">
                            <i t-att-class="'fa ' + c.icon"/>
                        </span>
                        <span class="dl-technical-row-body">
                            <span class="dl-technical-row-name" t-esc="c.name"/>
                            <span class="dl-technical-row-desc" t-esc="c.desc"/>
                        </span>
                        <span t-if="!c.actionXmlId" class="dl-technical-row-soon">Sắp có</span>
                        <i t-else="" class="fa fa-angle-right dl-technical-row-arrow"/>
                    </div>
                </t>
            </div>
        </div>
    </div>
</t>

</templates>
