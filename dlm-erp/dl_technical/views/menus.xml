<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         BOM — dưới menu gốc "Kỹ thuật" (dl_base.menu_dl_technical)
    ================================================================ -->
    <menuitem id="menu_bom_parent"
              name="BOM"
              parent="dl_base.menu_dl_technical"
              groups="dl_base.dl_group_tech,dl_base.dl_group_admin,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager"
              sequence="10"/>

    <menuitem id="menu_bom_quotation"
              name="BOM sản phẩm / Bán thành phẩm"
              parent="menu_bom_parent"
              action="action_dl_bom"
              sequence="10"/>

    <menuitem id="menu_bom_template"
              name="BOM mẫu"
              parent="menu_bom_parent"
              action="action_dl_bom_template"
              sequence="20"/>

    <!-- Danh mục Sản phẩm / Nhóm sản phẩm / Bán thành phẩm: ngoài phạm vi
         S08 (không tạo màn quản lý ở đây) — "Danh mục Sản phẩm" đã có sẵn
         ở dl_sale (dl_base.menu_dl_technical_product). -->

    <!-- ================================================================
         BẢN VẼ
    ================================================================ -->
    <!-- Trưởng phòng KD CỐ Ý không có mục này: họ không có ACL `dl.drawing`, mở
         menu là AccessError. Ranh giới đã có sẵn ở form BOM (khối "Bản vẽ kỹ
         thuật" và ô xem trước gán groups tech/admin/ceo) — chỉ menu này lệch.
         Muốn mở cho họ thì phải cấp ACL đọc dl.drawing trước, không sửa mỗi đây. -->
    <menuitem id="menu_drawing"
              name="Bản vẽ kỹ thuật"
              parent="dl_base.menu_dl_technical"
              action="action_dl_drawing"
              groups="dl_base.dl_group_tech,dl_base.dl_group_admin,dl_base.dl_group_ceo"
              sequence="30"/>
    <!-- menuitem groups= chỉ CỘNG DỒN ⇒ bỏ vai khỏi thuộc tính KHÔNG gỡ được vai
         cũ trên DB đã nâng cấp. Chốt cứng bằng (6,0,...). -->
    <record id="menu_drawing" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_tech'),
            ref('dl_base.dl_group_admin'),
            ref('dl_base.dl_group_ceo'),
        ])]"/>
    </record>

    <!-- ================================================================
         TẠO RFQ — sidebar riêng cho Sales, dưới menu gốc "CRM &amp; Báo giá"
         (dl_base.menu_dl_sale). Thay thế màn tạo RFQ cũ cho Sales; menu
         "Yêu cầu báo giá" bên dưới vẫn giữ nguyên cho Kỹ thuật xử lý.
    ================================================================ -->
    <!-- Giám đốc CỐ Ý không có mục này: ACL dl.quotation.request của CEO là
         chỉ-đọc, mà action mở thẳng form tạo ⇒ họ vào được nhưng không lưu nổi.
         CEO theo dõi RFQ qua mục "Tất cả RFQ" bên dưới. -->
    <menuitem id="menu_rfq_create"
              name="Tạo RFQ"
              parent="dl_base.menu_dl_sale"
              action="action_dl_quotation_request_create"
              groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"
              sequence="20"/>
    <record id="menu_rfq_create" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_ba'),
            ref('dl_base.dl_group_sales_manager'),
            ref('dl_base.dl_group_admin'),
        ])]"/>
    </record>

    <!-- ================================================================
         YÊU CẦU BÁO GIÁ (RFQ) — dưới menu gốc "CRM &amp; Báo giá" (dl_base.menu_dl_sale)
         Kỹ thuật xử lý RFQ tại đây (danh sách/xử lý, không phải màn tạo mới).
    ================================================================ -->
    <menuitem id="menu_rfq_parent"
              name="Yêu cầu báo giá"
              parent="dl_base.menu_dl_sale"
              groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_tech,dl_base.dl_group_sales_manager"
              sequence="25"/>

    <!-- Ghi RÕ groups đúng bằng menu cha (thay vì để trống thừa hưởng): trong DB
         menu này từng bị giới hạn Admin/IT + Kỹ thuật (dữ liệu sót, không từ code);
         Odoo KHÔNG xoá groups_id cũ khi thuộc tính groups trống lúc -u, nên phải
         khai báo tường minh để -u ghi đè và trả lại quyền xem cho Sales/BA/TrKD. -->
    <menuitem id="menu_rfq_all"
              name="Tất cả RFQ"
              parent="menu_rfq_parent"
              action="action_dl_quotation_request"
              groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_tech,dl_base.dl_group_sales_manager"
              sequence="10"/>

    <menuitem id="menu_rfq_my"
              name="RFQ cần xử lý"
              parent="menu_rfq_parent"
              action="action_dl_quotation_request_my"
              sequence="20"
              groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>

</odoo>
