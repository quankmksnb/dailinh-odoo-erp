<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         BOM (dl.bom)
    ================================================================ -->

    <!-- Tree view -->
    <record id="view_dl_bom_tree" model="ir.ui.view">
        <field name="name">dl.bom.tree</field>
        <field name="model">dl.bom</field>
        <field name="arch" type="xml">
            <tree string="Bill of Materials"
                  class="dl-bom-list" js_class="dl_bom_list"
                  decoration-muted="status == 'archived'"
                  decoration-info="status == 'draft'"
                  decoration-success="status == 'confirmed'"
                  decoration-warning="status == 'locked'">
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="product_id"/>
                <field name="version"/>
                <field name="product_qty" string="Output Quantity"/>
                <field name="total_material_cost" string="Chi phí VT"
                       groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-success="status == 'confirmed'"
                       decoration-warning="status == 'locked'"
                       decoration-muted="status == 'archived'"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_dl_bom_form" model="ir.ui.view">
        <field name="name">dl.bom.form</field>
        <field name="model">dl.bom</field>
        <field name="arch" type="xml">
            <form string="Bill of Materials" class="dl-bom-form" js_class="dl_bom_form">
                <header>
                    <field name="show_back_to_rfq" invisible="1"/>
                    <!-- Chỉ hiện khi form BOM mở từ màn Xử lý RFQ (modal) —
                         quay đúng wizard đang dở thay vì rơi về form dòng SP. -->
                    <button name="action_back_to_rfq_wizard" type="object"
                            string="← Quay lại Xử lý RFQ"
                            class="oe_highlight"
                            invisible="not show_back_to_rfq"/>
                    <button name="action_create_from_template" type="object"
                            string="Create From BOM Template"
                            invisible="status != 'draft'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_create_bom_template" type="object"
                            string="Tạo BOM mẫu cho nhóm"
                            invisible="not product_id or not line_ids"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_confirm" type="object" string="Xác nhận BOM"
                            class="oe_highlight"
                            invisible="status != 'draft'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_reset_draft" type="object" string="Về nháp"
                            invisible="status != 'confirmed'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_lock" type="object" string="Khóa"
                            invisible="status != 'confirmed'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_create_new_version" type="object"
                            string="Tạo phiên bản mới"
                            invisible="status not in ('confirmed', 'locked')"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_archive" type="object" string="Lưu trữ"
                            class="btn-danger"
                            invisible="status in ('locked', 'archived')"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"
                            confirm="Bạn có chắc muốn lưu trữ BOM này?"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,confirmed,locked"
                           readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã khóa"
                            bg_color="text-bg-warning" invisible="status != 'locked'"/>
                    <widget name="web_ribbon" title="Lưu trữ"
                            bg_color="text-bg-danger" invisible="status != 'archived'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="name != 'New'"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Thông tin BOM">
                            <field name="bom_type"/>
                            <field name="version" readonly="1"/>
                            <field name="product_qty" string="Output Quantity"/>
                        </group>
                        <group string="Sản phẩm">
                            <field name="category_id" readonly="status != 'draft'"
                                   string="Nhóm sản phẩm (lọc)"
                                   help="Chỉ để lọc nhanh Sản phẩm bên dưới, không bắt buộc."/>
                            <field name="product_id" readonly="status != 'draft'"/>
                        </group>
                    </group>

                    <!-- §4a/§4b — Bản vẽ kỹ thuật của sản phẩm ngay trên màn BOM:
                         "Xem bản vẽ" mở dialog xem/tải file; "Tải lên bản vẽ" mở form
                         Bản vẽ (dialog) đã gắn sẵn Sản phẩm. Chỉ nhóm được đọc bản vẽ
                         (Tech/Admin/CEO) mới thấy — tránh AccessError cho BA/Trưởng KD. -->
                    <group string="Bản vẽ kỹ thuật"
                           groups="dl_base.dl_group_tech,dl_base.dl_group_admin,dl_base.dl_group_ceo">
                        <field name="drawing_id" invisible="1"/>
                        <field name="drawing_attachment_id" invisible="1"/>
                        <div colspan="2" class="o_row">
                            <field name="drawing_filename" readonly="1" nolabel="1"
                                   invisible="not drawing_attachment_id"/>
                            <span class="text-muted" invisible="drawing_attachment_id">
                                Sản phẩm chưa có bản vẽ kỹ thuật.
                            </span>
                            <button name="action_view_drawing" type="object"
                                    string="Xem bản vẽ" class="btn-secondary ms-2"
                                    icon="fa-file-image-o"
                                    invisible="not drawing_attachment_id"/>
                            <button name="action_upload_drawing" type="object"
                                    string="Tải lên bản vẽ" class="btn-secondary ms-2"
                                    icon="fa-upload"
                                    invisible="not product_id"/>
                        </div>
                    </group>

                    <notebook>
                        <page string="Dòng BOM" name="bom_lines">
                            <field name="line_ids"
                                   readonly="status in ('locked', 'archived')">
                                <tree string="Dòng BOM">
                                    <field name="material_id"/>
                                    <field name="measurement_type_id" optional="show"/>
                                    <field name="measurement_shape_id" optional="show"/>
                                    <field name="computed_quantity" string="Định mức"/>
                                    <field name="quantity"/>
                                    <field name="complexity_id" optional="show"/>
                                    <field name="waste_rate" string="Hao hụt (%)"/>
                                    <field name="effective_qty" string="SL thực"/>
                                    <field name="uom_id" optional="show"/>
                                </tree>
                                <form string="Dòng BOM" class="dl-bom-line-form">
                                    <field name="shape_code" invisible="1"/>
                                    <div class="row">
                                      <!-- Trái: nhập vật tư / kích thước / định mức cho dòng -->
                                      <div class="col-12 col-lg-7">
                                    <group>
                                        <group string="1. Material">
                                            <field name="material_id"
                                                   options="{'no_quick_create': True}"
                                                   context="{'default_product_kind': 'material'}"/>
                                            <field name="uom_id" readonly="1"/>
                                        </group>
                                        <group string="2-3. Calculation Rule / Shape">
                                            <field name="measurement_type_id"
                                                   options="{'no_create': True, 'no_create_edit': True}"/>
                                            <field name="measurement_shape_id"
                                                   options="{'no_create': True, 'no_create_edit': True}"/>
                                            <field name="measurement_coefficient"
                                                   invisible="shape_code not in ('flat_plate', 'hollow_square_tube', 'hollow_round_tube', 'solid_round_bar', 'solid_square_bar')"/>
                                        </group>
                                    </group>
                                    <group string="4. Kích thước (theo Shape đã chọn)"
                                           invisible="not measurement_shape_id or shape_code not in ('flat_plate', 'hollow_square_tube', 'hollow_round_tube', 'solid_round_bar', 'solid_square_bar', 'area_rectangle', 'area_square', 'area_circle', 'area_triangle', 'perimeter_rectangle', 'perimeter_square', 'perimeter_circle', 'volume_box', 'volume_cube', 'volume_cylinder', 'volume_sphere', 'length_segment')">
                                        <field name="dim_length"
                                               invisible="shape_code in ('area_circle', 'perimeter_circle', 'volume_cylinder', 'area_square', 'perimeter_square', 'volume_cube', 'volume_sphere')"/>
                                        <field name="dim_width"
                                               invisible="shape_code not in ('flat_plate', 'area_rectangle', 'perimeter_rectangle', 'volume_box')"/>
                                        <field name="dim_side"
                                               invisible="shape_code not in ('hollow_square_tube', 'solid_square_bar', 'area_square', 'perimeter_square', 'volume_cube')"/>
                                        <field name="dim_diameter"
                                               invisible="shape_code not in ('hollow_round_tube', 'solid_round_bar', 'area_circle', 'perimeter_circle', 'volume_cylinder', 'volume_sphere')"/>
                                        <field name="dim_thickness"
                                               invisible="shape_code not in ('flat_plate', 'hollow_square_tube', 'hollow_round_tube')"/>
                                        <field name="dim_height"
                                               invisible="shape_code not in ('area_triangle', 'volume_box', 'volume_cylinder')"/>
                                    </group>
                                    <group>
                                        <group string="Kết quả">
                                            <field name="computed_quantity"/>
                                        </group>
                                        <group string="5. Quantity (dùng thực tế — sửa được)">
                                            <field name="quantity"/>
                                            <field name="is_override"/>
                                            <field name="override_reason"
                                                   invisible="not is_override"
                                                   required="is_override"/>
                                        </group>
                                    </group>
                                    <group string="6. Waste">
                                        <field name="complexity_id"/>
                                        <field name="waste_rate"/>
                                        <field name="effective_qty" readonly="1"/>
                                    </group>
                                      </div>
                                      <!-- Phải: bản vẽ kỹ thuật của SP (PDF/ảnh xem trực tiếp).
                                           Chỉ nhóm đọc được bản vẽ (Tech/Admin/CEO) mới nạp —
                                           tránh AccessError cho BA/Trưởng KD. -->
                                      <div class="col-12 col-lg-5"
                                           groups="dl_base.dl_group_tech,dl_base.dl_group_admin,dl_base.dl_group_ceo">
                                          <field name="drawing_mimetype" invisible="1"/>
                                          <field name="drawing_filename" invisible="1"/>
                                          <field name="drawing_attachment_id"
                                                 widget="dl_drawing_preview" nolabel="1"/>
                                      </div>
                                    </div>
                                </form>
                            </field>

                            <group class="oe_subtotal_footer oe_right"
                                   groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager">
                                <field name="total_material_cost"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>

                        <page string="Ghi chú" name="notes">
                            <field name="note" nolabel="1"
                                   placeholder="Ghi chú kỹ thuật..."/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Log/chatter cho quản lý (CEO, Trưởng KD, Admin) và đội sở
                     hữu BOM (Kỹ thuật). -->
                <div class="oe_chatter"
                     groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_admin,dl_base.dl_group_tech">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_dl_bom_search" model="ir.ui.view">
        <field name="name">dl.bom.search</field>
        <field name="model">dl.bom</field>
        <field name="arch" type="xml">
            <search string="Tìm BOM">
                <field name="name"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <separator/>
                <filter name="draft" string="Nháp"
                        domain="[('status', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận"
                        domain="[('status', '=', 'confirmed')]"/>
                <filter name="locked" string="Đã khóa"
                        domain="[('status', '=', 'locked')]"/>
                <filter name="archived" string="Lưu trữ"
                        domain="[('status', '=', 'archived')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_status" string="Trạng thái"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_category" string="Nhóm sản phẩm"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_product" string="Sản phẩm"
                            context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_dl_bom" model="ir.actions.act_window">
        <field name="name">BOM sản phẩm / BTP</field>
        <field name="res_model">dl.bom</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- action_dl_bom_template chuyển sang model dl.bom.template (bom_template_views.xml) -->

</odoo>
