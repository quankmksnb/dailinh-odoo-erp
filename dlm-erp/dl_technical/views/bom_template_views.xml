<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         BOM TEMPLATE (dl.bom.template) — BOM dùng cho Product Group. Cấu
         trúc đầu BOM + workflow version/status giống Product BOM (dl.bom),
         dùng chung qua dl.bom.header.mixin/dl.bom.line.mixin.
    ================================================================ -->

    <record id="view_dl_bom_template_tree" model="ir.ui.view">
        <field name="name">dl.bom.template.tree</field>
        <field name="model">dl.bom.template</field>
        <field name="arch" type="xml">
            <tree string="BOM Template"
                  class="dl-bomtpl-list"
                  js_class="dl_bomtpl_list"
                  decoration-muted="status == 'archived'"
                  decoration-bf="is_current">
                <field name="is_current" column_invisible="1"/>
                <field name="name"/>
                <field name="product_category_id"/>
                <field name="version"/>
                <field name="product_qty" string="Số lượng thành phẩm"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-success="status == 'confirmed'"
                       decoration-warning="status == 'locked'"
                       decoration-muted="status == 'archived'"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_bom_template_form" model="ir.ui.view">
        <field name="name">dl.bom.template.form</field>
        <field name="model">dl.bom.template</field>
        <field name="arch" type="xml">
            <form string="BOM Template" class="dl-bomtpl-form" js_class="dl_bomtpl_form">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận BOM"
                            class="oe_highlight"
                            invisible="status != 'draft'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_reset_draft" type="object" string="Về nháp"
                            invisible="status != 'confirmed'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_lock" type="object" string="Khóa"
                            invisible="status != 'confirmed'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_create_new_version" type="object"
                            string="Tạo phiên bản mới"
                            invisible="status not in ('confirmed', 'locked')"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_archive" type="object" string="Lưu trữ"
                            class="btn-danger"
                            invisible="status == 'archived' or not id"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"
                            confirm="Bạn có chắc muốn lưu trữ BOM mẫu này?"/>
                    <field name="status" widget="dl_stepper"
                           statusbar_visible="draft,confirmed,locked"
                           readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã khóa"
                            bg_color="text-bg-warning" invisible="status != 'locked'"/>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="text-bg-danger"
                            invisible="status != 'archived'"/>
                    <div class="oe_title">
                        <label for="name" string="Tên BOM mẫu"/>
                        <h1><field name="name" placeholder="VD: BOM mẫu Khung thép hàn"/></h1>
                    </div>

                    <group>
                        <group string="Thông tin BOM">
                            <field name="version" readonly="1"/>
                            <field name="is_current" readonly="1"
                                   string="Phiên bản hiện hành"/>
                            <field name="product_qty" string="Số lượng thành phẩm"/>
                            <field name="approved_by" readonly="1"
                                   invisible="not approved_by"/>
                            <field name="approved_date" readonly="1"
                                   invisible="not approved_date"/>
                        </group>
                        <group string="Nhóm sản phẩm">
                            <field name="product_category_id" readonly="status != 'draft'"/>
                            <field name="is_parametric" invisible="1"/>
                            <field name="generic_missing" invisible="1"/>
                            <!-- Sản phẩm dùng chung: đích đến của MỌI kích thước sinh
                                 từ mẫu này. Thiếu nó thì workspace RFQ không dẫn được
                                 Kỹ thuật về SP dùng chung ⇒ mỗi cỡ lại đẻ một mã SP. -->
                            <field name="generic_product_id"
                                   invisible="not is_parametric"
                                   options="{'no_quick_create': True}"
                                   context="{'default_product_kind': 'manufactured',
                                             'default_categ_id': product_category_id}"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert"
                         invisible="not generic_missing">
                        <i class="fa fa-exclamation-triangle me-1" title="Thiếu"/>
                        <b>Mẫu tham số này chưa gán “Sản phẩm dùng chung”.</b>
                        Kỹ thuật xử lý RFQ sẽ không được dẫn về sản phẩm dùng chung,
                        và mỗi kích thước lại đẻ thêm một mã sản phẩm mới. Hãy chọn
                        sản phẩm dùng chung cho mẫu.
                    </div>

                    <notebook>
                        <page string="Dòng BOM" name="lines">
                            <field name="line_ids"
                                   readonly="status in ('locked', 'archived')">
                                <tree string="Dòng mẫu">
                                    <field name="material_id"/>
                                    <!-- Cùng mixin với dòng BOM thật: cut list =
                                         đoạn cắt × số đoạn (xem bom_views.xml). -->
                                    <field name="dim_length" string="Dài đoạn (mm)"/>
                                    <field name="dim_width" string="Rộng (mm)" optional="hide"/>
                                    <field name="piece_count"/>
                                    <field name="computed_quantity" string="Định mức"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" string="Đơn vị tính"/>
                                    <field name="complexity_id" optional="hide"/>
                                    <field name="waste_rate" string="Hao hụt (%)"/>
                                    <field name="effective_qty" string="Số lượng thực"/>
                                    <field name="note" optional="show"/>
                                </tree>
                                <form string="Dòng mẫu">
                                    <!-- Kiểu tính của VẬT TƯ quyết định dòng này hỏi
                                         gì (§13) — không còn quy tắc/hình dạng. -->
                                    <field name="material_calc_kind" invisible="1"/>
                                    <!-- Dùng cho domain param_id của ánh xạ (parent.bom_template_id). -->
                                    <field name="bom_template_id" invisible="1"/>
                                    <group>
                                        <group string="1. Vật tư">
                                            <field name="material_id"
                                                   options="{'no_quick_create': True}"
                                                   context="{'default_product_kind': 'material'}"/>
                                            <field name="uom_id" readonly="1"/>
                                        </group>
                                    </group>

                                    <!-- Vật tư mua-dùng-thẳng (ốc/vít/sơn/que hàn):
                                         không có kích thước nào để suy — nhập tay. -->
                                    <div invisible="material_calc_kind in ('cut_length', 'sheet')">
                                        <div class="text-muted mb-2" invisible="not material_id">
                                            <i class="fa fa-info-circle me-1"/>Vật tư này dùng
                                            thẳng theo đơn vị mua (Cái/Túi/kg/Lít) — nhập trực
                                            tiếp Số lượng bên dưới.
                                        </div>
                                        <group>
                                            <label for="quantity" string="Số lượng"/>
                                            <div class="o_row">
                                                <field name="quantity" nolabel="1"/>
                                                <field name="uom_id" readonly="1" nolabel="1"/>
                                            </div>
                                        </group>
                                    </div>

                                    <div invisible="material_calc_kind not in ('cut_length', 'sheet')">
                                    <group string="2. Kích thước cắt"
                                           invisible="material_calc_kind != 'cut_length'">
                                        <field name="dim_length"/>
                                        <field name="piece_count"/>
                                    </group>
                                    <group string="2. Kích thước tấm"
                                           invisible="material_calc_kind != 'sheet'">
                                        <field name="dim_length" string="Chiều dài (mm)"/>
                                        <field name="dim_width"/>
                                        <field name="piece_count" string="Số tấm"/>
                                    </group>
                                    <group>
                                        <group string="Kết quả">
                                            <label for="computed_quantity" string="Định mức"/>
                                            <div class="o_row">
                                                <field name="computed_quantity" nolabel="1"/>
                                                <field name="uom_id" readonly="1" nolabel="1"/>
                                            </div>
                                            <div class="text-muted" style="font-size:11px;"
                                                 colspan="2"
                                                 invisible="material_calc_kind != 'cut_length'">
                                                = (Chiều dài đoạn × Số đoạn) ÷ chiều dài cây
                                                khai ở vật tư.
                                            </div>
                                            <div class="text-muted" style="font-size:11px;"
                                                 colspan="2"
                                                 invisible="material_calc_kind != 'sheet'">
                                                = (Dài × Rộng × Số tấm) ÷ khổ tấm khai ở vật tư.
                                            </div>
                                        </group>
                                        <group string="3. Số lượng (dùng thực tế)">
                                            <label for="quantity" string="Số lượng"/>
                                            <div class="o_row">
                                                <field name="quantity" nolabel="1"
                                                       readonly="not is_override"/>
                                                <field name="uom_id" readonly="1" nolabel="1"/>
                                            </div>
                                            <field name="is_override"/>
                                            <field name="override_reason"
                                                   invisible="not is_override"
                                                   required="is_override"/>
                                        </group>
                                    </group>
                                    </div>

                                    <group string="4. Hao hụt">
                                        <field name="complexity_id"/>
                                        <field name="waste_rate"/>
                                        <field name="effective_qty" readonly="1"/>
                                    </group>

                                    <!-- Đợt 4 — ánh xạ tham số sản phẩm (D/R/C) vào ô kích
                                         thước của dòng này: giá trị = hệ số × tham số + cộng
                                         thêm. Ô không có ánh xạ giữ giá trị cứng ở trên. -->
                                    <group string="Ánh xạ tham số → kích thước (sinh định mức)">
                                        <div colspan="2" class="text-muted small mb-1">
                                            <i class="fa fa-info-circle me-1"/>Khai tham số ở tab
                                            "Tham số" của BOM mẫu trước. Ví dụ 4 chân bàn cao C:
                                            ánh xạ "Chiều dài đoạn" ← tham số C (hệ số 1) và đặt
                                            <b>Số đoạn = 4</b> — đừng nhân 4 vào chiều dài, vì
                                            như vậy mất cut list của xưởng.
                                        </div>
                                        <field name="param_map_ids" nolabel="1" colspan="2">
                                            <tree editable="bottom">
                                                <field name="target_field"/>
                                                <field name="param_id"
                                                       domain="[('bom_template_id', '=', parent.bom_template_id)]"
                                                       options="{'no_create': True, 'no_open': True}"/>
                                                <field name="factor"/>
                                                <field name="offset"/>
                                            </tree>
                                        </field>
                                    </group>

                                    <group>
                                        <field name="note"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Tham số (sinh định mức)" name="params">
                            <div class="text-muted mb-2">
                                <i class="fa fa-magic me-1"/>Khai các tham số CẤP SẢN PHẨM
                                (vd Dài D, Rộng R, Cao C). Khi xử lý một đơn, KTV nhập các
                                giá trị này một lần; hệ thống suy kích thước từng dòng vật tư
                                qua ánh xạ ở tab "Dòng BOM".
                            </div>
                            <field name="param_ids"
                                   readonly="status in ('locked', 'archived')">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="dim_role"/>
                                    <field name="default_value"/>
                                    <field name="value_min"/>
                                    <field name="value_max"/>
                                    <field name="required"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Log/chatter cho quản lý (CEO, Trưởng KD, Admin) và đội sở
                     hữu BOM mẫu (Kỹ thuật). -->
                <div class="oe_chatter"
                     groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_admin,dl_base.dl_group_tech">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_bom_template_search" model="ir.ui.view">
        <field name="name">dl.bom.template.search</field>
        <field name="model">dl.bom.template</field>
        <field name="arch" type="xml">
            <search string="Tìm BOM mẫu">
                <field name="name"/>
                <field name="product_category_id"/>
                <separator/>
                <filter name="draft" string="Nháp" domain="[('status', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận" domain="[('status', '=', 'confirmed')]"/>
                <filter name="locked" string="Đã khóa" domain="[('status', '=', 'locked')]"/>
                <filter name="archived" string="Lưu trữ" domain="[('status', '=', 'archived')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_category" string="Nhóm sản phẩm"
                            context="{'group_by': 'product_category_id'}"/>
                    <filter name="group_status" string="Trạng thái"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_bom_template" model="ir.actions.act_window">
        <field name="name">BOM mẫu</field>
        <field name="res_model">dl.bom.template</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm BOM mẫu đầu tiên!</p>
        </field>
    </record>

</odoo>
