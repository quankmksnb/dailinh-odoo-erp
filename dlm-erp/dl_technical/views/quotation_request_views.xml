<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         YÊU CẦU BÁO GIÁ — D1 (dl.quotation.request, header) + D2 (line)
         status new/processing/confirmed = COMPUTED từ dòng D2 (readonly).
    ================================================================ -->

    <!-- Tree view -->
    <record id="view_dl_quotation_request_tree" model="ir.ui.view">
        <field name="name">dl.quotation.request.tree</field>
        <field name="model">dl.quotation.request</field>
        <field name="arch" type="xml">
            <tree string="Yêu cầu báo giá"
                  class="dl-rfq-list" js_class="dl_rfq_list"
                  decoration-muted="status in ('cancelled', 'quoted')">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="requested_date" widget="date"/>
                <field name="deadline" widget="date"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'new'"
                       decoration-warning="status in ('processing', 'supplemented')"
                       decoration-danger="status == 'returned'"
                       decoration-success="status == 'confirmed'"
                       decoration-muted="status in ('quoted', 'cancelled')"/>
                <!-- Modal lịch sử RFQ (timeline chỉ đọc) — tree "RFQ cần xử lý"
                     kế thừa tree này nên cả 2 màn Sales & Kỹ thuật cùng có. -->
                <button name="action_open_history" type="object" string="Lịch sử"
                        class="btn-link"/>
            </tree>
        </field>
    </record>

    <!-- Tree view riêng cho "RFQ cần xử lý" (Kỹ thuật) — không tạo mới ở đây
         (chỉ tạo qua "Tạo RFQ" của Sales), có thêm cột Product/BOM Reference. -->
    <record id="view_dl_quotation_request_tree_my" model="ir.ui.view">
        <field name="name">dl.quotation.request.tree.my</field>
        <field name="model">dl.quotation.request</field>
        <field name="inherit_id" ref="view_dl_quotation_request_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="class">dl-rfq-list dl-rfq-list-my</attribute>
                <!-- js_class riêng: chặn mở chi tiết RFQ chưa nhận (Mới/Đã bổ
                     sung) — chỉ áp dụng màn Kỹ thuật này, list Sales mở tự do. -->
                <attribute name="js_class">dl_rfq_list_my</attribute>
            </xpath>
            <xpath expr="//field[@name='status']" position="after">
                <field name="resolved_product_ids" widget="many2many_tags" string="Product Reference"/>
                <field name="resolved_bom_ids" widget="many2many_tags" string="BOM Reference"/>
                <!-- §3d — KTV nhận RFQ ngay trên list: Mới/Đã bổ sung → Đang
                     xử lý, sau đó mới mở được chi tiết. KHÔNG đặt icon (button
                     list có icon sẽ chỉ hiện icon, chữ thành tooltip). -->
                <button name="action_receive" type="object" string="Nhận RFQ"
                        class="btn-link"
                        invisible="status not in ('new', 'supplemented')"
                        groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
            </xpath>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_dl_quotation_request_form" model="ir.ui.view">
        <field name="name">dl.quotation.request.form</field>
        <field name="model">dl.quotation.request</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu báo giá" class="dl-rfq-form" js_class="dl_rfq_form">
                <header>
                    <!-- Nút "Nhận RFQ" đã chuyển ra LIST (từng dòng) — KTV phải
                         nhận trên list thì mới mở được chi tiết RFQ. -->
                    <!-- Kỹ thuật trả RFQ về Sales bổ sung (thiếu thông tin) -->
                    <button name="action_open_return_wizard" type="object"
                            string="Gửi lại Sales (bổ sung)"
                            invisible="status in ('returned', 'quoted', 'cancelled')"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <!-- Sales gửi lại sau khi đã bổ sung -->
                    <button name="action_resubmit" type="object"
                            string="Gửi lại (đã bổ sung)" class="oe_highlight"
                            invisible="status != 'returned'"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"/>
                    <!-- Sale đánh dấu đã tạo báo giá (tạm thời thủ công, xem
                         docstring model — D3 chưa có quotation_request_id) -->
                    <button name="action_mark_quoted" type="object"
                            string="Đánh dấu đã tạo báo giá" class="oe_highlight"
                            invisible="status != 'confirmed'"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"/>
                    <!-- Hủy: chỉ Sale/Trưởng KD/CEO/Admin — Kỹ thuật KHÔNG có quyền -->
                    <button name="action_cancel" type="object"
                            string="Hủy"
                            invisible="status in ('quoted', 'cancelled')"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_ceo,dl_base.dl_group_admin"
                            confirm="Bạn có chắc muốn hủy RFQ này?"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,processing,returned,supplemented,confirmed,quoted"
                           readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã hủy"
                            bg_color="text-bg-danger" invisible="status != 'cancelled'"/>
                    <widget name="web_ribbon" title="Đã tạo báo giá"
                            bg_color="text-bg-success" invisible="status != 'quoted'"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="status != 'returned'">
                        <strong>Đã trả lại Sales để bổ sung:</strong>
                        <field name="return_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Thông tin yêu cầu">
                            <field name="customer_id" readonly="status != 'new'"
                                options="{'no_quick_create': True}"
                                context="{'default_partner_role': 'customer', 'default_partner_type': 'company', 'form_view_ref': 'dl_partner.view_dl_customer_form'}"/>
                            <field name="requested_date" readonly="status != 'new'"/>
                            <field name="deadline"/>
                            <field name="created_by"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Dòng sản phẩm" name="lines">
                            <field name="line_ids"
                                   readonly="status in ('quoted', 'cancelled')">
                                <!-- §3a — tree KHÔNG editable: click 1 dòng mở form
                                     con dạng dialog (dễ quan sát/xử lý). -->
                                <tree string="Dòng sản phẩm">
                                    <field name="is_technician" column_invisible="1"/>
                                    <field name="product_type"/>
                                    <field name="product_name" required="1"/>
                                    <field name="product_category_id"/>
                                    <field name="quantity"/>
                                    <field name="dimension_note" optional="show"/>
                                    <field name="reference_product_id" string="SP tham khảo"
                                           optional="show"/>
                                    <field name="preview_image" widget="image"
                                           options="{'size': [40, 40]}" string="Ảnh" optional="show"/>
                                    <field name="resolvable_product_ids" column_invisible="1"/>
                                    <field name="resolved_product_id" string="Product Reference"
                                           readonly="not is_technician"
                                           domain="[('id', 'in', resolvable_product_ids)]"
                                           context="{'form_view_ref': 'dl_product.view_dl_product_tech_form', 'default_product_kind': 'manufactured', 'default_dlm_lifecycle_state': 'draft', 'default_categ_id': product_category_id, 'default_name': product_name}"/>
                                    <field name="resolved_bom_id" string="BOM Reference"
                                           readonly="not is_technician"
                                           domain="[('product_id', '=', resolved_product_id)]"/>
                                    <field name="is_infeasible" readonly="not is_technician"/>
                                    <field name="infeasible_reason"
                                           invisible="not is_infeasible"
                                           readonly="not is_technician" optional="show"/>
                                    <!-- §gộp màn — mở thẳng màn Xử lý RFQ (1 dialog
                                         duy nhất) từ dòng, khỏi qua form dòng trước. -->
                                    <button name="action_open_resolve_wizard" type="object"
                                            string="Xử lý RFQ" icon="fa-cogs"
                                            class="btn-link"
                                            invisible="is_infeasible or product_type == 'trading'"
                                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                                </tree>
                                <form string="Dòng sản phẩm" class="dl-rfq-line-detail">
                                    <field name="is_technician" invisible="1"/>
                                    <field name="product_type" invisible="1"/>
                                    <field name="selectable_category_ids" invisible="1"/>
                                    <field name="reference_product_ids" invisible="1"/>
                                    <field name="resolvable_product_ids" invisible="1"/>
                                    <header>
                                        <button name="action_open_resolve_wizard" type="object"
                                                string="Xử lý RFQ" icon="fa-cogs"
                                                class="oe_highlight"
                                                invisible="not id or is_infeasible or product_type == 'trading'"
                                                groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                                    </header>
                                    <sheet>
                                        <widget name="web_ribbon" title="Không khả thi"
                                                bg_color="text-bg-danger"
                                                invisible="not is_infeasible"/>
                                        <widget name="web_ribbon" title="Đã xử lý"
                                                bg_color="text-bg-success"
                                                invisible="is_infeasible or not resolved_product_id"/>
                                        <div class="oe_title">
                                            <label for="product_name" string="Tên sản phẩm"/>
                                            <h2>
                                                <field name="product_name" required="1"
                                                       placeholder="Tên sản phẩm..."/>
                                            </h2>
                                        </div>
                                        <group>
                                            <group string="Yêu cầu (Sales)">
                                                <field name="product_category_id"
                                                       domain="[('id', 'in', selectable_category_ids)]"/>
                                                <field name="reference_product_id"
                                                       string="Sản phẩm tham khảo"
                                                       options="{'no_create': True}"
                                                       domain="[('id', 'in', reference_product_ids)]"
                                                       invisible="product_type == 'trading'"/>
                                                <field name="quantity"/>
                                            </group>
                                            <group string="Kết quả xử lý (Kỹ thuật)">
                                                <div colspan="2" class="text-muted"
                                                     invisible="is_infeasible or resolved_product_id or product_type == 'trading'">
                                                    <i class="fa fa-info-circle me-1"/>Chưa xử lý — bấm
                                                    <b>Xử lý RFQ</b> để chọn/tạo Sản phẩm &amp; BOM.
                                                </div>
                                                <field name="resolved_product_id" string="Sản phẩm xác định"
                                                       invisible="is_infeasible"
                                                       readonly="not is_technician"
                                                       domain="[('id', 'in', resolvable_product_ids)]"
                                                       context="{'form_view_ref': 'dl_product.view_dl_product_tech_form', 'default_product_kind': 'manufactured', 'default_dlm_lifecycle_state': 'draft', 'default_categ_id': product_category_id, 'default_name': product_name}"/>
                                                <field name="resolved_bom_id" string="BOM"
                                                       invisible="is_infeasible"
                                                       readonly="not is_technician"
                                                       domain="[('product_id', '=', resolved_product_id)]"/>
                                                <field name="is_infeasible" readonly="not is_technician"/>
                                                <field name="infeasible_reason"
                                                       invisible="not is_infeasible"
                                                       required="is_infeasible"
                                                       readonly="not is_technician"/>
                                            </group>
                                        </group>
                                        <separator string="Yêu cầu / Mô tả"/>
                                        <field name="dimension_note" nolabel="1"
                                               class="dl-rfq-desc"
                                               placeholder="Kích thước, yêu cầu kỹ thuật..."/>
                                        <!-- §1d — Ảnh & file đính kèm gộp chung 1 trường
                                             (many2many_binary hiển thị cả thumbnail ảnh lẫn
                                             file). Sales bổ sung được khi RFQ bị trả lại. -->
                                        <separator string="Ảnh / File đính kèm"
                                                   invisible="product_type == 'trading'"/>
                                        <field name="attachment_ids" widget="many2many_binary"
                                               nolabel="1"
                                               invisible="product_type == 'trading'"/>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Ghi chú" name="notes">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Ghi chú tổng thể: hẹn nhận hàng, điều khoản thanh toán..."/>
                            </group>
                            <group string="Ghi chú nội bộ">
                                <field name="note" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Log/chatter cho quản lý (CEO, Trưởng KD, Admin) và đội sở
                     hữu RFQ (BA + Kỹ thuật cùng cộng tác). -->
                <div class="oe_chatter"
                     groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_tech">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================
         TẠO RFQ (Sales) — màn tạo mới, tách riêng khỏi form cũ ở trên (form cũ
         vẫn giữ nguyên cho Kỹ thuật xử lý RFQ, không đổi).
         Mỗi dòng tự chọn product_type: "Sản phẩm thương mại" (chọn thẳng
         Product có sẵn, không qua BOM) hoặc "Sản phẩm gia công" (chỉ nhập tên/
         mô tả/số lượng, Product/Nhóm sản phẩm chỉ tham khảo, Kỹ thuật xử lý
         sau) — §2-6 màn Tạo RFQ.
    ================================================================ -->
    <record id="view_dl_quotation_request_sales_form" model="ir.ui.view">
        <field name="name">dl.quotation.request.sales.form</field>
        <field name="model">dl.quotation.request</field>
        <field name="arch" type="xml">
            <form string="Tạo RFQ" class="dl-rfq-form" js_class="dl_rfq_form">
                <header>
                    <button name="action_resubmit" type="object"
                            string="Gửi lại (đã bổ sung)" class="oe_highlight"
                            invisible="status != 'returned'"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"/>
                    <button name="action_mark_quoted" type="object"
                            string="Đánh dấu đã tạo báo giá" class="oe_highlight"
                            invisible="status != 'confirmed'"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"/>
                    <button name="action_cancel" type="object"
                            string="Hủy"
                            invisible="status in ('quoted', 'cancelled')"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_ceo,dl_base.dl_group_admin"
                            confirm="Bạn có chắc muốn hủy RFQ này?"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,processing,returned,supplemented,confirmed,quoted"
                           readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã hủy"
                            bg_color="text-bg-danger" invisible="status != 'cancelled'"/>
                    <widget name="web_ribbon" title="Đã tạo báo giá"
                            bg_color="text-bg-success" invisible="status != 'quoted'"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="status != 'returned'">
                        <strong>Kỹ thuật trả lại để bổ sung:</strong>
                        <field name="return_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Thông tin yêu cầu">
                            <field name="customer_id" readonly="status != 'new'"
                                options="{'no_quick_create': True}"
                                context="{'default_partner_role': 'customer', 'default_partner_type': 'company', 'form_view_ref': 'dl_partner.view_dl_customer_form'}"/>
                            <field name="requested_date" readonly="status != 'new'"/>
                            <field name="deadline"/>
                            <field name="created_by"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Dòng sản phẩm" name="lines">
                            <!-- BẢNG 1: Sản phẩm thương mại (chọn thẳng, có giá) -->
                            <separator string="Sản phẩm thương mại"/>
                            <field name="trading_line_ids"
                                   readonly="status in ('quoted', 'cancelled')">
                                <tree string="Sản phẩm thương mại" editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_type" column_invisible="1"/>
                                    <field name="resolved_product_id" string="Sản phẩm"
                                           required="1"
                                           options="{'no_create': True}"
                                           domain="[('product_kind', '=', 'trading'), ('dlm_lifecycle_state', '=', 'active')]"/>
                                    <field name="product_price" string="Đơn giá"
                                           widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="quantity" string="Số lượng"/>
                                    <field name="price_subtotal" string="Thành tiền"
                                           widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </tree>
                            </field>

                            <!-- BẢNG 2: Sản phẩm gia công (mô tả + ảnh + file) -->
                            <separator string="Sản phẩm gia công"/>
                            <field name="manufactured_line_ids"
                                   readonly="status in ('quoted', 'cancelled')">
                                <tree string="Sản phẩm gia công">
                                    <field name="product_type" column_invisible="1"/>
                                    <field name="product_name" string="Tên sản phẩm"/>
                                    <field name="product_category_id" string="Nhóm sản phẩm"/>
                                    <field name="reference_product_id" string="Sản phẩm tham khảo"/>
                                    <field name="quantity" string="Số lượng"/>
                                    <field name="dimension_note" string="Mô tả"/>
                                    <!-- §2b — hiện thumbnail ảnh thay vì số lượng -->
                                    <field name="preview_image" widget="image"
                                           options="{'size': [40, 40]}" string="Ảnh"/>
                                </tree>
                                <form string="Sản phẩm gia công">
                                    <field name="product_type" invisible="1"/>
                                    <field name="selectable_category_ids" invisible="1"/>
                                    <field name="reference_product_ids" invisible="1"/>
                                    <group>
                                        <group string="Thông tin">
                                            <field name="product_name" required="1"/>
                                            <!-- §1a — chỉ nhóm SP gia công -->
                                            <field name="product_category_id"
                                                   options="{'no_create': True}"
                                                   domain="[('id', 'in', selectable_category_ids)]"/>
                                            <!-- §1b — SP tham khảo lọc theo nhóm đã chọn -->
                                            <field name="reference_product_id"
                                                   options="{'no_create': True}"
                                                   domain="[('id', 'in', reference_product_ids)]"/>
                                            <field name="quantity"/>
                                        </group>
                                    </group>
                                    <!-- §1c — ô Yêu cầu/Mô tả để rộng & cao hơn -->
                                    <separator string="Yêu cầu / Mô tả"/>
                                    <field name="dimension_note" nolabel="1"
                                           class="dl-rfq-desc"
                                           placeholder="Kích thước, yêu cầu kỹ thuật..."/>
                                    <!-- §1d — Ảnh & file đính kèm gộp chung 1 trường -->
                                    <separator string="Ảnh / File đính kèm"/>
                                    <field name="attachment_ids" widget="many2many_binary"
                                           nolabel="1"/>
                                </form>
                            </field>
                        </page>

                        <page string="Ghi chú" name="notes">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Ghi chú tổng thể: hẹn nhận hàng, điều khoản thanh toán..."/>
                            </group>
                            <group string="Ghi chú nội bộ">
                                <field name="note" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Log/chatter cho quản lý (CEO, Trưởng KD, Admin) và đội sở
                     hữu RFQ (BA + Kỹ thuật cùng cộng tác). -->
                <div class="oe_chatter"
                     groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_tech">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_dl_quotation_request_search" model="ir.ui.view">
        <field name="name">dl.quotation.request.search</field>
        <field name="model">dl.quotation.request</field>
        <field name="arch" type="xml">
            <search string="Tìm yêu cầu báo giá">
                <field name="name"/>
                <field name="customer_id"/>
                <separator/>
                <filter name="new" string="Mới"
                        domain="[('status', '=', 'new')]"/>
                <filter name="processing" string="Đang xử lý"
                        domain="[('status', '=', 'processing')]"/>
                <filter name="supplemented" string="Đã bổ sung"
                        domain="[('status', '=', 'supplemented')]"/>
                <filter name="confirmed" string="Chờ báo giá"
                        domain="[('status', '=', 'confirmed')]"/>
                <filter name="quoted" string="Đã tạo BG"
                        domain="[('status', '=', 'quoted')]"/>
                <separator/>
                <filter name="overdue" string="Quá hạn"
                        domain="[('deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('status', 'not in', ('quoted', 'cancelled'))]"/>
                <filter name="to_process" string="Cần Kỹ thuật xử lý"
                        domain="[('status', 'in', ('new', 'processing', 'supplemented'))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_status" string="Trạng thái"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_customer" string="Khách hàng"
                            context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dl_quotation_request" model="ir.actions.act_window">
        <field name="name">Yêu cầu báo giá</field>
        <field name="res_model">dl.quotation.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_new': 1, 'search_default_processing': 1, 'search_default_supplemented': 1}</field>
