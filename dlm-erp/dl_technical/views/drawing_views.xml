<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         BẢN VẼ KỸ THUẬT (dl.drawing)
    ================================================================ -->

    <record id="view_dl_drawing_tree" model="ir.ui.view">
        <field name="name">dl.drawing.tree</field>
        <field name="model">dl.drawing</field>
        <field name="arch" type="xml">
            <tree string="Bản vẽ kỹ thuật"
                  class="dl-drawing-list" js_class="dl_drawing_list"
                  decoration-muted="status == 'archived'"
                  decoration-bf="is_current">
                <field name="is_current" column_invisible="1"/>
                <field name="drawing_code"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="version"/>
                <field name="is_current" widget="boolean_toggle" string="Hiện hành"
                       readonly="1" optional="show"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-success="status == 'confirmed'"
                       decoration-muted="status == 'archived'"/>
                <field name="confirmed_date"/>
                <field name="created_by"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_drawing_form" model="ir.ui.view">
        <field name="name">dl.drawing.form</field>
        <field name="model">dl.drawing</field>
        <field name="arch" type="xml">
            <form string="Bản vẽ kỹ thuật" class="dl-drawing-form" js_class="dl_drawing_form">
                <header>
                    <!-- 1 CTA chính/trạng thái + Lưu trữ TRUNG TÍNH (review UX
                         drawing #f2): archive không xóa dữ liệu nên không dùng
                         màu đỏ nguy hiểm. -->
                    <button name="action_confirm" type="object" string="Xác nhận"
                            class="btn-primary"
                            invisible="status != 'draft'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_reset_draft" type="object" string="Về nháp"
                            class="btn-secondary"
                            invisible="status != 'confirmed'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_archive" type="object" string="Lưu trữ"
                            class="btn-secondary"
                            invisible="status == 'archived' or not id"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <field name="status" widget="dl_stepper"
                           statusbar_visible="draft,confirmed,archived" readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Lưu trữ"
                            bg_color="text-bg-secondary" invisible="status != 'archived'"/>
                    <widget name="web_ribbon" title="Hiện hành"
                            bg_color="text-bg-success" invisible="not is_current"/>
                    <field name="is_current" invisible="1"/>
                    <div class="oe_title">
                        <label for="drawing_code"/>
                        <h1>
                            <field name="drawing_code" placeholder="Mã bản vẽ..."
                                   readonly="drawing_code != 'New'"/>
                        </h1>
                        <label for="name"/>
                        <h2>
                            <field name="name" placeholder="Tên bản vẽ..."/>
                        </h2>
                    </div>
                    <!-- Bản vẽ là NỘI DUNG CHÍNH (review UX drawing #f1): đưa file
                         lên đầu, thông tin phụ xuống dưới. -->
                    <group string="File bản vẽ">
                        <field name="attachment_id" nolabel="1" colspan="2"
                               widget="dl_drawing_upload"/>
                    </group>
                    <group>
                        <group string="Thông tin">
                            <field name="product_id"/>
                            <field name="version"/>
                            <field name="created_by"/>
                        </group>
                        <group string="Xác nhận">
                            <field name="confirmed_date"/>
                        </group>
                    </group>
                </sheet>
                <!-- Log/chatter cho quản lý (CEO, Admin) và đội sở hữu bản vẽ
                     (Kỹ thuật) — Trưởng KD không có quyền đọc bản vẽ. -->
                <div class="oe_chatter"
                     groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_tech">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_drawing_search" model="ir.ui.view">
        <field name="name">dl.drawing.search</field>
        <field name="model">dl.drawing</field>
        <field name="arch" type="xml">
            <search string="Tìm bản vẽ">
                <field name="drawing_code" string="Tìm nhanh"
                       filter_domain="['|', '|', ('drawing_code', 'ilike', self), ('name', 'ilike', self), ('product_id', 'ilike', self)]"/>
                <field name="name"/>
                <field name="product_id"/>
                <filter name="draft" string="Nháp" domain="[('status', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận" domain="[('status', '=', 'confirmed')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_product" string="Sản phẩm"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_status" string="Trạng thái"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_drawing" model="ir.actions.act_window">
        <field name="name">Bản vẽ kỹ thuật</field>
        <field name="res_model">dl.drawing</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
    </record>

</odoo>
