<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Kế thừa form sản phẩm (PROD-02, product.product) — nối "BOM liên
         quan" vào đúng chỗ placeholder của dl_product.
         Data Model refactor: model nay là product.product (mở rộng thuần),
         không còn dl.product. Nhóm "Cung ứng (supply_type/purchase_cost...)"
         cũ đã bỏ theo Data Model — chỉ giữ phần bom_ids.
    ================================================================ -->

    <record id="view_dl_product_form_inherit_bom" model="ir.ui.view">
        <field name="name">product.product.form.inherit.bom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="dl_product.view_dl_product_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <field name="is_rfq_provisional" invisible="1"/>
                <widget name="web_ribbon" title="Tạm từ RFQ"
                        bg_color="text-bg-info" invisible="not is_rfq_provisional"/>
                <div class="alert alert-info" role="status"
                     invisible="not is_rfq_provisional">
                    Sản phẩm này đang được giữ tạm cho một dòng RFQ chưa hoàn tất.
                    <field name="rfq_source_line_id" readonly="1"/>
                </div>
            </xpath>
            <!-- S05 · Thuộc tính kỹ thuật (Đợt 2, §3.6) — nền cho bộ dò khớp SP
                 "đã từng gia công": có D/R/C + vật liệu + độ dày thì engine so
                 số-với-số. Chỉ SP gia công / bán thành phẩm. -->
            <xpath expr="//page[@name='boms']" position="before">
                <page string="Thuộc tính kỹ thuật" name="tech_attrs"
                      groups="dl_base.dl_group_admin,dl_base.dl_group_tech,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager"
                      invisible="product_kind not in ('manufactured', 'material_processed')">
                    <group>
                        <group string="Kích thước bao (mm)">
                            <field name="dlm_dim_length"/>
                            <field name="dlm_dim_width"/>
                            <field name="dlm_dim_height"/>
                            <field name="dlm_thickness"/>
                        </group>
                        <group string="Vật liệu &amp; hoàn thiện">
                            <field name="dlm_main_material_id"
                                   options="{'no_create': True}"/>
                            <field name="dlm_finish"/>
                            <field name="dlm_est_weight"/>
                        </group>
                    </group>
                    <div class="text-muted small">
                        <i class="fa fa-info-circle me-1"/>
                        Thuộc tính này giúp hệ thống gợi ý lại đúng sản phẩm khi có
                        yêu cầu tương tự (so khớp kích thước / vật liệu / nhóm).
                    </div>
                </page>
            </xpath>
            <xpath expr="//page[@name='boms']/div" position="replace">
                <!-- bom_ids là computed field (chỉ đọc) — không hỗ trợ "Add a
                     line" trực tiếp. Dùng nút bên dưới để tạo BOM mới. -->
                <button name="action_create_bom" type="object"
                        string="+ Tạo BOM"
                        class="btn-secondary mb-2"
                        groups="dl_base.dl_group_admin,dl_base.dl_group_tech"/>
                <!-- Hai TRỤC khác nhau, không được trộn một bảng: định mức chuẩn
                     nối tiếp theo thời gian (một bản hiện hành thay bản cũ) còn
                     định mức theo đơn tồn tại song song (mỗi cấu hình một bản). -->
                <separator string="Định mức chuẩn của sản phẩm"/>
                <div class="text-muted small mb-2">
                    Cách làm chuẩn, dùng cho mọi đơn. Bản mới <b>thay thế</b> bản cũ —
                    một thời điểm chỉ một bản hiện hành.
                </div>
                <field name="standard_bom_ids" nolabel="1">
                    <tree string="Định mức chuẩn">
                        <field name="name"/>
                        <field name="version_label" string="Phiên bản"/>
                        <field name="is_current" widget="boolean_toggle"
                               string="Hiện hành" readonly="1"/>
                        <field name="status" widget="badge"/>
                        <field name="total_material_cost"
                               groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant"/>
                    </tree>
                </field>

                <separator string="Định mức theo đơn"
                           invisible="not instance_bom_ids"/>
                <div class="text-muted small mb-2" invisible="not instance_bom_ids">
                    Mỗi cấu hình (kích thước) của một đơn. Các bản <b>tồn tại song song</b>,
                    không bản nào thay thế bản nào.
                </div>
                <field name="instance_bom_ids" nolabel="1"
                       invisible="not instance_bom_ids">
                    <tree string="Định mức theo đơn">
                        <field name="name"/>
                        <field name="version_label" string="Lần sinh"/>
                        <field name="param_display" string="Tham số"/>
                        <field name="status" widget="badge"/>
                        <field name="total_material_cost"
                               groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>

    <!-- Dữ liệu tạm chỉ được mở qua RFQ nguồn, không lẫn vào danh mục chính. -->
    <record id="dl_product.action_dl_product_full" model="ir.actions.act_window">
        <field name="domain">[('product_kind', 'in', ['manufactured', 'trading']), ('is_rfq_provisional', '=', False)]</field>
    </record>
    <record id="dl_product.action_dl_product_tech" model="ir.actions.act_window">
        <field name="domain">[('product_kind', 'in', ['manufactured', 'trading']), ('is_rfq_provisional', '=', False)]</field>
    </record>
    <record id="dl_product.action_dl_product_view" model="ir.actions.act_window">
        <field name="domain">[('product_kind', 'in', ['manufactured', 'trading']), ('is_rfq_provisional', '=', False)]</field>
    </record>

</odoo>
