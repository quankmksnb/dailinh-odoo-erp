<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_dlm_material" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dlm.material</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Vật tư" string="Vật tư" name="dlm_material">
                    <block title="Bảng giá Vật tư" name="dlm_material_pricing_setting_container">
                        <setting id="dlm_material_expiry_warning_setting"
                                 string="Ngưỡng cảnh báo hết hạn giá"
                                 help="Số ngày cảnh báo trước/sau khi giá vật tư hết hạn">
                            <field name="dlm_material_expiry_warning_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_dlm_material_settings" model="ir.actions.act_window">
        <field name="name">Cấu hình Vật tư</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'dlm_material'}</field>
    </record>

    <!-- Cộng thêm Kế toán nội bộ vào menu Cấu hình sẵn có của dl_base (không xóa nhóm cũ) -->
    <record id="dl_base.menu_dl_config" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('dl_base.dl_group_accountant'))]"/>
    </record>

</odoo>
