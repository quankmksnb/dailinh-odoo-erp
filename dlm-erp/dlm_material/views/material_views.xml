<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         DANH MỤC VẬT TƯ (dl.material)
    ================================================================ -->

    <!-- List view -->
    <record id="view_dl_material_tree" model="ir.ui.view">
        <field name="name">dlm.material.tree</field>
        <field name="model">dl.material</field>
        <field name="arch" type="xml">
            <tree string="Danh mục Vật tư" class="dl-material-list" js_class="dl_material_list"
                  decoration-muted="status == 'discontinued'">
                <field name="code" string="Mã VT"/>
                <field name="name" string="Tên vật tư"/>
                <field name="category" string="Nhóm vật tư"/>
                <field name="unit" string="ĐVT"/>
                <field name="status" string="Trạng thái" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-success="status == 'active'"
                       decoration-muted="status == 'discontinued'"/>
                <field name="price_status" string="Tình trạng giá" widget="badge"
                       decoration-success="price_status == 'ok'"
                       decoration-warning="price_status == 'warning'"
                       decoration-danger="price_status == 'expired'"
                       decoration-muted="price_status == 'none'"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_dl_material_form" model="ir.ui.view">
        <field name="name">dlm.material.form</field>
        <field name="model">dl.material</field>
        <field name="arch" type="xml">
            <form string="Vật tư" class="dl-material-form" js_class="dl_material_form">
                <header>
                    <button name="action_activate" type="object" string="Kích hoạt"
                            class="oe_highlight" groups="dl_base.dl_group_accountant"
                            invisible="status == 'active'"/>
                    <button name="action_discontinue" type="object" string="Ngừng dùng"
                            groups="dl_base.dl_group_accountant"
                            invisible="status != 'active'"/>
                    <button name="action_new_price" type="object" string="Cập nhật giá mới"
                            class="oe_highlight" groups="dl_base.dl_group_accountant"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,discontinued"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" placeholder="Mã vật tư..."/>
                        </h1>
                        <label for="name"/>
                        <h2>
                            <field name="name" placeholder="Tên vật tư..."/>
                        </h2>
                    </div>
                    <field name="is_technician" invisible="1"/>
                    <group>
                        <group string="Thông tin chung">
                            <field name="category"/>
                            <field name="unit"/>
                        </group>
                        <group string="Tình trạng giá"
                               groups="dl_base.dl_group_ceo,dl_base.dl_group_accountant">
                            <field name="active_price_id"/>
                            <field name="has_active_price"/>
                            <field name="price_status" widget="badge"
                                   decoration-danger="price_status == 'expired'"
                                   decoration-warning="price_status == 'warning'"
                                   decoration-success="price_status == 'ok'"/>
                        </group>
                    </group>
                    <group string="Thông số kỹ thuật">
                        <field name="technical_spec" nolabel="1" readonly="not is_technician"
                               placeholder="Mác thép, độ dày, quy cách..."/>
                    </group>
                    <notebook>
                        <page string="Lịch sử giá" name="price_history"
                              groups="dl_base.dl_group_ceo,dl_base.dl_group_accountant">
                            <field name="price_ids">
                                <tree decoration-danger="status == 'expired'"
                                      decoration-muted="status == 'invalid'"
                                      create="0" delete="0">
                                    <field name="supplier_id"/>
                                    <field name="unit_price"/>
                                    <field name="source"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="status" widget="badge"/>
                                    <field name="create_uid"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_dl_material_search" model="ir.ui.view">
        <field name="name">dlm.material.search</field>
        <field name="model">dl.material</field>
        <field name="arch" type="xml">
            <search string="Tìm Vật tư">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <separator/>
                <filter string="Nháp" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Đang dùng" name="active_status" domain="[('status', '=', 'active')]"/>
                <filter string="Ngừng dùng" name="discontinued" domain="[('status', '=', 'discontinued')]"/>
                <separator/>
                <filter string="Thiếu giá hiệu lực" name="no_active_price"
                        domain="[('has_active_price', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhóm vật tư" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Trạng thái" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action window -->
    <record id="action_dl_material" model="ir.actions.act_window">
        <field name="name">Danh mục Vật tư</field>
        <field name="res_model">dl.material</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_material_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_material_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_material_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm vật tư đầu tiên!
            </p>
            <p>Quản lý danh mục vật tư (thép tấm, thép hộp-ống, sơn-mạ, vật tư phụ...).</p>
        </field>
    </record>

</odoo>
