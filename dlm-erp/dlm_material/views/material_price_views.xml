<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         BẢNG GIÁ VẬT TƯ (dl.material.price)
    ================================================================ -->

    <!-- Form view -->
    <record id="view_dl_material_price_form" model="ir.ui.view">
        <field name="name">dlm.material.price.form</field>
        <field name="model">dl.material.price</field>
        <field name="arch" type="xml">
            <form string="Dòng giá vật tư">
                <header>
                    <button name="action_mark_invalid" type="object" string="Đánh dấu không hợp lệ"
                            groups="dl_base.dl_group_accountant"
                            invisible="status == 'invalid'"
                            confirm="Đánh dấu dòng giá này là KHÔNG HỢP LỆ? Dòng sẽ được giữ lại trong lịch sử."/>
                    <field name="status" widget="statusbar" statusbar_visible="active,expired,invalid"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not auto_close_preview">
                        <field name="auto_close_preview" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="material_id" readonly="id"/>
                            <field name="supplier_id" readonly="id"/>
                            <field name="unit_price" readonly="id"/>
                            <field name="source" readonly="id"/>
                        </group>
                        <group>
                            <field name="valid_from" readonly="id"/>
                            <field name="valid_to" readonly="id"/>
                        </group>
                    </group>
                    <group string="Lý do không hợp lệ" invisible="status != 'invalid'">
                        <field name="invalid_reason" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view (chuẩn cho các action đứng riêng, có cột Vật tư) -->
    <record id="view_dl_material_price_list_tree" model="ir.ui.view">
        <field name="name">dlm.material.price.list.tree</field>
        <field name="model">dl.material.price</field>
        <field name="arch" type="xml">
            <tree string="Bảng giá Vật tư" create="0"
                  class="dl-material-price-list" js_class="dl_material_price_list"
                  decoration-danger="status == 'expired'"
                  decoration-muted="status == 'invalid'">
                <field name="material_id" string="Vật tư"/>
                <field name="supplier_id" string="Nhà cung cấp"/>
                <field name="unit_price" string="Đơn giá"/>
                <field name="valid_from" string="Hiệu lực từ"/>
                <field name="valid_to" string="Đến"/>
                <field name="status" string="Trạng thái" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_dl_material_price_search" model="ir.ui.view">
        <field name="name">dlm.material.price.search</field>
        <field name="model">dl.material.price</field>
        <field name="arch" type="xml">
            <search string="Tìm Bảng giá Vật tư">
                <field name="material_id"/>
                <field name="supplier_id"/>
                <separator/>
                <filter string="Hiệu lực" name="active_status" domain="[('status', '=', 'active')]"/>
                <filter string="Hết hạn" name="expired" domain="[('status', '=', 'expired')]"/>
                <filter string="Không hợp lệ" name="invalid" domain="[('status', '=', 'invalid')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Vật tư" name="group_material" context="{'group_by': 'material_id'}"/>
                    <filter string="Nhà cung cấp" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Trạng thái" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: toàn bộ Bảng giá Vật tư -->
    <record id="action_dl_material_price" model="ir.actions.act_window">
        <field name="name">Bảng giá Vật tư</field>
        <field name="res_model">dl.material.price</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_material_price_list_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_material_price_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_material_price_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p>Xem toàn bộ lịch sử giá vật tư. Để thêm giá mới, vào Danh mục Vật tư và bấm "Cập nhật giá mới".</p>
        </field>
    </record>

    <!-- Action: worklist Vật tư cần cập nhật giá (spec 6.2) -->
    <record id="action_dl_material_price_overdue" model="ir.actions.act_window">
        <field name="name">Vật tư cần cập nhật giá</field>
        <field name="res_model">dl.material</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('status', '=', 'active'), ('price_status', 'in', ['warning', 'expired', 'none'])]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_material_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_material_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_material_search"/>
        <field name="help" type="html">
            <p>Danh sách vật tư đang thiếu giá hiệu lực, sắp hết hạn hoặc đã quá hạn.</p>
        </field>
    </record>

</odoo>
