<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Kế toán nay chỉ-đọc product.product (ACL write=0) — rule này giữ lại
             cho tương thích DB cũ, không còn tác dụng ghi. -->
        <record id="rule_product_accountant_trading_write_only" model="ir.rule">
            <field name="name">Kế toán: chỉ sửa bảng giá SP thương mại / Vật tư</field>
            <field name="model_id" ref="product.model_product_product" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_accountant'))]" />
            <field name="domain_force">[('product_kind', 'in', ('trading', 'material'))]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Mua hàng: được GHI product (gắn/duyệt/áp dụng giá NCC qua tab Nhà cung
             cấp) nhưng CHỈ với SP thương mại / Vật tư — không đụng SP gia công/BTP.
             Field nhạy cảm (giá vốn/giá bán/vòng đời/loại SP) vẫn khóa cứng ở
             write() guard. perm_read=0 ⇒ vẫn đọc mọi SP để tham chiếu. -->
        <record id="rule_product_purchasing_cost_write_only" model="ir.rule">
            <field name="name">Mua hàng: chỉ sửa giá SP thương mại / Vật tư</field>
            <field name="model_id" ref="product.model_product_product" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_purchasing'))]" />
            <field name="domain_force">[('product_kind', 'in', ('trading', 'material'))]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Mua hàng: cùng lý do trên NHƯNG ở tầng product.template — vì o2m Nhà
             cung cấp (seller_ids) nằm trên template, lưu dòng giá NCC từ form SP
             ghi vào template. Giới hạn trading/material qua biến thể (product_kind
             ở product.product). Thiếu rule/ACL này ⇒ AccessError product.template. -->
        <record id="rule_product_tmpl_purchasing_write_only" model="ir.rule">
            <field name="name">Mua hàng: chỉ sửa template SP thương mại / Vật tư</field>
            <field name="model_id" ref="product.model_product_template" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_purchasing'))]" />
            <field name="domain_force">[('product_variant_ids.product_kind', 'in', ('trading', 'material'))]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Sales (BA) được TẠO/SỬA nhưng CHỈ với Sản phẩm thương mại (luồng:
             Sales tạo SP thương mại → Kế toán nhập giá → Sales kích hoạt).
             perm_read=0 ⇒ không đụng quyền đọc (Sales vẫn xem mọi SP để tham
             khảo khi tạo RFQ). Không đụng SP gia công/vật tư/BTP. -->
        <record id="rule_product_ba_trading_write_create" model="ir.rule">
            <field name="name">Sales: chỉ tạo/sửa Sản phẩm thương mại</field>
            <field name="model_id" ref="product.model_product_product" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_ba'))]" />
            <field name="domain_force">[('product_kind', '=', 'trading')]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>


    </data>


</odoo>