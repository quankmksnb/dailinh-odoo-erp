<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Kế toán nay chỉ-đọc product.product (ACL write=0) — rule này giữ lại
             cho tương thích DB cũ, không còn tác dụng ghi. -->
        <record id="rule_product_accountant_trading_write_only" model="ir.rule">
            <field name="name">Kế toán: chỉ sửa bảng giá sản phẩm thương mại / Vật tư</field>
            <field name="model_id" ref="product.model_product_product" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_accountant'))]" />
            <field name="domain_force">[('product_kind', 'in', ('trading', 'material'))]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Mua hàng: được GHI product (gắn/duyệt/áp dụng giá NCC qua tab Nhà cung
             cấp) nhưng CHỈ với SP thương mại / Vật tư — không đụng SP gia công/BTP.
             Field nhạy cảm (giá vốn/giá bán/vòng đời/loại SP) vẫn khóa cứng ở
             write() guard. perm_read=0 ⇒ vẫn đọc mọi SP để tham chiếu. -->
        <record id="rule_product_purchasing_cost_write_only" model="ir.rule">
            <field name="name">Mua hàng: chỉ sửa giá sản phẩm thương mại / Vật tư</field>
            <field name="model_id" ref="product.model_product_product" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_purchasing'))]" />
            <field name="domain_force">[('product_kind', 'in', ('trading', 'material'))]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Mua hàng: cùng lý do trên NHƯNG ở tầng product.template — vì o2m Nhà
             cung cấp (seller_ids) nằm trên template, lưu dòng giá NCC từ form SP
             ghi vào template. Giới hạn trading/material qua biến thể (product_kind
             ở product.product). Thiếu rule/ACL này ⇒ AccessError product.template. -->
        <record id="rule_product_tmpl_purchasing_write_only" model="ir.rule">
            <field name="name">Mua hàng: chỉ sửa template sản phẩm thương mại / Vật tư</field>
            <field name="model_id" ref="product.model_product_template" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_purchasing'))]" />
            <field name="domain_force">[('product_variant_ids.product_kind', 'in', ('trading', 'material'))]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Trưởng phòng KD được TẠO/SỬA nhưng CHỈ với Sản phẩm thương mại — họ
             là chủ sở hữu danh mục hàng thương mại và là người CHỐT GIÁ BÁN
             (luồng: TPKD tạo SP → Mua hàng tìm NCC & nhập giá vốn → TPKD chốt
             giá bán rồi kích hoạt). perm_read=0 ⇒ không đụng quyền đọc (vẫn xem
             mọi SP). Không đụng SP gia công/vật tư/BTP. -->
        <record id="rule_product_sm_trading_write_create" model="ir.rule">
            <field name="name">Trưởng phòng KD: chỉ tạo/sửa Sản phẩm thương mại</field>
            <field name="model_id" ref="product.model_product_product" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_sales_manager'))]" />
            <field name="domain_force">[('product_kind', '=', 'trading')]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Sales (BA) nay CHỈ-ĐỌC sản phẩm: quyền tạo SP thương mại & chốt giá
             bán đã chuyển hẳn lên Trưởng phòng KD (2026-08-15). Rule giữ lại cho
             tương thích DB cũ — ACL write/create của BA đã về 0 nên không còn
             tác dụng (giống rule Kế toán bên trên). -->
        <record id="rule_product_ba_trading_write_create" model="ir.rule">
            <field name="name">Sales: chỉ tạo/sửa Sản phẩm thương mại</field>
            <field name="model_id" ref="product.model_product_product" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_ba'))]" />
            <field name="domain_force">[('product_kind', '=', 'trading')]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- LK-12 (§5.1) — Kỹ thuật tự tạo/sửa NHÓM nhánh Vật tư (nhóm vật tư/BTP
             + tách nhóm theo kết cấu để làm họ tham số §18.2). KHÔNG đụng nhánh
             Thành phẩm (quyết định kinh doanh — Admin/Trưởng KD) và 2 nhóm gốc.
             perm_read=0 ⇒ Kỹ thuật vẫn ĐỌC toàn bộ cây nhóm (rule khác/ACL). -->
        <record id="rule_category_tech_material" model="ir.rule">
            <field name="name">KTV tạo/sửa nhóm nhánh Vật tư</field>
            <field name="model_id" ref="product.model_product_category" />
            <field name="groups" eval="[(4, ref('dl_base.dl_group_tech'))]" />
            <field name="domain_force">[('dl_branch', '=', 'material')]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>


    </data>


</odoo>