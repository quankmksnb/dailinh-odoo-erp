<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         PROD-02 — dl.product = product.product (mở rộng thuần)
         Bảng hợp nhất 4 loại: manufactured / trading / material /
         material_processed (phân biệt qua product_kind).
    ============================================================ -->

    <record id="view_dl_product_tree" model="ir.ui.view">
        <field name="name">dl.product.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree
                string="Sản phẩm"
                class="dl-product-list"
                js_class="dl_product_list"
                decoration-muted="active == False or dlm_lifecycle_state == 'obsolete'"
                expand="1"
            >
                <field
                    name="image_128"
                    widget="image"
                    string="Ảnh"
                    options="{'size': [24, 24]}"
                    optional="show"
                />
                <field name="default_code" string="Mã SP" />
                <field name="name" string="Tên SP" />
                <field name="categ_id" string="Nhóm SP" />
                <!-- Loại SP: badge màu để phân biệt nhanh gia công / thương mại /
                     vật tư / BTP — mỗi loại một sắc thái riêng -->
                <field name="product_kind" string="Loại SP" widget="badge"
                    decoration-info="product_kind == 'manufactured'"
                    decoration-success="product_kind == 'trading'"
                    decoration-warning="product_kind == 'material_processed'"
                    decoration-muted="product_kind == 'material'" />
                <field name="dlm_lifecycle_state" string="Vòng đời" widget="badge"
                    decoration-warning="dlm_lifecycle_state == 'draft'"
                    decoration-success="dlm_lifecycle_state == 'active'"
                    decoration-muted="dlm_lifecycle_state == 'obsolete'"
                    optional="show" />
                <field name="uom_id" string="ĐVT" optional="show" />
                <field name="active" column_invisible="1" />
            </tree>
        </field>
    </record>

    <record id="view_dl_product_form" model="ir.ui.view">
        <field name="name">dl.product.form</field>
        <field name="model">product.product</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form
                string="Sản phẩm"
                class="dl-product-form"
                js_class="dl_product_form"
            >
                <header>
                    <!-- Vòng đời: SP gia công/BTP do Kỹ thuật duyệt; SP thương
                         mại do Sales duyệt (sau khi Kế toán nhập giá). Model tự
                         chặn quyền (_check_lifecycle_manager) — 'groups' ở đây
                         chỉ ẩn/hiện cho gọn UI. -->
                    <field name="dlm_trading_ready" invisible="1" />
                    <button
                        name="action_lifecycle_activate"
                        type="object"
                        string="Duyệt (Active)"
                        class="oe_highlight"
                        invisible="dlm_lifecycle_state != 'draft' or product_kind != 'trading' or not dlm_trading_ready"
                        groups="dl_base.dl_group_ba,dl_base.dl_group_admin"
                    />
                    <button
                        name="action_lifecycle_activate"
                        type="object"
                        string="Duyệt (Active)"
                        class="oe_highlight"
                        invisible="dlm_lifecycle_state != 'draft' or product_kind == 'trading'"
                        groups="dl_base.dl_group_tech,dl_base.dl_group_admin"
                    />
                    <button
                        name="action_lifecycle_obsolete"
                        type="object"
                        string="Ngừng sử dụng"
                        class="btn-secondary"
                        confirm="Đưa sản phẩm này về trạng thái Ngừng sử dụng? SP vẫn giữ trong danh mục để tra lịch sử nhưng không còn được chọn để tái sử dụng."
                        invisible="dlm_lifecycle_state != 'active' or not id"
                        groups="dl_base.dl_group_tech,dl_base.dl_group_ba,dl_base.dl_group_admin"
                    />
                    <button
                        name="action_lifecycle_reset_draft"
                        type="object"
                        string="Đưa về Nháp"
                        class="btn-secondary"
                        invisible="dlm_lifecycle_state != 'obsolete'"
                        groups="dl_base.dl_group_tech,dl_base.dl_group_ba,dl_base.dl_group_admin"
                    />
                    <button
                        name="toggle_active"
                        type="object"
                        string="Vô hiệu hóa SP"
                        class="btn-danger"
                        invisible="not active or not id"
                        confirm="Vô hiệu hóa sản phẩm này? SP sẽ không xuất hiện khi tạo RFQ/BOM mới; dữ liệu cũ giữ nguyên."
                        groups="dl_base.dl_group_admin"
                    />
                    <button
                        name="toggle_active"
                        type="object"
                        string="Kích hoạt lại"
                        class="btn-secondary"
                        invisible="active"
                        groups="dl_base.dl_group_admin"
                    />
                    <field
                        name="dlm_lifecycle_state"
                        widget="dl_stepper"
                        statusbar_visible="draft,active,obsolete"
                    />
                </header>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Đã lưu trữ"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />

                    <!-- SP thương mại còn Nháp & chưa đủ điều kiện: liệt kê việc
                         còn thiếu (đặc biệt "chờ Mua hàng áp dụng giá NCC") thay
                         vì để Sales bấm Duyệt rồi báo lỗi. Nút Duyệt chỉ hiện khi
                         dlm_trading_ready = True. -->
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="product_kind != 'trading' or dlm_lifecycle_state != 'draft' or dlm_trading_ready"
                    >
                        <i class="fa fa-clock-o me-2" />
                        <b>Chưa đủ điều kiện kích hoạt.</b> Cần hoàn tất trước khi Duyệt:
                        <field name="dlm_trading_blockers_html" nolabel="1" />
                    </div>

                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        options="{'preview_image': 'image_128'}"
                    />

                    <div class="oe_title">
                        <label for="name" string="Tên sản phẩm" />
                        <h1>
                            <field
                                name="name"
                                placeholder="VD: Khung thép hàn CT-200..."
                            />
                        </h1>
                        <!-- Mã SP TỰ SINH theo loại (GC-/TM-/VT-/BTP-) khi lưu —
                             người dùng không phải nhập tay. Ẩn tới khi có mã. -->
                        <div class="text-muted" invisible="not default_code">
                            Mã SP: <field name="default_code" class="oe_inline"
                                readonly="1" />
                        </div>
                    </div>

                    <group>
                        <group string="Phân loại">
                            <!-- Sales không đổi được Loại SP (khoá = trading khi
                                 tạo); chỉ Admin/Kỹ thuật đổi loại. -->
                            <field name="dlm_can_change_kind" invisible="1" />
                            <field name="product_kind"
                                readonly="not dlm_can_change_kind" />
                            <!-- Nhóm lọc ĐỘNG theo Loại SP: gia công/thương mại →
                                 nhánh Thành phẩm; vật tư/BTP → nhánh Vật tư.
                                 no_create: nhóm mới phải tạo ở màn Nhóm sản phẩm
                                 (có chọn nhóm cha) để không sinh nhóm ngoài nhánh. -->
                            <field name="dl_categ_branch" invisible="1" />
                            <field
                                name="categ_id"
                                string="Nhóm SP"
                                options="{'no_open': True, 'no_create': True}"
                                domain="[('dl_branch', '=', dl_categ_branch)]"
                            />
                        </group>
                        <group string="Đơn vị tính">
                            <field name="uom_id" />
                            <!-- Q1 — MỘT quy tắc đơn vị duy nhất: ô này vừa là
                                 đơn vị NCC bán, vừa là đơn vị định mức quy về.
                                 Nói rõ tại chỗ để không ai đi tìm "đơn vị mua"
                                 thứ hai ở đâu đó. -->
                            <div
                                class="text-muted"
                                colspan="2"
                                invisible="product_kind not in ('material', 'material_processed')"
                            >
                                Đơn vị nhà cung cấp <b>bán</b> vật tư này (Cây ·
                                Tấm · Cuộn · Túi · kg · Lít). Giá NCC là đồng trên
                                <b>chính đơn vị này</b>, và định mức cũng quy về nó
                                — không có đơn vị trung gian.
                            </div>
                            <field name="uom_po_id" groups="uom.group_uom" />
                            <div class="text-muted" colspan="2" groups="uom.group_uom">
                                Phải giữ <b>trùng</b> với Đơn vị tính. Để lệch thì
                                engine báo giá chặn cứng (QTE-007) vì giá nhà cung
                                cấp không còn cùng đơn vị với định mức.
                            </div>
                        </group>
                    </group>

                    <group
                        name="group_trading_info"
                        string="Thông tin thương mại"
                        invisible="product_kind != 'trading'"
                    >
                        <field name="currency_id" invisible="1" />
                        <field name="dlm_can_edit_sale_price" invisible="1" />
                        <!-- Giá vốn tham chiếu (readonly) hiện sẵn để Sales biết
                             cơ sở khi định giá bán — tự đặt theo giá NCC Mua hàng
                             áp dụng. -->
                        <field
                            name="standard_price"
                            string="Giá vốn tham chiếu"
                            widget="dl_money"
                            options="{'currency_field': 'currency_id'}"
                            readonly="1"
                        />
                        <!-- Mua trước → bán sau: ô Giá bán chỉ MỞ sau khi đã có
                             Giá vốn (Mua hàng áp giá NCC). Lúc mới tạo, Sales chưa
                             cần nhập giá bán vội. -->
                        <field
                            name="list_price"
                            string="Giá bán"
                            widget="dl_money"
                            options="{'currency_field': 'currency_id'}"
                            readonly="not dlm_can_edit_sale_price"
                            help="Sales nhập SAU khi Mua hàng đã thiết lập &amp; áp dụng giá NCC (đã có Giá vốn tham chiếu), rồi kích hoạt sản phẩm."
                        />
                        <div
                            class="text-muted fst-italic"
                            colspan="2"
                            invisible="dlm_lifecycle_state != 'draft' or dlm_can_edit_sale_price"
                        >
                            <i class="fa fa-lock me-1" />
                            Giá bán sẽ mở để nhập sau khi Mua hàng thiết lập &amp;
                            áp dụng giá NCC (có Giá vốn tham chiếu).
                        </div>
                    </group>

                    <!-- Nhắc MỀM: vật tư khai thiếu thì dòng định mức không tự
                         tính được, im lặng ra 0. Cổng CỨNG nằm ở lúc Xác nhận
                         định mức — đây chỉ là lời nhắc sớm ngay nơi sửa được. -->
                    <div
                        class="alert alert-warning mb-3"
                        role="status"
                        invisible="product_kind not in ('material', 'material_processed') or not dlm_calc_missing_hint"
                    >
                        <i class="fa fa-exclamation-triangle me-1" title="Thiếu" />
                        <b>Chưa dùng được trong định mức</b> — còn thiếu: <field
                            name="dlm_calc_missing_hint"
                            readonly="1"
                            nolabel="1"
                            class="oe_inline"
                        />.
                    </div>

                    <!-- Quy cách nằm ở ĐÂY, không gõ lại mỗi dòng BOM: một vật
                         tư = một quy cách + một đơn vị mua. Kiểu tính quyết định
                         dòng BOM hỏi gì và định mức quy ra đơn vị nào.

                         KHÔNG đặt string cho group NGOÀI: tiêu đề group ngoài
                         chiếm trọn một dòng, làm tiêu đề cột phải tụt xuống thấp
                         hơn ô đầu tiên của cột trái (separator mang mt-4). Đặt
                         tiêu đề cho CẢ HAI group trong thì hai đầu cột canh
                         thẳng nhau — đúng khuôn "Phân loại / Đơn vị tính" ở trên. -->
                    <group
                        name="group_physical_info"
                        invisible="product_kind not in ('material', 'material_processed')"
                    >
                        <field name="dlm_uom_group" invisible="1" />
                        <group string="Cách tính định mức">
                            <field name="dlm_calc_kind" />
                            <!-- Giải thích ngay tại chỗ chọn: mỗi kiểu tính đổi
                                 hẳn việc dòng định mức hỏi gì. Nói bằng đúng câu
                                 người dùng sẽ thấy ở màn Định mức. -->
                            <div class="text-muted" colspan="2"
                                invisible="dlm_calc_kind != 'cut_length'">
                                Dòng định mức sẽ hỏi <b>Chiều dài đoạn</b> ×
                                <b>Số đoạn</b> (theo <b>mm</b> trên bản vẽ), rồi
                                chia cho chiều dài cây → ra <b>số cây</b>.
                                <br />Thanh · ống · hộp · thép cây.
                            </div>
                            <div class="text-muted" colspan="2"
                                invisible="dlm_calc_kind != 'sheet'">
                                Dòng định mức sẽ hỏi <b>Dài × Rộng</b> và
                                <b>Số tấm</b> (theo <b>mm</b> trên bản vẽ), rồi
                                chia cho khổ tấm → ra <b>số tấm</b>.
                                <br />Tôn · lưới · alu · tấm nhựa.
                            </div>
                            <div class="text-muted" colspan="2"
                                invisible="dlm_calc_kind != 'count'">
                                Dòng định mức <b>chỉ hỏi Số lượng</b> — không có
                                kích thước nào để suy ra. <br />Ốc · vít · bản lề ·
                                tay nắm · đá cắt.
                            </div>
                            <div class="text-muted" colspan="2"
                                invisible="dlm_calc_kind != 'bulk'">
                                Dòng định mức <b>chỉ hỏi Số lượng</b> theo kg/lít,
                                kỹ thuật tự ước lượng. <br />Sơn · que hàn · hoá chất.
                            </div>

                            <!-- Quy cách hình học (mặt cắt · cạnh · độ dày · khối
                                 lượng riêng) đã GỠ 2026-08-09: nó chỉ suy ra số
                                 barem cao hơn thép thật 12-31%, trong khi số cân
                                 thật đã được khai thẳng ở cột bên. Quy cách vẫn
                                 đọc được — nó nằm trong TÊN vật tư. -->
                        </group>
                        <!-- Vật tư mua theo đơn vị RỜI (cây · tấm · cuộn): khai
                             xem MỘT đơn vị đó to bằng nào và nặng bao nhiêu. Đây
                             là mẫu số biến kích thước cắt thành số cây/số tấm. -->
                        <group
                            string="Một đơn vị mua lớn cỡ nào"
                            invisible="dlm_uom_group != 'unit' or dlm_calc_kind not in ('cut_length', 'sheet')"
                        >
                            <div class="text-muted" colspan="2"
                                invisible="dlm_uom_group != 'unit' or dlm_calc_kind not in ('cut_length', 'sheet')">
                                Một <b>cây</b> dài bao nhiêu, một <b>tấm</b> khổ bao
                                nhiêu, nặng bao nhiêu — hệ thống lấy đây làm mẫu số
                                để biến kích thước cắt thành số cây / số tấm.
                                <br />Khai theo <b>mét</b> (cây 6 m, tôn khổ
                                1,25 × 2,5 m); kích thước cắt vẫn nhập <b>mm</b>.
                            </div>
                            <field
                                name="dlm_stock_length"
                                invisible="dlm_calc_kind != 'cut_length' or dlm_uom_group != 'unit'"
                            />
                            <field
                                name="dlm_sheet_w"
                                invisible="dlm_calc_kind != 'sheet' or dlm_uom_group != 'unit'"
                            />
                            <field
                                name="dlm_sheet_h"
                                invisible="dlm_calc_kind != 'sheet' or dlm_uom_group != 'unit'"
                            />
                            <!-- Hỏi NGAY khi khai vật tư cắt đoạn/tấm, KHÔNG chờ
                                 tick "Có thu hồi phế liệu": lúc cầm chứng từ NCC
                                 mới biết số cân thật, tick thu hồi có thể mãi sau
                                 mới bật. Mua theo kg thì bỏ qua — hao hụt đã là kg,
                                 hệ số quy đổi là 1. -->
                            <field
                                name="dlm_mass_per_unit"
                                invisible="dlm_uom_group == 'weight' or dlm_calc_kind not in ('cut_length', 'sheet')"
                            />
                            <div
                                class="text-muted"
                                colspan="2"
                                invisible="dlm_uom_group == 'weight' or dlm_calc_kind not in ('cut_length', 'sheet')"
                            >
                                Số cân thật trên chứng từ nhà cung cấp. Dùng để
                                đối chiếu khi có nhà cung cấp báo giá theo kg.
                                <b>Không vào giá vốn.</b>
                            </div>
                            <!-- 🔴 K16 — dải "đã bật thu hồi mà chưa khai kg" đã
                                 gỡ cùng cách tính % thu hồi: không còn tiền phế
                                 liệu nào để ra 0. -->

                        </group>

                        <!-- Vật tư mua theo KG: không có "một đơn vị" nào để mô tả
                             (1 kg là 1 kg). Thứ cần khai là TỶ LỆ quy kích thước
                             ra kg — và ô này vào THẲNG định mức. -->
                        <group
                            string="Quy kích thước sang kg"
                            invisible="dlm_calc_kind not in ('cut_length', 'sheet') or dlm_uom_group != 'weight'"
                        >
                            <div class="text-muted" colspan="2"
                                invisible="dlm_calc_kind != 'cut_length'">
                                Vật tư này bán theo <b>kg</b> ⇒ định mức = tổng số
                                <b>mét</b> cắt × kg mỗi mét.
                            </div>
                            <div class="text-muted" colspan="2"
                                invisible="dlm_calc_kind != 'sheet'">
                                Vật tư này bán theo <b>kg</b> ⇒ định mức = tổng
                                <b>m²</b> cắt × kg mỗi m².
                            </div>
                            <field
                                name="dlm_mass_per_meter"
                                invisible="dlm_calc_kind != 'cut_length'"
                            />
                            <field
                                name="dlm_mass_per_sqm"
                                invisible="dlm_calc_kind != 'sheet'"
                            />
                            <div class="text-muted" colspan="2">
                                <i class="fa fa-exclamation-triangle me-1" title="Lưu ý" />
                                Ô này <b>vào thẳng tiền</b>. Lấy số <b>cân thật</b>
                                trên chứng từ, đừng tính từ kích thước danh nghĩa —
                                cách đó ra số barem, cao hơn thép thật 10–30%.
                            </div>
                        </group>
                    </group>

                    <!-- 🔴 K16 (2026-08-13) — hai ô "Có thu hồi phế liệu" và "Tỷ
                         lệ thu hồi (%)" ĐÃ GỠ khỏi màn: người dùng chốt bỏ cách
                         tính % thu hồi, nên để chúng lại là hiện một con số
                         không còn ảnh hưởng tới đồng nào — kiểu sai khó phát
                         hiện nhất. Cột dữ liệu vẫn còn (xem
                         dl_bom_line_mixin._dlm_recovery_kg).
                         `dlm_scrap_product_id` thì Ở LẠI và nay LUÔN hiện: nó
                         trả lời "vật tư này thải ra loại phế liệu nào" — câu
                         hỏi vẫn sống, vì phiếu Nhập kho từ xưởng bắt khai đúng
                         mặt hàng phế cân được. -->
                    <group
                        name="group_waste_info"
                        string="Hao hụt &amp; phế liệu"
                        invisible="product_kind not in ('material', 'material_processed')"
                    >
                        <field name="dlm_waste_rate" />
                        <field name="dlm_scrap_product_id"
                            options="{'no_create': True}" />
                    </group>

                    <notebook>
                        <page
                            string="BOM liên quan"
                            name="boms"
                            groups="dl_base.dl_group_admin,dl_base.dl_group_ba,dl_base.dl_group_ceo,dl_base.dl_group_tech,dl_base.dl_group_sales_manager"
                            invisible="product_kind not in ('manufactured', 'material_processed')"
                        >
                            <div class="text-muted" style="padding:12px">
                                <i class="fa fa-info-circle" /> BOM sẽ hiển thị ở đây khi module <b>
                                dl_technical</b> được cài. </div>
                        </page>
                        <page string="Thông tin hệ thống" name="audit">
                            <group>
                                <group string="Khởi tạo">
                                    <field name="create_uid" string="Người tạo" readonly="1" />
                                    <field name="create_date" string="Ngày tạo" readonly="1" />
                                </group>
                                <group string="Cập nhật gần nhất">
                                    <field name="write_uid" string="Người sửa" readonly="1" />
                                    <field name="write_date" string="Ngày sửa" readonly="1" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <!-- Log/chatter cho quản lý (CEO, Trưởng KD, Admin) và đội sở
                     hữu sản phẩm (Kỹ thuật tạo/sửa). -->
                <div class="oe_chatter"
                     groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_admin,dl_base.dl_group_tech">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_product_search" model="ir.ui.view">
        <field name="name">dl.product.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Tìm sản phẩm">
                <field name="name" string="Tên" />
                <field name="default_code" string="Mã SP" />
                <field
                    name="categ_id"
                    string="Nhóm SP"
                    domain="[('id', 'not in', [%(product.product_category_all)d, %(product.product_category_1)d, %(product.cat_expense)d])]"
                />
                <separator />
                <!-- ── Trạng thái sử dụng (vòng đời) — bộ lọc chính, dùng thường
                     xuyên. "Ngừng sử dụng" = còn trong danh mục để tra lịch sử.
                     Bản ghi đã lưu trữ (active=False) ẩn mặc định; Admin dùng
                     filter "Archived" chuẩn của Odoo trong menu Bộ lọc nếu cần. -->
                <filter string="Nháp / Kỹ thuật" name="f_lc_draft"
                    domain="[('dlm_lifecycle_state', '=', 'draft')]" />
                <filter string="Đã duyệt" name="f_lc_active"
                    domain="[('dlm_lifecycle_state', '=', 'active')]" />
                <filter string="Ngừng sử dụng" name="f_lc_obsolete"
                    domain="[('dlm_lifecycle_state', '=', 'obsolete')]" />
                <separator />
                <!-- Màn Sản phẩm chỉ lọc 2 loại; màn Vật tư dùng
                     view_dl_material_search, màn Bảng giá dùng
                     view_dl_product_pricing_search (không lọc loại SP) -->
                <filter string="Gia công" name="f_manufactured"
                    domain="[('product_kind', '=', 'manufactured')]" />
                <filter string="Thương mại" name="f_trading"
                    domain="[('product_kind', '=', 'trading')]" />
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhóm SP" name="group_category"
                        context="{'group_by': 'categ_id'}" />
                    <filter string="Loại SP" name="group_kind"
                        context="{'group_by': 'product_kind'}" />
                    <filter string="Trạng thái vòng đời" name="group_lifecycle"
                        context="{'group_by': 'dlm_lifecycle_state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_dl_product_kanban" model="ir.ui.view">
        <field name="name">dl.product.kanban</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <kanban
                string="Sản phẩm"
                class="dl-product-kanban"
                js_class="dl_product_kanban"
                sample="1"
            >
                <field name="id" />
                <field name="name" />
                <field name="default_code" />
                <field name="categ_id" />
                <field name="product_kind" />
                <field name="uom_id" />
                <field name="active" />
                <field name="image_128" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click dl-prod-card #{record.active.raw_value ? '' : 'dl-prod-card--off'}">
                            <div class="dl-prod-img">
                                <img t-if="record.image_128.raw_value"
                                    t-att-src="kanban_image('product.product', 'image_128', record.id.raw_value)"
                                    t-att-alt="record.name.value" />
                                <span t-else="" class="dl-prod-img__placeholder">
                                    <i class="fa fa-cube" title="Sản phẩm" />
                                </span>
                            </div>
                            <div class="dl-prod-info">
                                <span class="dl-prod-name" t-esc="record.name.value" />
                                <div class="dl-prod-meta">
                                    <span class="dl-prod-code" t-if="record.default_code.value"
                                        t-esc="record.default_code.value" />
                                    <span class="dl-prod-sep" t-if="record.default_code.value and record.categ_id.value">·</span>
                                    <span t-if="record.categ_id.value" t-esc="record.categ_id.value" />
                                </div>
                                <div class="dl-prod-detail" t-if="record.uom_id.value">
                                    <i class="fa fa-balance-scale" title="Đơn vị tính" />
                                    <span t-esc="record.uom_id.value" />
                                </div>
                            </div>
                            <span t-attf-class="dl-prod-badge dl-prod-badge--#{record.product_kind.raw_value}"
                                t-esc="record.product_kind.value" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- View riêng cho KTV: Kế thừa form gốc (giữ nguyên tab tạo BOM cho dl_technical -->
    <record id="view_dl_product_tech_form" model="ir.ui.view">
        <field name="name">dl.product.tech.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="view_dl_product_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_trading_info']" position="replace" />
        </field>
    </record>

    <!-- Tree riêng màn "Sản phẩm" của Sales: SP gia công TÔ MỜ (chỉ xem — Sales
         không tạo/sửa, đi luồng RFQ/Kỹ thuật). Class dl-product-list-ba đổi nhãn
         nút tạo thành "Thêm SP thương mại" (xem dl_base/global_cp.scss). -->
    <record id="view_dl_product_tree_ba" model="ir.ui.view">
        <field name="name">dl.product.tree.ba</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="view_dl_product_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class">dl-product-list dl-product-list-ba</attribute>
                <attribute name="decoration-muted">active == False or dlm_lifecycle_state == 'obsolete' or product_kind == 'manufactured'</attribute>
            </xpath>
        </field>
    </record>

    <!-- Sản phẩm & Vật tư (product.template) — form redesign nhẹ, đồng bộ DLM.
         Trong app này template chỉ được mở qua mũi tên "Sản phẩm & Vật tư" ở màn
         Giá NCC (product.supplierinfo.product_tmpl_id); mọi nơi khác dùng
         product_id → product.product (đã có form riêng). Các field nghiệp vụ
         product_kind/dlm_* nằm trên product.product nên template chỉ hiển thị
         thông tin cơ bản. class dl-*-form + priority=1 để thành form mặc định. -->
    <record id="view_dl_product_template_form" model="ir.ui.view">
        <field name="name">dl.product.template.form</field>
        <field name="model">product.template</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Sản phẩm &amp; Vật tư" class="dl-product-template-form">
                <sheet>
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" title="Đã lưu trữ"
                        bg_color="text-bg-danger" invisible="active" />
                    <field name="image_1920" widget="image" class="oe_avatar"
                        options="{'preview_image': 'image_128'}" />
                    <div class="oe_title">
                        <label for="name" string="Tên sản phẩm" />
                        <h1>
                            <field name="name" placeholder="VD: Khung thép hàn CT-200..." />
                        </h1>
                        <div class="text-muted" invisible="not default_code">
                            Mã SP: <field name="default_code" class="oe_inline" readonly="1" />
                        </div>
                    </div>
                    <group>
                        <group string="Phân loại">
                            <field name="categ_id" string="Nhóm SP" />
                        </group>
                        <group string="Đơn vị tính">
                            <field name="uom_id" />
                            <field name="uom_po_id" groups="uom.group_uom" />
                        </group>
                    </group>
                    <group string="Giá">
                        <field name="currency_id" invisible="1" />
                        <field name="list_price" string="Giá bán" widget="monetary"
                            options="{'currency_field': 'currency_id'}" />
                        <field name="standard_price" string="Giá vốn" widget="monetary"
                            options="{'currency_field': 'currency_id'}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ ACTIONS (tách Full / Tech / View theo role) ============ -->

    <!-- Full: chỉ Admin (Trưởng KD chuyển sang view-only, xem action_dl_product_view) -->
    <record id="action_dl_product_full" model="ir.actions.act_window">
        <field name="name">Sản phẩm</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_product_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_product_search" />
        <field name="domain">[('product_kind', 'in', ['manufactured', 'trading'])]</field>
        <field name="context">{'default_detailed_type': 'product', 'default_product_kind':
            'manufactured', 'default_dlm_lifecycle_state': 'draft',
            'dl_kind_scope': ['manufactured', 'trading'],
            'search_default_group_kind': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm sản phẩm đầu tiên!</p>
        </field>
        <!-- groups_id chặn cả truy cập trực tiếp qua card Trang chủ (bypass menu groups) -->
        <field name="groups_id" eval="[(6, 0, [ref('dl_base.dl_group_admin')])]" />
    </record>

    <!-- Tech: KTV — create/edit OK, delete blocked (ACL 1|1|1|0) -->
    <record id="action_dl_product_tech" model="ir.actions.act_window">
        <field name="name">Sản phẩm</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_product_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_tech_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_product_search" />
        <field name="domain">[('product_kind', 'in', ['manufactured', 'trading'])]</field>
        <field name="context">{'default_detailed_type': 'product', 'default_product_kind':
            'manufactured', 'default_dlm_lifecycle_state': 'draft',
            'dl_kind_scope': ['manufactured', 'trading'],
            'delete': False, 'search_default_group_kind': 1}</field>
        <field name="groups_id"
            eval="[(6, 0, [ref('dl_base.dl_group_admin'), ref('dl_base.dl_group_tech')])]" />
    </record>

    <!-- View-only: BA/Sales, CEO, Trưởng phòng KD — không gồm Kế toán -->
    <record id="action_dl_product_view" model="ir.actions.act_window">
        <field name="name">Sản phẩm</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_product_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_product_search" />
        <field name="domain">[('product_kind', 'in', ['manufactured', 'trading'])]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False,
            'dl_kind_scope': ['manufactured', 'trading'],
            'search_default_group_kind': 1}</field>
        <field name="groups_id"
            eval="[(6, 0, [
                ref('dl_base.dl_group_admin'),
                ref('dl_base.dl_group_ba'),
                ref('dl_base.dl_group_ceo'),
                ref('dl_base.dl_group_sales_manager'),
            ])]" />
    </record>

    <!-- Sales (BA): mục "Sản phẩm" DUY NHẤT — THẤY đủ loại SP (gia công + thương
         mại, đồng nhất với màn của các role khác) nhưng chỉ được TẠO SP thương
         mại (nút Tạo mặc định loại 'thương mại'; ir.rule chặn tạo/sửa loại khác).
         SP gia công chỉ để xem tham khảo. SP thương mại mới ở Nháp; Sales nhập
         Giá bán rồi Kích hoạt sau khi có ≥1 giá NCC đã duyệt. -->
    <record id="action_dl_product_trading_ba" model="ir.actions.act_window">
        <field name="name">Sản phẩm</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_product_tree_ba')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_product_search" />
        <field name="domain">[('product_kind', 'in', ['manufactured', 'trading'])]</field>
        <field name="context">{'default_detailed_type': 'product',
            'default_product_kind': 'trading',
            'default_dlm_lifecycle_state': 'draft',
            'default_list_price': 0.0,
            'dl_kind_scope': ['manufactured', 'trading'],
            'delete': False, 'search_default_group_kind': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm sản phẩm thương mại đầu tiên!</p>
            <p>Bấm <b>Tạo</b> để thêm sản phẩm thương mại (mua về bán). Sản phẩm
               gia công do Kỹ thuật tạo — hiển thị ở đây để tham khảo, Sales không sửa.</p>
        </field>
        <field name="groups_id"
            eval="[(6, 0, [ref('dl_base.dl_group_ba'), ref('dl_base.dl_group_admin')])]" />
    </record>
</odoo>
