<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem
        id="menu_dl_product_root"
        name="Sản phẩm"
        parent="dl_base.menu_dl_product"
        sequence="15"
    />

    <!-- ============================================================
         SẢN PHẨM (product.product — hợp nhất 4 loại)
    ============================================================ -->
    <menuitem
        id="menu_dl_product_full"
        name="Sản phẩm"
        action="action_dl_product_full"
        parent="menu_dl_product_root"
        sequence="10"
        groups="dl_base.dl_group_admin"
    />

    <menuitem
        id="menu_dl_product_tech"
        name="Sản phẩm"
        action="action_dl_product_tech"
        parent="menu_dl_product_root"
        sequence="11"
        groups="dl_base.dl_group_tech"
    />
    <!-- View-only: CEO, Sales/BA (Trưởng phòng KD dùng menu tạo bên dưới; Kế toán
         thao tác giá qua màn Bảng giá riêng, xem product_pricing_views.xml) -->
    <menuitem
        id="menu_dl_product_view"
        name="Sản phẩm"
        action="action_dl_product_view"
        parent="menu_dl_product_root"
        sequence="12"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_ba"
    />
    <!-- Trưởng phòng KD: mục "Sản phẩm" DUY NHẤT — THẤY đủ loại SP (như role
         khác), chỉ TẠO được SP thương mại. Không tách tab con riêng.
         XML ID giữ hậu tố "_ba" (lịch sử) — xem product_views.xml. -->
    <menuitem
        id="menu_dl_product_trading_ba"
        name="Sản phẩm"
        action="action_dl_product_trading_ba"
        parent="menu_dl_product_root"
        sequence="12"
        groups="dl_base.dl_group_sales_manager"
    />
    <!-- menuitem groups= chỉ CỘNG DỒN (Command.link) ⇒ bỏ nhóm khỏi thuộc tính
         KHÔNG gỡ được nhóm cũ trên DB đã nâng cấp. Chốt cứng bằng (6,0,...) để
         quyền "tạo SP thương mại" thực sự chuyển hẳn BA → Trưởng phòng KD. -->
    <record id="menu_dl_product_view" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_ceo'),
            ref('dl_base.dl_group_ba'),
        ])]" />
    </record>
    <record id="menu_dl_product_trading_ba" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_sales_manager'),
        ])]" />
    </record>

    <menuitem
        id="menu_dl_material_full"
        name="Vật tư"
        action="action_dl_material_full"
        parent="menu_dl_product_root"
        sequence="20"
        groups="dl_base.dl_group_admin"
    />
    <menuitem
        id="menu_dl_material_tech"
        name="Vật tư"
        action="action_dl_material_tech"
        parent="menu_dl_product_root"
        sequence="21"
        groups="dl_base.dl_group_tech"
    />
    <!-- Không có dl_group_ba — BA/Sales không xem Vật tư -->
    <menuitem
        id="menu_dl_material_view"
        name="Vật tư"
        action="action_dl_material_view"
        parent="menu_dl_product_root"
        sequence="22"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager"
    />


    <!-- ============================================================
         NHÓM SẢN PHẨM (product.category)
    ============================================================ -->
    <menuitem
        id="menu_dl_category_full"
        name="Nhóm sản phẩm"
        action="action_dl_category_full"
        parent="menu_dl_product_root"
        sequence="30"
        groups="dl_base.dl_group_admin,dl_base.dl_group_sales_manager"
    />
    <menuitem
        id="menu_dl_category_view"
        name="Nhóm sản phẩm"
        action="action_dl_category_view"
        parent="menu_dl_product_root"
        sequence="31"
        groups="dl_base.dl_group_ba,dl_base.dl_group_tech,dl_base.dl_group_ceo"
    />
    <!-- LK-12 — KTV tự tạo/sửa nhóm nhánh Vật tư (tách khỏi nhánh Thành phẩm). -->
    <menuitem
        id="menu_dl_category_material"
        name="Nhóm vật tư"
        action="action_dl_category_material"
        parent="menu_dl_product_root"
        sequence="32"
        groups="dl_base.dl_group_tech,dl_base.dl_group_admin"
    />

    <!-- ============================================================
         BẢNG GIÁ (SP thương mại / Vật tư) — chủ sở hữu: Kế toán nội bộ;
         CEO/Trưởng KD chỉ xem (ACL write=0); KTV không được vào.
         Trước đây 2 action bảng giá KHÔNG có menu nào trỏ tới (mồ côi).
    ============================================================ -->
    <!-- Menu CONTAINER (không action): điều hướng đi qua các menu con bên dưới
         — rail suy ra tính khả dụng của nhóm từ menu con (_hasActionableMenu). -->
    <menuitem
        id="menu_dl_pricing_root"
        name="Bảng giá"
        parent="dl_base.menu_dl_product"
        sequence="20"
        groups="dl_base.dl_group_admin,dl_base.dl_group_purchasing,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager"
    />
    <!-- Bỏ thuộc tính action khỏi <menuitem> KHÔNG xoá giá trị cũ trên DB đã
         nâng cấp (menuitem chỉ ghi field nào có mặt). Phải clear tường minh,
         không thì menu còn trỏ tới action hub đã xoá ⇒ bấm vào là lỗi. -->
    <record id="menu_dl_pricing_root" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>
    <!-- Vật tư chờ định giá (Mua hàng) — hòm việc EX-13: vật tư thô chưa có giá
         NCC đang áp dụng. Đặt ĐẦU nhóm Bảng giá vì đây là việc chủ động của Mua
         hàng (khác 2 màn dưới là tra cứu/sửa bảng giá đã có). -->
    <menuitem
        id="menu_dl_material_needs_price"
        name="Vật tư chờ định giá"
        action="action_dl_material_needs_price"
        parent="menu_dl_pricing_root"
        sequence="5"
        groups="dl_base.dl_group_admin,dl_base.dl_group_purchasing"
    />

    <!-- Bảng giá SP thương mại — MỘT màn product-centric duy nhất: liệt kê SP
         thương mại + trạng thái giá NCC. Mua hàng/Admin nhập giá NCC (đã cấp
         quyền ghi product giới hạn trading/material); Kế toán/CEO/Trưởng KD chỉ
         xem (ACL product read-only). Action tự lọc theo vai trò. -->
    <menuitem
        id="menu_dl_pricing_trading"
        name="Bảng giá sản phẩm thương mại"
        action="action_dl_product_pricing"
        parent="menu_dl_pricing_root"
        sequence="10"
        groups="dl_base.dl_group_admin,dl_base.dl_group_purchasing,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager"
    />
    <!-- (6, ...) chốt cứng groups — tránh cộng dồn/sót nhóm từ các phiên bản menu
         trước (từng trỏ supplierinfo / tách margin) trên DB đã nâng cấp. -->
    <record id="menu_dl_pricing_trading" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_admin'),
            ref('dl_base.dl_group_purchasing'),
            ref('dl_base.dl_group_ceo'),
            ref('dl_base.dl_group_sales_manager'),
        ])]" />
    </record>
    <!-- Bảng giá Vật tư (quyền sửa): Mua hàng là chủ sở hữu giá NCC; Kế toán
         chuyển sang bản chỉ-xem bên dưới. -->
    <menuitem
        id="menu_dl_pricing_material"
        name="Bảng giá Vật tư"
        action="action_dl_supplierinfo_material_full"
        parent="menu_dl_pricing_root"
        sequence="20"
        groups="dl_base.dl_group_admin,dl_base.dl_group_purchasing"
    />
    <!-- menuitem/groups cộng dồn ở một số database đã nâng cấp; lệnh (6, ...)
         bảo đảm loại bỏ hẳn Kế toán/CEO/Trưởng KD khỏi action có quyền chỉnh sửa. -->
    <record id="menu_dl_pricing_material" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_admin'),
            ref('dl_base.dl_group_purchasing'),
        ])]" />
    </record>
    <menuitem
        id="menu_dl_pricing_material_view"
        name="Bảng giá Vật tư"
        action="action_dl_supplierinfo_material_view"
        parent="menu_dl_pricing_root"
        sequence="20"
        groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager"
    />

    <!-- ============================================================
         ĐO LƯỜNG (PROD-04/05/06) — 😴 NGỦ ĐÔNG.
         Cách tính định mức nay nằm trên chính vật tư (dlm_calc_kind + mẫu số
         khai thẳng), dòng BOM không còn chọn Loại/Hình dạng đo lường nữa.
         Model và màn hình GIỮ NGUYÊN để còn đường lui, nhưng
         không seed bản ghi và ẩn khỏi menu thường (group_no_one = chỉ hiện
         khi bật Chế độ nhà phát triển).
         Thiết kế: docs/Doi_chieu_du_lieu_doanh_nghiep_va_thiet_ke_dinh_muc_vat_tu.md §14
    ============================================================ -->
    <menuitem
        id="menu_dl_measurement_root"
        name="Đo lường"
        parent="menu_dl_product_root"
        sequence="40"
        groups="base.group_no_one"
    />
    <menuitem
        id="menu_dl_measurement_type"
        name="Loại đo lường"
        action="action_dl_measurement_type"
        parent="menu_dl_measurement_root"
        sequence="10"
    />
    <menuitem
        id="menu_dl_measurement_shape"
        name="Hình dạng đo lường"
        action="action_dl_measurement_shape"
        parent="menu_dl_measurement_root"
        sequence="20"
    />
</odoo>
