<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         BẢNG GIÁ — dùng lại danh sách/form Sản phẩm (view_dl_product_*),
         chỉ khác domain lọc theo product_kind (trading / material).
    ============================================================ -->

    <!-- View bảng giá: kế thừa form gốc, thêm lại tab "Nhà cung cấp & Bảng giá"
         (tab này đã bị bỏ khỏi màn Danh sách Sản phẩm / Vật tư chung). -->
    <record id="view_dl_product_pricing_form" model="ir.ui.view">
        <field name="name">dl.product.pricing.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="view_dl_product_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- Màn Bảng giá = nơi định GIÁ, không sửa DANH TÍNH SP. Khóa tên/mã/
                 nhóm/loại/ĐVT (do Sales/Kỹ thuật đặt ở màn Sản phẩm) — tránh Mua
                 hàng (nay có quyền ghi product) sửa nhầm khi gắn giá NCC. -->
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="product_kind" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="uom_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <!-- Giá vốn tham chiếu (readonly) đã có sẵn trong group Thông tin
                 thương mại của form gốc — không thêm lại ở đây để tránh trùng field. -->
            <notebook position="inside">
                <page
                    string="Nhà cung cấp &amp; Bảng giá"
                    name="sellers"
                    groups="dl_base.dl_group_admin,dl_base.dl_group_purchasing,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager,dl_base.dl_group_ceo"
                >
                    <!-- Banner hướng dẫn ngữ cảnh: chỉ hiện khi còn dòng giá Nháp,
                         nhắc người mới bước tiếp theo thay vì bắt họ tự đoán. -->
                    <field name="dlm_has_draft_seller" invisible="1" />
                    <div class="alert alert-info" role="alert"
                        invisible="not dlm_has_draft_seller"
                        groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin">
                        <i class="fa fa-lightbulb-o me-2" />
                        Giá nhà cung cấp phải được <b>Duyệt</b> mới dùng được để tính giá
                        trong BOM / báo giá. Nhập xong dòng giá, bấm nút
                        <b>Duyệt</b> ở cuối dòng — bảng giá đầu tiên của vật tư
                        sẽ tự động được áp dụng.
                    </div>
                    <field name="seller_ids">
                        <tree editable="bottom"
                            decoration-muted="display_state == 'draft'">
                            <field name="company_id" column_invisible="1" />
                            <field name="approval_state" column_invisible="1" />
                            <field name="is_applied" column_invisible="1" />
                            <field name="partner_id" string="Nhà cung cấp"
                                domain="[('partner_role', 'in', ['supplier', 'both'])]"
                                context="{'default_partner_role': 'supplier', 'form_view_ref': 'dl_partner.view_dl_supplier_form'}" />
                            <field name="price" widget="dl_money" />
                            <field name="currency_id" column_invisible="1" />
                            <field name="date_start" string="Từ ngày" />
                            <field name="date_end" string="Đến ngày" />
                            <field name="min_qty" string="Số lượng tối thiểu" optional="hide" />
                            <field
                                name="display_state"
                                widget="badge"
                                decoration-success="display_state == 'applied'"
                                decoration-info="display_state == 'approved'"
                                decoration-warning="display_state == 'draft'"
                            />
                            <!-- Mỗi trạng thái đúng 1 hành động chính:
                                 Nháp → Duyệt; Đã duyệt → Áp dụng; Đang áp dụng → Bỏ áp dụng -->
                            <button name="action_approve" type="object" string="Duyệt"
                                icon="fa-check" invisible="approval_state == 'approved'"
                                groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin" />
                            <button name="action_set_applied" type="object" string="Áp dụng"
                                icon="fa-star" invisible="approval_state != 'approved' or is_applied"
                                groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin" />
                            <button name="action_unset_applied" type="object" string="Bỏ áp dụng"
                                icon="fa-star-o" invisible="not is_applied"
                                groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin" />
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Tree riêng màn Bảng giá SP thương mại: kế thừa list Sản phẩm chung
         nhưng THÊM cột Giá vốn / Giá bán / Biên LN. Cố ý tách primary để các
         cột giá KHÔNG rớt sang màn Sản phẩm của KTV/BA (view gốc giữ nguyên).
         Trạng thái = vòng đời SP (dlm_lifecycle_state) — không thêm luồng
         duyệt giá bán riêng (xem quyết định ở memory commercial-margin). -->
    <record id="view_dl_product_pricing_tree" model="ir.ui.view">
        <field name="name">dl.product.pricing.tree</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="view_dl_product_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- Class riêng: list Bảng giá có thêm cột giá nên cần bộ width
                 fixed-layout riêng (pricing_list.scss) — không dùng chung
                 .dl-product-list (bộ width cộng 100% cho list SP không giá). -->
            <xpath expr="//tree" position="attributes">
                <attribute name="class">dl-pricing-list</attribute>
            </xpath>
            <!-- Ảnh thừa cho bảng giá; ĐVT để ẩn tùy chọn cho gọn (bật lại được). -->
            <field name="image_128" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="uom_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <!-- Domain action đã cố định 'trading' → cột Loại SP thừa, ẩn cho gọn. -->
            <field name="product_kind" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="categ_id" position="after">
                <field name="currency_id" column_invisible="1" />
                <!-- Trạng thái giá NCC: Mua hàng nhìn cột này biết ngay SP nào
                     còn thiếu giá (none = đỏ) mà xử lý — không bị động. -->
                <field name="dlm_supplier_price_state" string="Giá nhà cung cấp" widget="badge"
                    decoration-danger="dlm_supplier_price_state == 'none'"
                    decoration-warning="dlm_supplier_price_state == 'pending'"
                    decoration-success="dlm_supplier_price_state == 'applied'" />
                <field name="standard_price" string="Giá vốn tham chiếu" widget="dl_money"
                    options="{'currency_field': 'currency_id'}" optional="show" />
                <field name="list_price" string="Giá bán" widget="dl_money"
                    options="{'currency_field': 'currency_id'}" />
                <!-- Biên LN tô màu theo ngưỡng: &lt;15% đỏ, 15–30% vàng, ≥30% xanh -->
                <field name="dlm_sale_margin" string="Biên lợi nhuận (%)" widget="badge"
                    decoration-danger="dlm_sale_margin &lt; 15"
                    decoration-warning="dlm_sale_margin &gt;= 15 and dlm_sale_margin &lt; 30"
                    decoration-success="dlm_sale_margin &gt;= 30" />
            </field>
        </field>
    </record>

    <!-- Search riêng cho 2 màn Bảng giá: bỏ filter/group-by Loại SP —
         domain action đã cố định 1 loại (trading hoặc material) -->
    <record id="view_dl_product_pricing_search" model="ir.ui.view">
        <field name="name">dl.product.pricing.search</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="view_dl_product_search" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- Bỏ nhóm lọc "Loại SP" (domain action đã cố định 1 loại) cùng
                 dấu ngăn cách đứng trước nó. Xóa separator TRƯỚC khi xóa filter
                 mốc để xpath còn tham chiếu được. -->
            <xpath expr="//filter[@name='f_trading']/preceding-sibling::separator[1]"
                position="replace" />
            <filter name="f_manufactured" position="replace" />
            <filter name="f_trading" position="replace" />
            <filter name="group_kind" position="replace" />
            <!-- Lọc theo trạng thái giá NCC: Mua hàng bấm "Chưa có giá NCC" để
                 chỉ còn SP cần thiết lập giá — chủ động thay vì dò cả danh sách. -->
            <xpath expr="//search" position="inside">
                <separator />
                <filter name="f_no_supplier_price" string="Chưa có giá nhà cung cấp"
                    domain="[('dlm_supplier_price_state', '=', 'none')]" />
                <filter name="f_supplier_price_pending" string="Có giá — chưa áp dụng"
                    domain="[('dlm_supplier_price_state', '=', 'pending')]" />
                <filter name="f_supplier_price_applied" string="Đã áp dụng giá nhà cung cấp"
                    domain="[('dlm_supplier_price_state', '=', 'applied')]" />
                <group expand="0" string="Nhóm giá nhà cung cấp">
                    <filter name="group_supplier_price_state" string="Trạng thái giá nhà cung cấp"
                        context="{'group_by': 'dlm_supplier_price_state'}" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- Bảng giá SP thương mại — LẤY SẢN PHẨM LÀM TRUNG TÂM: liệt kê mọi SP
         thương mại (kể cả SP Sales vừa tạo, chưa có giá NCC) + cột "Giá NCC" và
         bộ lọc "Chưa có giá NCC" để Mua hàng CHỦ ĐỘNG thấy việc cần làm. Mua hàng
         mở SP, gắn NCC + giá mua ngay tab (đã cấp quyền ghi product giới hạn
         trading/material). Quản lý (CEO/TrKD/Kế toán) chỉ xem (ACL read-only).
         Giá vốn/Giá bán/Vòng đời/Loại SP vẫn khóa cứng ở write() guard. -->
    <record id="action_dl_product_pricing" model="ir.actions.act_window">
        <field name="name">Bảng giá sản phẩm thương mại</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_product_pricing_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_pricing_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_product_pricing_search" />
        <field name="domain">[('product_kind', '=', 'trading')]</field>
        <field name="context">{'create': False, 'delete': False,
            'dl_kind_scope': ['trading']}</field>
        <!-- Mua hàng + Admin: nhập giá NCC. Kế toán/CEO/Trưởng KD: chỉ xem. -->
        <field name="groups_id"
            eval="[(6, 0, [
                ref('dl_base.dl_group_admin'),
                ref('dl_base.dl_group_purchasing'),
                ref('dl_base.dl_group_accountant'),
                ref('dl_base.dl_group_ceo'),
                ref('dl_base.dl_group_sales_manager'),
            ])]" />
    </record>

    <!-- Vật tư: chỉ xem chi tiết, được sửa bảng giá NCC (tab "Nhà cung cấp &
         Bảng giá") — các trường còn lại khóa readonly. -->
    <record id="view_dl_product_pricing_material_form" model="ir.ui.view">
        <field name="name">dl.product.pricing.material.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="view_dl_product_pricing_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="product_kind" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="uom_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="uom_po_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>

    <record id="action_dl_product_pricing_material" model="ir.actions.act_window">
        <field name="name">Bảng giá Vật tư</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_product_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_pricing_material_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_product_pricing_search" />
        <field name="domain">[('product_kind', '=', 'material')]</field>
        <field name="context">{'create': False, 'delete': False,
            'dl_kind_scope': ['material']}</field>
        <field name="groups_id"
            eval="[(6, 0, [
                ref('dl_base.dl_group_admin'),
                ref('dl_base.dl_group_accountant'),
                ref('dl_base.dl_group_ceo'),
                ref('dl_base.dl_group_sales_manager'),
            ])]" />
    </record>

    <!-- ============================================================
         VẬT TƯ CHỜ ĐỊNH GIÁ (Mua hàng) — worklist EX-13/RES-022.
         Vật tư thô CHƯA có giá NCC đang áp dụng (none/pending), chưa Ngừng.
         Bù đúng khoảng trống của màn "Bảng giá Vật tư" (list supplierinfo — vật
         tư CHƯA có dòng giá nào thì không hiện ở đó). Mở dòng = form Mua hàng
         (khóa nhận dạng, chỉ mở tab giá NCC); hoặc bấm "Thêm/sửa giá NCC" để
         nhập nhanh trên list bảng giá đã điền sẵn vật tư.
    ============================================================ -->
    <record id="view_dl_material_needs_price_tree" model="ir.ui.view">
        <field name="name">dl.material.needs.price.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree string="Vật tư chờ định giá" create="0" edit="0"
                  decoration-danger="dlm_supplier_price_state == 'none'"
                  decoration-warning="dlm_supplier_price_state == 'pending'">
                <field name="default_code" string="Mã"/>
                <field name="name" string="Vật tư"/>
                <field name="categ_id" string="Nhóm"/>
                <field name="uom_id" string="Đơn vị"/>
                <field name="dlm_supplier_price_state" widget="badge"
                       decoration-danger="dlm_supplier_price_state == 'none'"
                       decoration-warning="dlm_supplier_price_state == 'pending'"/>
                <!-- Việc Kỹ thuật đã giao (Cập nhật giá NCC) hiện ngay trên dòng. -->
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <button name="action_dlm_add_supplier_price" type="object"
                        string="Thêm / sửa giá nhà cung cấp" icon="fa-tag"
                        class="btn-link"
                        groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_material_needs_price_search" model="ir.ui.view">
        <field name="name">dl.material.needs.price.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Vật tư chờ định giá">
                <field name="name" string="Tìm nhanh"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('default_code', 'ilike', self), ('categ_id', 'ilike', self)]"/>
                <field name="default_code" string="Mã"/>
                <field name="categ_id" string="Nhóm"/>
                <separator/>
                <filter name="none" string="Chưa có giá nhà cung cấp"
                        domain="[('dlm_supplier_price_state', '=', 'none')]"/>
                <filter name="pending" string="Có giá — chưa áp dụng"
                        domain="[('dlm_supplier_price_state', '=', 'pending')]"/>
                <filter name="tech_requested" string="Kỹ thuật đã yêu cầu"
                        domain="[('activity_ids', '!=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_categ" string="Nhóm vật tư"
                            context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_material_needs_price" model="ir.actions.act_window">
        <field name="name">Vật tư chờ định giá</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="25"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_material_needs_price_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_pricing_material_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_material_needs_price_search" />
        <field name="domain">[('product_kind', '=', 'material'),
            ('dlm_supplier_price_state', '!=', 'applied'),
            ('dlm_lifecycle_state', '!=', 'obsolete')]</field>
        <field name="context">{'create': False, 'dl_kind_scope': ['material']}</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_admin'),
            ref('dl_base.dl_group_purchasing'),
        ])]" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Không có vật tư nào chờ định giá.</p>
            <p>Vật tư sẽ hiện ở đây khi được dùng trong định mức mà chưa có giá nhà cung cấp
               đang áp dụng — Kỹ thuật bấm "Báo Mua hàng" cũng đẩy vật tư vào danh sách này.</p>
        </field>
    </record>

</odoo>
