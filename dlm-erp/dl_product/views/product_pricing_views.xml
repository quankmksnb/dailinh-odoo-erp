<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dl_product_pricing_tree" model="ir.ui.view">
        <field name="name">dl.product.pricing.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree string="Bảng giá SP thương mại" editable="bottom">
                <field name="default_code" string="Mã SP" readonly="1" />
                <field name="name" string="Tên SP" readonly="1" />
                <field name="categ_id" string="Nhóm SP" readonly="1" />
                <field name="currency_id" column_invisible="1" />
                <field name="lst_price" string="Giá bán" />
            </tree>
        </field>
    </record>

    <record id="view_dl_product_pricing_form" model="ir.ui.view">
        <field name="name">dl.product.pricing.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form string="Bảng giá SP thương mại">
                <sheet>
                    <group>
                        <field name="default_code" string="Mã SP" readonly="1" />
                        <field name="name" string="Tên SP" readonly="1" />
                        <field name="categ_id" string="Nhóm SP" readonly="1" />
                        <field name="currency_id" invisible="1" />
                        <field name="lst_price" string="Giá bán" widget="monetary"
                            options="{'currency_field': 'currency_id'}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_product_pricing" model="ir.actions.act_window">
        <field name="name">Bảng giá SP thương mại</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">
            tree,form
        </field>
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_product_pricing_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_pricing_form')}),
        ]" />
        <field name="domain">[('product_kind', '=', 'trading')]</field>
        <field name="context">{'create': False, 'delete': False, 'search_default_active': 1}</field>
    </record>

</odoo>