<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         VẬT TƯ — dùng lại view Sản phẩm (view_dl_product_*), chỉ khác
         domain lọc theo product_kind (material / material_processed).
    ============================================================ -->

    <!-- Search riêng cho màn Vật tư: thay cặp filter Gia công/Thương mại
         của search Sản phẩm bằng Vật tư/Bán thành phẩm -->
    <record id="view_dl_material_search" model="ir.ui.view">
        <field name="name">dl.material.search</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="view_dl_product_search" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <filter name="f_manufactured" position="replace">
                <filter string="Vật tư" name="f_material"
                    domain="[('product_kind', '=', 'material')]" />
            </filter>
            <filter name="f_trading" position="replace">
                <filter string="Bán thành phẩm" name="f_material_processed"
                    domain="[('product_kind', '=', 'material_processed')]" />
            </filter>
        </field>
    </record>

    <!-- Tree riêng màn "Vật tư": chỉ khác class để nút tạo mang nhãn
         "+ Thêm vật tư" (xem dl_base/global_cp.scss) — dùng lại toàn bộ cột của
         view Sản phẩm. Giữ cả dl-product-list để không mất bộ width cột. -->
    <record id="view_dl_material_tree" model="ir.ui.view">
        <field name="name">dl.material.tree</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="view_dl_product_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class">dl-product-list dl-material-list</attribute>
                <attribute name="string">Vật tư</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_dl_material_full" model="ir.actions.act_window">
        <field name="name">Vật tư</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_material_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_material_search" />
        <field name="domain">
            [('product_kind', 'in', ['material', 'material_processed'])]
        </field>
        <!-- 🔴 `default_categ_id: False` PHẢI khai tường minh, đừng "dọn" cho gọn.
             `default_get` kiểm `'default_categ_id' in context` — CÓ MẶT, không phải
             giá trị (odoo/models.py:1495). Bỏ dòng này đi là rơi về default của
             Odoo lõi = nhóm "All", tức ô Nhóm lại hiện một giá trị nằm ngoài domain
             của chính nó. Để trống là cố ý: buộc chọn nhóm chi tiết, vì 2 gốc
             "Thành phẩm"/"Vật tư" nay không còn trong dropdown. -->
        <field name="context" eval="{
            'default_product_kind': 'material',
            'default_categ_id': False,
            'dl_kind_scope': ['material', 'material_processed'],
            'search_default_group_kind': 1,
        }"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm vật tư đầu tiên
            </p>
        </field>
        <field name="groups_id" eval="[(6, 0, [ref('dl_base.dl_group_admin')])]" />
    </record>

    <record id="action_dl_material_tech" model="ir.actions.act_window">
        <field name="name">Vật tư</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_material_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_tech_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_material_search" />
        <field name="domain">
            [('product_kind', 'in', ['material', 'material_processed'])]
        </field>
        <field name="context" eval="{
            'default_product_kind': 'material',
            'default_categ_id': False,
            'delete': False,
            'dl_kind_scope': ['material', 'material_processed'],
            'search_default_group_kind': 1,
        }"/>
        <field name="groups_id" eval="[(6, 0, [ref('dl_base.dl_group_admin'), ref('dl_base.dl_group_tech')])]" />
    </record>

    <record id="action_dl_material_view" model="ir.actions.act_window">
        <field name="name">Vật tư</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_material_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_product_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_material_search" />
        <field name="domain">[('product_kind', 'in', ['material', 'material_processed'])]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False,
            'dl_kind_scope': ['material', 'material_processed'],
            'search_default_group_kind': 1}</field>
        <!-- KHÔNG có dl_group_ba — BA/Sales không được xem Vật tư -->
        <field name="groups_id" eval="[(6, 0, [
            ref('dl_base.dl_group_admin'),
            ref('dl_base.dl_group_ceo'),
            ref('dl_base.dl_group_sales_manager'),
        ])]" />
    </record>
</odoo>
