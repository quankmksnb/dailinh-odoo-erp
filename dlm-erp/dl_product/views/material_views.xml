<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ TREE ============ -->
    <record id="dl_material_view_tree" model="ir.ui.view">
        <field name="name">dl.material.tree</field>
        <field name="model">dl.material</field>
        <field name="arch" type="xml">
            <tree
                string="Vật tư"
                class="dl-material-list"
                js_class="dl_material_list"
                decoration-muted="status == 'inactive'"
            >
                <field name="material_code" string="Mã VT" />
                <field name="name" string="Tên vật tư" />
                <field name="categ_id" string="Nhóm VT"
                    domain="[('category_kind', '=', 'material')]" />
                <field name="spec" string="Quy cách" />
                <field name="uom_id" string="ĐVT" />
                <field name="current_unit_price" string="Đơn giá hiện hành"
                    groups="dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager" />
                <field name="current_price_status" string="Trạng thái giá"
                    widget="badge"
                    decoration-success="current_price_status == 'valid'"
                    decoration-warning="current_price_status == 'expiring'"
                    decoration-danger="current_price_status == 'expired'"
                    groups="dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager" />
                <field name="status" string="Trạng thái"
                    widget="badge"
                    decoration-success="status == 'active'"
                    decoration-danger="status == 'inactive'" />
            </tree>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="dl_material_view_form" model="ir.ui.view">
        <field name="name">dl.material.form</field>
        <field name="model">dl.material</field>
        <field name="arch" type="xml">
            <form string="Vật tư" class="dl-material-form" js_class="dl_material_form">
                <header>
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="material_code" />
                        <h1>
                            <field name="material_code" placeholder="Tự sinh" />
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="name" string="Tên vật tư" />
                            <field name="categ_id" string="Nhóm vật tư"
                                domain="[('category_kind', '=', 'material')]" />
                            <field name="spec" placeholder="VD: 25×25×1.2mm, dài 6m/cây" />
                        </group>
                        <group string="Đơn vị &amp; Giá">
                            <field name="uom_id" string="ĐVT" />
                            <field name="active_price_id" string="Giá hiện hành"
                                groups="dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử giá" name="prices"
                            groups="dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager">
                            <field name="price_ids">
                                <tree editable="bottom">
                                    <field name="valid_from" />
                                    <field name="valid_to" />
                                    <field name="unit_price" />
                                    <field name="uom_id" />
                                    <field name="currency_id" />
                                    <field name="supplier_id" />
                                    <field name="is_active" />
                                    <field name="price_status" widget="badge"
                                        decoration-success="price_status == 'valid'"
                                        decoration-warning="price_status == 'expiring'"
                                        decoration-danger="price_status == 'expired'" />
                                    <field name="note" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="dl_material_view_search" model="ir.ui.view">
        <field name="name">dl.material.search</field>
        <field name="model">dl.material</field>
        <field name="arch" type="xml">
            <search string="Tìm vật tư">
                <field name="material_code" string="Mã VT" />
                <field name="name" string="Tên vật tư" />
                <field name="spec" string="Quy cách" />
                <separator />
                <filter name="active" string="Đang sử dụng"
                    domain="[('status', '=', 'active')]" />
                <filter name="inactive" string="Ngừng sử dụng"
                    domain="[('status', '=', 'inactive')]" />
                <separator />
                <filter name="price_expiring" string="Giá sắp hết hạn"
                    domain="[('current_price_status', '=', 'expiring')]" />
                <filter name="price_expired" string="Giá hết hạn"
                    domain="[('current_price_status', '=', 'expired')]" />
                <separator />
                <group expand="0" string="Nhóm theo">
                    <filter name="group_categ" string="Nhóm VT"
                        context="{'group_by': 'categ_id'}" />
                    <filter name="group_status" string="Trạng thái"
                        context="{'group_by': 'status'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ACTIONS (tách Full / View / Tech) ============ -->

    <!-- Full: Admin, Kế toán -->
    <record id="action_material_full" model="ir.actions.act_window">
        <field name="name">Vật tư &amp; Bảng giá</field>
        <field name="res_model">dl.material</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('dl_material_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dl_material_view_form')}),
        ]" />
        <field name="search_view_id" ref="dl_material_view_search" />
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm vật tư đầu tiên!</p>
        </field>
    </record>

    <!-- View-only: CEO, Trưởng KD -->
    <record id="action_material_view" model="ir.actions.act_window">
        <field name="name">Vật tư &amp; Bảng giá</field>
        <field name="res_model">dl.material</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('dl_material_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dl_material_view_form')}),
        ]" />
        <field name="search_view_id" ref="dl_material_view_search" />
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'search_default_active': 1}</field>
    </record>

    <!-- KTV: View-only, giá ẩn bởi field-level groups -->
    <record id="action_material_tech" model="ir.actions.act_window">
        <field name="name">Vật tư</field>
        <field name="res_model">dl.material</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('dl_material_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dl_material_view_form')}),
        ]" />
        <field name="search_view_id" ref="dl_material_view_search" />
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'search_default_active': 1}</field>
    </record>

</odoo>
