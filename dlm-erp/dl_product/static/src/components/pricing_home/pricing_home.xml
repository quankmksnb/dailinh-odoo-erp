<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="dl_product.DlPricingHome">
        <div class="dl-config dl-pricing o_action">
            <div class="dl-pricing-inner">
                <div class="dl-pricing-head">
                    <div class="dl-pricing-head-main">
                        <h1 class="dl-pricing-title">Bảng giá</h1>
                        <span class="dl-pricing-subtitle">Giá bán SP thương mại và giá NCC theo vật tư</span>
                    </div>
                </div>

                <div class="dl-pricing-rows">
                    <t t-foreach="cards" t-as="c" t-key="c.key">
                        <div class="dl-pricing-row" t-att-class="{ 'is-disabled': !c.resolvedActionId }" t-on-click="() => this.openCard(c.resolvedActionId)">
                            <span class="dl-pricing-row-icon">
                                <i t-att-class="'fa ' + c.icon"/>
                            </span>
                            <span class="dl-pricing-row-body">
                                <span class="dl-pricing-row-name" t-esc="c.name"/>
                                <span class="dl-pricing-row-desc" t-esc="c.desc"/>
                            </span>
                            <span t-if="!c.resolvedActionId" class="dl-pricing-row-soon">Sắp có</span>
                            <i t-else="" class="fa fa-angle-right dl-pricing-row-arrow"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
