<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="dl_product.DlProductHome">
        <div class="dl-config dl-product o_action">
            <div class="dl-product-inner">
                <!-- Page header -->
                <div class="dl-product-head">
                    <div class="dl-product-head-main">
                        <h1 class="dl-product-title">Sản phẩm &amp; Vật tư</h1>
                        <span class="dl-product-subtitle">Danh sách Sản Phẩm &amp; Vật tư và Danh mục</span>
                    </div>
                </div>

                <div class="dl-product-rows">
                    <t t-foreach="cards" t-as="c" t-key="c.key">
                        <div class="dl-product-row" t-on-click="() => this.openCard(c)">
                            <span class="dl-product-row-icon">
                                <i t-att-class="'fa ' + c.icon"/>
                            </span>
                            <span class="dl-product-row-body">
                                <span class="dl-product-row-name" t-esc="c.name"/>
                                <span class="dl-product-row-desc" t-esc="c.desc"/>
                            </span>
                            <i class="fa fa-angle-right dl-product-row-arrow"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
