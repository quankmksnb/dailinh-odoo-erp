<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nhóm sản phẩm dùng chung (product.category).
         'category_kind' của thiết kế cũ đã bỏ — phân loại nay ở product_kind cấp sản phẩm. -->
    <record id="material_categ_steel_sheet" model="product.category">
        <field name="name">Thép tấm</field>
    </record>
    <record id="material_categ_steel_box" model="product.category">
        <field name="name">Thép hộp</field>
    </record>
    <record id="material_categ_steel_pipe" model="product.category">
        <field name="name">Thép ống</field>
    </record>
    <record id="material_categ_paint" model="product.category">
        <field name="name">Sơn</field>
    </record>
    <record id="material_categ_consumable" model="product.category">
        <field name="name">Vật tư tiêu hao</field>
    </record>
    <record id="material_categ_outsource" model="product.category">
        <field name="name">Gia công ngoài</field>
    </record>
</odoo>
