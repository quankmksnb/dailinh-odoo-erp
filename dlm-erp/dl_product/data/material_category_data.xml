<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nhóm sản phẩm dùng chung (product.category) — cây 2 cấp:
         • Thành phẩm  : SP bán ra (gia công theo BOM / thương mại nhập bán).
         • Vật tư      : đầu vào sản xuất (NVL thô, sơn, tiêu hao, kể cả
                         Bán thành phẩm — khớp màn Vật tư gồm product_kind
                         material + material_processed).
         Lưu ý: nhóm CHỈ là danh mục catalog + nơi treo BOM mẫu; phân loại
         nghiệp vụ nằm ở product_kind cấp sản phẩm ('category_kind' cũ đã bỏ). -->
    <record id="categ_root_finished" model="product.category">
        <field name="name">Thành phẩm</field>
    </record>
    <record id="categ_root_material" model="product.category">
        <field name="name">Vật tư</field>
    </record>

    <record id="material_categ_steel_sheet" model="product.category">
        <field name="name">Thép tấm</field>
        <field name="parent_id" ref="categ_root_material"/>
    </record>
    <record id="material_categ_steel_box" model="product.category">
        <field name="name">Thép hộp</field>
        <field name="parent_id" ref="categ_root_material"/>
    </record>
    <record id="material_categ_steel_pipe" model="product.category">
        <field name="name">Thép ống</field>
        <field name="parent_id" ref="categ_root_material"/>
    </record>
    <record id="material_categ_paint" model="product.category">
        <field name="name">Sơn</field>
        <field name="parent_id" ref="categ_root_material"/>
    </record>
    <record id="material_categ_consumable" model="product.category">
        <field name="name">Vật tư tiêu hao</field>
        <field name="parent_id" ref="categ_root_material"/>
    </record>
    <record id="material_categ_semi" model="product.category">
        <field name="name">Bán thành phẩm</field>
        <field name="parent_id" ref="categ_root_material"/>
    </record>
</odoo>
