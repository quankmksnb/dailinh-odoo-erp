<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============ NHÀ CUNG CẤP (res.partner) ============ -->
        <record id="demo_supplier_nam_dinh" model="res.partner">
            <field name="name">Công ty TNHH Thép Nam Định</field>
            <field name="company_type">company</field>
            <field name="partner_type">company</field>
            <field name="partner_role">supplier</field>
        </record>
        <record id="demo_supplier_thanh_hoa" model="res.partner">
            <field name="name">Công ty CP Thép Thanh Hóa</field>
            <field name="company_type">company</field>
            <field name="partner_type">company</field>
            <field name="partner_role">supplier</field>
        </record>
        <record id="demo_supplier_hoa_thanh_que" model="res.partner">
            <field name="name">Cơ khí Hoa Thanh Quế</field>
            <field name="company_type">company</field>
            <field name="partner_type">company</field>
            <field name="partner_role">supplier</field>
        </record>
        <record id="demo_supplier_kim_long" model="res.partner">
            <field name="name">Nội thất Kim Long</field>
            <field name="company_type">company</field>
            <field name="partner_type">company</field>
            <field name="partner_role">supplier</field>
        </record>

        <!-- ============ NHÓM SẢN PHẨM (product.category) ============ -->
        <record id="categ_khung_thep_han" model="product.category">
            <field name="name">Khung thép hàn</field>
        </record>
        <record id="categ_ban_ghe_sat" model="product.category">
            <field name="name">Bàn ghế sắt</field>
        </record>

        <!-- ============ PROD-02 — SẢN PHẨM (product.product) ============ -->
        <!-- (1) manufactured — SP gia công theo BOM -->
        <record id="demo_product_ct200" model="product.product">
            <field name="name">Khung thép hàn CT-200</field>
            <field name="default_code">CT-200</field>
            <field name="product_kind">manufactured</field>
            <field name="categ_id" ref="categ_khung_thep_han" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
        </record>

        <!-- (2) trading — SP thương mại, tra giá NCC (không BOM) -->
        <record id="demo_product_gs100" model="product.product">
            <field name="name">Ghế sắt sơn tĩnh điện GS-100</field>
            <field name="default_code">GS-100</field>
            <field name="product_kind">trading</field>
            <field name="categ_id" ref="categ_ban_ghe_sat" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
            <field name="seller_ids" eval="[(0, 0, {
                'partner_id': ref('demo_supplier_kim_long'),
                'price': 450000,
                'date_start': '2026-06-20',
                'approval_state': 'approved',
            })]" />
        </record>

        <!-- (3) material — vật tư thô, tra giá NCC -->
        <record id="demo_product_thep_cuon" model="product.product">
            <field name="name">Thép cuộn CT3</field>
            <field name="default_code">VT-001</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="categ_khung_thep_han" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_kgm" />
            <field name="uom_po_id" ref="uom.product_uom_kgm" />
            <field name="seller_ids" eval="[(0, 0, {
                'partner_id': ref('demo_supplier_nam_dinh'),
                'price': 22000,
                'date_start': '2026-06-01',
                'approval_state': 'approved',
            })]" />
        </record>
        <record id="demo_product_ong_vuong" model="product.product">
            <field name="name">Ống thép vuông 25×25×1.5mm</field>
            <field name="default_code">VT-014</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="categ_khung_thep_han" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_kgm" />
            <field name="uom_po_id" ref="uom.product_uom_kgm" />
            <field name="seller_ids" eval="[(0, 0, {
                'partner_id': ref('demo_supplier_thanh_hoa'),
                'price': 27000,
                'date_start': '2026-06-01',
                'approval_state': 'approved',
            })]" />
        </record>
        <record id="demo_product_oc_vit" model="product.product">
            <field name="name">Ốc vít M6</field>
            <field name="default_code">VT-032</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="categ_khung_thep_han" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
            <field name="seller_ids" eval="[(0, 0, {
                'partner_id': ref('demo_supplier_hoa_thanh_que'),
                'price': 500,
                'date_start': '2026-05-01',
                'approval_state': 'approved',
            })]" />
        </record>

        <!-- (4) material_processed — vật tư đã gia công, có BOM riêng -->
        <record id="demo_product_tam_sat" model="product.product">
            <field name="name">Tấm sắt phủ sơn 600×400×2mm</field>
            <field name="default_code">BTP-TAMSAT-01</field>
            <field name="product_kind">material_processed</field>
            <field name="categ_id" ref="categ_khung_thep_han" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
        </record>
        <record id="demo_product_khung_ong" model="product.product">
            <field name="name">Khung ống vuông 25×25×1.5mm (bộ)</field>
            <field name="default_code">BTP-KHUNGONG-01</field>
            <field name="product_kind">material_processed</field>
            <field name="categ_id" ref="categ_khung_thep_han" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
        </record>

        <!-- ============ PROD-04/05/06 — MEASUREMENT ============ -->
        <record id="demo_meas_type_weight" model="dl.measurement.type">
            <field name="name">Khối lượng (Weight)</field>
            <field name="description">Đo theo kg — vật tư kim loại tính theo trọng lượng.</field>
        </record>
        <record id="demo_meas_type_area" model="dl.measurement.type">
            <field name="name">Diện tích (Area)</field>
            <field name="description">Đo theo m² — vật tư dạng tấm/khối lưu kho theo diện tích.</field>
        </record>

        <record id="demo_meas_shape_flat" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="demo_meas_type_weight" />
            <field name="name">Tấm phẳng</field>
            <field name="code">flat_plate</field>
            <field name="default_coefficient">7850</field>
            <field name="coefficient_label">Khối lượng riêng (kg/m³)</field>
        </record>
        <record id="demo_meas_shape_square_tube" model="dl.measurement.shape">
            <field name="measurement_type_id" ref="demo_meas_type_weight" />
            <field name="name">Ống vuông rỗng</field>
            <field name="code">hollow_square_tube</field>
            <field name="default_coefficient">7850</field>
            <field name="coefficient_label">Khối lượng riêng (kg/m³)</field>
        </record>

        <record id="demo_meas_param_flat_len" model="dl.measurement.shape.param">
            <field name="shape_id" ref="demo_meas_shape_flat" />
            <field name="name">Chiều dài</field>
            <field name="code">length</field>
        </record>
        <record id="demo_meas_param_flat_wid" model="dl.measurement.shape.param">
            <field name="shape_id" ref="demo_meas_shape_flat" />
            <field name="name">Chiều rộng</field>
            <field name="code">width</field>
        </record>
        <record id="demo_meas_param_flat_thick" model="dl.measurement.shape.param">
            <field name="shape_id" ref="demo_meas_shape_flat" />
            <field name="name">Độ dày</field>
            <field name="code">thickness</field>
        </record>
        <record id="demo_meas_param_tube_len" model="dl.measurement.shape.param">
            <field name="shape_id" ref="demo_meas_shape_square_tube" />
            <field name="name">Chiều dài</field>
            <field name="code">length</field>
        </record>
        <record id="demo_meas_param_tube_side" model="dl.measurement.shape.param">
            <field name="shape_id" ref="demo_meas_shape_square_tube" />
            <field name="name">Cạnh ngoài</field>
            <field name="code">side</field>
        </record>
        <record id="demo_meas_param_tube_thick" model="dl.measurement.shape.param">
            <field name="shape_id" ref="demo_meas_shape_square_tube" />
            <field name="name">Độ dày thành ống</field>
            <field name="code">thickness</field>
        </record>

    </data>
</odoo>
