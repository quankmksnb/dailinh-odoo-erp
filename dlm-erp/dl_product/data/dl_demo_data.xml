<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============ NHÓM SẢN PHẨM (product.category) ============
             Nhóm THÀNH PHẨM demo — nằm dưới gốc "Thành phẩm"
             (material_category_data.xml). Vật tư/BTP demo dùng nhóm vật tư
             chuẩn có sẵn, KHÔNG nhét chung vào nhóm thành phẩm. -->
        <record id="categ_khung_thep_han" model="product.category">
            <field name="name">Khung thép hàn</field>
            <field name="parent_id" ref="categ_root_finished"/>
        </record>
        <record id="categ_ban_ghe_sat" model="product.category">
            <field name="name">Bàn ghế sắt</field>
            <field name="parent_id" ref="categ_root_finished"/>
        </record>

        <!-- ============ PROD-02 — SẢN PHẨM (product.product) ============ -->
        <!-- (1) manufactured — SP gia công theo BOM -->
        <record id="demo_product_ct200" model="product.product">
            <field name="name">Khung thép hàn CT-200</field>
            <field name="default_code">CT-200</field>
            <field name="product_kind">manufactured</field>
            <field name="categ_id" ref="categ_khung_thep_han" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
        </record>

        <!-- (2) trading — SP thương mại, tra giá NCC (không BOM) -->
        <record id="demo_product_gs100" model="product.product">
            <field name="name">Ghế sắt sơn tĩnh điện GS-100</field>
            <field name="default_code">GS-100</field>
            <field name="product_kind">trading</field>
            <field name="categ_id" ref="categ_ban_ghe_sat" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
        </record>

        <!-- (3) material — vật tư thô, tra giá NCC. Nhóm = nhóm VẬT TƯ chuẩn
             (material_category_data.xml), mã theo convention seed VT-<nhóm>-<spec>. -->
        <!-- Tôn cuộn: mua theo CUỘN, tính như tấm (khổ = cuộn trải ra). -->
        <record id="demo_product_thep_cuon" model="product.product">
            <field name="name">Thép cuộn CT3 dày 2mm (khổ 1250 × cuộn 20m)</field>
            <field name="default_code">VT-TT-CT3-CUON</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="material_categ_steel_sheet" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="dlm_uom_cuon" />
            <field name="uom_po_id" ref="dlm_uom_cuon" />
            <field name="dlm_calc_kind">sheet</field>
            <field name="dlm_spec_t">2</field>
            <field name="dlm_sheet_w">1250</field>
            <field name="dlm_sheet_h">20000</field>
            <field name="dlm_mass_per_unit">392.5</field>
            <field name="dlm_density">7850</field>
            <field name="dlm_waste_rate">3.0</field>
            <field name="dlm_has_recovery">1</field>
            <field name="dlm_recovery_rate">60.0</field>
            <field name="dlm_scrap_product_id" ref="seed_scrap_steel" />
        </record>
        <!-- Mã VT-TH-25 đã là vật tư seed chuẩn; bản demo này là quy cách dày
             1.5mm nên tách mã riêng để không đụng ràng buộc mã duy nhất. -->
        <record id="demo_product_ong_vuong" model="product.product">
            <field name="name">Thép hộp vuông 25×25×1.5mm</field>
            <field name="default_code">VT-TH-25-15</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="material_categ_steel_box" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="dlm_uom_cay" />
            <field name="uom_po_id" ref="dlm_uom_cay" />
            <field name="dlm_calc_kind">cut_length</field>
            <field name="dlm_profile_kind">box</field>
            <field name="dlm_spec_a">25</field>
            <field name="dlm_spec_t">1.5</field>
            <field name="dlm_stock_length">6000</field>
            <field name="dlm_mass_per_unit">5.6</field>
            <field name="dlm_density">7850</field>
            <field name="dlm_waste_rate">4.5</field>
            <field name="dlm_has_recovery">1</field>
            <field name="dlm_recovery_rate">55.0</field>
            <field name="dlm_scrap_product_id" ref="seed_scrap_steel" />
        </record>
        <record id="demo_product_oc_vit" model="product.product">
            <field name="name">Ốc vít M6</field>
            <field name="default_code">VT-OCVIT-M6</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="material_categ_consumable" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
            <field name="dlm_calc_kind">count</field>
            <field name="dlm_waste_rate">1.0</field>
            <field name="dlm_has_recovery">0</field>
        </record>

        <!-- (4) material_processed — bán thành phẩm (có BOM riêng), nhóm
             "Bán thành phẩm" dưới gốc Vật tư. -->
        <record id="demo_product_tam_sat" model="product.product">
            <field name="name">Tấm sắt phủ sơn 600×400×2mm</field>
            <field name="default_code">BTP-TAMSAT-01</field>
            <field name="product_kind">material_processed</field>
            <field name="categ_id" ref="material_categ_semi" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
        </record>
        <record id="demo_product_khung_ong" model="product.product">
            <field name="name">Khung hàn thép hộp 25×25×1.5mm (bộ)</field>
            <field name="default_code">BTP-KHUNGONG-01</field>
            <field name="product_kind">material_processed</field>
            <field name="categ_id" ref="material_categ_semi" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
        </record>

        <!-- PROD-04/05/06 — seed Loại/Hình dạng đo lường đã GỠ (§14 ngủ đông).
             Quy cách nay nằm trên chính vật tư; DB mới không có bản ghi đo lường
             nào để tránh dữ liệu mồ côi. Model vẫn còn nếu cần bật lại. -->

    </data>
</odoo>
