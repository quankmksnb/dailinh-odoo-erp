<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Mã SP / vật tư TỰ SINH theo loại — người dùng KHÔNG phải nhập tay
         (đồng nhất với Mã KH, Mã BOM, Mã RFQ...). Sinh ngay khi tạo bản ghi
         (product.create). Riêng SP gia công tạm từ RFQ để trống tới khi chốt
         đơn mới sinh mã chính thức (product._dlm_standardize_on_promote).
           • GC-  gia công (manufactured)
           • TM-  thương mại (trading)
           • VT-  vật tư (material)
           • BTP- bán thành phẩm (material_processed)
    ============================================================ -->
    <record id="seq_dl_product_manufactured" model="ir.sequence">
        <field name="name">Mã sản phẩm gia công</field>
        <field name="code">dl.product.manufactured</field>
        <field name="prefix">GC-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>

    <record id="seq_dl_product_trading" model="ir.sequence">
        <field name="name">Mã sản phẩm thương mại</field>
        <field name="code">dl.product.trading</field>
        <field name="prefix">TM-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>

    <record id="seq_dl_product_material" model="ir.sequence">
        <field name="name">Mã vật tư</field>
        <field name="code">dl.product.material</field>
        <field name="prefix">VT-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>

    <record id="seq_dl_product_material_processed" model="ir.sequence">
        <field name="name">Mã bán thành phẩm</field>
        <field name="code">dl.product.material_processed</field>
        <field name="prefix">BTP-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>

    <!-- ============================================================
         Nháp mồ côi: SP gia công còn Nháp mà RFQ không chốt thành đơn.
         Cron tự chuyển 'Ngừng' khi quá hạn (ngưỡng ir.config_parameter).
    ============================================================ -->
    <record id="param_orphan_draft_days" model="ir.config_parameter">
        <field name="key">dl_product.orphan_draft_days</field>
        <field name="value">30</field>
    </record>

    <record id="cron_obsolete_orphan_drafts" model="ir.cron">
        <field name="name">DL: Dọn nháp sản phẩm gia công mồ côi</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">model._cron_obsolete_orphan_drafts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Rà soát tay: mở danh sách nháp mồ côi (mọi tuổi) để Kỹ thuật xử lý -->
    <record id="action_review_orphan_drafts" model="ir.actions.server">
        <field name="name">Nháp mồ côi (rà soát)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">action = model.action_dlm_review_orphan_drafts()</field>
    </record>

    <menuitem
        id="menu_dl_orphan_drafts"
        name="Nháp mồ côi (rà soát)"
        action="action_review_orphan_drafts"
        parent="menu_dl_product_root"
        sequence="14"
        groups="dl_base.dl_group_tech,dl_base.dl_group_admin"
    />
</odoo>
