<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         SEED VẬT TƯ — doanh nghiệp cơ khí sắt thép Đại Linh.
         Cùng bảng product.product (product_kind = material) như màn
         "Vật tư" và bảng Hao hụt của "Cấu hình Báo giá": SỬA Ở BẤT KỲ
         MÀN NÀO CŨNG LÀ CÙNG MỘT DỮ LIỆU (các field dlm_*).

         noupdate="1": seed một lần khi cài/-u, sau đó cho phép sửa tự do
         (config linh động) mà lần -u sau KHÔNG ghi đè giá trị đã chỉnh.
    ============================================================ -->
    <data noupdate="1">

        <!-- Sản phẩm phế liệu: đơn giá thu hồi lấy từ list_price của nó.
             Recovery của vật tư bên dưới trỏ về đây. -->
        <record id="seed_scrap_steel" model="product.product">
            <field name="name">Phế liệu thép (thu hồi)</field>
            <field name="default_code">SCRAP-STEEL</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="material_categ_consumable" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_kgm" />
            <field name="uom_po_id" ref="uom.product_uom_kgm" />
            <field name="list_price">8000</field>
        </record>

        <!-- ============ THÉP TẤM (cắt CNC/plasma — hao hụt cao, thu hồi tốt) ============ -->
        <record id="seed_mat_tt_ct3_2" model="product.product">
            <field name="name">Thép tấm CT3 dày 2mm (1250×2500)</field>
            <field name="default_code">VT-TT-CT3-2</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="material_categ_steel_sheet" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_kgm" />
            <field name="uom_po_id" ref="uom.product_uom_kgm" />
            <field name="dlm_waste_rate">7.0</field>
            <field name="dlm_has_recovery">1</field>
            <field name="dlm_recovery_rate">65.0</field>
            <field name="dlm_scrap_product_id" ref="seed_scrap_steel" />
            <field name="dlm_density">7850</field>
        </record>
        <record id="seed_mat_tt_ct3_5" model="product.product">
            <field name="name">Thép tấm CT3 dày 5mm (1500×6000)</field>
            <field name="default_code">VT-TT-CT3-5</field>
            <field name="product_kind">material</field>
            <field name="categ_id" ref="material_categ_steel_sheet" />
            <field name="detailed_type">product</field>
            <field name="uom_id" ref="uom.product_uom_kgm" />
            <field name="uom_po_id" ref="uom.product_uom_kgm" />
            <field name="dlm_waste_rate">5.0</field>
            <field name="dlm_has_recovery">1</field>
            <field name="dlm_recovery_rate">65.0</field>
            <field name="dlm_scrap_product_id" ref="seed_scrap_steel" />
            <field name="dlm_density">7850</field>
        </record>
