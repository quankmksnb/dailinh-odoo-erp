            <field name="vat">0301567890</field>
            <field name="phone">024 3856 2020</field>
            <field name="email">vanthu@thptleloi.edu.vn</field>
            <field name="street">15 Nguyễn Trãi</field>
            <field name="city">Hà Nội</field>
        </record>

        <!-- (6) Công ty nội thất — khách doanh nghiệp mua khung/kệ đều đặn. -->
