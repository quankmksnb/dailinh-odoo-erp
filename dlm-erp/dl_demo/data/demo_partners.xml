            <field name="name">Kim khí Thăng Long</field>
            <field name="partner_role">supplier</field>
            <field name="company_type">company</field>
            <field name="vat">0104556677</field>
            <field name="phone">024 3765 3434</field>
            <field name="email">sales@kimkhithanglong.vn</field>
            <field name="street">88 Nguyễn Văn Cừ</field>
            <field name="city">Hà Nội</field>
        </record>

    </data>
</odoo>
