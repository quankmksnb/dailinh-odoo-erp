<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- K1 — Tính năng Kho trên màn Phân quyền.
             ⚠️ `code` phải DUY NHẤT toàn hệ thống (ràng buộc code_uniq). Tiền tố
             stock_ để không đụng các code ngắn đang dùng (products, category,
             bom, quotation...). Đổi code sau này = sinh bản ghi mới chứ không
             phải đổi tên — sẽ để lại feature mồ côi làm -u chết. -->

        <record id="feat_stock_quant" model="dl.rbac.feature">
            <field name="name">Tồn kho</field>
            <field name="code">stock_quant</field>
            <field name="model_id" ref="stock.model_stock_quant" />
            <field name="category">master</field>
            <field name="sequence">50</field>
        </record>

        <record id="feat_stock_picking" model="dl.rbac.feature">
            <field name="name">Phiếu kho (nhận / kiểm / chuyển / giao)</field>
            <field name="code">stock_picking</field>
            <field name="model_id" ref="stock.model_stock_picking" />
            <field name="category">master</field>
            <field name="sequence">51</field>
        </record>

        <record id="feat_stock_lot" model="dl.rbac.feature">
            <field name="name">Lô hàng</field>
            <field name="code">stock_lot</field>
            <field name="model_id" ref="stock.model_stock_lot" />
            <field name="category">master</field>
            <field name="sequence">52</field>
        </record>

        <record id="feat_stock_location" model="dl.rbac.feature">
            <field name="name">Vị trí kho</field>
            <field name="code">stock_location</field>
            <field name="model_id" ref="stock.model_stock_location" />
            <field name="category">system</field>
            <field name="sequence">53</field>
        </record>

        <!-- Kiểm kê KHÔNG có model riêng (Odoo dùng chế độ kiểm kê ngay trên
             stock.quant). Khai feature không model_id — giống cách feat_supplier
             của dl_partner cố ý bỏ trống — để màn Phân quyền vẫn liệt kê được
             nghiệp vụ này cho người quản trị đọc. -->
        <record id="feat_stock_inventory" model="dl.rbac.feature">
            <field name="name">Kiểm kê</field>
            <field name="code">stock_inventory</field>
            <field name="category">master</field>
            <field name="sequence">54</field>
        </record>

    </data>
</odoo>
