<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         K5 — M2 Nhận hàng NCC + M3 Kiểm & cất hàng
         docs/Thiet_ke_phan_he_kho.md §6, §11.3, §11.4

         MỘT list dùng chung cho cả ba màn (Nhận / Kiểm / Hàng đợi): ba màn khác
         nhau ở VIỆC PHẢI LÀM chứ không ở cột hiển thị. Ba bản tree gần giống
         nhau là ba chỗ phải sửa mỗi lần đổi cột.

         Hai FORM thì tách thật, vì nhãn cột khác hẳn nghiệp vụ:
         "Dự kiến / Thực nhận" (đếm số NCC giao) ≠ "NCC giao / Đạt / Loại"
         (kiểm chất lượng). Dùng chung một form rồi đổi nhãn bằng điều kiện là
         cách nhanh nhất để thủ kho ghi nhầm hàng thiếu thành hàng lỗi.
    ============================================================ -->

    <record id="view_dl_picking_tree" model="ir.ui.view">
        <field name="name">dl.stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <tree string="Phiếu kho" class="dl-picking-list"
                  decoration-muted="state == 'cancel'">
                <field name="name" string="Số phiếu"/>
                <field name="picking_type_id" string="Loại phiếu" optional="show"/>
                <field name="partner_id" string="Đối tác"/>
                <field name="scheduled_date" string="Ngày" widget="date"/>
                <field name="origin" string="Nguồn" optional="hide"/>
                <field name="dlm_qty_rejected_total" widget="dl_qty" string="Số loại"
                       optional="show"/>
                <!-- Chip kết quả kiểm: đọc được cả cột trạng thái phiếu lẫn chất
                     lượng hàng mà không phải mở từng phiếu. -->
                <field name="dlm_qc_state" string="Kiểm hàng" widget="badge"
                       decoration-success="dlm_qc_state == 'passed'"
                       decoration-warning="dlm_qc_state == 'pending'"
                       decoration-danger="dlm_qc_state == 'has_reject'"
                       invisible="dlm_qc_state == 'none'" optional="show"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'assigned'"
                       decoration-muted="state in ('draft', 'cancel')"/>
            </tree>
        </field>
    </record>

    <!-- Bản KHÔNG cho tạo, cho những màn mà phiếu do hệ thống sinh ra (Kiểm
         hàng). Kế thừa primary thay vì chép lại cả bảng cột: `create` chỉ đọc
         được từ thuộc tính trên arch — `context="{'create': False}"` của
         act_window KHÔNG có tác dụng ở Odoo 17 (chỉ `getActiveActions` đọc arch).
         Đã vấp thật: list dùng chung để create="0" làm màn Nhận hàng mất luôn
         nút Tạo, trong khi ô trạng thái rỗng vẫn mời "tạo một phiếu nhận". -->
    <record id="view_dl_picking_tree_nocreate" model="ir.ui.view">
        <field name="name">dl.stock.picking.tree.nocreate</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="view_dl_picking_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="create">0</attribute>
            </tree>
        </field>
    </record>

    <!-- ============================================================
         M2 — Nhận hàng NCC (phiếu [1]: NCC → Chờ kiểm hàng)
    ============================================================ -->
    <record id="view_dl_receipt_form" model="ir.ui.view">
        <field name="name">dl.stock.picking.receipt.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Nhận hàng nhà cung cấp" class="dl-receipt-form">
                <header>
                    <!-- 1 CTA btn-primary cho mỗi trạng thái; phụ = secondary;
                         phá huỷ = danger (quy ước §11.1). -->
                    <button name="action_confirm" string="Xác nhận phiếu"
                            type="object" class="btn-primary"
                            invisible="state != 'draft' or dlm_blocked"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <button name="button_validate" string="Xác nhận nhận hàng"
                            type="object" class="btn-primary"
                            invisible="state not in ('waiting', 'confirmed', 'assigned') or dlm_blocked"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <button name="action_dlm_open_qc_picking" string="Mở phiếu kiểm"
                            type="object" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button name="action_cancel" string="Huỷ phiếu"
                            type="object" class="btn-danger"
                            invisible="state in ('done', 'cancel')"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <!-- RS-12 (§11.3) — nhãn của XƯỞNG, không phải của Odoo:
                         "Hoàn tất" trên phiếu nhận khiến thủ kho tưởng xong cả
                         việc kiểm, trong khi hàng mới chỉ vào khu Chờ kiểm. -->
                    <field name="state" widget="dl_stepper"
                           statusbar_visible="draft,assigned,done"
                           options="{'labels': {'draft': 'Nháp', 'assigned': 'Chờ nhận', 'done': 'Đã nhận'}}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_dlm_open_returns" type="object"
                                class="oe_stat_button" icon="fa-reply"
                                invisible="dlm_return_count == 0">
                            <field name="dlm_return_count" widget="statinfo"
                                   string="Phiếu trả nhà cung cấp"/>
                        </button>
                    </div>

                    <!-- company_id: domain của partner_id/picking_type_id trên
                         stock.picking tham chiếu tới nó ⇒ thiếu là view không nạp được. -->
                    <field name="company_id" invisible="1"/>
                    <!-- location_id/dest do picking_type suy ra (NCC → Chờ kiểm).
                         Phải khai để o2m move_ids truyền xuống làm vị trí nguồn/đích
                         cho mỗi dòng — thiếu thì stock.move không có Source Location,
                         Lưu sẽ lỗi "trường bắt buộc chưa được đặt". Ẩn: thủ kho không
                         chọn tay, cả hai đã cố định theo loại phiếu Nhận hàng NCC. -->
                    <field name="location_id" invisible="1"/>
                    <field name="location_dest_id" invisible="1"/>
                    <!-- SM-02: khi chưa chọn NCC thì bảng dòng bị khoá (bên dưới),
                         dải này giải thích vì sao — inline, không modal. -->
                    <div class="alert alert-info" role="alert" invisible="partner_id">
                        Chọn <b>Nhà cung cấp</b> trước — danh sách mặt hàng sẽ lọc
                        theo đúng những gì nhà cung cấp đó cung cấp.
                    </div>
                    <field name="dlm_banner_level" invisible="1"/>
                    <field name="dlm_blocked" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="dlm_banner_level != 'info'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="dlm_banner_level != 'success'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="dlm_banner_level != 'warning'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="dlm_banner_level != 'danger'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="dl-fields-row">
                        <div class="dl-field">
                            <label for="partner_id" string="Nhà cung cấp"/>
                            <field name="partner_id" nolabel="1" required="1"
                                   readonly="state in ('done', 'cancel')"
                                   domain="[('partner_role', 'in', ['supplier', 'both'])]"
                                   context="{'default_partner_role': 'supplier'}"/>
                        </div>
                        <div class="dl-field">
                            <label for="picking_type_id" string="Loại phiếu"/>
                            <!-- Domain + giá trị mặc định đều lấy từ khoá ngữ
                                 cảnh native `restricted_picking_type_code` của
                                 Odoo (xem action bên dưới): thủ kho bấm Tạo là
                                 loại phiếu đã điền sẵn "Nhận hàng NCC". -->
                            <field name="picking_type_id" nolabel="1"
                                   readonly="state != 'draft'"
                                   domain="context.get('restricted_picking_type_code') and [('code', '=', context.get('restricted_picking_type_code'))] or [('code', '=', 'incoming')]"/>
                        </div>
                        <div class="dl-field">
                            <label for="scheduled_date" string="Ngày nhận"/>
                            <field name="scheduled_date" nolabel="1"
                                   readonly="state in ('done', 'cancel')"/>
                        </div>
                        <div class="dl-field">
                            <!-- Số chứng từ của NCC: mắt xích đối chiếu khi khiếu
                                 nại — hoá đơn/phiếu giao của họ ghi số này. -->
                            <label for="origin" string="Số chứng từ của nhà cung cấp"/>
                            <field name="origin" nolabel="1"
                                   placeholder="VD: HD-2026-8841"
                                   readonly="state in ('done', 'cancel')"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Hàng nhận" name="moves">
                            <!-- SM-02: khoá thêm dòng tới khi có NCC — domain của
                                 product_id (SM-01) neo vào parent.partner_id, chưa
                                 có NCC thì danh sách rỗng, thêm dòng là vô nghĩa. -->
                            <field name="move_ids"
                                   readonly="not partner_id or state in ('done', 'cancel')"
                                   context="{'default_location_id': location_id,
                                             'default_location_dest_id': location_dest_id}">
                                <tree editable="bottom">
                                    <!-- SM-01: chỉ hiện mặt hàng NCC đang chọn thực
                                         sự cung cấp (seller_ids = bảng giá NCC). Đai
                                         an toàn product_kind: gia công/BTP tự sản
                                         xuất, không mua. no_create: hàng nhận phải là
                                         SP đã tồn tại (đã chốt giá), không đẻ tại chỗ. -->
                                    <field name="product_id" string="Mặt hàng"
                                           required="1"
                                           options="{'no_create': True}"
                                           domain="[('seller_ids.partner_id', '=', parent.partner_id),
                                                    ('product_kind', 'in', ('material', 'trading'))]"/>
                                    <field name="product_uom_qty" widget="dl_qty" string="Dự kiến"/>
                                    <field name="quantity" widget="dl_qty" string="Thực nhận"/>
                                    <field name="product_uom" string="Đơn vị tính"
                                           groups="uom.group_uom"/>
                                    <!-- Lô do hệ thống tự sinh lúc xác nhận nên
                                         cột này trống tới khi phiếu xong — đúng
                                         thực tế, đừng bày ô nhập gây hiểu nhầm. -->
                                    <field name="lot_ids" string="Số lô"
                                           widget="many2many_tags" readonly="1"/>
                                    <field name="picked" column_invisible="1"/>
                                    <!-- name/location_id/dest: đều là trường BẮT BUỘC của
                                         stock.move được điền GIÁN TIẾP (name qua onchange
                                         product_id = product.partner_ref; vị trí qua
                                         default_location_* ở context move_ids). Web chỉ
                                         GIỮ giá trị gián tiếp nếu field nằm trong active
                                         fields của tree con — thiếu khai thì bị bỏ, lưu
                                         móc lỗi "trường bắt buộc chưa được đặt". Đây là lý
                                         do Odoo core cũng khai column_invisible cả ba. -->
                                    <field name="name" column_invisible="1"/>
                                    <field name="location_id" column_invisible="1"/>
                                    <field name="location_dest_id" column_invisible="1"/>
                                    <!-- company_id: domain của product_id trên
                                         stock.move tham chiếu tới nó ⇒ thiếu là
                                         view không nạp được. -->
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_receipt_search" model="ir.ui.view">
        <field name="name">dl.stock.picking.receipt.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Nhận hàng nhà cung cấp">
                <field name="name" string="Tìm nhanh"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('origin', 'ilike', self)]"/>
                <field name="partner_id" string="Nhà cung cấp"/>
                <field name="origin" string="Số chứng từ của nhà cung cấp"/>

                <!-- Segment: 3 chip cùng một nhóm (chọn nhiều = OR, KHÔNG
                     separator giữa chúng) — tiền lệ filter trạng thái Báo giá. -->
                <filter name="todo" string="Cần nhận"
                        domain="[('state', 'in', ('waiting', 'confirmed', 'assigned'))]"/>
                <filter name="received" string="Đã nhận"
                        domain="[('state', '=', 'done')]"/>
                <filter name="draft" string="Nháp"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="cancelled" string="Đã huỷ"
                        domain="[('state', '=', 'cancel')]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner" string="Nhà cung cấp"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Ngày nhận"
                            context="{'group_by': 'scheduled_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_picking_receipt" model="ir.actions.act_window">
        <field name="name">Nhận hàng nhà cung cấp</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('picking_type_id.code', '=', 'incoming')]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_picking_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_receipt_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_receipt_search"/>
        <field name="context">{'restricted_picking_type_code': 'incoming'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có phiếu nhận hàng nào</p>
            <p>Mỗi lần nhà cung cấp giao hàng, tạo một phiếu nhận. Hàng vào khu
               <b>Chờ kiểm hàng</b> trước, kiểm đạt mới cất vào kho.</p>
        </field>
    </record>

    <!-- ============================================================
         M3 — Kiểm & cất hàng ★ (phiếu [2]: Chờ kiểm → Vật tư & HTM)
         Màn quan trọng nhất: chỗ DUY NHẤT phân biệt "NCC giao thiếu" với
         "NCC giao hàng kém".
    ============================================================ -->
    <record id="view_dl_qc_form" model="ir.ui.view">
        <field name="name">dl.stock.picking.qc.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Kiểm &amp; cất hàng" class="dl-qc-form" create="0">
                <header>
                    <!-- Nút biến mất khi còn lỗi thay vì bày nút bấm-không-được:
                         dải đỏ ngay dưới đã liệt kê đích danh dòng nào sai.
                         KHÔNG modal xác nhận — dải hệ quả đã nói rõ hàng loại đi
                         đâu và ai xử lý tiếp (§11.4). -->
                    <button name="action_dlm_validate_qc" string="Xác nhận kiểm"
                            type="object" class="btn-primary"
                            invisible="state in ('done', 'cancel') or dlm_blocked"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <button name="action_dlm_pass_all" string="Đạt tất cả"
                            type="object" class="btn-secondary"
                            invisible="state in ('done', 'cancel') or dlm_wait_receipt"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <!-- RS-12 (§11.4) — "Đang chờ / Sẵn sàng / Hoàn tất" là
                         ngôn ngữ Odoo. Thủ kho đọc theo việc: chờ kiểm → đang
                         kiểm → đã cất vào kho. -->
                    <field name="state" widget="dl_stepper"
                           statusbar_visible="waiting,confirmed,assigned,done"
                           options="{'labels': {'waiting': 'Chờ hàng về', 'confirmed': 'Chờ kiểm', 'assigned': 'Đang kiểm', 'done': 'Đã cất'}}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_dlm_open_source_receipt" type="object"
                                class="oe_stat_button" icon="fa-download">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Phiếu nhận</span>
                                <span class="o_stat_text">gốc</span>
                            </div>
                        </button>
                        <button name="action_dlm_open_returns" type="object"
                                class="oe_stat_button" icon="fa-reply"
                                invisible="dlm_return_count == 0">
                            <field name="dlm_return_count" widget="statinfo"
                                   string="Phiếu trả nhà cung cấp"/>
                        </button>
                    </div>

                    <field name="dlm_blocked" invisible="1"/>
                    <field name="dlm_wait_receipt" invisible="1"/>
                    <!-- company_id: domain của partner_id/picking_type_id trên
                         stock.picking tham chiếu tới nó ⇒ thiếu là view không nạp được. -->
                    <field name="company_id" invisible="1"/>
                    <field name="dlm_banner_level" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="dlm_banner_level != 'info'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="dlm_banner_level != 'success'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="dlm_banner_level != 'warning'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="dlm_banner_level != 'danger'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="dl-fields-row">
                        <div class="dl-field">
                            <label for="partner_id" string="Nhà cung cấp"/>
                            <field name="partner_id" nolabel="1" readonly="1"/>
                        </div>
                        <div class="dl-field">
                            <label for="origin" string="Từ phiếu"/>
                            <field name="origin" nolabel="1" readonly="1"/>
                        </div>
                        <div class="dl-field">
                            <label for="scheduled_date" string="Ngày kiểm"/>
                            <field name="scheduled_date" nolabel="1"
                                   readonly="state in ('done', 'cancel')"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Kết quả kiểm" name="qc">
                            <!-- Ba cột số ĐẶT CẠNH NHAU để so bằng mắt theo hàng
                                 ngang; hàng tổng do `sum` của list dựng sẵn. -->
                            <field name="move_ids" readonly="state in ('done', 'cancel')">
                                <tree editable="bottom" create="0" delete="0"
                                      decoration-danger="dlm_qc_over"
                                      decoration-warning="dlm_qty_rejected &gt; 0 and not dlm_qc_over">
                                    <!-- SM-08: khu Chờ kiểm chứa cả SP thương mại,
                                         không riêng vật tư — nhãn "Mặt hàng" nhất
                                         quán với Nhận hàng (SM-01)/Chuyển/Giao. -->
                                    <field name="product_id" string="Mặt hàng"
                                           readonly="1"/>
                                    <field name="lot_ids" string="Lô"
                                           widget="many2many_tags" readonly="1"
                                           optional="show"/>
                                    <field name="product_uom_qty" widget="dl_qty" string="Nhà cung cấp giao"
                                           readonly="1" sum="Tổng"/>
                                    <field name="quantity" widget="dl_qty" string="Đạt" sum="Tổng"/>
                                    <field name="dlm_qty_rejected" widget="dl_qty" string="Loại"
                                           sum="Tổng"/>
                                    <!-- QC-03/04 — required ĐỘNG, báo ngay trên
                                         dòng; không @api.constrains bắn modal. -->
                                    <field name="dlm_reject_reason" string="Lý do loại"
                                           required="dlm_qty_rejected &gt; 0"
                                           readonly="dlm_qty_rejected &lt;= 0"/>
                                    <field name="dlm_reject_note" string="Ghi chú"
                                           required="dlm_reject_reason == 'other'"
                                           readonly="not dlm_reject_reason"
                                           placeholder="Bắt buộc khi lý do là Khác"/>
                                    <!-- K17 — chỉ dòng THẬT SỰ có hàng loại mới
                                         hiện ô ảnh: bày máy ảnh trên 20 dòng đạt
                                         là mời bấm nhầm.
                                         🔴 Nút PHẢI có `string`: cột nút trong
                                         list của Odoo luôn render <th> RỖNG
                                         (list_renderer.xml), nên icon trần đứng
                                         dưới một tiêu đề trắng — không hover thì
                                         không đoán được nó làm gì. `icon` +
                                         `string` hiện được cùng lúc. -->
                                    <field name="dlm_evidence_count" string="Ảnh"
                                           invisible="dlm_qty_rejected &lt;= 0"/>
                                    <button name="action_dlm_open_evidence"
                                            type="object" icon="fa-camera"
                                            string="Bằng chứng"
                                            title="Chụp / xem ảnh hàng lỗi của dòng này"
                                            invisible="dlm_qty_rejected &lt;= 0"/>
                                    <field name="product_uom" string="Đơn vị tính"
                                           groups="uom.group_uom" readonly="1"/>
                                    <field name="dlm_qc_over" column_invisible="1"/>
                                    <field name="picked" column_invisible="1"/>
                                    <!-- company_id: domain của product_id trên
                                         stock.move tham chiếu tới nó ⇒ thiếu là
                                         view không nạp được. -->
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================
         K17 — Hộp ảnh bằng chứng của MỘT dòng hàng loại.

         MỘT view dùng cho cả ba chặng ([2] kiểm, [3] trả NCC, [9] hoá phế
         liệu): quyền ghi không do view quyết mà do `dlm_evidence_locked`
         (compute theo loại phiếu + trạng thái) — nuôi ba bản view chỉ để đổi
         readonly là ba chỗ để lệch nhau.
    ================================================================ -->
    <record id="view_dl_move_evidence_form" model="ir.ui.view">
        <field name="name">dl.stock.move.evidence.form</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form string="Bằng chứng hàng loại">
                <sheet>
                    <!-- company_id / product_uom_category_id: domain của
                         product_id + product_uom trên stock.move tham chiếu tới
                         chúng ⇒ thiếu là view không nạp được. -->
                    <field name="company_id" invisible="1"/>
                    <field name="product_uom_category_id" invisible="1"/>
                    <field name="dlm_evidence_locked" invisible="1"/>

                    <div class="alert alert-info" role="alert"
                         invisible="dlm_evidence_locked">
                        Chụp <b>chỗ lỗi</b> và <b>nhãn lô</b> trong cùng khung
                        hình — ảnh không thấy lô thì không chứng minh được nó là
                        hàng của chuyến này. Xác nhận kiểm xong là
                        <b>khoá lại</b>, không sửa được nữa.
                    </div>
                    <div class="alert alert-secondary" role="alert"
                         invisible="not dlm_evidence_locked">
                        Bằng chứng đã khoá — chỉ xem. Ảnh được chụp tại phiếu
                        kiểm, lúc hàng còn ở khu Chờ kiểm.
                    </div>

                    <group>
                        <group>
                            <field name="product_id" string="Mặt hàng" readonly="1"/>
                            <field name="dlm_reject_qty_shown" widget="dl_qty"
                                   string="Số lượng lỗi" readonly="1"/>
                        </group>
                        <group>
                            <field name="dlm_reject_reason" string="Lý do loại"
                                   readonly="1"/>
                            <field name="dlm_reject_note" string="Ghi chú"
                                   readonly="1"/>
                        </group>
                    </group>

                    <!-- ẢNH đứng TRƯỚC ô upload, và là thứ duy nhất còn lại khi
                         đã khoá: người mở hộp này để NHÌN vết lỗi, không phải để
                         quản lý danh sách file. -->
                    <separator string="Ảnh bằng chứng"/>
                    <field name="dlm_evidence_gallery" nolabel="1" readonly="1"/>

                    <div invisible="dlm_evidence_locked" class="mt-3">
                        <separator string="Thêm ảnh"/>
                        <field name="dlm_evidence_ids" widget="many2many_binary"
                               nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dl_qc_search" model="ir.ui.view">
        <field name="name">dl.stock.picking.qc.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Kiểm hàng">
                <field name="name" string="Tìm nhanh"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('origin', 'ilike', self)]"/>
                <field name="partner_id" string="Nhà cung cấp"/>
                <field name="origin" string="Từ phiếu"/>

                <filter name="pending" string="Chờ kiểm"
                        domain="[('state', 'not in', ('done', 'cancel', 'waiting'))]"/>
                <!-- `waiting` = phiếu nhận gốc chưa xác nhận: hàng chưa về, chưa
                     đếm được. Vẫn cho nhìn thấy (việc sắp tới), nhưng KHÔNG trộn
                     vào "Chờ kiểm" — trộn là mời thủ kho kiểm hàng chưa về. -->
                <filter name="waiting_receipt" string="Chờ hàng về"
                        domain="[('state', '=', 'waiting')]"/>
                <filter name="checked" string="Đã kiểm"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <!-- Phiếu có hàng loại = việc còn treo với NCC, phải lọc nhanh. -->
                <filter name="has_reject" string="Có hàng loại"
                        domain="[('dlm_qty_rejected_total', '&gt;', 0)]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner" string="Nhà cung cấp"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_qc" string="Kết quả kiểm"
                            context="{'group_by': 'dlm_qc_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_picking_qc" model="ir.actions.act_window">
        <field name="name">Kiểm hàng</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('picking_type_id.sequence_code', '=', 'KC')]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_picking_tree_nocreate')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_qc_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_qc_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Không có phiếu nào chờ kiểm</p>
            <p>Phiếu kiểm sinh ra <b>tự động</b> sau khi xác nhận một phiếu
               <b>Nhận hàng nhà cung cấp</b> — không tạo tay ở đây.</p>
        </field>
    </record>

    <!-- ============================================================
         K8 — Hàng đợi phiếu (docs/Thiet_ke_phan_he_kho.md §11.11)

         Màn LAND của Thủ kho: việc chính của họ là XỬ LÝ PHIẾU, không phải ngắm
         tồn kho ⇒ gom mọi phiếu đang ở trạng thái `assigned` (sẵn sàng thao tác)
         của các loại thủ kho phụ trách.

         🔴 Định tuyến form: một list nhưng mỗi dòng mở bằng ĐÚNG form chuyên
         biệt của loại phiếu đó (form Nhận ≠ form Kiểm — nhãn cột trái ngược).
         Không dồn về một form chung: mở phiếu kiểm bằng form nhận là mời thủ kho
         ghi hàng lỗi vào ô hàng thiếu (đúng cái nhầm §6 dựng lên để tránh). Việc
         định tuyến do `js_class="dl_picking_todo_list"` (picking_todo.js) lo,
         đọc `dlm_picking_kind` rồi doAction sang action chuyên biệt.
    ============================================================ -->
    <record id="view_dl_picking_todo_tree" model="ir.ui.view">
        <field name="name">dl.stock.picking.todo.tree</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="view_dl_picking_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="js_class">dl_picking_todo_list</attribute>
            </tree>
            <!-- Nạp kind để JS định tuyến; ẩn cột vì "Loại phiếu" đã hiện tên. -->
            <field name="state" position="after">
                <field name="dlm_picking_kind" column_invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_dl_picking_todo_search" model="ir.ui.view">
        <field name="name">dl.stock.picking.todo.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Hàng đợi phiếu">
                <field name="name" string="Tìm nhanh"
                       filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id" string="Đối tác"/>
                <!-- 4 chip theo loại việc — cùng nhóm nên chọn nhiều là OR. -->
                <filter name="kind_receipt" string="Cần nhận"
                        domain="[('picking_type_id.code', '=', 'incoming')]"/>
                <filter name="kind_qc" string="Cần kiểm"
                        domain="[('picking_type_id.sequence_code', '=', 'KC')]"/>
                <filter name="kind_transfer" string="Cần chuyển"
                        domain="[('picking_type_id.sequence_code', '=', 'CK')]"/>
                <filter name="kind_delivery" string="Cần giao"
                        domain="[('picking_type_id.sequence_code', '=', 'GH')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_type" string="Loại phiếu"
                            context="{'group_by': 'picking_type_id'}"/>
                    <filter name="group_partner" string="Đối tác"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_picking_todo" model="ir.actions.act_window">
        <field name="name">Hàng đợi phiếu</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree</field>
        <!-- assigned = đã giữ chỗ đủ, sẵn sàng thao tác. Chỉ loại thủ kho phụ
             trách (Nhận/Kiểm/Chuyển/Giao); Trả NCC là việc Mua hàng, Bán phế
             liệu đi từ màn Phế liệu — không dồn vào hàng đợi của thủ kho. -->
        <field name="domain">[('state', '=', 'assigned'),
            ('picking_type_id.sequence_code', 'in', ['NH', 'KC', 'CK', 'GH'])]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_picking_todo_tree')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_picking_todo_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hết việc — không còn phiếu nào chờ xử lý</p>
            <p>Đây là <b>hàng đợi</b> mọi phiếu đang chờ bạn: nhận hàng, kiểm &amp;
               cất, chuyển kho, giao hàng. Bấm một dòng để mở đúng phiếu.</p>
        </field>
    </record>

</odoo>
