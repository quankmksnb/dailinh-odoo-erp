<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         K6 — M6 Trả hàng NCC (phiếu [3]: Chờ trả NCC → NCC)
         docs/Thiet_ke_phan_he_kho.md §6.4, §11.7

         Chủ sở hữu là MUA HÀNG, không phải thủ kho: trả hàng là việc đối ngoại
         (đổi hàng? giảm trừ công nợ? NCC tự đến lấy?). Thủ kho ghi nhận ở bước
         kiểm, Mua hàng quyết định ở đây — đúng ranh giới kiểm soát chéo.

         Phiếu KHÔNG tạo tay ở màn này: nó sinh ra từ kết quả kiểm hàng — ba lớp
         khoá (create="0" ở list + form + bảng dòng, cộng ir.rule RS-03) đều CỐ
         Ý, chúng giữ bất biến "phiếu trả luôn truy được về một lần giao hàng cụ
         thể của NCC".

         🔴 SỬA MỘT ĐẶC TẢ SAI (§6.5, 2026-08-13): bản trước ghi hàng phát hiện
         lỗi SAU khi đã cất kho thì "làm phiếu tay từ khu Vật tư" — KHÔNG làm
         được, chính vì ba lớp khoá trên. Ở B1 ca đó xử lý ngoài hệ thống (gọi
         NCC, ghi công nợ); nếu hàng ở lại kho thì dùng nút [Chuyển thành phế
         liệu] trên màn Tồn kho (phiếu [9]). Mở đường tạo tay để lại cho B3
         cùng rail Mua hàng — phần khó là neo phiếu tay vào một lần nhận cũ,
         không phải cái nút.
    ============================================================ -->

    <record id="view_dl_vendor_return_tree" model="ir.ui.view">
        <field name="name">dl.stock.picking.vendor.return.tree</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <tree string="Trả hàng nhà cung cấp" class="dl-vendor-return-list"
                  decoration-muted="state == 'cancel'"
                  decoration-bf="state == 'draft'">
                <field name="name" string="Số phiếu"/>
                <field name="partner_id" string="Nhà cung cấp"/>
                <field name="dlm_origin_picking_id" string="Phiếu nhận gốc"/>
                <field name="dlm_qty_total" widget="dl_qty" string="Số lượng trả"/>
                <field name="dlm_reject_summary" string="Lý do"/>
                <field name="scheduled_date" string="Ngày" widget="date"
                       optional="hide"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'assigned'"
                       decoration-muted="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <!-- Không cho tạo tay: `create` chỉ đọc được từ thuộc tính trên arch,
         context={'create': False} của act_window KHÔNG có tác dụng ở Odoo 17. -->
    <record id="view_dl_vendor_return_tree_nocreate" model="ir.ui.view">
        <field name="name">dl.stock.picking.vendor.return.tree.nocreate</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="view_dl_vendor_return_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="create">0</attribute>
            </tree>
        </field>
    </record>

    <record id="view_dl_vendor_return_form" model="ir.ui.view">
        <field name="name">dl.stock.picking.vendor.return.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Trả hàng nhà cung cấp" class="dl-vendor-return-form" create="0">
                <header>
                    <!-- RS-03 — "Chốt trả hàng" và "Không trả nữa" là QUYẾT ĐỊNH
                         ĐỐI NGOẠI (đổi hàng / giảm công nợ / NCC tự lấy) ⇒ của
                         Mua hàng. Thủ kho chỉ bấm "Xác nhận đã trả" — hành động
                         VẬT LÝ lúc xe NCC tới lấy hàng. Kiểm soát chéo §8.1 giữ
                         nguyên: thủ kho ghi lỗi ở bước kiểm nhưng không quyết
                         định trả gì. `groups` ở đây chỉ là lớp ngoài — guard
                         thật nằm ở server (xem `_dlm_check_return_decision`). -->
                    <button name="action_confirm" string="Chốt trả hàng"
                            type="object" class="btn-primary"
                            groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin,dl_base.dl_group_ceo"
                            invisible="state != 'draft'"/>
                    <button name="button_validate" string="Xác nhận đã trả"
                            type="object" class="btn-primary"
                            invisible="state not in ('waiting', 'confirmed', 'assigned')"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <!-- Huỷ = thoả thuận xong không trả nữa (NCC giảm trừ công
                         nợ chẳng hạn). Hàng vẫn nằm ở khu Chờ trả NCC — lối ra
                         DUY NHẤT còn lại là nút [Chuyển thành phế liệu] bên
                         dưới (§6.4.1). -->
                    <button name="action_cancel" string="Không trả nữa"
                            type="object" class="btn-danger"
                            groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin,dl_base.dl_group_ceo"
                            invisible="state in ('done', 'cancel')"/>
                    <!-- 🔴 K12 — LỐI RA của ngõ cụt. Khu Chờ trả cấm kiểm kê tay
                         VÀ cấm làm nguồn phiếu chuyển kho, nên trước bản này
                         hàng huỷ trả nằm trong sổ vĩnh viễn. Nút chỉ hiện khi
                         phiếu đã huỷ mà hàng CÒN kẹt — hoá phế liệu xong thì
                         quant hết, nút tự tắt (không hoá hai lần cùng một lô). -->
                    <button name="action_dlm_to_scrap"
                            string="Chuyển thành phế liệu"
                            type="object" class="btn-primary"
                            invisible="state != 'cancel' or not dlm_has_stuck_stock"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <!-- K17 — đường ra khỏi hệ thống cho bằng chứng: NCC không
                         đăng nhập ERP, ảnh nằm trong Odoo thì lúc ngồi đàm phán
                         vẫn là con số không. Nút CÓ Ở MỌI TRẠNG THÁI, kể cả đã
                         xong/đã huỷ — tranh chấp thường nổ ra sau khi phiếu đã
                         đóng, và bản in lại phải ra đúng nội dung cũ.
                         KHÔNG khoá theo `groups`: thủ kho cũng cần in ra kẹp vào
                         hàng lúc xe NCC tới lấy. -->
                    <button name="action_dlm_print_reject_report"
                            string="Biên bản gửi nhà cung cấp" icon="fa-file-pdf-o"
                            type="object" class="btn-secondary"/>
                    <!-- Nút GỬI hẹp hơn nút IN ngay trên: in là việc của kho
                         (kẹp vào hàng lúc xe NCC tới lấy), còn gửi là mở đầu
                         cuộc đàm phán giảm trừ — quan hệ với NCC là của Mua
                         hàng. `groups` chỉ giấu nút; lá chắn thật nằm ở
                         action_dlm_email_reject_report. -->
                    <button name="action_dlm_email_reject_report"
                            string="Gửi biên bản qua email" icon="fa-envelope-o"
                            type="object" class="btn-secondary"
                            groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin,dl_base.dl_group_ceo"/>
                    <field name="state" widget="dl_stepper"
                           statusbar_visible="draft,assigned,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_dlm_open_source_receipt" type="object"
                                class="oe_stat_button" icon="fa-download"
                                invisible="not dlm_origin_picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Phiếu nhận</span>
                                <span class="o_stat_text">gốc</span>
                            </div>
                        </button>
                    </div>

                    <field name="company_id" invisible="1"/>
                    <!-- Odoo 17: field dùng trong `invisible` của nút PHẢI có
                         mặt trong view, không thì nạp module chết ngay. -->
                    <field name="dlm_has_stuck_stock" invisible="1"/>
                    <field name="dlm_banner_level" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="dlm_banner_level != 'info'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="dlm_banner_level != 'success'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="dl-fields-row">
                        <div class="dl-field">
                            <label for="partner_id" string="Nhà cung cấp"/>
                            <!-- RS-09 — NCC KHÔNG phải lựa chọn: nó là dữ kiện
                                 suy từ phiếu nhận. Sửa tay là phá mắt xích
                                 "hàng này của ai giao" mà cả K3–K5 dựng lên.
                                 Trả cho NCC khác thì đó là phiếu khác. -->
                            <field name="partner_id" nolabel="1" readonly="1"/>
                        </div>
                        <div class="dl-field">
                            <label for="dlm_origin_picking_id" string="Phiếu nhận gốc"/>
                            <field name="dlm_origin_picking_id" nolabel="1"
                                   readonly="1"/>
                        </div>
                        <div class="dl-field">
                            <label for="scheduled_date" string="Ngày trả"/>
                            <field name="scheduled_date" nolabel="1"
                                   readonly="state in ('done', 'cancel')"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Hàng trả" name="moves">
                            <field name="move_ids" readonly="state in ('done', 'cancel')">
                                <tree editable="bottom" create="0">
                                    <field name="product_id" string="Mặt hàng"
                                           readonly="1"/>
                                    <field name="dlm_return_lot_display"
                                           string="Lô" readonly="1"/>
                                    <field name="product_uom_qty" widget="dl_qty" string="Số lượng trả"
                                           sum="Tổng"/>
                                    <field name="product_uom" string="Đơn vị tính"
                                           groups="uom.group_uom" readonly="1"/>
                                    <field name="dlm_reject_reason" string="Lý do"
                                           readonly="1"/>
                                    <field name="dlm_reject_note" string="Ghi chú"
                                           readonly="1" optional="show"/>
                                    <!-- K17 — thứ Mua hàng thật sự cầm đi đàm
                                         phán. Chỉ-đọc: ảnh thuộc về lúc mở
                                         hàng, không thuộc về lúc thương lượng.
                                         CỐ Ý không có cột đếm ảnh như bên phiếu
                                         kiểm: ở đây câu hỏi chỉ là "có ảnh
                                         không" (nút hiện hay không), còn 2 hay 3
                                         tấm thì mở ra khắc thấy — thêm một cột
                                         số nữa là bảng tràn khung. -->
                                    <field name="dlm_evidence_count"
                                           column_invisible="1"/>
                                    <button name="action_dlm_open_evidence"
                                            type="object" icon="fa-camera"
                                            string="Bằng chứng"
                                            title="Xem ảnh hàng lỗi thủ kho chụp lúc mở hàng"
                                            invisible="dlm_evidence_count == 0"/>
                                    <field name="picked" column_invisible="1"/>
                                    <!-- company_id: domain của product_id trên
                                         stock.move tham chiếu tới nó ⇒ thiếu là
                                         view không nạp được. -->
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_vendor_return_search" model="ir.ui.view">
        <field name="name">dl.stock.picking.vendor.return.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Trả hàng nhà cung cấp">
                <field name="name" string="Tìm nhanh"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('dlm_origin_picking_id', 'ilike', self)]"/>
                <field name="partner_id" string="Nhà cung cấp"/>
                <field name="dlm_origin_picking_id" string="Phiếu nhận gốc"/>

                <!-- "Chờ xử lý" đứng đầu và là filter mặc định của action: phiếu
                     nháp là VIỆC TỒN của Mua hàng, không phải kho lưu trữ. -->
                <filter name="todo" string="Chờ xử lý"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="Đã chốt, chờ trả"
                        domain="[('state', 'in', ('waiting', 'confirmed', 'assigned'))]"/>
                <filter name="returned" string="Đã trả"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="cancelled" string="Không trả nữa"
                        domain="[('state', '=', 'cancel')]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner" string="Nhà cung cấp"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_picking_vendor_return" model="ir.actions.act_window">
        <field name="name">Trả hàng nhà cung cấp</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('picking_type_id.sequence_code', '=', 'TR')]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_vendor_return_tree_nocreate')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_vendor_return_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_vendor_return_search"/>
        <field name="context">{'search_default_todo': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Không có phiếu trả hàng nào</p>
            <p>Phiếu trả sinh ra <b>tự động</b> khi bước kiểm hàng ghi nhận hàng
               không đạt, và để ở trạng thái <b>nháp</b> để Mua hàng thoả thuận
               với nhà cung cấp trước.</p>
        </field>
    </record>

</odoo>
