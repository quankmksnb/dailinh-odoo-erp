        sequence="65"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_ceo,dl_base.dl_group_accountant"
    />

    <!-- Kỹ thuật CÓ mục này dù không đụng hàng vật lý: đây là vòng phản hồi duy
         nhất cho biết hệ số hao hụt (dlm_waste_rate) họ đặt có khớp thực tế
         không — mà hệ số đó đi thẳng vào giá báo khách. -->
    <menuitem
