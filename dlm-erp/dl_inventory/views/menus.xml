<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         K4–K5 — Menu phân hệ Kho. Cha là dl_base.menu_dl_inventory (container).
         ⚠️ Menu LÁ bắt buộc có action: rail và Home lọc mục bằng
         _hasActionableMenu — menu lá rỗng action sẽ BIẾN MẤT khỏi rail.
         Mục còn lại (Phế liệu / Kiểm kê) thêm ở K7–K8.

         "Trả hàng NCC" CÓ menu ở đây dù §11.7 xếp nó về phía Mua hàng: chưa có
         phân hệ Mua hàng (B3) nên chưa có rail nào để gắn, mà không có menu thì
         Mua hàng KHÔNG có đường nào tới việc của chính họ ngoài smart button
         trên phiếu kiểm — chứng từ họ không được phép mở. Khi B3 có rail riêng
         thì chuyển mục này sang đó.
    ============================================================ -->

    <!-- RS-10 — "Hàng đợi" đứng ĐẦU: thủ kho mở máy là thấy VIỆC, không phải
         thấy tồn kho. Màn này đã có sẵn từ K8 nhưng không menu nào trỏ tới nên
         UI chết. Landing của thủ kho vẫn là Nhận hàng (commit b081ebf) — vệt
         sáng trên rail phải khớp mục đang mở. -->
    <menuitem
        id="menu_dl_picking_todo"
        name="Hàng đợi"
        action="action_dl_picking_todo"
        parent="dl_base.menu_dl_inventory"
        sequence="5"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_ceo"
    />

    <menuitem
        id="menu_dl_stock_quant"
        name="Tồn kho"
        action="action_dl_stock_quant"
        parent="dl_base.menu_dl_inventory"
        sequence="10"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_purchasing,dl_base.dl_group_tech,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_accountant"
    />

    <menuitem
        id="menu_dl_picking_receipt"
        name="Nhận hàng"
        action="action_dl_picking_receipt"
        parent="dl_base.menu_dl_inventory"
        sequence="20"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_purchasing,dl_base.dl_group_ceo,dl_base.dl_group_accountant"
    />

    <menuitem
        id="menu_dl_picking_qc"
        name="Kiểm hàng"
        action="action_dl_picking_qc"
        parent="dl_base.menu_dl_inventory"
        sequence="30"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_purchasing,dl_base.dl_group_ceo,dl_base.dl_group_accountant"
    />

    <!-- K13 — Đầu ra của nhánh gia công.
         🔴 K16 ĐẢO quyết định của K13 ("người TẠO phiếu vẫn là Thủ kho"): nay
         chính KỸ THUẬT lập phiếu này, và Thủ kho là người đếm & ký nhận. Lý do
         đảo: từ K16 phiếu khai cả VẬT TƯ ĐÃ DÙNG — con số chỉ xưởng biết. Bắt
         thủ kho gõ hộ là chép lại lời người khác rồi ký tên mình.
         Quyền ghi của Kỹ thuật bị khoá đúng loại phiếu này bằng ir.rule
         (rule_picking_tech_fg_receipt_only), không phải mở ACL toàn bộ. -->
    <menuitem
        id="menu_dl_picking_fg_receipt"
        name="Nhập kho từ xưởng"
        action="action_dl_picking_fg_receipt"
        parent="dl_base.menu_dl_inventory"
        sequence="35"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_ceo,dl_base.dl_group_tech"
    />

    <!-- K15 — Kỹ thuật CÓ mục này: phiếu ra Xưởng sản xuất chờ chữ ký NHẬN
         HÀNG của họ, mà đây là đường duy nhất tới phiếu đó (họ không có smart
         button nào trỏ tới). Chip "Chờ xưởng xác nhận" ở màn này là hàng đợi
         của họ. Quyền vẫn chỉ-đọc — cái họ ghi được đúng một thứ, qua nút
         "Xác nhận đã nhận" (chạy sudo sau khi kiểm vai trò). -->
    <menuitem
        id="menu_dl_picking_transfer"
        name="Chuyển kho"
        action="action_dl_picking_transfer"
        parent="dl_base.menu_dl_inventory"
        sequence="40"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_ceo,dl_base.dl_group_accountant,dl_base.dl_group_tech"
    />

    <menuitem
        id="menu_dl_picking_delivery"
        name="Giao hàng"
        action="action_dl_picking_delivery"
        parent="dl_base.menu_dl_inventory"
        sequence="50"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_accountant"
    />

    <!-- Chủ sở hữu là Mua hàng; Thủ kho CỐ Ý không có mục này — họ đã ghi nhận
         hàng loại ở bước kiểm, quyết định trả là việc đối ngoại của Mua hàng. -->
    <menuitem
        id="menu_dl_picking_vendor_return"
        name="Trả hàng NCC"
        action="action_dl_picking_vendor_return"
        parent="dl_base.menu_dl_inventory"
        sequence="60"
        groups="dl_base.dl_group_purchasing,dl_base.dl_group_admin,dl_base.dl_group_ceo"
    />

    <menuitem
        id="menu_dl_scrap"
        name="Phế liệu"
        action="action_dl_scrap_quant"
        parent="dl_base.menu_dl_inventory"
        sequence="65"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_ceo,dl_base.dl_group_accountant"
    />

    <!-- 🔴 K16 — mục "Đối chiếu thu hồi" ĐÃ GỠ cùng với cách tính % thu hồi phế
         liệu (người dùng chốt 2026-08-13). Không còn DỰ TOÁN thì không còn gì
         để đối chiếu. Vòng phản hồi thay thế nằm ở phiếu cấp vật tư: "định mức
         BOM / đã cấp / cộng dồn" (stock_picking._dlm_build_bom_hint) — đo bằng
         vật tư đếm được từng cây, chính xác hơn hẳn phế liệu cân gộp. -->

    <menuitem
        id="menu_dl_stock_lot"
        name="Lô hàng"
        action="action_dl_stock_lot"
        parent="dl_base.menu_dl_inventory"
        sequence="70"
        groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin,dl_base.dl_group_purchasing,dl_base.dl_group_tech,dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_accountant"
    />

</odoo>
