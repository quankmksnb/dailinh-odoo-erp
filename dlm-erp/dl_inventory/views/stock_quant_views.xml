<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         K4 — M1 Tồn kho (docs/Thiet_ke_phan_he_kho.md §11.2)

         Chỉ-đọc: thay đổi số lượng là việc của KIỂM KÊ (màn riêng, K8) hoặc của
         phiếu kho — sửa thẳng trên bảng tồn là mất dấu vết ai đổi, vì sao đổi.

         🔴 KHÔNG có cột giá vốn / giá trị tồn: Thủ kho đếm hàng, không định giá
         (§8.3). Kèm thêm: module định giá tồn kho đã được gỡ khỏi dự án (§3.8).
    ============================================================ -->
    <record id="view_dl_stock_quant_tree" model="ir.ui.view">
        <field name="name">dl.stock.quant.tree</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <tree string="Tồn kho" class="dl-stock-quant-list"
                  create="0" edit="0" delete="0"
                  decoration-warning="quantity &lt;= 0">
                <field name="product_id" string="Hàng hoá"/>
                <field name="lot_id" string="Lô" optional="show"/>
                <field name="dlm_supplier_id" string="Nhà cung cấp" optional="show"/>
                <field name="dlm_receipt_date" string="Ngày nhập" optional="show"/>
                <field name="location_id" string="Vị trí"/>
                <field name="quantity" string="Số lượng" sum="Tổng"/>
                <field name="product_uom_id" string="ĐVT"/>
                <!-- Giữ hàng cho phiếu xuất: cho thủ kho biết phần nào đã "có
                     chủ", tránh hứa giao trùng. Ẩn mặc định để bảng đỡ rối. -->
                <field name="reserved_quantity" string="Đang giữ" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_stock_quant_search" model="ir.ui.view">
        <field name="name">dl.stock.quant.search</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search string="Tồn kho">
                <field name="product_id" string="Hàng hoá"/>
                <field name="lot_id" string="Số lô"/>
                <field name="location_id" string="Vị trí"/>
                <field name="dlm_supplier_id" string="Nhà cung cấp"/>

                <!-- Chỉ hàng nằm trong kho thật. Không có bộ lọc này thì bảng
                     lẫn cả vị trí ẢO (Sản xuất, Điều chỉnh tồn) — số âm/dương
                     đối ứng làm người đọc tưởng dữ liệu sai. -->
                <filter name="internal" string="Trong kho"
                        domain="[('location_id.usage', '=', 'internal')]"/>

                <separator/>
                <!-- 4 chip theo LOẠI HÀNG — cùng một nhóm nên chọn nhiều là OR
                     (xem tiền lệ filter trạng thái màn Báo giá). -->
                <filter name="kind_material" string="Vật tư"
                        domain="[('product_id.product_kind', '=', 'material')]"/>
                <filter name="kind_btp" string="Bán thành phẩm"
                        domain="[('product_id.product_kind', '=', 'material_processed')]"/>
                <filter name="kind_finished" string="Thành phẩm"
                        domain="[('product_id.product_kind', '=', 'manufactured')]"/>
                <filter name="kind_trading" string="Hàng thương mại"
                        domain="[('product_id.product_kind', '=', 'trading')]"/>

                <separator/>
                <!-- Số lượng ≤ 0 là TÍN HIỆU LỖI nghiệp vụ (xuất quá tay / thiếu
                     kiểm kê), không phải trạng thái bình thường ⇒ lọc nhanh. -->
                <filter name="negative" string="Tồn bất thường (≤ 0)"
                        domain="[('quantity', '&lt;=', 0)]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_location" string="Vị trí"
                            context="{'group_by': 'location_id'}"/>
                    <filter name="group_product" string="Hàng hoá"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_lot" string="Lô"
                            context="{'group_by': 'lot_id'}"/>
                    <filter name="group_supplier" string="Nhà cung cấp"
                            context="{'group_by': 'dlm_supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_stock_quant" model="ir.actions.act_window">
        <field name="name">Tồn kho</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_stock_quant_tree')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_stock_quant_search"/>
        <field name="context">{'search_default_internal': 1, 'search_default_group_location': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Kho đang trống</p>
            <p>Tồn kho sinh ra từ phiếu <b>Nhận hàng NCC</b>. Nhận hàng xong và
               kiểm hàng đạt là hàng xuất hiện ở đây.</p>
        </field>
    </record>

</odoo>
