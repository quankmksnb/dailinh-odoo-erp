<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         K8 — M9 Kiểm kê (docs/Thiet_ke_phan_he_kho.md §11.10)

         Chế độ kiểm kê NATIVE của stock.quant (inventory_mode) — KHÔNG tự xây
         model kiểm kê (§2, §10.1). Thủ kho đếm thực tế, bấm Áp dụng ⇒ Odoo sinh
         phiếu điều chỉnh, tồn khớp số đếm.

         Đặt TRƯỚC màn Tồn kho vì nút [Kiểm kê] trên đó trỏ tới action ở đây.

         🔴 Nút Áp dụng KHÔNG gán groups="stock.group_stock_manager" như bản
         native (§8.3 cấm cấp manager cho Thủ kho). Quyền áp được kiểm ở tầng
         model: stock_quant._apply_inventory nâng quyền cho dl_group_warehouse.
    ============================================================ -->
    <record id="view_dl_inventory_tree" model="ir.ui.view">
        <field name="name">dl.stock.quant.inventory.tree</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <!-- editable: nhập số đếm ngay trên bảng. inventory_quantity_set +
                 3 nút Đặt/Áp dụng/Xoá là cơ chế native — không phát minh lại. -->
            <tree string="Kiểm kê" class="dl-inventory-list"
                  editable="bottom" create="1" delete="0"
                  default_order="location_id, product_id"
                  decoration-info="inventory_quantity_set">
                <field name="tracking" column_invisible="1"/>
                <field name="inventory_quantity_set" column_invisible="1"/>
                <!-- company_id: domain của product_id/lot_id trên stock.quant
                     tham chiếu tới nó ⇒ thiếu là list EDITABLE không nạp được
                     (cùng bẫy màn Phế liệu K7). -->
                <field name="company_id" column_invisible="1"/>
                <field name="product_id" string="Hàng hoá"
                       readonly="id != False" options="{'no_create': True}"/>
                <field name="lot_id" string="Lô"
                       readonly="tracking not in ('lot', 'serial') or (id and (lot_id or quantity != 0))"
                       context="{'default_product_id': product_id}"
                       optional="show"/>
                <field name="location_id" string="Vị trí"
                       domain="[('usage', '=', 'internal')]"
                       readonly="id != False" options="{'no_create': True}"/>
                <field name="quantity" widget="dl_qty" string="Tồn hệ thống" readonly="1"
                       sum="Tổng"/>
                <field name="product_uom_id" string="Đơn vị tính" readonly="1"/>
                <field name="inventory_quantity" string="Tồn thực đếm"
                       widget="counted_quantity_widget"/>
                <field name="inventory_diff_quantity" widget="dl_qty" string="Chênh lệch"
                       invisible="not inventory_quantity_set"
                       decoration-muted="inventory_diff_quantity == 0"
                       decoration-danger="inventory_diff_quantity &lt; 0"
                       decoration-success="inventory_diff_quantity &gt; 0"
                       decoration-bf="inventory_diff_quantity != 0"/>
                <!-- Nút thao tác trên dòng. KHÔNG groups="…_manager": Thủ kho
                     phải bấm được. Quyền áp thật do model canh (§8.3). -->
                <button name="action_set_inventory_quantity" type="object"
                        string="Đặt = tồn" icon="fa-bullseye"
                        class="btn btn-link"
                        invisible="inventory_quantity_set"/>
                <button name="action_apply_inventory" type="object"
                        string="Áp dụng" icon="fa-save"
                        class="btn btn-link"
                        invisible="not inventory_quantity_set"/>
                <button name="action_clear_inventory_quantity" type="object"
                        string="Xoá" icon="fa-times"
                        class="btn text-warning"
                        invisible="not inventory_quantity_set"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_inventory_search" model="ir.ui.view">
        <field name="name">dl.stock.quant.inventory.search</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search string="Kiểm kê">
                <field name="product_id" string="Hàng hoá"/>
                <field name="lot_id" string="Số lô"/>
                <field name="location_id" string="Vị trí"/>
                <!-- Chờ áp: dòng đã đếm nhưng chưa bấm Áp dụng — việc còn dở. -->
                <filter name="to_apply" string="Chờ áp dụng"
                        domain="[('inventory_quantity_set', '=', True)]"/>
                <separator/>
                <filter name="negative" string="Tồn bất thường (≤ 0)"
                        domain="[('quantity', '&lt;=', 0)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_location" string="Vị trí"
                            context="{'group_by': 'location_id'}"/>
                    <filter name="group_product" string="Hàng hoá"
                            context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_stock_inventory" model="ir.actions.act_window">
        <field name="name">Kiểm kê</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree</field>
        <!-- RS-07 — bỏ 2 khu quá cảnh (Chờ kiểm, Chờ trả NCC): tồn ở đó đang
             được chứng từ tham chiếu, đếm tay là xoá mất bằng chứng. -->
        <field name="domain">[('location_id.usage', '=', 'internal'),
                             ('location_id.dlm_no_inventory', '=', False)]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_inventory_tree')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_inventory_search"/>
        <!-- inventory_mode: bật cột "Tồn thực đếm" + nút Áp dụng của native. -->
        <field name="context">{'inventory_mode': True, 'search_default_group_location': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có gì để kiểm kê</p>
            <p>Bấm <b>Đặt = tồn</b> ở dòng cần đếm rồi sửa lại <b>Tồn thực đếm</b>,
               hoặc <b>Tạo</b> dòng mới. Bấm <b>Áp dụng</b> để hệ thống sinh phiếu
               điều chỉnh cho phần chênh lệch — tồn kho sẽ khớp số đếm.</p>
        </field>
    </record>

    <!-- ============================================================
         K4 — M1 Tồn kho (docs/Thiet_ke_phan_he_kho.md §11.2)

         Chỉ-đọc: thay đổi số lượng là việc của KIỂM KÊ (màn riêng, K8) hoặc của
         phiếu kho — sửa thẳng trên bảng tồn là mất dấu vết ai đổi, vì sao đổi.

         🔴 KHÔNG có cột giá vốn / giá trị tồn: Thủ kho đếm hàng, không định giá
         (§8.3). Kèm thêm: module định giá tồn kho đã được gỡ khỏi dự án (§3.8).
    ============================================================ -->
    <record id="view_dl_stock_quant_tree" model="ir.ui.view">
        <field name="name">dl.stock.quant.tree</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <tree string="Tồn kho" class="dl-stock-quant-list"
                  create="0" edit="0" delete="0"
                  decoration-warning="quantity &lt;= 0">
                <!-- [Kiểm kê] LUÔN hiện (display="always") — không cần chọn dòng.
                     §11.11: kiểm kê là NÚT trên màn Tồn kho, cố ý KHÔNG lên rail
                     (rail 9 mục là quá dài để quét). -->
                <header>
                    <button name="%(action_dl_stock_inventory)d" type="action"
                            string="Kiểm kê" class="btn-secondary"
                            display="always"/>
                    <!-- K12 — lối vào thứ hai của phiếu [9] (§6.5): vật tư hỏng
                         trong kho mà KHÔNG đòi được NCC. KHÔNG display="always"
                         — nút này phải có dòng được chọn mới có nghĩa, hiện sẵn
                         khi chưa chọn gì là mời bấm rồi ăn lỗi. -->
                    <button name="action_dlm_to_scrap" type="object"
                            string="Chuyển thành phế liệu"
                            class="btn-secondary"/>
                </header>
                <field name="product_id" string="Hàng hoá"/>
                <field name="lot_id" string="Lô" optional="show"/>
                <field name="dlm_supplier_id" string="Nhà cung cấp" optional="show"/>
                <field name="dlm_receipt_date" string="Ngày nhập" optional="show"/>
                <field name="location_id" string="Vị trí"/>
                <field name="quantity" widget="dl_qty" string="Tồn" sum="Tổng"/>
                <!-- 🔴 K14 — hai cột này là lá chắn cho ca "hai người cùng bán
                     một lô thép". Trước đó bảng chỉ hiện Tồn = 24 và người thứ
                     hai bán tiếp 24 cây đã hứa cho đơn khác. HIỆN MẶC ĐỊNH
                     (optional="show"): cột ẩn không bảo vệ được ai.
                     `available_quantity` là field native (quantity − reserved),
                     compute non-stored ⇒ hiện được nhưng KHÔNG sort/filter được
                     — chấp nhận, đổi lại không đẻ field trùng nghĩa. -->
                <field name="reserved_quantity" widget="dl_qty" string="Đang giữ chỗ"
                       optional="show"
                       decoration-warning="reserved_quantity &gt; 0"/>
                <!-- Bấm để biết giữ CHO AI: cột trên trả lời BAO NHIÊU, câu hỏi
                     tiếp theo luôn là cho ai — không trả lời được thì cách đoán
                     rẻ nhất là bán chồng. -->
                <button name="action_dlm_open_reservations" type="object"
                        icon="fa-hand-paper-o" title="Xem phiếu đang giữ chỗ"
                        aria-label="Xem phiếu đang giữ chỗ"
                        invisible="reserved_quantity &lt;= 0"/>
                <field name="available_quantity" widget="dl_qty" string="Còn lấy được"
                       optional="show" decoration-bf="1"
                       decoration-danger="available_quantity &lt;= 0"/>
                <field name="product_uom_id" string="Đơn vị tính"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================
         K14 — "Ai đang giữ chỗ lô hàng này?"

         Mở từ nút trên cột "Đang giữ chỗ" của màn Tồn kho. Chỉ-đọc thuần: đây
         là màn TRA CỨU để đi thương lượng, không phải chỗ sửa chỗ giữ — nhả chỗ
         giữ phải làm trên chính phiếu đó, mới có dấu vết ai nhả và vì sao.

         🔴 KHÔNG có cột giá (§8.3). Cột "Đơn bán hàng" là số đơn, không phải tiền.
    ============================================================ -->
    <record id="view_dl_reservation_tree" model="ir.ui.view">
        <field name="name">dl.reservation.tree</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <tree string="Đang giữ chỗ" class="dl-reservation-list"
                  create="0" edit="0" delete="0" default_order="date">
                <field name="picking_id" string="Phiếu"/>
                <field name="dlm_sale_order_id" string="Đơn bán hàng"
                       optional="show"/>
                <field name="date" string="Ngày dự kiến"/>
                <field name="quantity" widget="dl_qty" string="Số giữ" sum="Tổng giữ"/>
                <field name="product_uom_id" string="Đơn vị tính"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state == 'partially_available'"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_stock_quant_search" model="ir.ui.view">
        <field name="name">dl.stock.quant.search</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search string="Tồn kho">
                <field name="product_id" string="Hàng hoá"/>
                <field name="lot_id" string="Số lô"/>
                <field name="location_id" string="Vị trí"/>
                <field name="dlm_supplier_id" string="Nhà cung cấp"/>

                <!-- Chỉ hàng nằm trong kho thật. Không có bộ lọc này thì bảng
                     lẫn cả vị trí ẢO (Sản xuất, Điều chỉnh tồn) — số âm/dương
                     đối ứng làm người đọc tưởng dữ liệu sai. -->
                <filter name="internal" string="Trong kho"
                        domain="[('location_id.usage', '=', 'internal')]"/>

                <separator/>
                <!-- 4 chip theo LOẠI HÀNG — cùng một nhóm nên chọn nhiều là OR
                     (xem tiền lệ filter trạng thái màn Báo giá). -->
                <filter name="kind_material" string="Vật tư"
                        domain="[('product_id.product_kind', '=', 'material')]"/>
                <filter name="kind_btp" string="Bán thành phẩm"
                        domain="[('product_id.product_kind', '=', 'material_processed')]"/>
                <filter name="kind_finished" string="Thành phẩm"
                        domain="[('product_id.product_kind', '=', 'manufactured')]"/>
                <filter name="kind_trading" string="Hàng thương mại"
                        domain="[('product_id.product_kind', '=', 'trading')]"/>

                <separator/>
                <!-- Số lượng ≤ 0 là TÍN HIỆU LỖI nghiệp vụ (xuất quá tay / thiếu
                     kiểm kê), không phải trạng thái bình thường ⇒ lọc nhanh. -->
                <filter name="negative" string="Tồn bất thường (≤ 0)"
                        domain="[('quantity', '&lt;=', 0)]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_location" string="Vị trí"
                            context="{'group_by': 'location_id'}"/>
                    <filter name="group_product" string="Hàng hoá"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_lot" string="Lô"
                            context="{'group_by': 'lot_id'}"/>
                    <filter name="group_supplier" string="Nhà cung cấp"
                            context="{'group_by': 'dlm_supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_stock_quant" model="ir.actions.act_window">
        <field name="name">Tồn kho</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_stock_quant_tree')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_stock_quant_search"/>
        <field name="context">{'search_default_internal': 1, 'search_default_group_location': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Kho đang trống</p>
            <p>Tồn kho sinh ra từ phiếu <b>Nhận hàng nhà cung cấp</b>. Nhận hàng xong và
               kiểm hàng đạt là hàng xuất hiện ở đây.</p>
        </field>
    </record>

</odoo>
