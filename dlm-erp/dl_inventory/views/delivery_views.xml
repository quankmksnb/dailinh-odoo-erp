<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         K6 — M5 Giao hàng khách (phiếu [5]: Kho thành phẩm → Khách)
         docs/Thiet_ke_phan_he_kho.md §9.1, §11.6

         Cột định danh là ĐƠN BÁN HÀNG, không phải loại phiếu: câu hỏi thường
         trực của thủ kho ở màn này là "đơn nào chưa giao", còn loại phiếu thì
         cả màn chỉ có một giá trị.
    ============================================================ -->

    <record id="view_dl_delivery_tree" model="ir.ui.view">
        <field name="name">dl.stock.picking.delivery.tree</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <tree string="Giao hàng khách" class="dl-delivery-list"
                  decoration-muted="state == 'cancel'">
                <field name="name" string="Số phiếu"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="dlm_sale_order_id" string="Đơn bán hàng"/>
                <field name="scheduled_date" string="Ngày giao" widget="date"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state in ('confirmed', 'waiting')"
                       decoration-muted="state in ('draft', 'cancel')"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_delivery_form" model="ir.ui.view">
        <field name="name">dl.stock.picking.delivery.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Giao hàng khách" class="dl-delivery-form">
                <header>
                    <button name="action_confirm" string="Xác nhận phiếu"
                            type="object" class="btn-primary"
                            invisible="state != 'draft' or dlm_blocked"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <button name="button_validate" string="Xác nhận đã giao"
                            type="object" class="btn-primary"
                            invisible="state not in ('waiting', 'confirmed', 'assigned') or dlm_blocked"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <button name="action_assign" string="Kiểm tra tồn"
                            type="object" class="btn-secondary"
                            invisible="state not in ('waiting', 'confirmed')"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <button name="action_cancel" string="Huỷ phiếu"
                            type="object" class="btn-danger"
                            invisible="state in ('done', 'cancel')"
                            groups="dl_base.dl_group_warehouse,dl_base.dl_group_admin"/>
                    <field name="state" widget="dl_stepper"
                           statusbar_visible="draft,assigned,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_dlm_open_sale_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not dlm_sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Đơn bán</span>
                                <span class="o_stat_text">hàng</span>
                            </div>
                        </button>
                    </div>

                    <field name="company_id" invisible="1"/>
                    <!-- SM-14: hai onchange "chọn khách → lọc đơn → điền hàng"
                         chỉ chạy khi `dlm_picking_kind` = delivery, mà nó suy từ
                         picking_type_id. Field không có mặt trong view thì client
                         không gửi lên, loại việc thành "other" và onchange im
                         lặng không làm gì. -->
                    <field name="picking_type_id" invisible="1"/>
                    <!-- location_dest_id (vị trí khách) do picking_type suy ra; khai
                         để o2m move_ids truyền xuống làm vị trí đích cho mỗi dòng —
                         thiếu thì stock.move không có Destination Location, Lưu sẽ
                         lỗi "trường bắt buộc chưa được đặt". location_id ("Lấy hàng
                         từ") đã hiện ở header. -->
                    <field name="location_dest_id" invisible="1"/>
                    <!-- SM-04: nuôi domain product_id — SP nằm trong đơn gắn phiếu. -->
                    <field name="dlm_orderable_product_ids" invisible="1"/>
                    <!-- SM-04: chưa gắn đơn thì không biết được phép giao gì.
                         Khoá bảng dòng (bên dưới) + dải giải thích — inline.
                         SM-14: thứ tự nhập nay là KHÁCH → ĐƠN (ô đơn lọc theo
                         khách), nên câu này phải nói đúng thứ tự đó — bản trước
                         mời chọn Đơn trước, mà chọn Đơn trước thì dropdown rỗng. -->
                    <div class="alert alert-info" role="alert"
                         invisible="dlm_sale_order_id">
                        Chọn <b>Khách hàng</b> trước, rồi chọn <b>Đơn bán hàng</b> —
                        danh sách đơn lọc theo đúng khách đó, và phần hàng
                        <b>còn phải giao</b> của đơn sẽ tự lên bảng bên dưới.
                    </div>
                    <field name="dlm_banner_level" invisible="1"/>
                    <field name="dlm_blocked" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="dlm_banner_level != 'info'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="dlm_banner_level != 'success'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="dlm_banner_level != 'warning'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="dlm_banner_level != 'danger'">
                        <field name="dlm_banner_message" nolabel="1" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="dl-fields-row">
                        <div class="dl-field">
                            <label for="partner_id" string="Khách hàng"/>
                            <field name="partner_id" nolabel="1" required="1"
                                   readonly="state in ('done', 'cancel')"
                                   domain="[('partner_role', 'in', ['customer', 'both'])]"
                                   context="{'default_partner_role': 'customer'}"/>
                        </div>
                        <div class="dl-field">
                            <label for="dlm_sale_order_id" string="Đơn bán hàng"/>
                            <!-- 🔴 SM-14 — trước bản này ô không có domain nào:
                                 dropdown xổ ra MỌI đơn của hệ thống, kể cả đơn
                                 nháp, đơn đã huỷ và đơn của khách khác. Chọn
                                 nhầm không có gì chặn, và tình trạng giao của
                                 đơn bị chọn nhầm sẽ nói sai vĩnh viễn.
                                 Ngưỡng trạng thái lấy đúng của
                                 `_dlm_check_delivery_allowed` (dl_sale_order.py)
                                 — cấm nháp/đã huỷ, không siết chặt hơn, để hai
                                 cửa tạo phiếu không nhận nuôi hai luật khác nhau. -->
                            <field name="dlm_sale_order_id" nolabel="1"
                                   readonly="state in ('done', 'cancel')"
                                   options="{'no_create': True}"
                                   placeholder="Chọn khách hàng trước"
                                   domain="[('partner_id', '=', partner_id),
                                            ('state', 'not in', ('draft', 'cancelled'))]"/>
                        </div>
                        <div class="dl-field">
                            <label for="scheduled_date" string="Ngày giao"/>
                            <field name="scheduled_date" nolabel="1"
                                   readonly="state in ('done', 'cancel')"/>
                        </div>
                        <div class="dl-field">
                            <label for="location_id" string="Lấy hàng từ"/>
                            <!-- 🔴 K11 CỬA THỨ BA (§4.1.1). Trước bản này domain
                                 chỉ có usage='internal' ⇒ chọn được "Chờ kiểm
                                 hàng" và GIAO THẲNG HÀNG CHƯA KIỂM CHO KHÁCH —
                                 nặng hơn hẳn hai cửa Chuyển kho/Kiểm kê cộng
                                 lại. Luật phải phát biểu theo VỊ TRÍ, không theo
                                 MÀN: mọi ô chọn vị trí đều lọc cùng domain này. -->
                            <field name="location_id" nolabel="1"
                                   readonly="state in ('done', 'cancel')"
                                   options="{'no_create': True}"
                                   domain="[('usage', '=', 'internal'),
                                            ('dlm_no_inventory', '=', False)]"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Hàng giao" name="moves">
                            <!-- SM-04: khoá thêm dòng tới khi có đơn — domain
                                 product_id neo vào parent SP-trong-đơn. -->
                            <field name="move_ids"
                                   readonly="not dlm_sale_order_id or state in ('done', 'cancel')"
                                   context="{'default_location_id': location_id,
                                             'default_location_dest_id': location_dest_id}">
                                <tree editable="bottom">
                                    <!-- SM-04: chỉ hiện mặt hàng khách đã đặt trên
                                         đơn (không giao thứ ngoài đơn). -->
                                    <field name="product_id" string="Mặt hàng"
                                           required="1"
                                           domain="[('id', 'in', parent.dlm_orderable_product_ids)]"/>
                                    <field name="product_uom_qty" widget="dl_qty" string="Cần giao"/>
                                    <field name="quantity" widget="dl_qty" string="Thực giao"/>
                                    <field name="product_uom" string="Đơn vị tính"
                                           groups="uom.group_uom"/>
                                    <!-- SM-05: lô của đúng SP + đang nằm ở nguồn. -->
                                    <field name="lot_ids" string="Số lô"
                                           widget="many2many_tags" optional="show"
                                           domain="[('product_id', '=', product_id),
                                                    ('quant_ids.location_id', 'child_of', parent.location_id)]"/>
                                    <field name="picked" column_invisible="1"/>
                                    <!-- name/location_id/dest: trường bắt buộc của
                                         stock.move điền gián tiếp (onchange product_id /
                                         default_location_* ở context); phải nằm trong
                                         active fields của tree con mới được giữ lại.
                                         Xem picking_views để biết chi tiết. -->
                                    <field name="name" column_invisible="1"/>
                                    <field name="location_id" column_invisible="1"/>
                                    <field name="location_dest_id" column_invisible="1"/>
                                    <!-- company_id: domain của product_id trên
                                         stock.move tham chiếu tới nó ⇒ thiếu là
                                         view không nạp được. -->
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_delivery_search" model="ir.ui.view">
        <field name="name">dl.stock.picking.delivery.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Giao hàng khách">
                <field name="name" string="Tìm nhanh"
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('dlm_sale_order_id', 'ilike', self), ('product_id', 'ilike', self)]"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="dlm_sale_order_id" string="Đơn bán hàng"/>
                <field name="product_id" string="Mặt hàng"/>

                <filter name="todo" string="Cần giao"
                        domain="[('state', 'in', ('waiting', 'confirmed', 'assigned'))]"/>
                <filter name="delivered" string="Đã giao"
                        domain="[('state', '=', 'done')]"/>
                <filter name="draft" string="Nháp"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="cancelled" string="Đã huỷ"
                        domain="[('state', '=', 'cancel')]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner" string="Khách hàng"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_order" string="Đơn bán hàng"
                            context="{'group_by': 'dlm_sale_order_id'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_picking_delivery" model="ir.actions.act_window">
        <field name="name">Giao hàng</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <!-- RS-04 — WHITELIST đúng 'GH', không lọc bằng "trừ ra".
             `outgoing` còn Trả hàng NCC (TR, chủ sở hữu là Mua hàng) và Bán phế
             liệu (BPL). Danh sách "trừ ra" rò rỉ ngay lần thêm loại phiếu sau:
             phiếu BPL đầu tiên sẽ hiện ở đây và mở bằng form Giao hàng — form
             đó khoá bảng dòng tới khi chọn Đơn bán hàng, mà phế liệu không có
             đơn nào ⇒ ngõ cụt. Màn nào của Đại Linh cũng neo vào đúng
             `sequence_code` của nó. -->
        <field name="domain">[('picking_type_id.sequence_code', '=', 'GH')]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_delivery_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_delivery_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_delivery_search"/>
        <field name="context">{'restricted_picking_type_code': 'outgoing'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có phiếu giao hàng nào</p>
            <p>Phiếu giao được tạo từ nút <b>Tạo phiếu giao</b> trên đơn bán hàng
               đã xác nhận — không tự sinh lúc chốt đơn, vì hàng gia công lúc đó
               chưa có.</p>
        </field>
    </record>

</odoo>
