<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Màn "Phê duyệt báo giá" cho Trưởng KD / Giám đốc.
         Kế thừa form yêu cầu duyệt (dl_config) để nhúng NGUYÊN trang "Phân tích
         giá thành" của form Báo giá: tóm tắt lãi/lỗ + cơ cấu chi phí 3 lớp +
         "công thức" giá thành theo từng sản phẩm, cạnh dòng báo giá và khung
         chiết khấu. Người duyệt quyết định ngay tại đây — nút "Mở báo giá đầy
         đủ" chỉ còn dùng khi cần chatter/đính kèm/lịch sử. -->

    <record id="view_dl_pricing_approval_request_form_quote" model="ir.ui.view">
        <field name="name">dl.pricing.approval.request.form.quote</field>
        <field name="model">dl.pricing.approval.request</field>
        <field name="inherit_id" ref="dl_config.view_dl_pricing_approval_request_form"/>
        <field name="arch" type="xml">
            <!-- Đồng bộ chrome UI với các form khác (nút lên breadcrumb, menu ⋮).
                 Gắn ở view kế thừa dl_sale vì js_class nằm trong asset dl_sale. -->
            <xpath expr="//form" position="attributes">
                <attribute name="class">dl-quote-approval-form</attribute>
                <attribute name="js_class">dl_quote_approval_form</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_quotation" string="Mở báo giá đầy đủ"
                        type="object" class="btn-secondary"
                        invisible="not quotation_id"/>
            </xpath>
            <!-- Bảng tóm tắt để duyệt, đặt lên đầu cạnh nút Duyệt/Từ chối:
                 người duyệt thấy ngay giá trị, lãi gộp, mức bào mòn markup và
                 chip rủi ro. Dùng đúng khuôn .dl-cost-summary của trang Phân
                 tích giá thành cho cùng cách đọc. Lý do từ chối nhập trong
                 dialog lúc bấm Từ chối, không để sẵn trên form. -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="dl-cost-summary" invisible="not quotation_id">
                    <div class="dl-cost-head">
                        <div class="dl-cost-cell">
                            <span class="dl-cost-lbl">Tổng thanh toán</span>
                            <field name="q_amount_total" widget="dl_money"
                                   options="{'currency_field': 'q_currency_id'}"
                                   nolabel="1" readonly="1" class="dl-cost-val"/>
                        </div>
                        <div class="dl-cost-cell"
                             groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager">
                            <span class="dl-cost-lbl">Lãi gộp</span>
                            <field name="q_gross_profit" widget="dl_money"
                                   nolabel="1" readonly="1" class="dl-cost-val"/>
                        </div>
                        <div class="dl-cost-cell"
                             groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager">
                            <span class="dl-cost-lbl">Tổng giá thành</span>
                            <field name="q_total_cost" widget="dl_money"
                                   nolabel="1" readonly="1" class="dl-cost-val2"/>
                        </div>
                        <div class="dl-cost-cell"
                             groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager">
                            <span class="dl-cost-lbl">Markup niêm yết → thực thu (sau chiết khấu)</span>
                            <span class="dl-cost-val2">
                                <field name="q_list_markup" readonly="1" nolabel="1" class="oe_inline"/>% →
                                <field name="q_effective_markup" readonly="1" nolabel="1" class="oe_inline"/>%
                            </span>
                            <!-- Mục tiêu chỉ là tham chiếu cho giá NIÊM YẾT; lằn ranh
                                 thật khi duyệt là markup tại giá sàn. -->
                            <span class="dl-cost-note">mục tiêu
                                <field name="q_target_markup" readonly="1" nolabel="1" class="oe_inline"/>% ·
                                sàn <field name="q_floor_markup" readonly="1" nolabel="1" class="oe_inline"/>%
                            </span>
                        </div>
                    </div>
                    <div class="dl-cost-risks">
                        <span class="badge text-bg-danger" invisible="not q_discount_above_max">Vượt trần chiết khấu</span>
                        <span class="badge text-bg-warning" invisible="q_discount_above_max or not q_discount_above_default">Cao hơn chiết khấu mặc định</span>
                        <span class="badge text-bg-danger" invisible="not q_below_floor"
                              groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager">Dưới giá sàn</span>
                        <span class="badge text-bg-success" invisible="not q_in_safe_range">Trong ngưỡng an toàn</span>
                    </div>
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="quotation_id" invisible="1"/>
                <field name="q_currency_id" invisible="1"/>
                <field name="q_in_safe_range" invisible="1"/>
                <!-- Cờ chỉ dùng cho chip cảnh báo ở đầu form — nạp ẩn. Bản gated
                     đi kèm chip gated tương ứng nên bị lược cùng nhau với vai
                     trò không được xem giá vốn. -->
                <field name="q_discount_above_default" invisible="1"/>
                <field name="q_discount_above_max" invisible="1"/>
                <field name="q_below_floor" invisible="1"
                       groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager"/>
                <group invisible="not quotation_id">
                    <group string="Báo giá được duyệt">
                        <field name="q_partner_id" readonly="1"/>
                        <field name="q_date_order" readonly="1"/>
                        <field name="q_state" readonly="1"/>
                    </group>
                </group>
                <!-- Trang Phân tích giá thành ĐỨNG TRƯỚC: đây mới là tài liệu ra
                     quyết định của người duyệt. Bố cục copy nguyên khuôn của form
                     Báo giá (3 hộp + "công thức" theo từng sản phẩm) để không phải
                     mở lại báo giá đầy đủ mới xem được giá cấu thành từ đâu. -->
                <notebook invisible="not quotation_id">
                    <page string="Phân tích giá thành"
                          groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager">
                        <div class="dl-cost-cols">
                            <div class="dl-cost-box">
                                <div class="dl-cost-box-title">Cơ cấu giá thành</div>
                                <div class="dl-cost-line"><span>Vật tư</span>
                                    <field name="q_cost_material_total" widget="dl_money" nolabel="1" readonly="1"/></div>
                                <div class="dl-cost-line"><span>Công đoạn</span>
                                    <field name="q_cost_operation_total" widget="dl_money" nolabel="1" readonly="1"/></div>
                                <div class="dl-cost-line"><span>Chi phí chung/điều chỉnh</span>
                                    <field name="q_cost_adjustment_total" widget="dl_money" nolabel="1" readonly="1"/></div>
                                <div class="dl-cost-line dl-cost-line-total"><span>Tổng giá thành</span>
                                    <field name="q_total_cost" widget="dl_money" nolabel="1" readonly="1"/></div>
                            </div>
                            <div class="dl-cost-box">
                                <div class="dl-cost-box-title">Giá sàn</div>
                                <div class="dl-cost-line"><span>Tổng giá sàn</span>
                                    <field name="q_floor_amount" widget="dl_money" nolabel="1" readonly="1"/></div>
                                <div class="dl-cost-line"><span>Doanh thu (sau chiết khấu, trước VAT)</span>
                                    <field name="q_amount_before_vat" widget="dl_money" nolabel="1" readonly="1"/></div>
                                <div class="dl-cost-line dl-cost-line-total"><span>Lãi gộp</span>
                                    <field name="q_gross_profit" widget="dl_money" nolabel="1" readonly="1"/></div>
                            </div>
                            <div class="dl-cost-box">
                                <div class="dl-cost-box-title">Chiết khấu &amp; phê duyệt</div>
                                <div class="dl-cost-line"><span>Nhóm khách hàng</span>
                                    <field name="q_partner_group" nolabel="1" readonly="1"/></div>
                                <div class="dl-cost-line"><span>Chiết khấu áp dụng</span>
                                    <span><field name="q_discount_pct" nolabel="1" readonly="1" class="oe_inline"/>%</span></div>
                                <div class="dl-cost-line"><span>Chiết khấu mặc định / tối đa</span>
                                    <span><field name="q_discount_default_rate" nolabel="1" readonly="1" class="oe_inline"/>% / <field name="q_discount_max_rate" nolabel="1" readonly="1" class="oe_inline"/>%</span></div>
                                <div class="dl-cost-line"><span>Cấp duyệt yêu cầu</span>
                                    <field name="approval_level" nolabel="1" readonly="1"/></div>
                            </div>
                        </div>
                        <!-- Diễn giải "công thức": vật tư/công đoạn/chi phí chung
                             CHO 1 SẢN PHẨM → × số lượng → + markup → giá bán.
                             Thay bảng cấu phần phẳng cũ (không đọc được cost/1sp). -->
                        <separator string="Chi tiết cấu phần — tính cho 1 sản phẩm, rồi × số lượng đặt"/>
                        <field name="q_cost_breakdown_html" nolabel="1" readonly="1"/>
                    </page>
                    <page string="Chi tiết báo giá">
                        <field name="q_line_ids" readonly="1">
                            <tree>
                                <field name="line_type" widget="badge"
                                       decoration-success="line_type == 'trading'"
                                       decoration-info="line_type == 'manufactured'"/>
                                <field name="name"/>
                                <field name="qty" widget="dl_qty"/>
                                <field name="uom_id" string="ĐVT"/>
                                <field name="material_cost" widget="dl_money" digits="[16, 0]" string="Chi phí vật tư/đơn vị" optional="hide"
                                       groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager"/>
                                <field name="operation_cost" widget="dl_money" digits="[16, 0]" string="Chi phí công đoạn/đơn vị" optional="hide"
                                       groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager"/>
                                <field name="total_cost" widget="dl_money" digits="[16, 0]" string="Giá thành/đơn vị"
                                       groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager"/>
                                <field name="floor_price" widget="dl_money" digits="[16, 0]" string="Giá sàn/đơn vị"
                                       groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager"/>
                                <field name="price_unit" widget="dl_money" digits="[16, 0]"/>
                                <field name="price_subtotal" widget="dl_money" digits="[16, 0]"/>
                            </tree>
                        </field>
                        <group class="oe_subtotal_footer">
                            <field name="q_amount_untaxed" widget="dl_money" readonly="1"
                                   string="Giá trước chiết khấu"/>
                            <field name="q_discount_pct" readonly="1"/>
                            <field name="q_discount_amount" widget="dl_money" readonly="1"
                                   string="Tiền chiết khấu"/>
                            <field name="q_amount_before_vat" widget="dl_money" readonly="1"
                                   string="Sau chiết khấu, trước VAT"/>
                            <field name="q_vat_pct" readonly="1"/>
                            <field name="q_vat_amount" widget="dl_money" readonly="1"
                                   string="Tiền VAT"/>
                            <field name="q_amount_total" widget="dl_money" readonly="1"
                                   string="Tổng thanh toán" class="oe_subtotal_footer_separator"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Tree riêng cho hòm phê duyệt báo giá: thêm cột khách hàng/giá trị. -->
    <record id="view_dl_quote_approval_tree" model="ir.ui.view">
        <field name="name">dl.pricing.approval.request.tree.quote</field>
        <field name="model">dl.pricing.approval.request</field>
        <field name="arch" type="xml">
            <tree string="Phê duyệt báo giá" create="false" delete="false"
                  class="dl-quote-approval-list" js_class="dl_quote_approval_list"
                  decoration-danger="state == 'pending' and waiting_days &gt;= 4"
                  decoration-warning="state == 'pending' and waiting_days &gt;= 2 and waiting_days &lt; 4">
                <field name="create_date" string="Ngày gửi" widget="date"/>
                <field name="waiting_days" string="Chờ (ngày)"/>
                <field name="object_label" string="Báo giá"/>
                <field name="q_partner_id" string="Khách hàng"/>
                <field name="q_currency_id" column_invisible="1"/>
                <field name="q_amount_total" string="Tổng thanh toán"
                       widget="dl_money" options="{'currency_field': 'q_currency_id'}"/>
                <field name="approval_level" string="Cấp duyệt"/>
                <!-- Cột lý do vượt ngưỡng ngay trên dòng, khỏi mở từng bản ghi.
                     Gắn groups vì có gộp cả "Dưới giá sàn" (số giá vốn). -->
                <field name="risk_summary" string="Rủi ro"
                       groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager"/>
                <field name="requester_id" string="Người gửi" widget="many2one_avatar_user"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="action_dl_quote_approval" model="ir.actions.act_window">
        <field name="name">Phê duyệt</field>
        <field name="res_model">dl.pricing.approval.request</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="domain">[('request_type', '=', 'quote_over_threshold')]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_quote_approval_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dl_config.view_dl_pricing_approval_request_form')}),
        ]"/>
        <field name="search_view_id" ref="dl_config.view_dl_pricing_approval_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Không có báo giá nào chờ phê duyệt.</p>
        </field>
    </record>
</odoo>
