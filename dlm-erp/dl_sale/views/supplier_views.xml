<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dl_supplier_tree" model="ir.ui.view">
        <field name="name">dlm.supplier.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="NCC / Thầu phụ" class="dl-supplier-list" js_class="dl_supplier_list"
                  decoration-muted="active == False">
                <field name="avatar_128" widget="image" class="dl-supplier-avatar"
                       options="{'preview_image': 'avatar_128'}" nolabel="1"/>
                <field name="dlm_supplier_code" string="Mã NCC"/>
                <field name="name" string="Tên NCC / Thầu phụ"/>
                <field name="dlm_supplier_group" string="Nhóm cung cấp" widget="badge"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="vat" string="MST"/>
                <field name="city" string="Tỉnh/TP"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_supplier_form" model="ir.ui.view">
        <field name="name">dlm.supplier.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="NCC / Thầu phụ" class="dl-supplier-form" js_class="dl_supplier_form">
                <header>
                    <!-- Vô hiệu hóa / kích hoạt: chỉ Kế toán + Admin (S04) -->
                    <button name="toggle_active" type="object" string="Vô hiệu hóa NCC"
                            class="btn-secondary" invisible="not active"
                            confirm="Vô hiệu hóa NCC này? Lịch sử giá cũ được giữ nguyên; NCC sẽ không xuất hiện khi cập nhật giá vật tư mới."
                            groups="dl_base.dl_group_accountant,dl_base.dl_group_admin"/>
                    <button name="toggle_active" type="object" string="Kích hoạt lại"
                            class="btn-secondary" invisible="active"
                            groups="dl_base.dl_group_accountant,dl_base.dl_group_admin"/>
                </header>
                <sheet>
                    <field name="is_dlm_supplier" invisible="1"/>
                    <field name="active" invisible="1"/>

                    <widget name="web_ribbon" title="Ngừng hợp tác"
                            bg_color="text-bg-danger" invisible="active"/>

                    <field name="image_1920" widget="image"
                           class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Tên NCC / Thầu phụ"/>
                        <h1>
                            <field name="name" placeholder="Tên NCC / Thầu phụ..."/>
                        </h1>
                        <div class="dl-sup-code" invisible="not dlm_supplier_code">
                            Mã NCC: <field name="dlm_supplier_code" class="oe_inline"/>
                        </div>
                    </div>

                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="website"/>
                            <field name="vat" string="Mã số thuế (MST)"/>
                        </group>
                        <group string="Điều kiện cung cấp">
                            <field name="dlm_supplier_group"/>
                            <field name="dlm_payment_days"/>
                        </group>
                    </group>

                    <group>
                        <group string="Địa chỉ">
                            <field name="street" placeholder="Số nhà, tên đường..."/>
                            <field name="street2" placeholder="Phường/Xã..."/>
                            <field name="city" placeholder="Tỉnh / Thành phố"/>
                            <field name="country_id" placeholder="Quốc gia"/>
                        </group>
                    </group>

                    <field name="partner_role" invisible="1"/>

                    <notebook>
                        <page string="Người liên hệ" name="contacts">
                            <field name="child_ids" context="{'default_type': 'contact'}">
                                <tree editable="bottom">
                                    <field name="name" string="Họ tên"/>
                                    <field name="function" string="Chức vụ"/>
                                    <field name="phone" string="Điện thoại"/>
                                    <field name="email" widget="email"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Ghi chú nội bộ" name="notes">
                            <field name="comment" placeholder="Ghi chú về NCC này (ưu tiên, lưu ý đặc biệt)..."/>
                        </page>

                        <page string="Thông tin hệ thống" name="audit">
                            <group>
                                <group string="Khởi tạo">
                                    <field name="create_uid" string="Người tạo" readonly="1"/>
                                    <field name="create_date" string="Ngày tạo" readonly="1"/>
                                </group>
                                <group string="Cập nhật gần nhất">
                                    <field name="write_uid" string="Người sửa" readonly="1"/>
                                    <field name="write_date" string="Ngày sửa" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_supplier_search" model="ir.ui.view">
        <field name="name">dlm.supplier.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Tìm NCC / Thầu phụ">
                <field name="name" string="Tên"/>
                <field name="dlm_supplier_code" string="Mã NCC"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="vat" string="MST"/>
                <separator/>
                <filter string="Thép xây dựng" name="filter_grp_steel"
                        domain="[('dlm_supplier_group', '=', 'steel')]"/>
                <filter string="Sơn - mạ" name="filter_grp_paint"
                        domain="[('dlm_supplier_group', '=', 'paint')]"/>
                <filter string="Vật tư điện" name="filter_grp_electric"
                        domain="[('dlm_supplier_group', '=', 'electric')]"/>
                <filter string="Gia công" name="filter_grp_subcontract"
                        domain="[('dlm_supplier_group', '=', 'subcontract')]"/>
                <filter string="Khác" name="filter_grp_other"
                        domain="[('dlm_supplier_group', '=', 'other')]"/>
                <separator/>
                <filter string="Đang hoạt động" name="active" domain="[('active', '=', True)]"/>
                <filter string="Không hoạt động" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhóm cung cấp" name="group_supplier_group"
                            context="{'group_by': 'dlm_supplier_group'}"/>
                    <filter string="Tỉnh/TP" name="group_city"
                            context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Sequence mã NCC (NCC-0001) -->
    <record id="seq_dlm_supplier" model="ir.sequence">
        <field name="name">DLM Nhà cung cấp</field>
        <field name="code">dlm.supplier</field>
        <field name="prefix">NCC-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="action_dl_supplier" model="ir.actions.act_window">
        <field name="name">NCC / Thầu phụ</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('partner_role', '=', 'supplier')]</field>
        <field name="context">{'default_partner_role': 'supplier'}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_supplier_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_supplier_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_supplier_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm nhà cung cấp đầu tiên!
            </p>
            <p>Quản lý NCC và thầu phụ cung cấp vật tư / dịch vụ cho Đại Linh.</p>
        </field>
    </record>

</odoo>
