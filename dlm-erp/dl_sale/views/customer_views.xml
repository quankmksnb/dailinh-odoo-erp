<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dl_customer_tree" model="ir.ui.view">
        <field name="name">dlm.customer.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Khách hàng" class="dl-customer-list" js_class="dl_customer_list"
                decoration-muted="active == False">
                <field name="avatar_128" widget="image" class="dl-customer-avatar"
                    options="{'preview_image': 'avatar_128'}" nolabel="1" />
                <field name="dlm_has_photo" column_invisible="1" />
                <field name="dlm_code" string="Mã KH" />
                <field name="name" string="Tên khách hàng" />
                <field name="partner_type" string="Loại" widget="badge"
                    decoration-info="partner_type == 'company'"
                    decoration-warning="partner_type == 'dealer'" />
                <field name="dlm_status_label" string="Trạng thái" widget="badge"
                    decoration-success="active"
                    decoration-danger="not active" />
                <field name="phone" string="Điện thoại" />
                <field name="email" widget="email" />
                <field name="city" string="Tỉnh/TP" />
                <field name="active" column_invisible="1" />
            </tree>
        </field>
    </record>

    <record id="view_dl_customer_kanban" model="ir.ui.view">
        <field name="name">dlm.customer.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="dl-cust-kanban" default_group_by="">
                <field name="name" />
                <field name="dlm_code" />
                <field name="partner_type" />
                <field name="partner_type_label" />
                <field name="phone" />
                <field name="mobile" />
                <field name="email" />
                <field name="city" />
                <field name="active" />
                <field name="dlm_has_photo" />
                <field name="dlm_initial" />
                <field name="dlm_avatar_bg" />
                <field name="dlm_avatar_fg" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click dl-cust-card"
                            t-attf-class="#{!record.active.raw_value ? 'dl-cust-card--off' : ''}">
                            <div class="dl-cust-card__head">
                                <div class="dl-cust-ava">
                                    <img t-if="record.dlm_has_photo.raw_value"
                                        t-att-src="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"
                                        alt="" />
                                    <span t-else="" class="dl-cust-ava__letter"
                                        t-attf-style="background:#{record.dlm_avatar_bg.value};color:#{record.dlm_avatar_fg.value}"
                                        t-esc="record.dlm_initial.value" />
                                </div>
                                <div class="dl-cust-card__id">
                                    <span class="dl-cust-card__name" t-esc="record.name.value" />
                                    <div class="dl-cust-card__tags">
                                        <span class="dl-cust-code" t-if="record.dlm_code.value"
                                            t-esc="record.dlm_code.value" />
                                        <span
                                            t-attf-class="dl-type-badge dl-type-badge--#{record.partner_type.raw_value}"
                                            t-esc="record.partner_type_label.value" />
                                    </div>
                                </div>
                                <t t-if="record.active.raw_value">
                                    <span class="dl-cust-status dl-cust-status--active">
                                        Đang hợp tác
                                    </span>
                                </t>

                                <t t-else="">
                                    <span class="dl-cust-status dl-cust-status--inactive">
                                        Ngừng hợp tác
                                    </span>
                                </t>
                            </div>
                            <div class="dl-cust-card__body">
                                <div class="dl-cust-row" t-if="record.phone.value">
                                    <i class="fa fa-phone" />
                                    <span t-esc="record.phone.value" />
                                </div>
                                <div class="dl-cust-row" t-if="record.mobile.value">
                                    <i class="fa fa-mobile" />
                                    <span t-esc="record.mobile.value" />
                                </div>
                                <div class="dl-cust-row" t-if="record.email.value">
                                    <i class="fa fa-envelope-o" />
                                    <span t-esc="record.email.value" />
                                </div>
                                <div class="dl-cust-row" t-if="record.city.value">
                                    <i class="fa fa-map-marker" />
                                    <span t-esc="record.city.value" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dl_customer_form" model="ir.ui.view">
        <field name="name">dlm.customer.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Khách hàng" class="dl-customer-form" js_class="dl_customer_form">
                <header>
                    <!-- Vô hiệu hóa / kích hoạt: chỉ Trưởng KD + Admin (Sales không được) -->
                    <button name="toggle_active" type="object" string="Vô hiệu hóa KH"
                        class="btn-secondary" invisible="not active"
                        confirm="Vô hiệu hóa khách hàng này? Dữ liệu cũ được giữ nguyên; KH sẽ không xuất hiện khi tạo báo giá/RFQ mới."
                        groups="dl_base.dl_group_sales_manager,dl_base.dl_group_admin" />
                    <button name="toggle_active" type="object" string="Kích hoạt lại"
                        class="btn-secondary" invisible="active"
                        groups="dl_base.dl_group_sales_manager,dl_base.dl_group_admin" />
                </header>
                <sheet>
                    <!-- Vai trò = customer (default trong context); giữ 2 cờ ẩn -->
                    <field name="partner_role" invisible="1" />
                    <field name="is_dlm_customer" invisible="1" />
                    <field name="active" invisible="1" />
                    <field name="dlm_split_warning" invisible="1" />
                    <field name="dlm_open_quote_count" invisible="1" />
                    <field name="dlm_recent_quote_total" invisible="1" />
                    <field name="dlm_split_threshold" invisible="1" />
                    <field name="dlm_currency_id" invisible="1" />

                    <widget name="web_ribbon" title="Ngừng hợp tác"
                        bg_color="text-bg-danger" invisible="active" />

                    <!-- EX-30: KH đã ngừng hợp tác nhưng còn BG chưa đóng -->
                    <div class="alert alert-danger" role="alert"
                        invisible="active or dlm_open_quote_count == 0">
                        <i class="fa fa-ban" />
                        <strong>KH đã ngừng hợp tác.</strong> Vẫn còn <field
                            name="dlm_open_quote_count" class="oe_inline" /> báo giá chưa đóng — các
                        báo giá này tiếp tục quy trình bình thường, nhưng không thể tạo báo giá/RFQ
                        mới cho KH này. </div>

                    <!-- EX-30: cảnh báo trước khi vô hiệu hóa (còn BG mở) -->
                    <div class="alert alert-info" role="alert"
                        invisible="not active or dlm_open_quote_count == 0">
                        <i class="fa fa-info-circle" /> KH này đang có <field
                            name="dlm_open_quote_count" class="oe_inline" /> báo giá chưa đóng. Vô
                        hiệu hóa KH sẽ không hủy các báo giá đó. </div>

                    <!-- EX-42: Cảnh báo gộp đơn (chống chia nhỏ né duyệt) -->
                    <div class="alert alert-warning" role="alert"
                        invisible="not dlm_split_warning">
                        <i class="fa fa-exclamation-triangle" />
                        <strong>Cảnh báo gộp đơn:</strong>
                        KH này có <field name="dlm_recent_quote_count" class="oe_inline" /> báo giá
                        trong 7 ngày gần đây với tổng <field name="dlm_recent_quote_total"
                            class="oe_inline"
                            widget="monetary" />, vượt ngưỡng duyệt tự động (<field
                            name="dlm_split_threshold" class="oe_inline"
                            widget="monetary" />) — kiểm tra khả năng chia nhỏ để né duyệt. </div>

                    <div class="dl-cust-head">
                        <field name="image_1920" widget="image"
                            class="oe_avatar dl-cust-form-avatar"
                            readonly="not active"
                            options="{'preview_image': 'image_128'}" />
                        <div class="dl-cust-head-main">
                            <label for="name" string="Tên khách hàng" />
                            <h1>
                                <field name="name" placeholder="Tên khách hàng..."
                                    readonly="not active" />
                            </h1>
                            <div class="dl-cust-code" invisible="not dlm_code"> Mã KH: <field
                                    name="dlm_code" class="oe_inline" />
                            </div>
                            <field name="partner_type" widget="radio"
                                options="{'horizontal': true}" nolabel="1"
                                readonly="not active"
                                class="dl-cust-type-seg" />
                        </div>
                    </div>

                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="phone" string="Điện thoại" readonly="not active" />
                            <field name="mobile" string="Di động" readonly="not active" />
                            <field name="email" widget="email" readonly="not active" />
                            <field name="tax_code" string="Mã số thuế (MST)"
                                readonly="partner_type == 'individual' or not active"
                                required="partner_type == 'company'"
                                placeholder="Bắt buộc với Doanh nghiệp" />
                            <field name="dlm_allow_dup_tax" readonly="not active"
                                invisible="partner_type == 'individual'" />
                        </group>
                        <group string="Địa chỉ">
                            <field name="street" string="Đường" readonly="not active"
                                placeholder="Số nhà, tên đường..." />
                            <field name="city" string="Tỉnh / TP" readonly="not active"
                                placeholder="Tỉnh / Thành phố" />
                            <field name="country_id" string="Quốc gia" readonly="not active"
                                placeholder="Quốc gia" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Người liên hệ" name="contacts">
                            <field name="child_ids" context="{'default_type': 'contact'}"
                                readonly="not active">
                                <tree editable="bottom">
                                    <field name="name" string="Họ tên" />
                                    <field name="function" string="Chức vụ" />
                                    <field name="phone" string="Điện thoại" />
                                    <field name="email" widget="email" />
                                </tree>
                            </field>
                        </page>

                        <page string="Lịch sử Báo giá" name="quote_history">
                            <group>
                                <group>
                                    <field name="dlm_quotation_count" string="Tổng số báo giá" />
                                </group>
                                <group
                                    groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_sales_manager">
                                    <field name="dlm_win_rate" string="Win rate (%)"
                                        widget="float" digits="[16, 1]" />
                                </group>
                            </group>
                            <field name="dlm_quotation_ids" nolabel="1" readonly="1">
                                <tree string="Báo giá" create="false" delete="false"
                                    decoration-success="state == 'approved'"
                                    decoration-danger="state == 'rejected'"
                                    decoration-info="state == 'sent'">
                                    <field name="name" string="Số BG" />
                                    <field name="date_order" string="Ngày" />
                                    <field name="amount_total" string="Giá trị" widget="monetary" />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="state" string="Trạng thái" widget="badge"
                                        decoration-success="state == 'approved'"
                                        decoration-danger="state == 'rejected'"
                                        decoration-info="state == 'sent'" />
                                </tree>
                            </field>
                        </page>

                        <page string="Ghi chú nội bộ" name="notes">
                            <field name="comment" readonly="not active"
                                placeholder="Ghi chú, yêu cầu đặc biệt, chính sách giá riêng..." />
                        </page>

                        <page string="Thông tin hệ thống" name="audit">
                            <group>
                                <group string="Khởi tạo">
                                    <field name="create_uid" string="Người tạo" readonly="1" />
                                    <field name="create_date" string="Ngày tạo" readonly="1" />
                                </group>
                                <group string="Cập nhật gần nhất">
                                    <field name="write_uid" string="Người sửa" readonly="1" />
                                    <field name="write_date" string="Ngày sửa" readonly="1" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_customer_search" model="ir.ui.view">
        <field name="name">dlm.customer.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Tìm khách hàng">
                <field name="name" string="Tên" filter_domain="[('name', 'ilike', self)]" />
                <field name="dlm_code" string="Mã KH" />
                <field name="phone" />
                <field name="email" />
                <field name="tax_code" string="MST" />
                <separator />
                <filter string="Cá nhân"
                    name="filter_individual"
                    domain="[('partner_type', '=', 'individual')]" />
                <filter string="Doanh nghiệp"
                    name="filter_company"
                    domain="[('partner_type', '=', 'company')]" />
                <filter string="Đại lý"
                    name="filter_dealer"
                    domain="[('partner_type', '=', 'dealer')]" />
                <separator />
                <filter string="Đang hoạt động" name="active" domain="[('active', '=', True)]" />
                <filter string="Không hoạt động" name="inactive" domain="[('active', '=', False)]" />
                <group expand="0" string="Nhóm theo">
                    <filter string="Loại khách hàng" name="group_type"
                        context="{'group_by': 'partner_type'}" />
                    <filter string="Tỉnh/TP" name="group_city"
                        context="{'group_by': 'city'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- EX-42: ngưỡng gộp đơn auto-approval (VNĐ) — CEO/Admin sửa được ở S02.
         noupdate để không ghi đè khi nâng cấp module. -->
    <data noupdate="1">
        <record id="param_split_order_threshold" model="ir.config_parameter">
            <field name="key">dl_sale.split_order_threshold</field>
            <field name="value">20000000</field>
        </record>
    </data>

    <!-- Sequence mã KH (KH-0001) -->
    <record id="seq_dlm_customer" model="ir.sequence">
        <field name="name">DLM Khách hàng</field>
        <field name="code">dlm.customer</field>
        <field name="prefix">KH-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="action_dl_customer" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('is_dlm_customer', '=', True)]</field>
        <field name="context">{'default_partner_role': 'customer', 'default_partner_type':
            'company', 'active_test': False}</field>
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_customer_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_dl_customer_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_customer_form')}),
        ]" />
        <field name="search_view_id" ref="view_dl_customer_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo khách hàng đầu tiên!
            </p>
            <p>Quản lý toàn bộ danh sách khách hàng của Đại Linh tại đây.</p>
        </field>
    </record>

</odoo>