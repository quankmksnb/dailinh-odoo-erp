<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         BÁO GIÁ (dl.quotation)
    ================================================================ -->

    <!-- List view -->
    <record id="view_dl_quotation_tree" model="ir.ui.view">
        <field name="name">dl.quotation.tree</field>
        <field name="model">dl.quotation</field>
        <field name="arch" type="xml">
            <tree string="Báo giá"
                  decoration-muted="state == 'rejected'"
                  decoration-success="state == 'approved'"
                  decoration-info="state == 'sent'">
                <field name="name" string="Số BG"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="date_order" string="Ngày"/>
                <field name="amount_total" string="Tổng tiền" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" string="Trạng thái"
                       decoration-muted="state == 'rejected'"
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'sent'"
                       widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_dl_quotation_form" model="ir.ui.view">
        <field name="name">dl.quotation.form</field>
        <field name="model">dl.quotation</field>
        <field name="arch" type="xml">
            <form string="Báo giá">
                <header>
                    <button name="action_send" string="Gửi báo giá"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Duyệt"
                            type="object" class="btn-success"
                            invisible="state != 'sent'"/>
                    <button name="action_reject" string="Từ chối"
                            type="object" class="btn-danger"
                            invisible="state not in ('sent', 'draft')"/>
                    <button name="action_reset_draft" string="Về nháp"
                            type="object"
                            invisible="state not in ('sent', 'rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="amount_total" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết báo giá">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note" placeholder="Ghi chú thêm..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_dl_quotation_search" model="ir.ui.view">
        <field name="name">dl.quotation.search</field>
        <field name="model">dl.quotation</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm báo giá">
                <field name="name" string="Số BG"/>
                <field name="partner_id" string="Khách hàng"/>
                <filter name="draft" string="Nháp" domain="[('state','=','draft')]"/>
                <filter name="sent" string="Đã gửi" domain="[('state','=','sent')]"/>
                <filter name="approved" string="Đã duyệt" domain="[('state','=','approved')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner" string="Khách hàng"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dl_quotation" model="ir.actions.act_window">
        <field name="name">Báo giá</field>
        <field name="res_model">dl.quotation</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_quotation_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_quotation_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_quotation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo báo giá đầu tiên!</p>
        </field>
    </record>

    <!-- Sequence -->
    <record id="seq_dl_quotation" model="ir.sequence">
        <field name="name">DL Quotation</field>
        <field name="code">dl.quotation</field>
        <field name="prefix">BG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
