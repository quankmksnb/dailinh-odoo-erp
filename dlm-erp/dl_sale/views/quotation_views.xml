<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dl_quotation_tree" model="ir.ui.view">
        <field name="name">dl.quotation.tree</field>
        <field name="model">dl.quotation</field>
        <field name="arch" type="xml">
            <tree string="Báo giá" class="dl-quotation-list" js_class="dl_quotation_list"
                  decoration-danger="validity_state == 'overdue'"
                  decoration-warning="validity_state == 'soon'">
                <field name="validity_state" column_invisible="1"/>
                <field name="name" string="Số báo giá"/>
                <field name="revision" string="Phiên bản" optional="hide"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="create_uid" string="Phụ trách" optional="show"/>
                <field name="date_order" string="Ngày"/>
                <field name="validity_label" string="Hạn hiệu lực" optional="show"/>
                <field name="amount_total" string="Tổng tiền" widget="dl_money"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-warning="state in ('draft', 'revision_requested')"
                       decoration-info="state in ('approved', 'sent')"
                       decoration-success="state in ('accepted', 'ordered')"
                       decoration-danger="state in ('rejected', 'expired')"
                       decoration-muted="state in ('cancelled', 'superseded')"/>
                <!-- Cột trạng thái duyệt cho Sales — ẩn mặc định vì đa số báo
                     giá không cần duyệt; bật qua nút cột tuỳ chọn khi cần theo
                     dõi hàng chờ duyệt. -->
                <field name="approval_state" string="Duyệt" widget="badge" optional="hide"
                       decoration-warning="approval_state == 'pending'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'rejected'"
                       decoration-muted="approval_state == 'not_required'"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_quotation_form" model="ir.ui.view">
        <field name="name">dl.quotation.form</field>
        <field name="model">dl.quotation</field>
        <field name="arch" type="xml">
            <form string="Báo giá" class="dl-quotation-form" js_class="dl_quotation_form">
                <header>
                    <!-- Gửi khách: hiện khi báo giá KHÔNG cần duyệt (Sales gửi
                         thẳng từ Nháp) hoặc đã qua ma trận phê duyệt (approved).
                         Bỏ nút "Duyệt nội bộ" thủ công — cổng kiểm soát duy nhất
                         là ma trận phê duyệt (chỉ kích hoạt khi vượt ngưỡng). -->
                    <button name="action_send" string="Gửi khách hàng"
                            type="object" class="btn-primary"
                            invisible="state not in ('draft', 'approved') or (state == 'draft' and (approval_required or approval_state != 'not_required'))"/>
                    <button name="action_customer_accept" string="Khách đồng ý"
                            type="object" class="btn-primary"
                            invisible="state != 'sent'"/>
                    <button name="action_open_revision_wizard" string="Khách yêu cầu điều chỉnh"
                            type="object" class="btn-secondary"
                            invisible="state != 'sent'"/>
                    <field name="revision_request_type" invisible="1"/>
                    <button name="action_create_revision" string="Sửa &amp; gửi lại"
                            type="object" class="btn-primary"
                            invisible="state not in ('revision_requested', 'rejected', 'expired') or (state == 'revision_requested' and revision_request_type == 'technical')"/>
                    <button name="action_send_back_to_tech" string="Chuyển Kỹ thuật sửa BOM"
                            type="object" class="btn-primary"
                            invisible="state != 'revision_requested' or revision_request_type != 'technical' or not quotation_request_id"/>
                    <button name="action_create_sale_order" string="Tạo đơn bán hàng"
                            type="object" class="btn-primary"
                            invisible="state != 'accepted'"/>
                    <!-- Khách đổi ý trước khi lên đơn: rút lại đồng ý, đưa báo
                         giá về Đã gửi khách để mở lại các nhánh phản hồi. -->
                    <button name="action_customer_withdraw" string="Khách rút đồng ý"
                            type="object" class="btn-secondary"
                            invisible="state != 'accepted'"
                            confirm="Đưa báo giá về 'Đã gửi khách' để khách xem lại?"/>
                    <button name="action_open_sale_order" string="Mở đơn bán hàng"
                            type="object" class="btn-primary"
                            invisible="state != 'ordered'"/>
                    <button name="action_reopen" string="Gia hạn"
                            type="object" class="btn-secondary"
                            invisible="state != 'expired'"/>
                    <!-- Duyệt nhanh cho người có quyền trên yêu cầu đang treo
                         (server tính can_resolve — đúng cấp theo ma trận). -->
                    <field name="approval_can_resolve" invisible="1"/>
                    <button name="action_approval_approve" string="Phê duyệt"
                            type="object" class="btn-primary"
                            invisible="approval_state != 'pending' or not approval_can_resolve"
                            confirm="Xác nhận PHÊ DUYỆT báo giá này?"/>
                    <button name="action_approval_open_reject" string="Từ chối duyệt"
                            type="object" class="btn-danger"
                            invisible="approval_state != 'pending' or not approval_can_resolve"/>
                    <button name="action_open_approval_request" string="Xem yêu cầu duyệt"
                            type="object" class="btn-secondary"
                            invisible="not approval_request_id"/>
                    <button name="action_open_reject_wizard" string="Từ chối"
                            type="object" class="btn-danger"
                            invisible="state not in ('draft', 'approved', 'sent', 'revision_requested')"/>
                    <button name="action_expire" string="Hết hiệu lực"
                            type="object" class="btn-secondary"
                            invisible="state not in ('approved', 'sent', 'revision_requested')"/>
                    <button name="action_reset_draft" string="Về nháp"
                            type="object" class="btn-link"
                            invisible="state not in ('approved', 'sent', 'revision_requested', 'rejected', 'expired')"/>
                    <!-- Xuất file gửi khách: Word/PDF chỉ có giá bán, rồi tải
                         về hoặc gửi email (đọc lại trước khi gửi). -->
                    <button name="action_open_export_wizard" string="Xuất / Gửi báo giá"
                            type="object" class="btn-secondary"
                            invisible="not line_ids"/>
                    <field name="state" widget="dl_stepper" options="{'preset': 'quotation'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_origin" type="object"
                                class="oe_stat_button" icon="fa-code-fork"
                                invisible="not origin_quotation_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Bản trước</span>
                            </div>
                        </button>
                        <button name="action_open_revisions" type="object"
                                class="oe_stat_button" icon="fa-copy"
                                invisible="revision_count == 0">
                            <field name="revision_count" widget="statinfo"
                                   string="Bản lập lại"/>
                        </button>
                    </div>
                    <field name="approval_request_id" invisible="1"/>
                    <field name="approval_required" invisible="1"/>
                    <field name="approval_state" invisible="1"/>
                    <field name="origin_quotation_id" invisible="1"/>
                    <field name="revision" invisible="1"/>
                    <!-- Chỉ MỘT dải thông báo trạng thái. Màu + nội dung do
                         model chọn sẵn (_compute_status_banner); view chỉ in ra
                         đúng dải khớp với mức màu. -->
                    <field name="status_banner_level" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="status_banner_level != 'info'">
                        <field name="status_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="status_banner_level != 'success'">
                        <field name="status_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="status_banner_level != 'warning'">
                        <field name="status_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="status_banner_level != 'danger'">
                        <field name="status_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-secondary" role="alert"
                         invisible="status_banner_level != 'secondary'">
                        <field name="status_banner_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <div class="dl-fields-row">
                        <div class="dl-field">
                            <label for="partner_id" string="Khách hàng"/>
                            <field name="partner_id" nolabel="1"
                                readonly="state != 'draft'"
                                context="{'default_partner_role': 'customer', 'default_partner_type': 'company'}"/>
                        </div>
                        <div class="dl-field">
                            <label for="date_order" string="Ngày báo giá"/>
                            <field name="date_order" nolabel="1"/>
                        </div>
                        <div class="dl-field">
                            <label for="validity_date" string="Hạn hiệu lực"/>
                            <field name="validity_date" nolabel="1"
                                   options="{'min_date': 'today'}"
                                   readonly="state not in ('draft', 'expired')"/>
                        </div>
                        <div class="dl-field">
                            <label for="quotation_request_id" string="RFQ nguồn"/>
                            <field name="quotation_request_id" nolabel="1" readonly="1"/>
                        </div>
                        <div class="dl-field">
                            <label for="pricing_date" string="Ngày tính giá"/>
                            <field name="pricing_date" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                    <!-- Nhắc mềm khi khách thiếu MST/địa chỉ (chỉ hiện lúc còn
                         Nháp/Đã duyệt, không chặn gửi). -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state not in ('draft', 'approved') or not customer_data_warning">
                        <field name="customer_data_warning" nolabel="1" readonly="1"/>
                    </div>
                    <notebook>
                        <page string="Chi tiết báo giá">
                            <!-- Khóa dữ liệu giá ngoài trạng thái Nháp: muốn sửa
                                 phải Về nháp để đi lại luồng đánh giá phê duyệt. -->
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="line_type" widget="badge"
                                           decoration-success="line_type == 'trading'"
                                           decoration-info="line_type == 'manufactured'"/>
                                    <field name="name"/>
                                    <field name="qty" widget="dl_money" digits="[16, 0]"/>
                                    <field name="material_cost" widget="dl_money" digits="[16, 0]" readonly="1" optional="hide"
                                           groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager"/>
                                    <field name="operation_cost" widget="dl_money" digits="[16, 0]" readonly="1" optional="show"
                                           groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager"/>
                                    <field name="adjustment_cost" widget="dl_money" digits="[16, 0]" readonly="1" optional="hide"
                                           groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager"/>
                                    <field name="total_cost" widget="dl_money" digits="[16, 0]" readonly="1"
                                           groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager"/>
                                    <field name="price_unit" widget="dl_money" digits="[16, 0]"/>
                                    <field name="price_subtotal" readonly="1" widget="dl_money" digits="[16, 0]"/>
                                </tree>
                            </field>
                            <!-- Dòng gợi ý nhỏ dưới ô Chiết khấu: khoảng cho
                                 phép theo nhóm khách + đổi màu theo con số vừa
                                 gõ. Màu + nội dung do model tính
                                 (_compute_discount_hint). -->
                            <field name="discount_hint_level" invisible="1"/>
                            <div class="dl-fields-row">
                                <div class="dl-field">
                                    <label for="discount_pct" string="Chiết khấu (%)"/>
                                    <field name="discount_pct" nolabel="1"
                                           readonly="state != 'draft'"/>
                                    <div class="dl-inline-hint dl-hint-info"
                                         invisible="discount_hint_level != 'info'">
                                        <field name="discount_hint_message" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="dl-inline-hint dl-hint-secondary"
                                         invisible="discount_hint_level != 'secondary'">
                                        <field name="discount_hint_message" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="dl-inline-hint dl-hint-warning"
                                         invisible="discount_hint_level != 'warning'">
                                        <field name="discount_hint_message" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                                <div class="dl-field">
                                    <label for="vat_pct" string="VAT (%)"/>
                                    <field name="vat_pct" nolabel="1"
                                           readonly="state != 'draft'"/>
                                </div>
                            </div>
                            <div class="dl-totals">
                                <div class="dl-total-row">
                                    <span class="dl-total-label">Giá trước chiết khấu</span>
                                    <field name="amount_untaxed" widget="dl_money"
                                           nolabel="1" class="dl-total-sub"/>
                                </div>
                                <div class="dl-total-row">
                                    <span class="dl-total-label">Chiết khấu</span>
                                    <field name="discount_amount" widget="dl_money"
                                           nolabel="1" class="dl-total-sub"/>
                                </div>
                                <div class="dl-total-row">
                                    <span class="dl-total-label">Sau chiết khấu, trước VAT</span>
                                    <field name="amount_before_vat" widget="dl_money"
                                           nolabel="1" class="dl-total-sub"/>
                                </div>
                                <div class="dl-total-row">
                                    <span class="dl-total-label">Tiền VAT</span>
                                    <field name="vat_amount" widget="dl_money"
                                           nolabel="1" class="dl-total-sub"/>
                                </div>
                                <div class="dl-total-row dl-total-final-row">
                                    <span class="dl-total-label">Tổng thanh toán</span>
                                    <field name="amount_total" widget="dl_money"
                                           nolabel="1" class="dl-total-final"/>
                                </div>
                            </div>
                        </page>
                        <page string="Phân tích giá thành"
                              groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager">
                            <!-- Cờ chỉ dùng cho chip cảnh báo — nạp ẩn. -->
                            <field name="below_floor" invisible="1"/>
                            <field name="discount_above_default" invisible="1"/>
                            <field name="discount_above_max" invisible="1"/>
                            <!-- 1. Bức tranh lãi/lỗ: 4 số chốt + dải chip cảnh báo
                                 (thay các ô tick khó đọc). Mượn khuôn .dl-decision
                                 của màn Phê duyệt để đồng bộ diện mạo. -->
                            <div class="dl-cost-summary">
                                <div class="dl-cost-head">
                                    <div class="dl-cost-cell">
                                        <span class="dl-cost-lbl">Tổng giá thành</span>
                                        <field name="total_cost" widget="dl_money"
                                               nolabel="1" readonly="1" class="dl-cost-val2"/>
                                    </div>
                                    <div class="dl-cost-cell">
                                        <span class="dl-cost-lbl">Doanh thu (sau chiết khấu, trước VAT)</span>
                                        <field name="amount_before_vat" widget="dl_money"
                                               nolabel="1" readonly="1" class="dl-cost-val2"/>
                                    </div>
                                    <div class="dl-cost-cell">
                                        <span class="dl-cost-lbl">Lãi gộp</span>
                                        <field name="gross_profit" widget="dl_money"
                                               nolabel="1" readonly="1" class="dl-cost-val"/>
                                    </div>
                                    <div class="dl-cost-cell">
                                        <span class="dl-cost-lbl">Markup niêm yết → thực thu (sau chiết khấu)</span>
                                        <span class="dl-cost-val2">
                                            <field name="list_markup" nolabel="1" readonly="1" class="oe_inline"/>% →
                                            <field name="effective_markup" nolabel="1" readonly="1" class="oe_inline"/>%
                                        </span>
                                        <!-- Mục tiêu chỉ là tham chiếu cho giá NIÊM YẾT; lằn ranh
                                             thật là markup tại giá sàn (lãi tối thiểu chấp nhận). -->
                                        <span class="dl-cost-note">mục tiêu
                                            <field name="target_markup" nolabel="1" readonly="1" class="oe_inline"/>% ·
                                            sàn <field name="floor_markup" nolabel="1" readonly="1" class="oe_inline"/>%
                                        </span>
                                    </div>
                                </div>
                                <div class="dl-cost-risks">
                                    <!-- Guardrail thật = giá sàn (markup tối thiểu). Không còn
                                         cảnh báo "dưới mục tiêu" vì chiết khấu luôn bào mòn markup
                                         thực thu xuống dưới mục tiêu — báo động cấu trúc, vô nghĩa. -->
                                    <span class="badge text-bg-danger" invisible="not below_floor">Dưới giá sàn</span>
                                    <span class="badge text-bg-danger" invisible="not discount_above_max">Chiết khấu vượt trần</span>
                                    <span class="badge text-bg-warning" invisible="discount_above_max or not discount_above_default">Chiết khấu trên mặc định</span>
                                    <span class="badge text-bg-success" invisible="below_floor or discount_above_max or discount_above_default">Không có cảnh báo</span>
                                </div>
                            </div>
                            <!-- 2. Ba khối gọn thay 10 field rời: tiền đổ vào đâu,
                                 giá sàn, chính sách chiết khấu/phê duyệt. -->
                            <div class="dl-cost-cols">
                                <div class="dl-cost-box">
                                    <div class="dl-cost-box-title">Cơ cấu giá thành</div>
                                    <div class="dl-cost-line"><span>Vật tư</span>
                                        <field name="cost_material_total" widget="dl_money" nolabel="1" readonly="1"/></div>
                                    <div class="dl-cost-line"><span>Công đoạn</span>
                                        <field name="cost_operation_total" widget="dl_money" nolabel="1" readonly="1"/></div>
                                    <div class="dl-cost-line"><span>Chi phí chung/điều chỉnh</span>
                                        <field name="cost_adjustment_total" widget="dl_money" nolabel="1" readonly="1"/></div>
                                    <div class="dl-cost-line dl-cost-line-total"><span>Tổng giá thành</span>
                                        <field name="total_cost" widget="dl_money" nolabel="1" readonly="1"/></div>
                                </div>
                                <div class="dl-cost-box">
                                    <div class="dl-cost-box-title">Giá sàn</div>
                                    <div class="dl-cost-line"><span>Tổng giá sàn</span>
                                        <field name="floor_amount" widget="dl_money" nolabel="1" readonly="1"/></div>
                                    <div class="dl-cost-line dl-cost-line-total"><span>Lãi gộp</span>
                                        <field name="gross_profit" widget="dl_money" nolabel="1" readonly="1"/></div>
                                </div>
                                <div class="dl-cost-box">
                                    <div class="dl-cost-box-title">Chiết khấu &amp; phê duyệt</div>
                                    <div class="dl-cost-line"><span>Nhóm khách hàng</span>
                                        <field name="partner_group" nolabel="1" readonly="1"/></div>
                                    <div class="dl-cost-line"><span>Chiết khấu mặc định / tối đa</span>
                                        <span><field name="discount_default_rate" nolabel="1" readonly="1" class="oe_inline"/>% / <field name="discount_max_rate" nolabel="1" readonly="1" class="oe_inline"/>%</span></div>
                                    <div class="dl-cost-line"><span>Trạng thái duyệt</span>
                                        <field name="approval_state" widget="badge" nolabel="1" readonly="1"
                                               decoration-warning="approval_state == 'pending'"
                                               decoration-success="approval_state == 'approved'"
                                               decoration-danger="approval_state == 'rejected'"
                                               decoration-muted="approval_state == 'not_required'"/></div>
                                </div>
                            </div>
                            <field name="approval_reasons" readonly="1"
                                   invisible="not approval_reasons"/>
                            <!-- 3. Chi tiết cấu phần — "công thức" cho 1 sản phẩm
                                 rồi mới × số lượng, cuối cùng cộng markup. Render
                                 từ field HTML (_compute_cost_breakdown_html). -->
                            <separator string="Chi tiết cấu phần — tính cho 1 sản phẩm, rồi × số lượng đặt"/>
                            <field name="cost_breakdown_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Điều khoản &amp; Ghi chú">
                            <!-- Điều khoản in vào file gửi khách (PDF/Word).
                                 Chỉ là văn bản, không ảnh hưởng giá nên cho sửa
                                 tới khi lên đơn. -->
                            <group>
                                <group string="Điều khoản gửi khách">
                                    <field name="payment_terms"
                                           readonly="state in ('ordered', 'cancelled', 'superseded')"
                                           placeholder="Vd: Tạm ứng 50% khi ký, 50% khi giao hàng..."/>
                                    <field name="delivery_terms"
                                           readonly="state in ('ordered', 'cancelled', 'superseded')"
                                           placeholder="Thời gian / địa điểm giao hàng..."/>
                                    <field name="warranty_terms"
                                           readonly="state in ('ordered', 'cancelled', 'superseded')"
                                           placeholder="Điều kiện và thời gian bảo hành..."/>
                                </group>
                            </group>
                            <separator string="Ghi chú nội bộ"/>
                            <field name="note" nolabel="1" class="dl-textarea-lg"
                                   placeholder="Ghi chú thêm..."/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Log/chatter chỉ hiển thị cho quản lý (CEO, Trưởng KD, Admin)
                     và đội sở hữu báo giá (BA/Sales) — dữ liệu vẫn lưu đầy đủ,
                     chỉ giới hạn người xem để phục vụ truy xuất. -->
                <div class="oe_chatter"
                     groups="dl_base.dl_group_ceo,dl_base.dl_group_sales_manager,dl_base.dl_group_admin,dl_base.dl_group_ba">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_quotation_search" model="ir.ui.view">
        <field name="name">dl.quotation.search</field>
        <field name="model">dl.quotation</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm báo giá">
                <field name="name" string="Tìm nhanh"
                       filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id" string="Khách hàng"/>
                <!-- Bộ lọc gộp: mặc định (search_default_open trên action) list
                     chỉ mở ra pipeline đang sống. "Đã đóng" gom các kết cục
                     nghiệp vụ; "Lịch sử phiên bản" = bản cũ bị thay thế
                     (superseded) — thuần truy vết, tránh làm rối danh sách.
                     TẤT CẢ filter trạng thái để CHUNG một nhóm (không chèn
                     <separator/>) để chúng OR với nhau — vì state đơn trị, bấm
                     "Đang xử lý" + "Từ chối" phải ra hợp của hai tập, không phải
                     giao (rỗng). -->
                <filter name="open" string="Đang xử lý"
                        domain="[('state','in',('draft','approved','sent','revision_requested','accepted','ordered'))]"/>
                <filter name="closed" string="Đã đóng"
                        domain="[('state','in',('rejected','expired','cancelled'))]"/>
                <filter name="history" string="Lịch sử phiên bản"
                        domain="[('state','=','superseded')]"/>
                <!-- Lọc chi tiết theo từng trạng thái (pipeline) -->
                <filter name="draft" string="Nháp" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Đã duyệt nội bộ" domain="[('state','=','approved')]"/>
                <filter name="sent" string="Đã gửi khách" domain="[('state','=','sent')]"/>
                <filter name="revision_requested" string="Yêu cầu điều chỉnh" domain="[('state','=','revision_requested')]"/>
                <filter name="accepted" string="Khách đồng ý" domain="[('state','=','accepted')]"/>
                <filter name="ordered" string="Đã lên đơn" domain="[('state','=','ordered')]"/>
                <!-- Lọc chi tiết theo từng trạng thái đóng / lịch sử -->
                <filter name="rejected" string="Từ chối" domain="[('state','=','rejected')]"/>
                <filter name="expired" string="Hết hiệu lực" domain="[('state','=','expired')]"/>
                <filter name="cancelled" string="Đã hủy" domain="[('state','=','cancelled')]"/>
                <filter name="superseded" string="Đã thay bản mới" domain="[('state','=','superseded')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner" string="Khách hàng"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_quotation" model="ir.actions.act_window">
        <field name="name">Danh sách báo giá</field>
        <field name="res_model">dl.quotation</field>
        <field name="view_mode">tree,form</field>
        <field name="limit" eval="15"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dl_quotation_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dl_quotation_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dl_quotation_search"/>
        <!-- Mặc định chỉ hiện pipeline đang xử lý — ẩn bản superseded (lịch sử)
             và các bản đã đóng khỏi danh sách để tránh data rác. Người dùng bấm
             filter "Đã đóng" / "Lịch sử phiên bản" khi cần tra cứu. -->
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo báo giá đầu tiên!</p>
        </field>
    </record>

    <record id="seq_dl_quotation" model="ir.sequence">
        <field name="name">DL Quotation</field>
        <field name="code">dl.quotation</field>
        <field name="prefix">BG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
