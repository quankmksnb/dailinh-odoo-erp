<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="dl_sale.DlStepper">
    <div class="dl-stepper">
        <t t-foreach="steps" t-as="s" t-key="s.key">
            <div class="dl-stepper-step"
                 t-att-class="{ 'is-done': s.done, 'is-current': s.current }">
                <span class="dl-stepper-dot">
                    <t t-if="s.done">✓</t>
                    <t t-else="" t-esc="s.index"/>
                </span>
                <span class="dl-stepper-label" t-esc="s.label"/>
            </div>
        </t>
    </div>
</t>

</templates>
