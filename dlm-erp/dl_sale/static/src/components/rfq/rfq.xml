<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="dl_sale.DlRfq">
    <div class="dl-rfq o_action">
        <div class="dl-rfq-inner">

            <!-- Tiêu đề -->
            <div class="dl-rfq-head">
                <div>
                    <h1 class="dl-rfq-title">Đơn hàng mới (RFQ)</h1>
                </div>
                <button class="dl-rfq-btn-new" type="button">
                    <i class="fa fa-plus"/> Tạo báo giá
                </button>
            </div>

            <!-- Bảng cấu hình tỷ lệ chi phí -->
            <div class="dl-rfq-panel">
                <div class="dl-rfq-panel-head">
                    <span class="dl-rfq-panel-title"><i class="fa fa-sliders"/> Cấu hình tỷ lệ chi phí</span>
                    <span class="dl-rfq-ratio-sum"
                          t-att-class="{ 'is-invalid': !ratioValid }">
                        Tổng: <b t-esc="ratioSum"/>%
                        <t t-if="ratioValid"><i class="fa fa-check-circle"/></t>
                        <t t-else=""><i class="fa fa-exclamation-triangle"/> (phải bằng 100%)</t>
                    </span>
                </div>
                <div class="dl-rfq-ratios">
                    <t t-foreach="ratioRows" t-as="r" t-key="r.key">
                        <div class="dl-rfq-ratio">
                            <span class="dl-rfq-ratio-label" t-esc="r.label"/>
                            <div class="dl-rfq-ratio-input">
                                <input type="number" min="0" max="100"
                                       t-att-value="state.ratios[r.key]"
                                       t-on-input="(ev) => this.onRatioInput(r.key, ev)"/>
                                <span class="dl-rfq-ratio-pct">%</span>
                            </div>
                            <span class="dl-rfq-ratio-hint" t-esc="r.hint"/>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Thanh công cụ: tìm kiếm + filter + xuất -->
            <div class="dl-rfq-toolbar">
                <div class="dl-rfq-search">
                    <i class="fa fa-search"/>
                    <input type="text" placeholder="Tìm số BG, khách hàng…"
                           t-att-value="state.search"
                           t-on-input="(ev) => state.search = ev.target.value"/>
                </div>
                <select class="dl-rfq-filter" t-model="state.group">
                    <option value="">Tất cả nhóm SP</option>
                    <t t-foreach="groupOptions" t-as="g" t-key="g">
                        <option t-att-value="g" t-esc="g"/>
                    </t>
                </select>
                <select class="dl-rfq-filter" t-model="state.size">
                    <option value="">Tất cả kích thước</option>
                    <t t-foreach="sizeOptions" t-as="s" t-key="s">
                        <option t-att-value="s" t-esc="s"/>
                    </t>
                </select>
                <div class="dl-rfq-export">
                    <button class="dl-rfq-export-btn internal" type="button"
                            t-on-click="() => this.openExport('internal')">
                        <i class="fa fa-file-text-o"/> Mẫu Nội bộ
                    </button>
                    <button class="dl-rfq-export-btn customer" type="button"
                            t-on-click="() => this.openExport('customer')">
                        <i class="fa fa-file-pdf-o"/> Mẫu Khách hàng
                    </button>
                </div>
            </div>

            <!-- Bảng danh sách RFQ -->
            <div class="dl-rfq-table-wrap">
                <table class="dl-rfq-table">
                    <thead>
                        <tr>
                            <th class="col-code">Số BG</th>
                            <th>Khách hàng</th>
                            <th>Nhóm SP</th>
                            <th class="num">SL</th>
                            <th class="num">Giá vốn</th>
                            <th class="num">Giá bán</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="filteredRfqs" t-as="rfq" t-key="rfq.id">
                            <tr t-att-class="{ 'is-selected': rfq.id === state.selectedId }"
                                t-on-click="() => this.selectRfq(rfq.id)">
                                <td class="col-code">
                                    <i class="fa fa-check dl-rfq-pick"
                                       t-att-style="rfq.id === state.selectedId ? '' : 'visibility:hidden'"/>
                                    <span t-esc="rfq.code"/>
                                </td>
                                <td t-esc="rfq.partner"/>
                                <td><span class="dl-rfq-tag" t-esc="rfqGroups(rfq)"/></td>
                                <td class="num" t-esc="rfqTotals(rfq).qty"/>
                                <td class="num" t-esc="fmt(rfqTotals(rfq).material)"/>
                                <td class="num strong" t-esc="fmt(rfqTotals(rfq).amount)"/>
                                <td>
                                    <span t-att-class="'dl-rfq-badge ' + rfq.state"
                                          t-esc="stateLabels[rfq.state]"/>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="!filteredRfqs.length">
                            <td colspan="7" class="dl-rfq-empty">Không có báo giá phù hợp bộ lọc.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>

        <!-- Modal xuất báo giá -->
        <t t-if="state.exportMode and exportDoc">
            <div class="dl-rfq-modal-backdrop" t-on-click="closeExport">
                <div class="dl-rfq-modal" t-on-click.stop="">
                    <div class="dl-rfq-modal-bar">
                        <span class="dl-rfq-modal-kind" t-att-class="state.exportMode">
                            <t t-if="state.exportMode === 'internal'">Mẫu Nội bộ — cơ cấu giá thành</t>
                            <t t-else="">Mẫu Khách hàng</t>
                        </span>
                        <div class="dl-rfq-modal-actions">
                            <button class="dl-rfq-modal-print" type="button" t-on-click="() => window.print()">
                                <i class="fa fa-print"/> In / PDF
                            </button>
                            <button class="dl-rfq-modal-close" type="button" t-on-click="closeExport">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>

                    <div class="dl-rfq-doc">
                        <!-- Đầu trang -->
                        <div class="dl-rfq-doc-head">
                            <div class="dl-rfq-doc-company">
                                <div class="dl-rfq-doc-logo">ĐL</div>
                                <div>
                                    <div class="dl-rfq-doc-cname">CÔNG TY ĐẠI LINH</div>
                                    <div class="dl-rfq-doc-caddr">KCN Đại Linh · MST 0100000000</div>
                                </div>
                            </div>
                            <div class="dl-rfq-doc-meta">
                                <div class="dl-rfq-doc-doctitle">
                                    <t t-if="state.exportMode === 'internal'">PHIẾU TÍNH GIÁ (NỘI BỘ)</t>
                                    <t t-else="">BÁO GIÁ</t>
                                </div>
                                <div>Số: <b t-esc="exportDoc.rfq.code"/></div>
                                <div>Ngày: <b t-esc="exportDoc.rfq.date"/></div>
                            </div>
                        </div>
                        <div class="dl-rfq-doc-to">
                            <span>Kính gửi:</span> <b t-esc="exportDoc.rfq.partner"/>
                        </div>

                        <!-- Bảng chi tiết: NỘI BỘ (đầy đủ cơ cấu) -->
                        <t t-if="state.exportMode === 'internal'">
                            <table class="dl-rfq-doc-table internal">
                                <thead>
                                    <tr>
                                        <th class="l">Sản phẩm</th>
                                        <th>Kích thước</th>
                                        <th class="num">SL</th>
                                        <th class="num">Vật tư</th>
                                        <th class="num">Nhân công</th>
                                        <th class="num">Rủi ro</th>
                                        <th class="num">Lợi nhuận</th>
                                        <th class="num">Đơn giá</th>
                                        <th class="num">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="exportDoc.lines" t-as="l" t-key="l.name">
                                        <tr>
                                            <td class="l" t-esc="l.name"/>
                                            <td t-esc="l.size"/>
                                            <td class="num" t-esc="l.qty"/>
                                            <td class="num" t-esc="fmt(l.b.material)"/>
                                            <td class="num" t-esc="fmt(l.b.labor)"/>
                                            <td class="num" t-esc="fmt(l.b.risk)"/>
                                            <td class="num" t-esc="fmt(l.b.profit)"/>
                                            <td class="num" t-esc="fmt(l.b.unit)"/>
                                            <td class="num strong" t-esc="fmt(l.b.amount)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="dl-rfq-doc-totals">
                                <div class="row"><span>Tổng giá thành</span><b t-esc="fmt(exportDoc.subtotal)"/></div>
                                <div class="row note">Bản nội bộ — dùng để duyệt giá, không gửi khách.</div>
                            </div>
                        </t>

                        <!-- Bảng chi tiết: KHÁCH HÀNG (gọn, có VAT) -->
                        <t t-else="">
                            <table class="dl-rfq-doc-table customer">
                                <thead>
                                    <tr>
                                        <th class="l">Sản phẩm</th>
                                        <th>Kích thước</th>
                                        <th class="num">SL</th>
                                        <th class="num">Đơn giá</th>
                                        <th class="num">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="exportDoc.lines" t-as="l" t-key="l.name">
                                        <tr>
                                            <td class="l" t-esc="l.name"/>
                                            <td t-esc="l.size"/>
                                            <td class="num" t-esc="l.qty"/>
                                            <td class="num" t-esc="fmt(l.b.unit)"/>
                                            <td class="num strong" t-esc="fmt(l.b.amount)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="dl-rfq-doc-totals">
                                <div class="row"><span>Tạm tính</span><b t-esc="fmt(exportDoc.subtotal)"/></div>
                                <div class="row"><span>VAT 8%</span><b t-esc="fmt(exportDoc.vat)"/></div>
                                <div class="row final"><span>Tổng cộng</span><b t-esc="fmt(exportDoc.total)"/></div>
                                <div class="row note">Báo giá có hiệu lực 30 ngày. Giá đã bao gồm VAT.</div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
