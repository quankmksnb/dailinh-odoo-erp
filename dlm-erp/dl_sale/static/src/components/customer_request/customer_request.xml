<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="dl_sale.DlCustomerRequest">
    <div class="dl-creq o_action">
        <div class="dl-creq-inner">

            <div class="dl-creq-head">
                <div>
                    <h1 class="dl-creq-title">Yêu cầu khách hàng</h1>
                </div>
            </div>

            <div class="dl-creq-stats">
                <t t-foreach="states" t-as="s" t-key="s.key">
                    <div class="dl-creq-stat"
                         t-att-class="{ 'is-active': state.stateFilter === s.key,
                                        's-new': s.key === 'new', 's-processing': s.key === 'processing',
                                        's-quoted': s.key === 'quoted', 's-closed': s.key === 'closed' }"
                         t-on-click="() => state.stateFilter = (state.stateFilter === s.key ? '' : s.key)">
                        <span class="dl-creq-stat-val" t-esc="countByState(s.key)"/>
                        <span class="dl-creq-stat-label" t-esc="s.label"/>
                    </div>
                </t>
            </div>

            <div class="dl-creq-toolbar">
                <div class="dl-creq-search">
                    <i class="fa fa-search"/>
                    <input type="text" placeholder="Tìm mã YC, khách hàng, nhóm SP…"
                           t-att-value="state.search"
                           t-on-input="(ev) => state.search = ev.target.value"/>
                </div>
            </div>

            <div class="dl-creq-body">

                <div class="dl-creq-list">
                    <t t-foreach="filtered" t-as="r" t-key="r.id">
                        <div class="dl-creq-item"
                             t-att-class="{ 'is-selected': r.id === state.selectedId }"
                             t-on-click="() => this.select(r.id)">
                            <div class="dl-creq-item-top">
                                <span class="dl-creq-item-code" t-esc="r.code"/>
                                <span t-att-class="'dl-creq-badge ' + r.state" t-esc="stateLabels[r.state]"/>
                            </div>
                            <div class="dl-creq-item-cust" t-esc="r.customer"/>
                            <div class="dl-creq-item-meta">
                                <span><i class="fa fa-cube"/> <t t-esc="r.group"/></span>
                                <span><i class="fa fa-hashtag"/> SL <t t-esc="r.qty"/></span>
                                <span><i class="fa fa-calendar-o"/> <t t-esc="r.date"/></span>
                            </div>
                        </div>
                    </t>
                    <div t-if="!filtered.length" class="dl-creq-empty">Không có yêu cầu phù hợp.</div>
                </div>

                <div class="dl-creq-detail" t-if="selected">
                    <div class="dl-creq-detail-head">
                        <div>
                            <div class="dl-creq-detail-code" t-esc="selected.code"/>
                            <div class="dl-creq-detail-cust" t-esc="selected.customer"/>
                        </div>
                        <span t-att-class="'dl-creq-badge ' + selected.state" t-esc="stateLabels[selected.state]"/>
                    </div>

                    <div class="dl-creq-detail-grid">
                        <div class="dl-creq-field">
                            <span class="k">Liên hệ</span>
                            <span class="v" t-esc="selected.contact"/>
                        </div>
                        <div class="dl-creq-field">
                            <span class="k">Kênh tiếp nhận</span>
                            <span class="v" t-esc="selected.channel"/>
                        </div>
                        <div class="dl-creq-field">
                            <span class="k">Nhóm sản phẩm</span>
                            <span class="v" t-esc="selected.group"/>
                        </div>
                        <div class="dl-creq-field">
                            <span class="k">Số lượng</span>
                            <span class="v" t-esc="selected.qty"/>
                        </div>
                        <div class="dl-creq-field">
                            <span class="k">Ngày yêu cầu</span>
                            <span class="v" t-esc="selected.date"/>
                        </div>
                    </div>

                    <div class="dl-creq-note">
                        <span class="k">Nội dung yêu cầu</span>
                        <p t-esc="selected.note"/>
                    </div>

                    <div class="dl-creq-detail-actions">
                        <button class="dl-creq-btn-primary" type="button" t-on-click="createRfq">
                            <i class="fa fa-file-text-o"/> Tạo báo giá (RFQ)
                        </button>
                        <button class="dl-creq-btn-ghost" type="button">
                            <i class="fa fa-check"/> Đánh dấu đã xử lý
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</t>

</templates>
