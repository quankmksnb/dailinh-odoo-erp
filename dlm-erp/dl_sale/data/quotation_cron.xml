<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Chạy nền hằng ngày: báo giá đã gửi khách mà quá hạn thì tự chuyển
         sang Hết hiệu lực. -->
    <record id="cron_dl_quotation_expire" model="ir.cron">
        <field name="name">Báo giá: tự động hết hiệu lực khi quá hạn</field>
        <field name="model_id" ref="model_dl_quotation"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_quotations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
