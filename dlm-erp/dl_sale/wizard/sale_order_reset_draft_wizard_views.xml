<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_sale_order_reset_draft_wizard_form" model="ir.ui.view">
        <field name="name">dl.sale.order.reset.draft.wizard.form</field>
        <field name="model">dl.sale.order.reset.draft.wizard</field>
        <field name="arch" type="xml">
            <form string="Đưa đơn bán hàng về nháp">
                <group col="1">
                    <field name="order_id"/>
                    <field name="reason"
                           placeholder="Ví dụ: Xác nhận nhầm số lượng, cần sửa trước khi triển khai đơn..."/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Chỉ thực hiện khi đơn chưa phát sinh lệnh sản xuất, mua hàng,
                    giao hàng hoặc hóa đơn.
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Đưa về nháp" class="btn-primary"/>
                    <button string="Không, giữ nguyên đơn" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
