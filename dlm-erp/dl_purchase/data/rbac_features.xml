<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ⚠️ `code` phải DUY NHẤT toàn hệ thống (code_uniq). Tiền tố purchase_
             để không đụng code ngắn đang dùng. Đổi code sau này = sinh bản ghi
             MỚI chứ không phải đổi tên, và feature mồ côi làm `-u` chết. -->
        <record id="feat_purchase_order" model="dl.rbac.feature">
            <field name="name">Đơn mua hàng</field>
            <field name="code">purchase_order</field>
            <field name="model_id" ref="model_dl_purchase_order" />
            <field name="category">master</field>
            <field name="sequence">70</field>
        </record>
    </data>
</odoo>
