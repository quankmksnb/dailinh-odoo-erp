<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         BOM (dl.bom)
    ================================================================ -->

    <!-- Tree view -->
    <record id="view_dl_bom_tree" model="ir.ui.view">
        <field name="name">dl.bom.tree</field>
        <field name="model">dl.bom</field>
        <field name="arch" type="xml">
            <tree string="Bill of Materials"
                  decoration-muted="status == 'archived'"
                  decoration-info="status == 'draft'"
                  decoration-success="status == 'confirmed'"
                  decoration-warning="status == 'locked'">
                <field name="name"/>
                <field name="bom_type" widget="badge"/>
                <field name="owner_name" string="Sản phẩm / Nhóm"/>
                <field name="version"/>
                <field name="product_qty"/>
                <field name="line_count" string="Dòng"/>
                <field name="total_material_cost" string="Chi phí VT"
                       groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-success="status == 'confirmed'"
                       decoration-warning="status == 'locked'"
                       decoration-muted="status == 'archived'"/>
                <field name="confirmed_by"/>
                <field name="confirmed_date" widget="date"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_dl_bom_form" model="ir.ui.view">
        <field name="name">dl.bom.form</field>
        <field name="model">dl.bom</field>
        <field name="arch" type="xml">
            <form string="Bill of Materials">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận BOM"
                            class="oe_highlight"
                            invisible="status != 'draft'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_reset_draft" type="object" string="Về nháp"
                            invisible="status != 'confirmed'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_create_new_version" type="object"
                            string="Tạo phiên bản mới"
                            invisible="status not in ('confirmed', 'locked')"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_copy_as_quotation_bom" type="object"
                            string="Sao chép → BOM báo giá"
                            invisible="bom_type != 'template'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <button name="action_archive_bom" type="object" string="Lưu trữ"
                            invisible="status in ('locked', 'archived')"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"
                            confirm="Bạn có chắc muốn lưu trữ BOM này?"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,confirmed,locked"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="name != 'New'"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Thông tin BOM">
                            <field name="bom_type" readonly="status != 'draft'"/>
                            <field name="version" readonly="1"/>
                            <field name="product_qty"/>
                            <field name="rfq_id" readonly="1"
                                   invisible="not rfq_id"/>
                        </group>
                        <group string="Liên kết sản phẩm">
                            <field name="product_id"
                                   readonly="status != 'draft'"
                                   invisible="bom_type == 'template' and not product_id"/>
                            <field name="semi_product_id"
                                   readonly="status != 'draft'"
                                   invisible="bom_type == 'template' and not semi_product_id"/>
                            <field name="category_id"
                                   readonly="status != 'draft'"
                                   invisible="bom_type != 'template'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Dòng BOM" name="bom_lines">
                            <field name="line_ids"
                                   readonly="status in ('locked', 'archived')">
                                <tree string="Dòng BOM" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="component_type"/>
                                    <field name="material_id"
                                           invisible="component_type != 'raw_material'"
                                           required="component_type == 'raw_material'"/>
                                    <field name="semi_finished_id"
                                           invisible="component_type != 'semi_finished'"
                                           required="component_type == 'semi_finished'"/>
                                    <field name="component_name" optional="hide"/>
                                    <field name="input_length_mm" optional="show"
                                           string="Dài (mm)"/>
                                    <field name="input_width_mm" optional="show"
                                           string="Rộng (mm)"/>
                                    <field name="input_thickness_mm" optional="show"
                                           string="Dày (mm)"/>
                                    <field name="quantity"/>
                                    <field name="waste_rate" string="Hao hụt (%)"/>
                                    <field name="effective_qty" string="SL thực"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="is_override" optional="hide"/>
                                    <field name="override_reason" optional="hide"/>
                                    <field name="price_snapshot"
                                           groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager"/>
                                    <field name="subtotal" sum="Tổng"
                                           groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager"/>
                                    <field name="material_price_status" widget="badge"
                                           decoration-danger="material_price_status == 'expired'"
                                           decoration-warning="material_price_status == 'warning'"
                                           decoration-success="material_price_status == 'ok'"
                                           optional="show" string="Giá VT"/>
                                    <field name="note" optional="hide"/>
                                </tree>
                            </field>

                            <group class="oe_subtotal_footer oe_right"
                                   groups="dl_base.dl_group_ceo,dl_base.dl_group_admin,dl_base.dl_group_accountant,dl_base.dl_group_sales_manager">
                                <field name="total_material_cost"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>

                        <page string="Ghi chú" name="notes">
                            <group>
                                <field name="note" nolabel="1"
                                       placeholder="Ghi chú kỹ thuật..."/>
                            </group>
                            <group string="Thay đổi">
                                <field name="change_note" nolabel="1"
                                       placeholder="Mô tả thay đổi so với phiên bản trước..."/>
                            </group>
                        </page>

                        <page string="Xác nhận" name="confirmation"
                              invisible="not confirmed_by">
                            <group>
                                <group>
                                    <field name="confirmed_by"/>
                                    <field name="confirmed_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_dl_bom_search" model="ir.ui.view">
        <field name="name">dl.bom.search</field>
        <field name="model">dl.bom</field>
        <field name="arch" type="xml">
            <search string="Tìm BOM">
                <field name="name"/>
                <field name="product_id"/>
                <field name="semi_product_id"/>
                <field name="category_id"/>
                <field name="owner_name"/>
                <separator/>
                <filter name="draft" string="Nháp"
                        domain="[('status', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận"
                        domain="[('status', '=', 'confirmed')]"/>
                <filter name="locked" string="Đã khóa"
                        domain="[('status', '=', 'locked')]"/>
                <filter name="archived" string="Lưu trữ"
                        domain="[('status', '=', 'archived')]"/>
                <separator/>
                <filter name="type_quotation" string="BOM báo giá"
                        domain="[('bom_type', '=', 'quotation')]"/>
                <filter name="type_template" string="BOM mẫu"
                        domain="[('bom_type', '=', 'template')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_status" string="Trạng thái"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="Loại BOM"
                            context="{'group_by': 'bom_type'}"/>
                    <filter name="group_product" string="Sản phẩm"
                            context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_dl_bom" model="ir.actions.act_window">
        <field name="name">Bill of Materials</field>
        <field name="res_model">dl.bom</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_type_quotation': 1}</field>
    </record>

    <record id="action_dl_bom_template" model="ir.actions.act_window">
        <field name="name">BOM Mẫu</field>
        <field name="res_model">dl.bom</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('bom_type', '=', 'template')]</field>
        <field name="context">{'default_bom_type': 'template'}</field>
    </record>

</odoo>
