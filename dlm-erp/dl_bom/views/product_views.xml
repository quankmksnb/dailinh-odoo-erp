<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         NHÓM SẢN PHẨM (dl.product.category — A2)
    ================================================================ -->

    <record id="view_dl_product_category_tree" model="ir.ui.view">
        <field name="name">dl.product.category.tree</field>
        <field name="model">dl.product.category</field>
        <field name="arch" type="xml">
            <tree string="Nhóm sản phẩm">
                <field name="name"/>
                <field name="template_bom_id"/>
                <field name="product_count" string="Số SP"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_product_category_form" model="ir.ui.view">
        <field name="name">dl.product.category.form</field>
        <field name="model">dl.product.category</field>
        <field name="arch" type="xml">
            <form string="Nhóm sản phẩm">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="template_bom_id"/>
                            <field name="product_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_product_category" model="ir.actions.act_window">
        <field name="name">Nhóm sản phẩm</field>
        <field name="res_model">dl.product.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================================================================
         THÀNH PHẨM (A3 — mở rộng product.product, KHÔNG có model dl.product
         riêng theo TDS. Views này hiển thị product.product lọc product_kind=finished).
    ================================================================ -->

    <record id="view_dl_product_tree" model="ir.ui.view">
        <field name="name">dl.product.product.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree string="Danh mục sản phẩm" decoration-muted="active == False">
                <field name="default_code"/>
                <field name="name"/>
                <field name="product_category_id"/>
                <field name="supply_type"/>
                <field name="dimension_spec"/>
                <field name="uom_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="bom_count" string="BOM"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_product_form" model="ir.ui.view">
        <field name="name">dl.product.product.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form string="Sản phẩm">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_boms" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="bom_count" widget="statinfo" string="BOM"/>
                        </button>
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="default_code"/>
                        <h1>
                            <field name="default_code" placeholder="Mã sản phẩm (VD: CT-200)..."/>
                        </h1>
                        <label for="name"/>
                        <h2>
                            <field name="name" placeholder="Tên sản phẩm..."/>
                        </h2>
                    </div>
                    <field name="product_kind" invisible="1"/>
                    <group>
                        <group string="Thông tin chung">
                            <field name="product_category_id"/>
                            <field name="uom_id"/>
                            <field name="supply_type"/>
                            <field name="purchase_cost"
                                   invisible="supply_type != 'trading'"/>
                            <field name="default_supplier_id"
                                   invisible="supply_type != 'trading'"/>
                        </group>
                        <group string="Thuộc tính kỹ thuật">
                            <field name="dimension_spec" placeholder="VD: 600x400x800mm"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú kỹ thuật" name="tech_note">
                            <field name="technical_note" nolabel="1"
                                   placeholder="Tiêu chuẩn, yêu cầu đặc biệt..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_product_search" model="ir.ui.view">
        <field name="name">dl.product.product.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Tìm sản phẩm">
                <field name="default_code"/>
                <field name="name"/>
                <field name="product_category_id"/>
                <filter name="active_state" string="Đang sản xuất"
                        domain="[('active', '=', True)]"/>
                <filter name="discontinued" string="Ngừng"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="manufactured" string="Gia công"
                        domain="[('supply_type', '=', 'manufactured')]"/>
                <filter name="trading" string="Hàng có sẵn"
                        domain="[('supply_type', '=', 'trading')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_category" string="Nhóm SP"
                            context="{'group_by': 'product_category_id'}"/>
                    <filter name="group_supply" string="Loại cung ứng"
                            context="{'group_by': 'supply_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_product" model="ir.actions.act_window">
        <field name="name">Danh mục sản phẩm</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('product_kind', '=', 'finished')]</field>
        <field name="context">{'search_default_active_state': 1, 'default_product_kind': 'finished', 'default_type': 'consu'}</field>
    </record>

</odoo>
