<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         NHÓM SẢN PHẨM (dl.product.category)
    ================================================================ -->

    <record id="view_dl_product_category_tree" model="ir.ui.view">
        <field name="name">dl.product.category.tree</field>
        <field name="model">dl.product.category</field>
        <field name="arch" type="xml">
            <tree string="Nhóm sản phẩm">
                <field name="name"/>
                <field name="template_bom_id"/>
                <field name="product_count" string="Số SP"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_product_category_form" model="ir.ui.view">
        <field name="name">dl.product.category.form</field>
        <field name="model">dl.product.category</field>
        <field name="arch" type="xml">
            <form string="Nhóm sản phẩm">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="template_bom_id"/>
                            <field name="product_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_product_category" model="ir.actions.act_window">
        <field name="name">Nhóm sản phẩm</field>
        <field name="res_model">dl.product.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================================================================
         THÀNH PHẨM (dl.product)
    ================================================================ -->

    <record id="view_dl_product_tree" model="ir.ui.view">
        <field name="name">dl.product.tree</field>
        <field name="model">dl.product</field>
        <field name="arch" type="xml">
            <tree string="Danh mục sản phẩm"
                  decoration-muted="state == 'discontinued'">
                <field name="default_code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="supply_type"/>
                <field name="dimension_spec"/>
                <field name="material_spec"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'discontinued'"/>
                <field name="bom_count" string="BOM"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_product_form" model="ir.ui.view">
        <field name="name">dl.product.form</field>
        <field name="model">dl.product</field>
        <field name="arch" type="xml">
            <form string="Sản phẩm">
                <header>
                    <button name="action_activate" type="object" string="Kích hoạt"
                            class="oe_highlight"
                            invisible="state == 'active'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"/>
                    <button name="action_discontinue" type="object" string="Ngừng"
                            invisible="state != 'active'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,discontinued"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_boms" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="bom_count" widget="statinfo" string="BOM"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="default_code"/>
                        <h1>
                            <field name="default_code" placeholder="Mã sản phẩm..."
                                   readonly="default_code != 'New'"/>
                        </h1>
                        <label for="name"/>
                        <h2>
                            <field name="name" placeholder="Tên sản phẩm..."/>
                        </h2>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="category_id"/>
                            <field name="uom_id"/>
                            <field name="supply_type"/>
                            <field name="purchase_cost"
                                   invisible="supply_type != 'trading'"/>
                        </group>
                        <group string="Thuộc tính kỹ thuật">
                            <field name="dimension_spec" placeholder="VD: 900 x 600 x 800"/>
                            <field name="material_spec" placeholder="VD: Thép CT3"/>
                            <field name="finish_spec"/>
                            <field name="weight_estimate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú kỹ thuật" name="tech_note">
                            <field name="technical_note" nolabel="1"
                                   placeholder="Tiêu chuẩn, yêu cầu đặc biệt..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dl_product_search" model="ir.ui.view">
        <field name="name">dl.product.search</field>
        <field name="model">dl.product</field>
        <field name="arch" type="xml">
            <search string="Tìm sản phẩm">
                <field name="default_code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="material_spec"/>
                <filter name="active_state" string="Đang sản xuất"
                        domain="[('state', '=', 'active')]"/>
                <filter name="discontinued" string="Ngừng"
                        domain="[('state', '=', 'discontinued')]"/>
                <separator/>
                <filter name="manufactured" string="Gia công"
                        domain="[('supply_type', '=', 'manufactured')]"/>
                <filter name="trading" string="Hàng có sẵn"
                        domain="[('supply_type', '=', 'trading')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_category" string="Nhóm SP"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_supply" string="Loại cung ứng"
                            context="{'group_by': 'supply_type'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dl_product" model="ir.actions.act_window">
        <field name="name">Danh mục sản phẩm</field>
        <field name="res_model">dl.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active_state': 1}</field>
    </record>

</odoo>
