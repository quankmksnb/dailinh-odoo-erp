<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Kế thừa form dl.product (S05, module dl_sale) — thêm thuộc tính
         cần cho S08 BOM + nối "BOM liên quan" đúng chỗ placeholder cũ.
         KHÔNG khai báo model/tree/form/action mới cho dl.product để tránh
         trùng lặp với màn Danh mục Sản phẩm đã có sẵn.
    ================================================================ -->

    <record id="view_dl_product_form_inherit_bom" model="ir.ui.view">
        <field name="name">dl.product.form.inherit.bom</field>
        <field name="model">dl.product</field>
        <field name="inherit_id" ref="dl_sale.view_dl_product_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_boms" type="object"
                            class="oe_stat_button" icon="fa-list">
                        <field name="bom_count" widget="statinfo" string="BOM"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='finish']/.." position="after">
                <group string="Cung ứng (S08 — BOM)">
                    <field name="supply_type"/>
                    <field name="uom_id"/>
                    <field name="purchase_cost" invisible="supply_type != 'trading'"/>
                    <field name="default_supplier_id" invisible="supply_type != 'trading'"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='boms']/div" position="replace">
                <field name="bom_ids" nolabel="1">
                    <tree string="BOM">
                        <field name="name"/>
                        <field name="version"/>
                        <field name="status" widget="badge"/>
                        <field name="line_count" string="Dòng"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         Quản lý Nhóm sản phẩm (dl.product.category) — dl_sale mới chỉ seed
         dữ liệu + dùng field trong dropdown, chưa có màn CRUD riêng, nên
         thêm ở đây để gán template_bom_id.
    ================================================================ -->

    <record id="view_dl_product_category_tree" model="ir.ui.view">
        <field name="name">dl.product.category.tree</field>
        <field name="model">dl.product.category</field>
        <field name="arch" type="xml">
            <tree string="Nhóm sản phẩm">
                <field name="name"/>
                <field name="template_bom_id"/>
                <field name="product_count" string="Số SP"/>
            </tree>
        </field>
    </record>

    <record id="view_dl_product_category_form" model="ir.ui.view">
        <field name="name">dl.product.category.form</field>
        <field name="model">dl.product.category</field>
        <field name="arch" type="xml">
            <form string="Nhóm sản phẩm">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="template_bom_id"/>
                            <field name="product_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_product_category" model="ir.actions.act_window">
        <field name="name">Nhóm sản phẩm</field>
        <field name="res_model">dl.product.category</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
