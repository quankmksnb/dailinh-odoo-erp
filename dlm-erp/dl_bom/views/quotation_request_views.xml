<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         YÊU CẦU BÁO GIÁ — D1 (dl.quotation.request, header) + line
    ================================================================ -->

    <!-- Tree view -->
    <record id="view_dl_quotation_request_tree" model="ir.ui.view">
        <field name="name">dl.quotation.request.tree</field>
        <field name="model">dl.quotation.request</field>
        <field name="arch" type="xml">
            <tree string="Yêu cầu báo giá"
                  decoration-danger="is_overdue == True"
                  decoration-muted="status in ('cancelled', 'quoted')">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="requested_date" widget="date"/>
                <field name="deadline" widget="date"
                       decoration-danger="is_overdue == True"/>
                <field name="line_count" string="Số dòng SP"/>
                <field name="technician_id"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'new'"
                       decoration-warning="status == 'assigned'"
                       decoration-success="status == 'processing'"
                       decoration-muted="status in ('quoted', 'cancelled')"/>
                <field name="is_overdue" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_dl_quotation_request_form" model="ir.ui.view">
        <field name="name">dl.quotation.request.form</field>
        <field name="model">dl.quotation.request</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu báo giá">
                <header>
                    <!-- Sales giao cho KT -->
                    <button name="action_assign_technician" type="object"
                            string="Giao cho Kỹ thuật" class="oe_highlight"
                            invisible="status != 'new'"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"/>
                    <!-- KT bắt đầu xử lý -->
                    <button name="action_start_processing" type="object"
                            string="Bắt đầu xử lý"
                            invisible="status != 'assigned'"
                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                    <!-- Hủy -->
                    <button name="action_cancel" type="object"
                            string="Hủy"
                            invisible="status in ('quoted', 'cancelled')"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_sales_manager,dl_base.dl_group_admin"
                            confirm="Bạn có chắc muốn hủy RFQ này?"/>
                    <!-- Về mới -->
                    <button name="action_reset_new" type="object"
                            string="Về mới"
                            invisible="status != 'cancelled'"
                            groups="dl_base.dl_group_ba,dl_base.dl_group_admin"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,assigned,processing,quoted"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Thông tin yêu cầu">
                            <field name="customer_id" readonly="status != 'new'"/>
                            <field name="requested_date" readonly="status != 'new'"/>
                            <field name="deadline"/>
                            <field name="created_by"/>
                        </group>
                        <group string="Phân công">
                            <field name="technician_id"
                                   readonly="status not in ('new', 'assigned')"/>
                            <field name="assigned_date"/>
                            <field name="is_overdue" invisible="not is_overdue"/>
                            <field name="quotation_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Dòng sản phẩm" name="lines">
                            <field name="line_ids"
                                   readonly="status in ('quoted', 'cancelled')">
                                <tree string="Dòng sản phẩm" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_name"/>
                                    <field name="product_category_id"/>
                                    <field name="quantity"/>
                                    <field name="product_check_result" widget="badge"
                                           decoration-info="product_check_result == 'new_product'"
                                           decoration-warning="product_check_result == 'similar_product'"
                                           decoration-success="product_check_result == 'existing_product'"
                                           decoration-muted="product_check_result == 'trading_no_bom'"/>
                                    <field name="reference_bom_id"/>
                                    <field name="created_bom_id"/>
                                    <button name="action_create_bom" type="object"
                                            string="Tạo BOM" icon="fa-cogs"
                                            invisible="not product_check_result or product_check_result == 'trading_no_bom' or created_bom_id"
                                            groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                                </tree>
                                <form string="Dòng sản phẩm">
                                    <group>
                                        <group string="Yêu cầu">
                                            <field name="product_name"/>
                                            <field name="product_category_id"/>
                                            <field name="quantity"/>
                                            <field name="note"/>
                                        </group>
                                        <group string="Đánh giá kỹ thuật">
                                            <field name="product_check_result" widget="radio"/>
                                            <field name="check_note"/>
                                            <field name="reference_product_id"
                                                   invisible="product_check_result in (False, 'new_product', 'trading_no_bom')"/>
                                            <field name="reference_bom_id"
                                                   invisible="product_check_result in (False, 'new_product', 'trading_no_bom')"/>
                                            <field name="created_bom_id" readonly="1"/>
                                        </group>
                                    </group>
                                    <group string="BOM tương tự (gợi ý)"
                                           invisible="not similar_bom_ids">
                                        <field name="similar_bom_ids" nolabel="1" readonly="1">
                                            <tree string="BOM tương tự">
                                                <field name="name"/>
                                                <field name="owner_name"/>
                                                <field name="version"/>
                                                <field name="status" widget="badge"/>
                                            </tree>
                                        </field>
                                    </group>
                                    <footer>
                                        <button name="action_create_bom" type="object"
                                                string="Tạo BOM" class="oe_highlight"
                                                invisible="not product_check_result or product_check_result == 'trading_no_bom' or created_bom_id"
                                                groups="dl_base.dl_group_tech,dl_base.dl_group_admin"/>
                                    </footer>
                                </form>
                            </field>
                        </page>

                        <page string="Ghi chú &amp; đính kèm" name="notes">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Ghi chú chung: hẹn nhận hàng, điều khoản thanh toán..."/>
                            </group>
                            <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_dl_quotation_request_search" model="ir.ui.view">
        <field name="name">dl.quotation.request.search</field>
        <field name="model">dl.quotation.request</field>
        <field name="arch" type="xml">
            <search string="Tìm yêu cầu báo giá">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="technician_id"/>
                <separator/>
                <filter name="new" string="Mới"
                        domain="[('status', '=', 'new')]"/>
                <filter name="assigned" string="Đã giao KT"
                        domain="[('status', '=', 'assigned')]"/>
                <filter name="processing" string="Đang xử lý"
                        domain="[('status', '=', 'processing')]"/>
                <filter name="quoted" string="Đã tạo BG"
                        domain="[('status', '=', 'quoted')]"/>
                <separator/>
                <filter name="overdue" string="Quá hạn"
                        domain="[('deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('status', 'not in', ('quoted', 'cancelled'))]"/>
                <filter name="my_rfq" string="RFQ của tôi"
                        domain="[('technician_id', '=', uid)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_status" string="Trạng thái"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_customer" string="Khách hàng"
                            context="{'group_by': 'customer_id'}"/>
                    <filter name="group_technician" string="Kỹ thuật viên"
                            context="{'group_by': 'technician_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dl_quotation_request" model="ir.actions.act_window">
        <field name="name">Yêu cầu báo giá</field>
        <field name="res_model">dl.quotation.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_new': 1, 'search_default_assigned': 1, 'search_default_processing': 1}</field>
    </record>

    <record id="action_dl_quotation_request_my" model="ir.actions.act_window">
        <field name="name">RFQ của tôi</field>
        <field name="res_model">dl.quotation.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_rfq': 1}</field>
    </record>

</odoo>
